# Individual: <http://www.ebi.ac.uk/coho/COHO_0000809> (<http://www.ebi.ac.uk/coho/COHO_0000809>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20811451") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000809> "A collection of DNA samples and lymphoblastoid cell lines from Japanese individuals in Tokyo, Japan, that forms one of the four founding population samples of the International HapMap Project and is used as a reference for human genetic variation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000810> (<http://www.ebi.ac.uk/coho/COHO_0000810>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471867") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000810> "A longitudinal, epidemiologic clinical-pathologic cohort study of common chronic conditions of ageing run by the Rush Alzheimer's Disease Center, which since 1997 has enrolled older lay persons without dementia, mainly from retirement communities across northeastern Illinois, who agree to annual clinical evaluations and organ donation, with an emphasis on decline in cognitive and motor function and risk of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000811> (<http://www.ebi.ac.uk/coho/COHO_0000811>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.thessgac.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000811> "A consortium founded in 2011 of medical researchers and social scientists that coordinates genome-wide association studies of social-science outcomes such as educational attainment across more than 100 contributing cohorts and promotes harmonised phenotype measurement.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000812> (<http://www.ebi.ac.uk/coho/COHO_0000812>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34654805") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000812> "A population-based longitudinal study of adults aged 65 and over recruited in three French cities, Bordeaux, Dijon and Montpellier, and followed from 1999 to 2012 with repeated examinations of vascular risk factors, cognition and subclinical vascular disease to study the relation between vascular diseases and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000813> (<http://www.ebi.ac.uk/coho/COHO_0000813>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18992148") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000813> "A case-control study of sporadic colorectal cancer in the Pays de la Loire region of France, which recruited about 1,000 patients diagnosed at age 40 or over in regional hospitals and clinics and about 1,100 age- and sex-matched controls at regional health examination centres in 2002–2006, to study genetic susceptibility to colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000814> (<http://www.ebi.ac.uk/coho/COHO_0000814>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28742079") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000814> "A collection of unrelated children and adolescents referred by local schools for assessment of reading difficulties at the Aston Dyslexia and Developmental Assessment Unit in Birmingham, UK, and invited to take part in research, genotyped for genetic studies of dyslexia and reading- and language-related skills.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000815> (<http://www.ebi.ac.uk/coho/COHO_0000815>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24722645") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000815> "A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000816> (<http://www.ebi.ac.uk/coho/COHO_0000816>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000817> (<http://www.ebi.ac.uk/coho/COHO_0000817>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000818> (<http://www.ebi.ac.uk/coho/COHO_0000818>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22271044") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000818> "A hospital-based prospective case-control study of prostate cancer in France, run by the Centre de Recherche pour les Pathologies Prostatiques (CeRePP) at Hôpital Tenon, Paris, whose cases are patients with histologically confirmed prostate cancer treated in French urology departments and whose controls are men found unaffected in a systematic health screening programme, used in genetic association studies of prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000819> (<http://www.ebi.ac.uk/coho/COHO_0000819>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 738 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000820> (<http://www.ebi.ac.uk/coho/COHO_0000820>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40783417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000820> "A population-based prospective cohort of men born in 1918–1952 living in Västmanland and Örebro counties in central Sweden, established in 1997 and used, with the Swedish Mammography Cohort, to study diet, lifestyle and chronic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000821> (<http://www.ebi.ac.uk/coho/COHO_0000821>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35807897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000821> "A hospital-based case-control study of colorectal cancer in the Czech Republic, with cases and controls collected at oncology departments of several Czech hospitals from 2003 onwards, used to study genetic and lifestyle risk factors for colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000822> (<http://www.ebi.ac.uk/coho/COHO_0000822>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000823> (<http://www.ebi.ac.uk/coho/COHO_0000823>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000824> (<http://www.ebi.ac.uk/coho/COHO_0000824>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24163127") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000824> "A hospital-based case-control study of bladder cancer in France (190 cases and 316 controls, 84% men, in the International Consortium of Bladder Cancer pooled analyses), whose cases were also genotyped for the NCI bladder cancer genome-wide association study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000825> (<http://www.ebi.ac.uk/coho/COHO_0000825>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25882629") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000825> "A National Cancer Institute Clinical Genetics Branch study (protocol 02-C-0178) that enrolls families with at least two cases of testicular germ cell tumour, identified through physician and self-referral, together with controls, to study the genetic and clinical features of familial testicular cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000826> (<http://www.ebi.ac.uk/coho/COHO_0000826>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000827> (<http://www.ebi.ac.uk/coho/COHO_0000827>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30206078") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000827> "A European population-based exposome cohort built across six existing longitudinal birth cohorts in France, Greece, Lithuania, Norway, Spain and the UK, with a subcohort of 1,301 mother-child pairs in which biomarkers, omics signatures and child health outcomes were measured at age 6–11 years, to relate multiple early-life environmental exposures to molecular signatures and child health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000828> (<http://www.ebi.ac.uk/coho/COHO_0000828>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33763119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36327219") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000828> "A collection of COVID-19 phenotypes from participants sequenced with the Helix Exome+ assay, including those of the Healthy Nevada Project, a population health study established in 2016 by Renown Health and the Desert Research Institute in Reno, Nevada, contributed to COVID-19 host genetics studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000829> (<http://www.ebi.ac.uk/coho/COHO_0000829>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000829> "An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000830> (<http://www.ebi.ac.uk/coho/COHO_0000830>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19174821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000830> "A population-based case-control study of bladder cancer in Los Angeles County, United States, with cases aged 25–64 diagnosed in 1987–1996 identified through the Los Angeles County Cancer Surveillance Program and matched neighbourhood controls, used to study lifestyle and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000831> (<http://www.ebi.ac.uk/coho/COHO_0000831>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000832> (<http://www.ebi.ac.uk/coho/COHO_0000832>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22672568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000832> "A case-control study at the Mayo Clinic, Rochester, Minnesota, of adults with objectively diagnosed venous thromboembolism and age- and sex-matched controls, supplemented by Olmsted County residents with incident venous thromboembolism and matched controls, used for candidate-gene, genome-wide and whole-genome sequencing studies of venous thromboembolism risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000833> (<http://www.ebi.ac.uk/coho/COHO_0000833>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41183009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000833> "A multicase-control study in Spain that recruited hospital-based cases of several common cancers, including breast, colorectal and prostate cancer, and population-based controls in 2008–2013, to study environmental, lifestyle and genetic risk factors for these cancers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000834> (<http://www.ebi.ac.uk/coho/COHO_0000834>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000835> (<http://www.ebi.ac.uk/coho/COHO_0000835>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000835> "A prospective population-based multicentre study of 3,014 men aged 69–81, randomly selected from the Swedish national population register and examined at hospitals in Malmö, Gothenburg and Uppsala in 2001–2004, the Swedish part of the Osteoporotic Fractures in Men study, set up to identify risk factors for osteoporosis and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000836> (<http://www.ebi.ac.uk/coho/COHO_0000836>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35536285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000836> "A population-based case-control study of bladder cancer among residents of Maine, New Hampshire and Vermont, United States, with cases newly diagnosed in 2001–2004 and population controls frequency-matched on age, sex and state, used to study environmental, dietary and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000837> (<http://www.ebi.ac.uk/coho/COHO_0000837>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000838> (<http://www.ebi.ac.uk/coho/COHO_0000838>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38184787") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000838> "A set of about 115 autopsied people referred with rapidly progressive dementia resembling prion disease to the National Prion Disease Pathology Surveillance Center at Case Western Reserve University between 2009 and 2017, in whom neuropathology, prion protein typing, PRNP sequencing and record review excluded prion disease and confirmed Alzheimer's disease, whole-genome sequenced from frozen brain tissue for genetic studies of rapidly progressive Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000839> (<http://www.ebi.ac.uk/coho/COHO_0000839>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32776978") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000839> "A cross-sectional observational cohort of more than 800 adult patients with sickle cell disease enrolled between 2002 and 2015 at sickle cell centres in the southeastern United States, coordinated from Duke University, to study genetic associations with clinical outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000840> (<http://www.ebi.ac.uk/coho/COHO_0000840>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26405788") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000840> "A population-based incidence cohort of people diagnosed with Parkinson's disease within the previous 3.5 years, recruited by the Oxford Parkinson's Disease Centre from 11 hospitals across the Thames Valley, England, between 2010 and 2014, and followed with motor, cognitive and non-motor assessments to study Parkinson's disease progression and subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000841> (<http://www.ebi.ac.uk/coho/COHO_0000841>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21529783") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000841> "A family sample of sibships ascertained through the Australian Twin Registry, with diagnostic interviews and blood or buccal DNA, of whom 8754 individuals (2062 alcohol-dependent cases) were genotyped genome-wide to study genetic contributions to alcohol use and dependence and nicotine dependence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000842> (<http://www.ebi.ac.uk/coho/COHO_0000842>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26442452") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000842> "A longitudinal multi-project collection of clinical data and biosamples from people with Parkinson's disease at different stages, other parkinsonism, essential tremor and controls, established in 2012 by the US National Institute of Neurological Disorders and Stroke as a consortium of biomarker discovery projects with standardized procedures and a shared data management resource.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000843> (<http://www.ebi.ac.uk/coho/COHO_0000843>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39271666") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000843> "A growing biobank and national consortium of case–control studies in Pakistan that aims to enrol one million participants (about 250,000 from 48 clinical sites in 17 cities by September 2023) across some 50 diseases, with whole-exome sequencing and recontact, used for genetic association and loss-of-function studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000844> (<http://www.ebi.ac.uk/coho/COHO_0000844>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25588294") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000844> "A multicentre, randomised, placebo-controlled smoking-cessation trial (NCT01314001) run from 2010 to 2014 at four academic medical centres in the United States and Canada, in which 1246 treatment-seeking smokers stratified by nicotine metabolite ratio were assigned to placebo, nicotine patch or varenicline.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000845> (<http://www.ebi.ac.uk/coho/COHO_0000845>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000845> "A Spanish case-control study of venous thromboembolism, based at the Hospital de la Santa Creu i Sant Pau in Barcelona, whose cases had a first venous thromboembolism and were sampled after 6–12 months of anticoagulant treatment, with healthy controls recruited from the general population, used to study genetic and plasma determinants of venous thromboembolism.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000846> (<http://www.ebi.ac.uk/coho/COHO_0000846>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18725614") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000846> "A multicentre prospective cohort of 646 patients with a first unprovoked major venous thromboembolism, enrolled from 12 tertiary care centres in 4 countries while on oral anticoagulation 5–7 months after the event and followed after stopping anticoagulation (to September 2006), to derive a clinical decision rule identifying patients at low risk of recurrent venous thromboembolism.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000847> (<http://www.ebi.ac.uk/coho/COHO_0000847>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9238600/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000847> "A single-centre longitudinal family cohort of 4,295 people from 1,006 families of the Lorraine region, recruited in 1993–1995 at the Center for Preventive Medicine in Nancy, France, and re-examined over about 20 years, to study the familial and genetic determinants of cardiovascular and metabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000848> (<http://www.ebi.ac.uk/coho/COHO_0000848>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40072435") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000848> "A cohort of 4,549 self-identified American Indian adults aged 45 years or older, recruited in 1989–1991 from tribal communities in Arizona, Oklahoma, North Dakota and South Dakota, United States, and followed through repeated examinations to estimate cardiovascular disease rates and risk factors in American Indians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000849> (<http://www.ebi.ac.uk/coho/COHO_0000849>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27197724") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28349126") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000849> "A stroke study in which 1,200 black and 1,200 white stroke patients were prospectively recruited between 1999 and 2010 from three hospitals covering a contiguous area of South London, United Kingdom, with black African and African Caribbean community controls from general practice lists in the same catchment area (1999–2012), to study stroke subtypes and the genetic and other risk factors for stroke in African and African Caribbean people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000850> (<http://www.ebi.ac.uk/coho/COHO_0000850>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19646677") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000850> "A collection of nuclear families, each ascertained through a proband with receptive and/or expressive language skills more than 1.5 SD below the age norm, gathered by the SLI Consortium from five clinical and epidemiological sites across the United Kingdom for linkage and association studies of specific language impairment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000851> (<http://www.ebi.ac.uk/coho/COHO_0000851>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22343618") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000851> "A case-control study of testicular germ cell tumours among US military servicemen aged 18–45 with serum stored in the Department of Defense Serum Repository, comparing men diagnosed on active duty in 2002–2005 with matched controls to study environmental, endocrine and genetic risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000852> (<http://www.ebi.ac.uk/coho/COHO_0000852>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000853> (<http://www.ebi.ac.uk/coho/COHO_0000853>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000854> (<http://www.ebi.ac.uk/coho/COHO_0000854>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20585626") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32139696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39753771") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000854> "A consortium of breast cancer genetic association studies in women of Asian ancestry, with studies in mainland China, Taiwan, South Korea and Japan (genome-wide data on about 24,000 cases and 25,000 controls by 2020), formed to discover breast cancer susceptibility loci in Asian populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000855> (<http://www.ebi.ac.uk/coho/COHO_0000855>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892015") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000855> "A consortium of cohort and case-control studies with genome-wide genotype data that pools them in meta-analyses of genome-wide association studies of atrial fibrillation, to identify genetic loci for atrial fibrillation; together with the Broad AF Study, its studies formed the majority of the 2018 multi-ethnic meta-analysis of more than half a million individuals.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000856> (<http://www.ebi.ac.uk/coho/COHO_0000856>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40796244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000856> "A placebo-controlled randomized trial of daily low-dose aspirin in 19,114 community-dwelling adults aged 70 or over (65 or over for US minorities) in Australia and the United States without prior cardiovascular events, dementia or independence-limiting physical disability, followed as a cohort after the trial to study healthy ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000857> (<http://www.ebi.ac.uk/coho/COHO_0000857>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000857> "A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000858> (<http://www.ebi.ac.uk/coho/COHO_0000858>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34923481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35951362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000858> "A family-based extension of the Austrian Stroke Prevention Study in Graz, Austria, for which ASPS participants and their first-degree relatives were invited between 2006 and 2013 (419 individuals from 176 families), examined with clinical history, neurological examination, brain MRI, laboratory tests, cognitive testing and vascular risk factor assessment to study the cerebral effects of vascular risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000859> (<http://www.ebi.ac.uk/coho/COHO_0000859>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000860> (<http://www.ebi.ac.uk/coho/COHO_0000860>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000861> (<http://www.ebi.ac.uk/coho/COHO_0000861>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39715278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000861> "A cohort of about 1,220 mainly vaccine-naive individuals with confirmed SARS-CoV-2 infection, across the full spectrum from asymptomatic to critical COVID-19, recruited early in the pandemic at 16 sites in Germany and South Tyrol, Italy, by a national host-genetics consortium built on the German COVID-19 Omics Initiative, with whole genome sequencing to study host genetic factors in COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000862> (<http://www.ebi.ac.uk/coho/COHO_0000862>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38839884") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000862> "An international consortium of restless legs syndrome case collections recruited by expert clinicians in movement-disorder and sleep clinics in Europe, Canada and the United States, with ancestry-matched population or hospital controls, pooled (7,248 cases and 19,802 controls) for genome-wide association studies of restless legs syndrome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000863> (<http://www.ebi.ac.uk/coho/COHO_0000863>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27198479") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000863> "A Dutch family dataset of 483 children from 307 nuclear families and 505 adults, including parents, assessed for word and nonword reading fluency, phonological awareness and rapid automatized naming to study genetic influences on reading and language.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000864> (<http://www.ebi.ac.uk/coho/COHO_0000864>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000864> "An international consortium of lung cancer studies of never-smoking Asian women from mainland China, Hong Kong, Singapore, Taiwan, South Korea and Japan, pooling genome-wide data to identify genetic risk factors for lung cancer, particularly adenocarcinoma, in this population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000865> (<http://www.ebi.ac.uk/coho/COHO_0000865>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39406924") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000865> "An international consortium of gout genetics research groups, named as a collective author of a genome-wide association analysis of gout in 2.6 million people, whose own case-control sample set (New Zealand/Ardea Biosciences/EuroGout: 4,713 people with self-reported clinically diagnosed gout or gout meeting the 1977 ARA classification criteria and 2,151 controls, of self-reported European ancestry) was genotyped for that study on the Illumina CoreExome array.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000866> (<http://www.ebi.ac.uk/coho/COHO_0000866>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41829988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000866> "A birth cohort in Singapore that enrolled 1468 pregnant women aged 18 years or over at their first-trimester dating scan at the two major public maternity units in 2009–2010 and follows the mothers and their children, to evaluate how early-life exposures influence later metabolic function, body composition and development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000867> (<http://www.ebi.ac.uk/coho/COHO_0000867>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000867> "A case-control study of first-time colorectal adenoma among Caucasian, Japanese and Native Hawaiian adults on Oahu, Hawaii, United States, with cases from the Hawaii site of the PLCO screening trial and Kaiser Permanente Hawaii clinics (1995–2006) and controls with normal endoscopy, used to study risk factors for colorectal neoplasia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000868> (<http://www.ebi.ac.uk/coho/COHO_0000868>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000868> "A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000869> (<http://www.ebi.ac.uk/coho/COHO_0000869>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37494057") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40650879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000869> "A cohort of patients with hidradenitis suppurativa recruited at the University of North Carolina Department of Dermatology in the United States from August 2018 (753 patients by July 2021, later expanded to 986), providing clinical data and DNA for genetic association studies of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000870> (<http://www.ebi.ac.uk/coho/COHO_0000870>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000870> "A multicentre hospital-based case–control study of lung cancer coordinated by the International Agency for Research on Cancer in Romania, Hungary, Slovakia, Poland, Russia and the Czech Republic, whose genome-wide genotyped cases and controls form the IARC lung cancer GWAS used by international lung cancer consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000871> (<http://www.ebi.ac.uk/coho/COHO_0000871>)

