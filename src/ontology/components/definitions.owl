AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25420145") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25420145") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(rdfs:comment "Additional DNA samples from CeAD patients of European origin were collected in 2010-2011 following CADISP inclusion criteria (Supplementary Fig. 1), through departments of neurology specialized in stroke care in Germany, the Netherlands, Sweden, Italy, France, Switzerland and the USA (Supplementary Table 4).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001759> "A collection of patients with cervical artery dissection, of European origin, at the Sahlgrenska Academy of the University of Gothenburg, Sweden, drawn from the Sahlgrenska Academy Study on Ischemic Stroke and meeting the inclusion criteria of the CADISP study, which with controls from the same study formed one of the follow-up samples of the 2015 genome-wide association study of cervical artery dissection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25420145") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25420145") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(rdfs:comment "Most of these were also drawn from already existing DNA databases of ischemic stroke patients (SIFAP,15 SAHLSIS, Gothenburg,16 Nijmegen,17 Barcelona stroke genetics study6 )") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001759> "A collection of patients with cervical artery dissection, of European origin, at the Sahlgrenska Academy of the University of Gothenburg, Sweden, drawn from the Sahlgrenska Academy Study on Ischemic Stroke and meeting the inclusion criteria of the CADISP study, which with controls from the same study formed one of the follow-up samples of the 2015 genome-wide association study of cervical artery dissection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25420145") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25420145") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(rdfs:comment "Sweden The Sahlgrenska Academy at Gothenburg University (SAHLSIS) Gothenburg 71 Sweden The Sahlgrenska Academy at Gothenburg University (SAHLSIS) Gothenburg 67") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001759> "A collection of patients with cervical artery dissection, of European origin, at the Sahlgrenska Academy of the University of Gothenburg, Sweden, drawn from the Sahlgrenska Academy Study on Ischemic Stroke and meeting the inclusion criteria of the CADISP study, which with controls from the same study formed one of the follow-up samples of the 2015 genome-wide association study of cervical artery dissection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001760> (<http://www.ebi.ac.uk/coho/COHO_0001760>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11381111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17689500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25951819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11381111") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC34453/") Annotation(rdfs:comment "Most families had two eligible full siblings (at least one of whom met DSM-IV criteria for schizophrenia or schizoaffective disorder, depressed subtype).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001760> "A family study of schizophrenia in the intramural research programme of the US National Institute of Mental Health, run by its Clinical Brain Disorders Branch and Genes, Cognition and Psychosis Program, that recruited patients with schizophrenia or schizoaffective disorder, their unaffected full siblings and healthy volunteers from local and national sources and studied them with cognitive testing, brain imaging and genotyping to identify intermediate phenotypes and risk genes for schizophrenia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11381111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17689500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25951819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11381111") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC34453/") Annotation(rdfs:comment "Subjects were recruited from local and national sources as volunteers for the Clinical Brain Disorders Branch/National Institute of Mental Health sibling study, as described (41).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001760> "A family study of schizophrenia in the intramural research programme of the US National Institute of Mental Health, run by its Clinical Brain Disorders Branch and Genes, Cognition and Psychosis Program, that recruited patients with schizophrenia or schizoaffective disorder, their unaffected full siblings and healthy volunteers from local and national sources and studied them with cognitive testing, brain imaging and genotyping to identify intermediate phenotypes and risk genes for schizophrenia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11381111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17689500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25951819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11381111") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11381111+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In 175 patients with schizophrenia, 219 unaffected siblings, and 55 controls, COMT genotype was related in allele dosage fashion to performance on the Wisconsin Card Sorting Test of executive cognition and explained 4% of variance (P = 0.001) in frequency of perseverative errors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001760> "A family study of schizophrenia in the intramural research programme of the US National Institute of Mental Health, run by its Clinical Brain Disorders Branch and Genes, Cognition and Psychosis Program, that recruited patients with schizophrenia or schizoaffective disorder, their unaffected full siblings and healthy volunteers from local and national sources and studied them with cognitive testing, brain imaging and genotyping to identify intermediate phenotypes and risk genes for schizophrenia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11381111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17689500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25951819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17689500") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2390785/") Annotation(rdfs:comment "In brief, subjects included 169 patients with schizophrenia-spectrum disorders (SCZ), 213 of their unaffected siblings (SIB), and 212 healthy volunteers (i.e. normal controls, or NC) (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001760> "A family study of schizophrenia in the intramural research programme of the US National Institute of Mental Health, run by its Clinical Brain Disorders Branch and Genes, Cognition and Psychosis Program, that recruited patients with schizophrenia or schizoaffective disorder, their unaffected full siblings and healthy volunteers from local and national sources and studied them with cognitive testing, brain imaging and genotyping to identify intermediate phenotypes and risk genes for schizophrenia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11381111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17689500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25951819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17689500") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2390785/") Annotation(rdfs:comment "We used optimized VBM to evaluate structural MRI data from the CBDB/NIMH Genetic Study of Schizophrenia, an ongoing family study aimed at identifying biologic intermediate phenotypes and ultimately risk genes for the illness (24).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001760> "A family study of schizophrenia in the intramural research programme of the US National Institute of Mental Health, run by its Clinical Brain Disorders Branch and Genes, Cognition and Psychosis Program, that recruited patients with schizophrenia or schizoaffective disorder, their unaffected full siblings and healthy volunteers from local and national sources and studied them with cognitive testing, brain imaging and genotyping to identify intermediate phenotypes and risk genes for schizophrenia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11381111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17689500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25951819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25951819") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4500051/") Annotation(rdfs:comment "The NIMH Genes, Cognition and Psychosis Study was funded by the NIH/NIMH Intramural Research Program and the Lieber Institute for Brain Development.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001760> "A family study of schizophrenia in the intramural research programme of the US National Institute of Mental Health, run by its Clinical Brain Disorders Branch and Genes, Cognition and Psychosis Program, that recruited patients with schizophrenia or schizoaffective disorder, their unaffected full siblings and healthy volunteers from local and national sources and studied them with cognitive testing, brain imaging and genotyping to identify intermediate phenotypes and risk genes for schizophrenia.")

