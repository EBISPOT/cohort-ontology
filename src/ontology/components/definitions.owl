AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31722307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41350806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31722307") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31722307+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Information obtained from JaCALS shows the natural histories of Japanese patients with ALS, including their genetic backgrounds and clinical and genetic factors associated with disease progression and prognosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001195> "A multicentre patient registry established in Japan in 2006 to register and follow up patients with amyotrophic lateral sclerosis across many participating institutions, collecting DNA samples and clinical data with periodic telephone follow-up to study the natural history, genetic background and prognosis of ALS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31722307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41350806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41350806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12680644/fullTextXML") Annotation(rdfs:comment "Patients with ALS contribute DNA samples and LCLs, and they are contacted every 3 months for a telephone survey.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001195> "A multicentre patient registry established in Japan in 2006 to register and follow up patients with amyotrophic lateral sclerosis across many participating institutions, collecting DNA samples and clinical data with periodic telephone follow-up to study the natural history, genetic background and prognosis of ALS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31722307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41350806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41350806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12680644/fullTextXML") Annotation(rdfs:comment "The JaCALS registry is a multicenter patient registry for ALS involving 42 institutions across Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001195> "A multicentre patient registry established in Japan in 2006 to register and follow up patients with amyotrophic lateral sclerosis across many participating institutions, collecting DNA samples and clinical data with periodic telephone follow-up to study the natural history, genetic background and prognosis of ALS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001196> (<http://www.ebi.ac.uk/coho/COHO_0001196>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "Briefly, incident prostate cancer cases were identified by cohort linkage to Surveillance, Epidemiology and End Results cancer registries covering Hawaii and California.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "Genotyping of the Japanese and Latinos in the MEC was conducted using the Illumina.Human660W_Quad_v1 bead array at the Broad Institute.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "In this study, we conducted two-stage GWAS to search for novel risk variants for prostate cancer in Japanese and Latinos, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "The MEC is a large population-based cohort study of over 215,000 individuals from Hawaii and California.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "Through January 1, 2008, the Japanese and Latino nested case-control studies of prostate cancer included 1,033 cases and 1,042 controls and 1,043 cases and 1,057 controls, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(rdfs:comment "Controls were matched to cases on race/ethnicity, area of residence (California or Hawaii) and age at entry into cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001197> (<http://www.ebi.ac.uk/coho/COHO_0001197>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33129280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML") Annotation(rdfs:comment "Baseline exposure data, including lifestyles, medical information, diets, physical activities, blood pressure, cognitive function, blood test, brain magnetic resonance imaging (MRI), and DNA samples, were collected with a pre-specified protocol and standardized measurement methods.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33129280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML") Annotation(rdfs:comment "First, we pre-specified and standardized the questionnaires, baseline survey items, measurement methods for the blood tests, and diagnostic procedures for dementia across the 8 research sites in 2015, to improve the quality of the collected data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33129280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML") Annotation(rdfs:comment "The Japan Prospective Studies Collaboration for Aging and Dementia (JPSC-AD) is a multisite, population-based prospective cohort study of dementia, which was designed to enroll approximately 10,000 community-dwelling residents aged 65 years or older from 8 sites in Japan and to follow them up prospectively for at least 5 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33129280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML") Annotation(rdfs:comment "The baseline survey was conducted from 2016 to 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33129280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML") Annotation(rdfs:comment "The project and data management were carried out by the central study secretariat set-up at Kyushu University (Center for Cohort Studies, Graduate School of Medicine).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33129280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML") Annotation(rdfs:comment "This study aims to explore the genetic and environmental risk factors for dementia and also to examine the gene–environment interaction on the onset of dementia by establishing a large-scale prospective cohort of Japanese.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001198> (<http://www.ebi.ac.uk/coho/COHO_0001198>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26184046") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML") Annotation(rdfs:comment "In the first step of the sampling, we conducted stratified probability sampling by region (15 metropolises and provinces), sex, and age (19 to 29, 30 to 39, 40 to 49, 50 to 59, over 60).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26184046") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML") Annotation(rdfs:comment "KRIEFS was the first survey in Korea to conduct a nationwide integrated dietary exposure assessment on hazardous substances in people of all ages.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26184046") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML") Annotation(rdfs:comment "Second, we extracted 34 cities and counties (si, gun, and gu) from 15 metropolises and provinces, and then extracted 102 town and township (eup, myon, and dong) clusters from 34 cities and towns.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26184046") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML") Annotation(rdfs:comment "The Korean Research Project on the Integrated Exposure Assessment of Hazardous Substances for Food Safety (KRIEFS) was initiated by the National Institute of Food and Drug Safety Evaluation in 2010.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26184046") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML") Annotation(rdfs:comment "The dietary exposure survey was conducted through individual dietary intake surveys involving a FFQ and 24-hour recall.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26184046") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML") Annotation(rdfs:comment "We conducted a food survey, dietary survey, biomonitoring, and health survey from 2010 to 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001199> (<http://www.ebi.ac.uk/coho/COHO_0001199>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "Briefly, incident prostate cancer cases were identified by cohort linkage to Surveillance, Epidemiology and End Results cancer registries covering Hawaii and California.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "Genotyping of the Japanese and Latinos in the MEC was conducted using the Illumina.Human660W_Quad_v1 bead array at the Broad Institute.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "In this study, we conducted two-stage GWAS to search for novel risk variants for prostate cancer in Japanese and Latinos, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "The MEC is a large population-based cohort study of over 215,000 individuals from Hawaii and California.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22923026") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode") Annotation(rdfs:comment "Through January 1, 2008, the Japanese and Latino nested case-control studies of prostate cancer included 1,033 cases and 1,042 controls and 1,043 cases and 1,057 controls, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(rdfs:comment "Controls were matched to cases on race/ethnicity, area of residence (California or Hawaii) and age at entry into cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001200> (<http://www.ebi.ac.uk/coho/COHO_0001200>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26584951") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4653886/fullTextXML") Annotation(rdfs:comment "(b) newly diagnosed PD within the past two years; (c) age 30 years and older; (d) a life expectancy of more than two years; and (e) no limitations in functional health for which the patient needs PD-medication.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26584951") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4653886/fullTextXML") Annotation(rdfs:comment "Seven academic hospitals and 43 community hospitals in the Netherlands are recruiting patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26584951") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4653886/fullTextXML") Annotation(rdfs:comment "To differentiate between the direct symptomatic effects and possible disease modifying effects of levodopa, we use a randomised delayed-start double-blind placebo-controlled multi-centre trial design.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35164821") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8842530/fullTextXML") Annotation(rdfs:comment "The first patient was included on 17 August 2011 and the last on 17 May 2016, amounting to a recruitment period 27 months longer than anticipated.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38644623") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38644623+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Follow-up visits were performed 3 and 5 years after baseline.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38644623") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38644623+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Levodopa in EArly Parkinson's disease study randomly assigned patients to levodopa/carbidopa 300/75 mg daily for 80 weeks (early start) or to placebo for 40 weeks followed by levodopa/carbidopa 300/75 mg daily for 40 weeks (delayed start).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001201> (<http://www.ebi.ac.uk/coho/COHO_0001201>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38174101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") Annotation(rdfs:comment "Finally, an annual longitudinal follow-up over up to 9 years (at time of publication) promises to strengthen the understanding of the complex genotype–phenotype interaction, and to identify diagnostic and progression biomarkers unravelling the phenotype variation in patients with neurodegenerative PS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38174101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") Annotation(rdfs:comment "Participants were recruited from Luxembourg and the surrounding geographical areas of Germany, France, and Belgium, as defined by the Greater Region.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38174101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") Annotation(rdfs:comment "Since 2015, over 800 individuals with PD and atypical parkinsonism along with more than 800 control subjects have been recruited in the frame of the observational, monocentric, nation-wide, longitudinal-prospective Luxembourg Parkinson’s study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38174101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") Annotation(rdfs:comment "The Luxembourg Parkinson’s study is a monocentric, observational cohort of individuals with neurodegenerative parkinsonism (PS) and controls without manifested clinical evidence for a neurodegenerative disorder (17).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38174101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") Annotation(rdfs:comment "To our knowledge, the Luxembourg Parkinson’s Study is one of the first pioneering observational studies with deep phenotyping, longitudinally follow-up and biosampling of the patients with PD or atypical PS along with parallel recruitment of controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38174101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") Annotation(rdfs:comment "To this end, the Luxembourg Parkinson’s study was established in 2015 in the framework of the National Centre of Excellence in Research in Parkinson’s disease (NCER-PD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001202> (<http://www.ebi.ac.uk/coho/COHO_0001202>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40798880") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12481885/") Annotation(rdfs:comment "Samples were collected as part of the LTRC from individuals who were undergoing clinically indicated thoracic surgery procedures using a standardized protocol described in the original study design, which included pulmonary function testing, questionnaires, and chest CT.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(rdfs:comment "Donors were recruited from individuals undergoing lung surgery for nodules or masses, having a biopsy for diagnosis of possible interstitial lung disease (ILD), or undergoing a therapeutic surgery for established lung disease (lung volume reduction surgery or lung transplant).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(rdfs:comment "Study Period March 2005 – February 2019") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(rdfs:comment "The LTRC was a biobank resource established by the NHLBI to collect and distribute lung tissue, blood samples, clinical data, and radiographic studies from participants with chronic obstructive pulmonary disease (COPD), idiopathic pulmonary fibrosis (IPF), other related idiopathic interstitial pneumonias (IIP)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(rdfs:comment "Subjects were recruited from Mayo Clinic, Universities of Colorado, Michigan, and Pittsburgh, and Temple University.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(rdfs:comment "The Lung Tissue Research Consortium is an NHLBI-funded resource, started in 2004, in which excess surgical lung tissue and blood samples were collected on carefully phenotyped patients who have undergone thoracic surgery") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001203> (<http://www.ebi.ac.uk/coho/COHO_0001203>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18506692") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18506692+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Data were collected by face-to-face interviews.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18506692") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18506692+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In a large population-based case-control study in Germany, including 3,464 breast cancer cases aged 50-74 at diagnosis and 6,657 population based and frequency matched controls, we investigated the effects of menopausal hormone therapy (HT) by type, regimen, timing and progestagenic constituent on postmenopausal breast cancer risk overall and according to histological type.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31694687") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6836389/fullTextXML") Annotation(rdfs:comment "Between 2002 and 2005, 3813 German-speaking breast cancer patients 50–74 years of age at diagnosis with an incident histologically confirmed invasive breast cancer (ICD-10 C50) (stages I to IV) or in situ tumour (D05) (stage 0) were recruited from participating clinics and cancer registries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31694687") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6836389/fullTextXML") Annotation(rdfs:comment "By 30 June 2015, a median of 6.0 years after the follow-up interview, 206 (10.1%) women died, 115 (5.6%) of which were from breast cancer, and 324 women (16.1%) developed a breast cancer recurrence") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31694687") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6836389/fullTextXML") Annotation(rdfs:comment "We used data from the MARIE study, a prospective population-based patient cohort study of 3813 postmenopausal breast cancer patients, aged 50–74 at diagnosis, recruited from 2002 to 2005, re-interviewed in 2009, and followed up until June 2015.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37964298") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10648629/fullTextXML") Annotation(rdfs:comment "In brief, 3813 women with a breast cancer diagnosis were initially enrolled between August 2002 and September 2005 in two regions (Rhine-Neckar-Karlsruhe and Hamburg) in Germany.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001204> (<http://www.ebi.ac.uk/coho/COHO_0001204>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18259084") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2821441/") Annotation(rdfs:comment "Stratified sampling was performed by randomly selecting subjects from within the 4 age and sex strata of the sampling frame.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18259084") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2821441/") Annotation(rdfs:comment "We used the medical records-linkage system to construct a sampling frame of Olmsted County residents aged 70–89 on October 1, 2004, who had been in contact with the system at least once within the 3 years prior to the index date (n = 20,805).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40830522") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12362905/fullTextXML") Annotation(rdfs:comment "We identified 2715 participants aged > 30 years with cross-sectional diffusion MRI (dMRI) from the Mayo Clinic Study of Aging (MCSA) [17, 18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41001249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12457950/fullTextXML") Annotation(rdfs:comment "As participants are evaluated in the MCSA not based on symptomatology but on scheduled follow‐up visits approximately every 15 months, we expect that MCI will be detected earlier in the MCSA than in patients visiting a clinic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41001249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12457950/fullTextXML") Annotation(rdfs:comment "The MCSA is a population‐based cohort study that examines the epidemiology, risk factors, and biomarkers of MCI and dementia in older adults living in Olmsted County.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41001249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12457950/fullTextXML") Annotation(rdfs:comment "The study population was later expanded in 2012 to include individuals ages 50–69.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001205> (<http://www.ebi.ac.uk/coho/COHO_0001205>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21239051") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3297116/") Annotation(rdfs:comment "Briefly, between Aug 1, 2004, and March 31, 2007, a case-control sample of patients with and without angiographic CAD undergoing cardiac catheterisation were recruited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001205> "A hospital-based case-control study designed for biomarker and genetic studies of coronary artery disease, which from August 2004 to March 2007 recruited patients with and without angiographic coronary artery disease undergoing cardiac catheterisation at the Washington Hospital Center, Washington, DC, United States, with support from the MedStar Research Institute.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21239051") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3297116/") Annotation(rdfs:comment "Discovery studies were PennCath and MedStar (webappendix p 2), which recruited patients before coronary angiography at the University of Pennsylvania Medical Center (Penn) and Washington Hospital Center (WHC), respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001205> "A hospital-based case-control study designed for biomarker and genetic studies of coronary artery disease, which from August 2004 to March 2007 recruited patients with and without angiographic coronary artery disease undergoing cardiac catheterisation at the Washington Hospital Center, Washington, DC, United States, with support from the MedStar Research Institute.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21239051") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3297116/") Annotation(rdfs:comment "MedStar Health Research Institute, Washington Hospital Center, Washington, DC, USA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001205> "A hospital-based case-control study designed for biomarker and genetic studies of coronary artery disease, which from August 2004 to March 2007 recruited patients with and without angiographic coronary artery disease undergoing cardiac catheterisation at the Washington Hospital Center, Washington, DC, United States, with support from the MedStar Research Institute.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21239051") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3297116/") Annotation(rdfs:comment "MedStar is a hospital-based study designed for biomarker and genetic studies of CAD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001205> "A hospital-based case-control study designed for biomarker and genetic studies of coronary artery disease, which from August 2004 to March 2007 recruited patients with and without angiographic coronary artery disease undergoing cardiac catheterisation at the Washington Hospital Center, Washington, DC, United States, with support from the MedStar Research Institute.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21239051") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3297116/") Annotation(rdfs:comment "The PennCath and MedStar studies were supported by the Cardiovascular Institute of the University of Pennsylvania, by the MedStar Health Research Institute at Washington Hospital Center and by a research grant from GlaxoSmithKline.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001205> "A hospital-based case-control study designed for biomarker and genetic studies of coronary artery disease, which from August 2004 to March 2007 recruited patients with and without angiographic coronary artery disease undergoing cardiac catheterisation at the Washington Hospital Center, Washington, DC, United States, with support from the MedStar Research Institute.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001206> (<http://www.ebi.ac.uk/coho/COHO_0001206>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31663602") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML") Annotation(rdfs:comment "By using the unique 12-digit personal registration number ascribed to all Swedish citizens, the participants, non-participants and the background population were linked to the Swedish Melanoma Registry (SweMR), the Swedish Cancer Registry, and the Swedish National Cause of Death Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31663602") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML") Annotation(rdfs:comment "In short, 41,000 Swedish-born women, with no history of malignancy, were selected randomly from each year of age in the category 25-64 years, from the Population Registry in southern Sweden (Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31663602") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML") Annotation(rdfs:comment "These women have received a questionnaire every 10th year, with questions about lifestyle factors and possible risk exposures, with special attention to risk factors for melanoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37675201") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10477307/fullTextXML") Annotation(rdfs:comment "We linked the response to questions relating to sun exposure from the Melanoma Inquiry in Southern Sweden (MISS) prospective cohort study in women to the risk of developing GCA or PMR.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40102189") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11919808/fullTextXML") Annotation(rdfs:comment "At baseline, participants answered a validated detailed questionnaire [30, 31, 32, 33] asking about common risk factors for skin cancer such as constitutional characteristics, sun exposure habits, socioeconomic factors, educational level, and smoking habits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40102189") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11919808/fullTextXML") Annotation(rdfs:comment "We used the prospective Melanoma Inquiry of Southern Sweden (MISS) study cohort, established in 1990–1992, which is described in detail elsewhere [2, 27, 28, 29, 30].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001207> (<http://www.ebi.ac.uk/coho/COHO_0001207>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31466551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7083329/") Annotation(rdfs:comment "Although the MSUTR initially began as a university-based twin registry assessing undergraduate men and women, we moved to recruiting twins via birth records beginning in 2004.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31466551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7083329/") Annotation(rdfs:comment "Families can then be recruited for one or more of the intensive, in-person studies from the population-based registry, using any one of several recruitment strategies (e.g., population-based, based on their answers to the registry questionnaire).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31466551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7083329/") Annotation(rdfs:comment "The Michigan Twins Project is an on-going, population-based, mail-in registry of child and adolescent twins aged 3 to 17 years and their families, and adult twins ages 18 to 55 years (~30,000 twins in 15,000+ pairs; ~80% are in the younger cohort).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31466551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7083329/") Annotation(rdfs:comment "The primary aim of the Michigan State University Twin Registry (MSUTR) is to examine developmental differences in genetic, environmental, neural, epigenetic, and neurobiological influences on psychopathology and resilience, particularly during childhood and adolescence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31466551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7083329/unicode") Annotation(rdfs:comment "The Michigan Department of Health and Human Services (MDHHS; formerly known as the Michigan Department of Community Health) identifies twin pairs residing in lower Michigan who meet our study age criteria (see criteria below)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40962958") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM7_ESM.xlsx") Annotation(rdfs:comment "Michigan State University Twin Register | MSUTR | United States of America | population-based (twin families)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001208> (<http://www.ebi.ac.uk/coho/COHO_0001208>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19774750") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19774750+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study comprises a cohort of over 5,000 women interviewed at their first ante-natal clinic visit and followed up at 3-5 days, six months, 5 and 14 years after the baby was born.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25519422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25519422+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "It has become a longitudinal study of growth, development and ageing with an emphasis on the generational transmission of a wide range of factors impacting on adult health outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25519422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25519422+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Since then there have been additional follow-ups of the mothers (27 years) and their children (30 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40889875") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12401581/fullTextXML") Annotation(rdfs:comment "In 2000, CM cases related to MUSP Generation 2 were linked to their records.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40889875") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12401581/fullTextXML") Annotation(rdfs:comment "The Mater-University of Queensland Study of Pregnancy (MUSP) study commenced as a 3- to 5-year longitudinal cohort study of 6753 pregnant women (Generation 1) birthing at the Mater Hospital in Brisbane, Australia, between 1981 and 1983 [1].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(rdfs:comment "The MUSP (Mater Misericordiae Mothers' Hospital-University of Queensland Study of Pregnancy) study is of 7 223 women recruited early in pregnancy over the period 1981-1983 and the live singleton children to whom they subsequently gave birth.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001209> (<http://www.ebi.ac.uk/coho/COHO_0001209>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26362759") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5300750/") Annotation(rdfs:comment "2,954 samples from 14 countries were collected through the Myositis Genetics Consortium (MYOGEN), and written informed consent was obtained from all cases with approval from research ethics boards at each participating centre.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26362759") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5300750/") Annotation(rdfs:comment "Control samples shared from Immunochip consortia matched by closest ethnicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29884237") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5994128/fullTextXML") Annotation(rdfs:comment "Geographical latitude was assigned according to the approximate latitude of the recruitment centre which contributed samples to the MYOGEN (Myositis Genetics Consortium) Immunochip study as a proxy for latitude of origin and disease onset [8].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36580032") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10238560/fullTextXML") Annotation(rdfs:comment "IIM samples were included if patients fulfilled probable or definite Bohan and Peter classification criteria (7) for polymyositis (PM), juvenile PM, dermatomyositis (DM), or juvenile DM, and Griggs, European Neuromuscular Centre, or Medical Research Council criteria for inclusion body myositis (IBM) (8).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36580032") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10238560/fullTextXML") Annotation(rdfs:comment "We analyzed 2,565 Caucasian IIM patient samples collected through the Myositis Genetics Consortium (MYOGEN) and 10,260 ethnically matched control samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36580032") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36580032+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We imputed 1,648,116 variants from the ImmunoChip array using the Haplotype Reference Consortium panel and conducted association analysis on IIM and clinical and serologic subgroups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001210> (<http://www.ebi.ac.uk/coho/COHO_0001210>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27492244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4972943/fullTextXML") Annotation(rdfs:comment "As described previously [17, 21–23], the CBCS researchers collected extensive clinical, molecular, and epidemiologic data for in situ (phase II) and invasive (phases I–III) breast cancer cases diagnosed from 1993 to 1996 (phase I), 1996 to 2001 (phase II), and 2008 to 2013 (phase III).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27492244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4972943/fullTextXML") Annotation(rdfs:comment "Cases were identified through rapid case ascertainment by the North Carolina Central Cancer Registry; control subjects were recruited (for phases I and II only) through North Carolina Department of Motor Vehicles records and Health Care Financing Administration records for Medicare enrollment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27492244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4972943/fullTextXML") Annotation(rdfs:comment "The CBCS is a population-based case-control study conducted in 24 (phases I and II) and 44 (phase III) counties of central and eastern North Carolina.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27492244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4972943/fullTextXML") Annotation(rdfs:comment "Women were eligible for inclusion if they were 20–74 years of age at the time of diagnosis (cases) or study recruitment (control subjects).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36968228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10035450/fullTextXML") Annotation(rdfs:comment "Black and younger women (ages <50 years) were oversampled using randomized recruitment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36968228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10035450/fullTextXML") Annotation(rdfs:comment "Recurrence data were available for CBCS phase III (2008–2013; n = 1246) through patient follow-up and subsequent medical record confirmation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001211> (<http://www.ebi.ac.uk/coho/COHO_0001211>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11219769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8320745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19706757") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19706757+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Tobacco smoking is the most important and well-established bladder cancer risk factor and a rich source of chemical carcinogens and reactive oxygen species that can induce damage to DNA in urothelial cells. Therefore, common variation in DNA repair genes might modify bladder cancer risk.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001211> "A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients with no history of cancer other than nonmelanoma skin cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11219769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8320745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19706757") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2782435/unicode") Annotation(rdfs:comment "NCBCS North Carolina Bladder Cancer Study 215 245 77 USA: hospital-based") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001211> "A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients with no history of cancer other than nonmelanoma skin cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11219769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8320745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8320745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8320745+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Control subjects were urology clinic patients who primarily presented with benign prostatic hypertrophy or impotence, who had no history of any cancer other than nonmelanoma skin cancer, and who were frequency matched to case patients on race, sex, and age (10-year age intervals).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001211> "A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients with no history of cancer other than nonmelanoma skin cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11219769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8320745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8320745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8320745+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We investigated whether the absence of the GSTM1 gene affects bladder cancer risk and whether there are racial differences in GSTM1 genotype frequency.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001211> "A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients with no history of cancer other than nonmelanoma skin cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11219769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8320745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8320745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8320745+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "we examined the frequency of the homozygous deleted genotype (GSTM1 0/0) in 229 patients with transitional cell carcinoma of the bladder and 211 control subjects who were enrolled from the Urology Clinics at Duke University Medical Center and the University of North Carolina Hospitals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001211> "A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients with no history of cancer other than nonmelanoma skin cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001212> (<http://www.ebi.ac.uk/coho/COHO_0001212>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29784730") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6072587/unicode") Annotation(rdfs:comment "At enrollment, trained interviewers administered a standardized questionnaire eliciting information on personal medical and cancer history, tobacco use, occupational, family medical history, socioeconomic history, diet, and anthropometric factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35468990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML") Annotation(rdfs:comment "A key purpose of this study was to investigate the role of environmental and genetic factors in prostate cancer development among AA men.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35468990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML") Annotation(rdfs:comment "A total of 976 cases (489 AA and 487 EA men) were recruited into the study between 2005 and 2015.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35468990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML") Annotation(rdfs:comment "At the time of enrollment, both cases and controls were administered a survey by a trained interviewer and a blood sample or mouthwash rinse/buccal cells was collected.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35468990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML") Annotation(rdfs:comment "Cases were recruited at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35468990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML") Annotation(rdfs:comment "Controls were identified through the Maryland Department of Motor Vehicle Administration database and were frequency-matched to cases on age and race.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001213> (<http://www.ebi.ac.uk/coho/COHO_0001213>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34999878") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8743124/fullTextXML") Annotation(rdfs:comment "At baseline, all mothers with expected dates of delivery between 1 January and 31 December 1966 were recruited from the two northernmost provinces in Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34999878") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8743124/fullTextXML") Annotation(rdfs:comment "Linkages with national register-based data provide further information on health between the follow-ups and are currently available until the age of 50 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34999878") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8743124/fullTextXML") Annotation(rdfs:comment "Mothers were recruited based on the calculated expected date of delivery at the first antenatal visit.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34999878") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8743124/fullTextXML") Annotation(rdfs:comment "The NFBC1966 was set up in the two northernmost provinces of Finland, Oulu and Lapland, which together covered an area equivalent to 48% of Finnish territory and 13.2% of population in 1966, i.e. a selected area of 160 000 km2 with approximately 604 000 inhabitants (Statistics Finland: https://www.stat.fi).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34999878") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8743124/fullTextXML") Annotation(rdfs:comment "The Northern Finland Birth Cohort 1966 (NFBC1966) was originally set up to identify a variety of maternal biological, behavioural and socioeconomic risk factors involved in preterm birth and intrauterine growth retardation, and to study the consequences of these early adverse outcomes on children’s subsequent morbidity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34999878") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8743124/fullTextXML") Annotation(rdfs:comment "Whereas the early follow-ups were only questionnaire based, the extensive follow-up studies in adulthood (at 31 and 46 years of age) included both questionnaires (web-based filling optional at 46 years) and clinical examinations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001214> (<http://www.ebi.ac.uk/coho/COHO_0001214>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34022824") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8141232/fullTextXML") Annotation(rdfs:comment "The Linxian General Population Nutrition Intervention Trial was a large-scale, randomized, double-blind, primary prevention trial in Linxian, China") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34022824") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8141232/fullTextXML") Annotation(rdfs:comment "The Nutrition Intervention Trials (NIT) were supported by National Cancer Institute contracts NO1-SC-91030 and HHSN261200477001C with the Cancer Institute of the Chinese Academy of Medical Sciences.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35224031") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8866236/fullTextXML") Annotation(rdfs:comment "In the post-trial follow-up (after 1991), village doctors continued to contact all living participants monthly, and new cancer cases and all-cause deaths were verified by a panel of American and Chinese experts (1991–1996) or senior Chinese doctors (1996–2018).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38282387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11101236/fullTextXML") Annotation(rdfs:comment "Briefly, the Linxian General Population Nutrition Intervention Trial enrolled healthy adults (aged 40–69 years) from four towns (Rencun, Hengshui, Donggang, and Yaocun) in northern Linxian in 1985.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38282387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11101236/fullTextXML") Annotation(rdfs:comment "Finally, a total of 29,584 subjects were included in the NIT study in 1986 to receive daily combined vitamin/mineral supplement or placebo.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38282387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11101236/fullTextXML") Annotation(rdfs:comment "Subjects were randomly assigned to one of eight intervention groups according to a 24 fractional factorial design, which received factors ABCD, AB, AC, AD, BC, BD, CD, or placebo, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001215> (<http://www.ebi.ac.uk/coho/COHO_0001215>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38365752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") Annotation(rdfs:comment "(2) Ace’s Open House Initiative [20], a social program that provides free assessment of the cognitive status of individuals from the community without the need for a physician’s referral,") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38365752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") Annotation(rdfs:comment "(3) the Fundació ACE Healthy Brain Initiative (FACEHBI), a longitudinal research study of aging, lifestyle, cognition, and biomarkers in individuals with subjective cognitive decline (SCD) [21], and (4) the BIOFACE project, a research study of novel biomarkers focused on individuals with early-onset MCI [22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38365752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") Annotation(rdfs:comment "Consecutive individuals evaluated due to cognitive decline at Ace Alzheimer Center Barcelona between September 2014 and March 2019 with a diagnosis of CH, MCI, or dementia, and who had available GWAS data from the GR@ACE study [18] were included in the present analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38365752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") Annotation(rdfs:comment "In the present study, we performed a GWAS aimed at identifying genes associated with RNFL and GCIPL thickness assessed by OCT in a Spanish population with different degrees of cognitive impairment, including CH, MCI, and dementia (most of them ADD), evaluated in a memory clinic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38365752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") Annotation(rdfs:comment "Participants were recruited from four sources within Ace Alzheimer Center Barcelona (ACE): (1) the Memory Clinic, an outpatient diagnostic unit for individuals with cognitive decline that has an agreement with the Catalan Public Health System [19],") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38365752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") Annotation(rdfs:comment "The study population comprised 3170 participants from the Neuro-Ophthalmology Research at Fundació ACE (NORFACE) cohort, which was founded in 2014 to search for retinal biomarkers of AD and examine the relationships between retinal changes and different types of neurodegenerative disorders [12].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001216> (<http://www.ebi.ac.uk/coho/COHO_0001216>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15136663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3456454") Annotation(rdfs:comment "Enrollment for the first phase of the NYCP occurred between January 2000 and December 2002.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15136663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3456454") Annotation(rdfs:comment "In addition, the New York Blood Center enrolled individuals into the project as part of its routine donor blood drives.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15136663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3456454") Annotation(rdfs:comment "Sites included six medical centers, two community hospitals, and six community-based health centers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15136663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3456454") Annotation(rdfs:comment "The primary focus of the biorepository is the extraction of DNA and plasma from human whole blood and the management of data associated with subsequent specimen processing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15136663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3456454") Annotation(rdfs:comment "To be eligible, enrollees had to be 30 years of age or older, reside in the New York Tri-State area, and have a literacy level sufficient to complete a simple mail- out follow-up questionnaire (potential subjects were screened using a sample questionnaire).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15136663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3456454") Annotation(rdfs:comment "Using venue-based sampling with quotas, 18,187 adults aged 30 years or older were recruited over a year to undergo a baseline questionnaire, venipuncture, and contact information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001217> (<http://www.ebi.ac.uk/coho/COHO_0001217>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33432348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8097307/fullTextXML") Annotation(rdfs:comment "Genomic DNA was extracted from saliva or blood samples, and we genotyped 665,326 SNPs using the Asian Screening Array (Illumina, San Diego, CA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33432348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8097307/fullTextXML") Annotation(rdfs:comment "Okinawa Bioinformation Bank Project promoted by University of the Ryukyus and the Okinawa Prefecture for Promotion of Advanced Medicine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33432348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8097307/fullTextXML") Annotation(rdfs:comment "Saliva or blood samples were collected from 1,240 individuals living in the Miyako Islands between 2016 and 2017 as part of the OBi Project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33432348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8097307/fullTextXML") Annotation(rdfs:comment "We aim to accumulate more genetic information derived from the Ryukyu Archipelago with clinical information through the OBi Project, and such data will enable us to further understand the population history of the Ryukyu Archipelago and to identify novel genetic factors related to susceptibility to several common and/or rare diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39987337") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11846991/fullTextXML") Annotation(rdfs:comment "Individual’s values for laboratory tests, including serum ALT, serum AST, and serum GGT; anthropometric measurements, including height, body weight, and body mass index; and lifestyle questionnaire information, including alcohol consumption and smoking status, were obtained from results of health check-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39987337") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11846991/fullTextXML") Annotation(rdfs:comment "We analyzed individuals registered in Okinawa Bioinformation Bank (OBi), which is a population-based study in Okinawa Prefecture established in 201616,17,21.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001218> (<http://www.ebi.ac.uk/coho/COHO_0001218>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25086665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dceg.cancer.gov/research/cancer-types/pancreas/panscan") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25086665") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4191666/unicode") Annotation(rdfs:comment "In stage 2, we used the primary whole genome scan data from the reported PanScan I (1,757 cases and 1,801 controls from 12 cohort studies and 1 case-control study typed on Illumina HumanHap550 array) and PanScan II (1,768 cases and 1,841 controls from 8 case-control studies typed with Illumina Human 610-Quad array) studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001218> "A consortium formed in 2006 within the US National Cancer Institute's Cohort Consortium by investigators of 12 prospective cohort studies to run PanScan, a multi-stage genome-wide association study of pancreatic cancer funded by the NCI. PanScan I genotyped cases and controls from the cohorts and one case-control study, PanScan II (from 2007) those of eight case-control studies, and PanScan III new incident cases from 14 cohorts and from case series and case-control studies, mostly people of European ancestry from the United States and Europe.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25086665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dceg.cancer.gov/research/cancer-types/pancreas/panscan") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3") Annotation(rdfs:comment "In 2007, the study was expanded to include 8 case-control studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001218> "A consortium formed in 2006 within the US National Cancer Institute's Cohort Consortium by investigators of 12 prospective cohort studies to run PanScan, a multi-stage genome-wide association study of pancreatic cancer funded by the NCI. PanScan I genotyped cases and controls from the cohorts and one case-control study, PanScan II (from 2007) those of eight case-control studies, and PanScan III new incident cases from 14 cohorts and from case series and case-control studies, mostly people of European ancestry from the United States and Europe.")
