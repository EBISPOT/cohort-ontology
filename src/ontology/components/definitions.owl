AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(rdfs:comment "Subjects participated in a large ongoing study on schizophrenia and BD and were recruited from out-patient and in-patient psychiatric units in Norway, from May, 2003 through July, 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002467> "An ongoing study of schizophrenia and bipolar disorder based in Oslo, Norway, that since 2003 has recruited patients from in-patient and out-patient psychiatric units, diagnosed by structured clinical interview, together with healthy controls randomly selected from the population records of the same catchment areas.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(rdfs:comment "The healthy controls subjects were randomly selected from statistical records of persons from the same catchment areas as the patient groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002467> "An ongoing study of schizophrenia and bipolar disorder based in Oslo, Norway, that since 2003 has recruited patients from in-patient and out-patient psychiatric units, diagnosed by structured clinical interview, together with healthy controls randomly selected from the population records of the same catchment areas.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(rdfs:comment "Thematically Organized Psychosis (TOP) Study Norwegian 203 349 119 (59%) 58 (29%) 6 b (3%) 20 (9%) DSMIV SCID Y 1.03") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002467> "An ongoing study of schizophrenia and bipolar disorder based in Oslo, Norway, that since 2003 has recruited patients from in-patient and out-patient psychiatric units, diagnosed by structured clinical interview, together with healthy controls randomly selected from the population records of the same catchment areas.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.943/MediaObjects/41588_2011_BFng943_MOESM29_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5322272/supplementaryFiles") Annotation(rdfs:comment "Participants were recruited in two waves as part of a large ongoing study on schizophrenia and bipolar disorder, the Thematic Organized Psychosis Research (TOP) study, which is run from the University Hospitals in Oslo, Norway.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002467> "An ongoing study of schizophrenia and bipolar disorder based in Oslo, Norway, that since 2003 has recruited patients from in-patient and out-patient psychiatric units, diagnosed by structured clinical interview, together with healthy controls randomly selected from the population records of the same catchment areas.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002471> (<http://www.ebi.ac.uk/coho/COHO_0002471>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31437200") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39483246") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31437200") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6705803/fullTextXML") Annotation(rdfs:comment "The present study comprises a prospective series of 67 males (mean age 59 years, range 18–95 years, Table 1) subjected to medico-legal autopsy in the Department of Forensic Medicine at the University of Tampere as a part of the Tampere Sudden Death Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002471> "A collection of medico-legal autopsies performed at the Department of Forensic Medicine of the University of Tampere, Finland, on unselected individuals from Tampere and the surrounding regions who died out of hospital from any cause, used to study coronary atherosclerosis, brain pathology such as Lewy-related pathology, and other post-mortem tissue, with risk-factor data gathered by interviewing relatives of the deceased.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31437200") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39483246") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38501694") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38501694+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We investigated alpha-synuclein pathology in brain tissue of the Tampere Sudden Death Study-unselected forensic autopsies on individuals living outside hospital institutions in Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002471> "A collection of medico-legal autopsies performed at the Department of Forensic Medicine of the University of Tampere, Finland, on unselected individuals from Tampere and the surrounding regions who died out of hospital from any cause, used to study coronary atherosclerosis, brain pathology such as Lewy-related pathology, and other post-mortem tissue, with risk-factor data gathered by interviewing relatives of the deceased.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31437200") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39483246") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39483246") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11525111/fullTextXML") Annotation(rdfs:comment "Only age, sex, and body mass index (BMI) were available CVD risk factors in the TSDS, whereas data on smoking habit and hypertension were gathered via postal questionnaire from spouses or close relatives and were available for 228 (34.5 %) out of the 660 participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002471> "A collection of medico-legal autopsies performed at the Department of Forensic Medicine of the University of Tampere, Finland, on unselected individuals from Tampere and the surrounding regions who died out of hospital from any cause, used to study coronary atherosclerosis, brain pathology such as Lewy-related pathology, and other post-mortem tissue, with risk-factor data gathered by interviewing relatives of the deceased.")
