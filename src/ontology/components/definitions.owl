AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41661118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41661118") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC13140159") Annotation(rdfs:comment "People with IBD and non-IBD controls were recruited as part of the MiaLAtinX Consortium from Cedars-Sinai Medical Center in Los Angeles (“CS”), the University of Puerto Rico (“PR”), the University of Miami (“MIA”), and Mount Sinai Health System in New York (“NY”).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000759> "A cohort of self-identified Hispanic people with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease and non-IBD controls, recruited through the MiaLAtinX Consortium at Cedars-Sinai Medical Center in Los Angeles, the University of Puerto Rico, the University of Miami and Mount Sinai Health System in New York and whole-genome sequenced at the Broad Institute, to study the ancestral origins of IBD risk in Hispanic populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41661118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41661118") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC13140159") Annotation(rdfs:comment "Study subjects self-identified as Hispanic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000759> "A cohort of self-identified Hispanic people with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease and non-IBD controls, recruited through the MiaLAtinX Consortium at Cedars-Sinai Medical Center in Los Angeles, the University of Puerto Rico, the University of Miami and Mount Sinai Health System in New York and whole-genome sequenced at the Broad Institute, to study the ancestral origins of IBD risk in Hispanic populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41661118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41661118") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC13140159") Annotation(rdfs:comment "Subjects had a confirmed diagnosis of CD, UC, or IBD unclassified encompassing indeterminate colitis (IBDU) according to standard criteria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000759> "A cohort of self-identified Hispanic people with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease and non-IBD controls, recruited through the MiaLAtinX Consortium at Cedars-Sinai Medical Center in Los Angeles, the University of Puerto Rico, the University of Miami and Mount Sinai Health System in New York and whole-genome sequenced at the Broad Institute, to study the ancestral origins of IBD risk in Hispanic populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41661118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41661118") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC13140159") Annotation(rdfs:comment "WGS on the MiaLAtinX cohort from CS, PR, MIA, and NY, was generated at the Broad Institute (Cambridge, MA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000759> "A cohort of self-identified Hispanic people with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease and non-IBD controls, recruited through the MiaLAtinX Consortium at Cedars-Sinai Medical Center in Los Angeles, the University of Puerto Rico, the University of Miami and Mount Sinai Health System in New York and whole-genome sequenced at the Broad Institute, to study the ancestral origins of IBD risk in Hispanic populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41661118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41661118") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41661118+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Genetic admixture of United States Hispanic individuals provides a unique opportunity to examine ancestral origins of inflammatory bowel disease (IBD) risk.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000759> "A cohort of self-identified Hispanic people with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease and non-IBD controls, recruited through the MiaLAtinX Consortium at Cedars-Sinai Medical Center in Los Angeles, the University of Puerto Rico, the University of Miami and Mount Sinai Health System in New York and whole-genome sequenced at the Broad Institute, to study the ancestral origins of IBD risk in Hispanic populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000760> (<http://www.ebi.ac.uk/coho/COHO_0000760>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40858910") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13585820/fullTextXML") Annotation(rdfs:comment "In order to account for current diagnostic practices, changes in working life, and the diagnostic criteria of AN that remain insufficiently inclusive of sex diversity, the general population sample from the NFBC1986, with over 30 years of lifetime follow-up, provides a comprehensive view of the long-term labour market outcomes of AN in the present day.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40858910") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13585820/fullTextXML") Annotation(rdfs:comment "In the NFBC1986 16-year follow-up study, questionnaire data were received from 7182 (76%) and clinical data from 6795 (72%) adolescents.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40858910") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13585820/fullTextXML") Annotation(rdfs:comment "The cohort members have been followed up with data collection at different ages and with individual-level linkage to registered data from various highly reliable Finnish national registers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40858910") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13585820/fullTextXML") Annotation(rdfs:comment "The study was based on the Northern Finland Birth Cohort 1986 (NFBC1986) [20], which is an unselected, general population sample based on 9432 live-born children with an expected date of birth between July 1 st, 1985 – June 30th, 1986, in the provinces of Oulu and Lapland [21].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40858910") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40858910+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Utilizing data from the Northern Finland Birth Cohort 1986, linked to national registers, we compared unemployment days, sickness absences, and income between individuals with AN (n = 165) and the rest of the cohort (control group, CG; n = 4884) using the Welch's t-test and two-part regression models.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://molgeniscatalogue.org/all/collections/NFBC1986") Annotation(rdfs:comment "The original data have been supplemented by data collected with postal questionnaires at the ages of 7, 8 and 16 years and various hospital records and statistical register data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12095082/fullTextXML") Annotation(rdfs:comment "Mothers of the NFBC1966 and NFBC1986 cohort participants gave their informed consent when they first joined the study during pregnancy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")

