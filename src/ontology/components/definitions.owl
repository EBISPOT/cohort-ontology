AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17554300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22025780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35499624") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17554300") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2719288/") Annotation(rdfs:comment "T1D cases were recruited from paediatric and adult diabetes clinics at 150 National Health Service hospitals across mainland UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001013> "A collection of people with type 1 diabetes diagnosed before the age of 17, assembled by the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory from paediatric and adult diabetes clinics at National Health Service hospitals across mainland United Kingdom, whose DNA and plasma samples are used in genetic and other studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17554300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22025780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35499624") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22025780") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3198057/") Annotation(rdfs:comment "Case subjects were diagnosed with type 1 diabetes before 17 years of age (mean age at diagnosis 7.8 years) and were from the Juvenile Diabetes Research Foundation/Wellcome Trust Diabetes and Inflammation Laboratory Genetic Resource Investigating Diabetes study (www.childhood-diabetes.org.uk/grid.shtml).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001013> "A collection of people with type 1 diabetes diagnosed before the age of 17, assembled by the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory from paediatric and adult diabetes clinics at National Health Service hospitals across mainland United Kingdom, whose DNA and plasma samples are used in genetic and other studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17554300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22025780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35499624") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35499624") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9233242/fullTextXML") Annotation(rdfs:comment "Plasma samples were obtained from the Genetics Resource Investigating Diabetes or GRID Study (Rec Reference 00/5/44), which encompassed the UK Nephropathy Family Study (Rec Reference 00/5/65).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001013> "A collection of people with type 1 diabetes diagnosed before the age of 17, assembled by the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory from paediatric and adult diabetes clinics at National Health Service hospitals across mainland United Kingdom, whose DNA and plasma samples are used in genetic and other studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17554300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22025780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35499624") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35499624") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9233242/fullTextXML") Annotation(rdfs:comment "Three independent resources were used to assess C-peptide levels in the plasma and β-cell loss within the pancreas, respectively: 1) plasma samples from the GRID collection (12), and 2) type 1 diabetes pancreas samples from the EADB (11,13) and nPOD biobank (14).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001013> "A collection of people with type 1 diabetes diagnosed before the age of 17, assembled by the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory from paediatric and adult diabetes clinics at National Health Service hospitals across mainland United Kingdom, whose DNA and plasma samples are used in genetic and other studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001014> (<http://www.ebi.ac.uk/coho/COHO_0001014>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26299218") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4548277/") Annotation(rdfs:comment "The HCMR study is a National Heart Lung and Blood Institute (NHLBI)-sponsored 2750 patient, 41 site, international registry and natural history study designed to address limitations in extant evidence to improve prognostication in HCM (NCT01915615).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31699273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6905038/") Annotation(rdfs:comment "HCMR is the first large prospective registry to include rigorous CMR imaging, genetic testing and prospective collection of blood for biomarker analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31699273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6905038/") Annotation(rdfs:comment "Longitudinal follow-up is being conducted to determine the incidence of cardiovascular events, adjudicated by a clinical events committee.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31699273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6905038/") Annotation(rdfs:comment "Patients included were ages 18–65 with an established diagnosis of HCM defined as unexplained LVH (wall thickness >15mm) without cavity dilatation or known predisposing cause (uncontrolled hypertension, aortic stenosis, etc.)(2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31699273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6905038/") Annotation(rdfs:comment "Patients were enrolled from 44 sites in the U.S. (18), Canada (4), United Kingdom (13), Italy (4), Germany (3), and the Netherlands (2) between April, 2014 and April, 2017 (Supplemental Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31699273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6905038/") Annotation(rdfs:comment "The primary goal of the study is to improve risk prediction for important adverse clinical outcomes in HCM by integrating cardiovascular magnetic resonance (CMR) imaging, biomarker, and genetic data with standard clinical and echocardiographic findings.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001015> (<http://www.ebi.ac.uk/coho/COHO_0001015>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24124113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(rdfs:comment "All cohorts are of self-reported Mexican ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001015> "A family study of Mexican Americans in the Los Angeles area, United States, which recruited the family members of probands with documented hypertension and measured insulin sensitivity by euglycaemic clamp, to examine the genetic basis of hypertension and insulin resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24124113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(rdfs:comment "Family members of probands with documented hypertension were recruited in the Los Angeles area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001015> "A family study of Mexican Americans in the Los Angeles area, United States, which recruited the family members of probands with documented hypertension and measured insulin sensitivity by euglycaemic clamp, to examine the genetic basis of hypertension and insulin resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24124113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(rdfs:comment "Insulin sensitivity was obtained by euglycemic clamp.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001015> "A family study of Mexican Americans in the Los Angeles area, United States, which recruited the family members of probands with documented hypertension and measured insulin sensitivity by euglycaemic clamp, to examine the genetic basis of hypertension and insulin resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24124113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(rdfs:comment "The Hypertension-Insulin Resistance Family Study (HTN-IR) was designed as a family study to examine the genetic basis of hypertension and insulin resistance.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001015> "A family study of Mexican Americans in the Los Angeles area, United States, which recruited the family members of probands with documented hypertension and measured insulin sensitivity by euglycaemic clamp, to examine the genetic basis of hypertension and insulin resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610958/supplementaryFiles") Annotation(rdfs:comment "Hypertension-Insulin Resistance Family Study (HTN) | Hispanic | USA | Family-based") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001015> "A family study of Mexican Americans in the Los Angeles area, United States, which recruited the family members of probands with documented hypertension and measured insulin sensitivity by euglycaemic clamp, to examine the genetic basis of hypertension and insulin resistance.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001016> (<http://www.ebi.ac.uk/coho/COHO_0001016>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3448/MediaObjects/41588_2016_BFng3448_MOESM1_ESM.pdf") Annotation(rdfs:comment "Advanced and intermediate AMD cases were mostly recruited from ophthalmology clinics (61.6% of cases), but also in spouses and friends of cases (2.1%), from general population (18.5%), or via mixed approaches (17.8%);") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "Customizing a chip for de novo centralized genotyping, we analyze >12 million variants including 163,714 directly typed protein-altering variants in 43,566 unrelated subjects of predominantly European ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "Here, we set out to systematically examine common and rare variation of AMD in the International AMD Genomics Consortium (IAMDGC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "We gathered advanced AMD cases with GA and/or CNV, intermediate AMD cases, and control subjects across 26 studies (Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "We genotyped all subjects centrally at the Center for Inherited Diseases Research (CIDR), Johns Hopkins University School of Medicine, Baltimore, MD, USA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "We utilized a custom-modified HumanCoreExome array by Illumina, Inc., which includes (i) tagging variants across the genome (genome chip content) and (ii) a catalogue of protein-altering variants (exome chip content).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11156861/fullTextXML") Annotation(rdfs:comment "We note that replication was to some extent expected, given that the majority of the Israeli cohort was included in the IAMDGC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001017> (<http://www.ebi.ac.uk/coho/COHO_0001017>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656865") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24656865") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/") Annotation(rdfs:comment "Case and control subjects included in the discovery phase were subjects of European ancestry aged >55 years in the Genetics of Cerebral Hemorrhage with Anticoagulation13 (GOCHA) study (multicenter study in the US) and aged >18 years in the Genetic and Environmental Risk Factors for Hemorrhagic Stroke16 (GERFHS) studies I and II in Cincinnati, OH;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001017> "A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656865") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24656865") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/") Annotation(rdfs:comment "Given the biological differences in ICH subtypes outlined in the introduction and after a prespecified analysis plan, genome-wide association analyses were computed separately for all ICH (lobar and nonlobar combined), for lobar ICH, and for nonlobar ICH.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001017> "A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656865") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24656865") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/") Annotation(rdfs:comment "Hospital del Mar Intracerebral Hemorrhage17 study and Vall d’Hebron Hospital ICH18 study in Barcelona, Spain; Jagiellonian University Hemorrhagic Stroke Study19 in Krakow, Poland; and the Lund Stroke Register20 study in Lund, Sweden.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001017> "A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656865") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24656865") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/") Annotation(rdfs:comment "In this study we meta-analyzed data from six previously unpublished genome-wide association studies of ICH that enrolled subjects of European ancestry in the United States and Europe under the auspices of the International Stroke Genetics Consortium, with subsequent replication of identified susceptibility loci in an independent study of ICH.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001017> "A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656865") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24656865") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/") Annotation(rdfs:comment "Spontaneous ICH was defined as a new and acute neurological deficit with compatible brain imaging (computed tomography or magnetic resonance imaging) showing the presence of intraparenchymal bleeding.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001017> "A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001018> (<http://www.ebi.ac.uk/coho/COHO_0001018>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18715499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18978787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18715499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2535604/fullTextXML") Annotation(rdfs:comment "Because ascertainment of cases through GELCAPS has been based on clinical centres specialising in the treatment of lung cancer a high proportion of cases have been diagnosed young.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001018> "A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18715499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18978787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22899653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607485/fullTextXML") Annotation(rdfs:comment "the UK lung cancer GWAS from the Institute for Cancer Research including lung cancer cases from the Genetic Lung Cancer Predisposition Study (GELCAPS) and controls from the 1958 Birth Cohort (7,68,69)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001018> "A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18715499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18978787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24880342") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4074058/") Annotation(rdfs:comment "This comprised 1,952 cases (1,166 male; mean age at diagnosis 57 years, SD 6) with pathologically confirmed lung cancer ascertained through the Genetic Lung Cancer Predisposition Study (GELCAPS) conducted between March 1999 and July 200448.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001018> "A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18715499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18978787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2754318/") Annotation(rdfs:comment "Individuals from the 1958 Birth cohort served as source of controls(7).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001018> "A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18715499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18978787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2754318/") Annotation(rdfs:comment "Phase 1 of the UK-GWA study was conducted using Illumina Human550 BeadChips according to the manufacturer's protocols (Illumina, San Diego, USA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001018> "A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001019> (<http://www.ebi.ac.uk/coho/COHO_0001019>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20436961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2860494/fullTextXML") Annotation(rdfs:comment "A 25% random sample of nonmigrants was invited to participate in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20436961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2860494/fullTextXML") Annotation(rdfs:comment "Briefly, the study was in four Indian factories (Lucknow, Hindustan Aeronautics Ltd; Nagpur, Indorama Synthetics Ltd; Hyderabad, Bharat Heavy Electricals Ltd; and Bangalore, Hindustan Machine Tools Ltd) situated in the north, centre, and south of the country.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20436961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2860494/fullTextXML") Annotation(rdfs:comment "Factory workers and their coresident spouses were recruited if they were rural-urban migrants using employer records as the sampling frame.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20436961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2860494/fullTextXML") Annotation(rdfs:comment "Field work began in March 2005 and was completed by December 2007.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20436961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2860494/fullTextXML") Annotation(rdfs:comment "In this cross-sectional study (a study in which participants are studied at a single time point), the researchers investigate whether rural to urban migrants in India have a higher prevalence of obesity and diabetes than rural nonmigrants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20436961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2860494/fullTextXML") Annotation(rdfs:comment "Migrants of rural origin, their rural dwelling sibs, and those of urban origin together with their urban dwelling sibs were assessed by interview, examination, and fasting blood samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001020> (<http://www.ebi.ac.uk/coho/COHO_0001020>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30188930") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39017907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42050091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16906370") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16906370+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This report documents the results of a study performed to examine clinical use of mizoribine (MZR), using data from a large-scale prospective cohort study, IORRA (Institute of Rheumatology Rheumatoid Arthritis).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001020> "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30188930") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39017907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42050091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30188930") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6126825/fullTextXML") Annotation(rdfs:comment "After providing informed consent, patients were invited to participate in the IORRA survey by completing a questionnaire biannually (April and October) during the period of treatment at our institute.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001020> "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30188930") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39017907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42050091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30188930") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6126825/fullTextXML") Annotation(rdfs:comment "In brief, all patients diagnosed with RA who visited our institute were registered in the IORRA cohort after informed consent was obtained.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001020> "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30188930") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39017907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42050091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30188930") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6126825/fullTextXML") Annotation(rdfs:comment "The IORRA cohort study is a single-institute-based, large observational cohort of Japanese patients with RA, established in October 2000 at the Institute of Rheumatology, Tokyo Women’s Medical University.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001020> "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30188930") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39017907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42050091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39017907") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11422331/fullTextXML") Annotation(rdfs:comment "Collected data include patients’ self-assessment (using the IORRA questionnaire), physician assessment, and laboratory data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001020> "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001021> (<http://www.ebi.ac.uk/coho/COHO_0001021>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34861974") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34861974") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8851871/unicode") Annotation(rdfs:comment "Here, we present the first GWAS meta-analysis of SA from the International Suicide Genetics Consortium (ISGC), including over 29,000 SA or suicide cases from 18 cohorts worldwide.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001021> "An international consortium that meta-analyses genome-wide association data on suicide attempt and suicide death from cohorts worldwide, including cohorts ascertained for psychiatric disorders or substance use, studies of suicide or suicide attempt, and population-based biobanks, to identify genetic risk loci for suicidal behaviour and separate them from those of psychiatric disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34861974") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34861974") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8851871/unicode") Annotation(rdfs:comment "The primary SA meta-analysis comprised 18 cohorts (Table S1 in Supplement 2; Supplement 1) ascertained for psychiatric disorders, including substance use (12 cohorts), studies of suicide or SA (4 cohorts), and population-based biobanks (2 cohorts).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001021> "An international consortium that meta-analyses genome-wide association data on suicide attempt and suicide death from cohorts worldwide, including cohorts ascertained for psychiatric disorders or substance use, studies of suicide or suicide attempt, and population-based biobanks, to identify genetic risk loci for suicidal behaviour and separate them from those of psychiatric disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34861974") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34861974") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8851871/unicode") Annotation(rdfs:comment "We identify novel loci implicated in SA, disentangle the genetic etiology of SA from that of MDD and psychiatric disorders, and characterize the genetic relationship among SA, psychiatric disorders, and a range of other risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001021> "An international consortium that meta-analyses genome-wide association data on suicide attempt and suicide death from cohorts worldwide, including cohorts ascertained for psychiatric disorders or substance use, studies of suicide or suicide attempt, and population-based biobanks, to identify genetic risk loci for suicidal behaviour and separate them from those of psychiatric disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001022> (<http://www.ebi.ac.uk/coho/COHO_0001022>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31235787") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML") Annotation(rdfs:comment "All samples were taken from the left-ventricular free wall at the mid ventricular level (Segments 11 or 12) on the 17-segment model.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31235787") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML") Annotation(rdfs:comment "The institutional review boards at all collection sites (including Stanford, the University of Pennsylvania and the Cleveland Clinic) reviewed and approved the protocols used in this study for procurement and use of human tissue and information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31235787") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML") Annotation(rdfs:comment "We established a collaborative multi-institution network with a 24/7 notification system and a team of travel-ready surgeons at major transplant centers to systematize the collection of cardiac tissue from failing hearts and unused heart transplant donors at operating rooms and remote locations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31235787") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML") Annotation(rdfs:comment "We genotyped and measured left-ventricular genome-wide gene expression of these samples, controlling for known covariates, specifically age, gender and collection site.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40038546") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-02064-3/MediaObjects/41588_2024_2064_MOESM6_ESM.xlsx") Annotation(rdfs:comment "MAGnet | Myocardial Applied Genomics Network | EUR |  | MAGNet is a collaborative group of investigators based at Perelman School of Medicine, University of Pennsylvania who use genomic approaches to understand human myocardial disease (http://www.med.upenn.edu/magnet/, NHLBI grant number 1R01HL105993-01A1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40038546") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-02064-3/MediaObjects/41588_2024_2064_MOESM6_ESM.xlsx") Annotation(rdfs:comment "The present analysis includes a case-control GWAS comparing a subset of patients with prevalent heart failure referred for evaluation and treatment at a heart failure specialty centre at a local institution.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")

