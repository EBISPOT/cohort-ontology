AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40483003") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12145211/fullTextXML") Annotation(rdfs:comment "The HELIUS study was set up as a prospective cohort study, with repeating measurements during follow-up examinations every 5–10 years to enable longitudinal analyses on the relationship between risk factors and cardiovascular diseases, mental disorders, and infectious diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000266> "A longitudinal multi-ethnic population-based cohort of residents of Amsterdam, the Netherlands, of Dutch, Surinamese, Turkish, Moroccan and Ghanaian origin, followed with examinations, questionnaires and gut microbiome sampling to investigate ethnic differences in health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40483003") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12145211/fullTextXML") Annotation(rdfs:comment "The Healthy Life in an Urban Setting (HELIUS) study is an ongoing prospective multiethnic cohort study in Amsterdam, The Netherlands that started in 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000266> "A longitudinal multi-ethnic population-based cohort of residents of Amsterdam, the Netherlands, of Dutch, Surinamese, Turkish, Moroccan and Ghanaian origin, followed with examinations, questionnaires and gut microbiome sampling to investigate ethnic differences in health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000795") Annotation(rdfs:comment "Shotgun metagenomics samples of 476 subjects at 2 timepoints (baseline and 6-year follow-up) of the HELIUS cohort study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000266> "A longitudinal multi-ethnic population-based cohort of residents of Amsterdam, the Netherlands, of Dutch, Surinamese, Turkish, Moroccan and Ghanaian origin, followed with examinations, questionnaires and gut microbiome sampling to investigate ethnic differences in health.")

