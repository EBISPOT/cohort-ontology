AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10829038") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19011631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19920828") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24146633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20501757") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2883738") Annotation(rdfs:comment "A previously characterized population-based sample series of 1042 CRCs collected between 1994 and 1998 from nine central hospitals in south-eastern Finland was utilized in this study (17, 18).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001719> "A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10829038") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19011631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19920828") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24146633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24146633") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3798264/fullTextXML") Annotation(rdfs:comment "A population-based material of normal and tumor tissue from 1,042 CRC patients was collected between 1994 and 1998 from nine Finnish central hospitals [4], [18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001719> "A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10829038") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19011631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19920828") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24146633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24146633") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3798264/fullTextXML") Annotation(rdfs:comment "After 1998 sample collection continued from two of the nine hospitals (unpublished collection).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001719> "A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001720> (<http://www.ebi.ac.uk/coho/COHO_0001720>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15546244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15546244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546244+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A case-control study was designed to elucidate roles of dietary and other behavioral influences, in combination with genetic susceptibility factors (genetic polymorphisms), in colorectal carcinogenesis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001720> "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15546244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15546244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546244+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Both cases and controls were residents in Fukuoka City and three adjacent areas.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001720> "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15546244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15546244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546244+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Cases were patients undergoing surgery for a first diagnosis of colorectal cancer at 8 hospitals in the study area, and controls were randomly selected in the community by frequency-matching with respect to the expected distribution by sex, age (10-year class), and residence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001720> "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15546244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15546244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546244+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Dietary and other lifestyle factors were ascertained by in-person interview, and venous blood was obtained for genotyping and possible biochemical measurements.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001720> "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15546244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15546244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546244+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The cases were interviewed at each hospital during the period from 2000 to 2003, and controls were surveyed during the period from 2001 to 2002.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001720> "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15546244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15546509") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546509+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This study investigated the relation of MTHFR C677T and A1298C polymorphisms to colorectal cancer in a case-control study in Fukuoka, Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001720> "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001721> (<http://www.ebi.ac.uk/coho/COHO_0001721>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36615099") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(rdfs:comment "Both studies utilized the same strategy to identify all potential participants with known diabetes in the area from hospital, clinic and primary care patient lists, widespread advertising through local media, pharmacies, optometrists, networks of health care professionals") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001721> "A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36615099") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(rdfs:comment "FDS1 and FDS2 were similarly conducted, observational, longitudinal studies of known diabetes conducted in the same zip code-defined geographic area surrounding the port city of Fremantle in Western Australia (WA) [20,21].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001721> "A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36615099") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(rdfs:comment "FDS1 recruited participants between 1993 and 1996 and FDS2 between 2008 and 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001721> "A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36615099") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(rdfs:comment "For those with type 2 diabetes, the assessment at study entry in FDS1 and FDS2 included comprehensive questionnaires, a physical examination and relevant tests including electrocardiography, and fasting biochemical tests performed in a single nationally accredited laboratory (18).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001721> "A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36615099") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(rdfs:comment "Participants were followed to death or end-2012 in FDS1 and end-2016 in FDS2, whichever came first.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001721> "A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40099758") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML") Annotation(rdfs:comment "All FDS2 participants were invited to face‐to‐face assessments at entry and then biennially over the next 6 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001721> "A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001722> (<http://www.ebi.ac.uk/coho/COHO_0001722>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22045388") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22045388") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3719980/") Annotation(rdfs:comment "Twenty-nine enrolling sites with 62 trained investigators and coordinators gathered individual and family information, graded the phenotype, and collected blood and/or saliva for genetic analysis on all individuals with and without FECD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001722> "The unaffected controls of a multicentre genetic study of Fuchs endothelial corneal dystrophy in the United States: people of European descent aged 60 or older, recruited at the study's clinical sites and matched by age, sex and ancestry to its index cases, whose corneas were graded free of the dystrophy on slit-lamp examination and whose refractive error and central corneal thickness were measured at baseline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22045388") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "All control subjects were of European descent and were at least 60 years of age and matched according to age, gender, and ancestry to the enrolled index cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001722> "The unaffected controls of a multicentre genetic study of Fuchs endothelial corneal dystrophy in the United States: people of European descent aged 60 or older, recruited at the study's clinical sites and matched by age, sex and ancestry to its index cases, whose corneas were graded free of the dystrophy on slit-lamp examination and whose refractive error and central corneal thickness were measured at baseline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22045388") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "FECD United States case-control (controls only) 393 71.50(9.18) 60.2 -0.14(2.49)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001722> "The unaffected controls of a multicentre genetic study of Fuchs endothelial corneal dystrophy in the United States: people of European descent aged 60 or older, recruited at the study's clinical sites and matched by age, sex and ancestry to its index cases, whose corneas were graded free of the dystrophy on slit-lamp examination and whose refractive error and central corneal thickness were measured at baseline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22045388") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "Measurements of refractive error, central corneal thickness and absence of FECD were obtained at baseline, along with recorded age, and gender.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001722> "The unaffected controls of a multicentre genetic study of Fuchs endothelial corneal dystrophy in the United States: people of European descent aged 60 or older, recruited at the study's clinical sites and matched by age, sex and ancestry to its index cases, whose corneas were graded free of the dystrophy on slit-lamp examination and whose refractive error and central corneal thickness were measured at baseline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22045388") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "To qualify, each control subject was required to be grade 0 on the FECD grading scale, have no family history of a possibly inherited corneal disorder (eg, FECD, keratoconus, stromal dystrophy), and have normal corneas with no abnormalities on slit-lamp examination apart from certain conditions judged not to affect FECD10 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001722> "The unaffected controls of a multicentre genetic study of Fuchs endothelial corneal dystrophy in the United States: people of European descent aged 60 or older, recruited at the study's clinical sites and matched by age, sex and ancestry to its index cases, whose corneas were graded free of the dystrophy on slit-lamp examination and whose refractive error and central corneal thickness were measured at baseline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22045388") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "We utilized control subjects who were part of a larger study on the genetics of Fuchs‟ Endothelial Corneal Dystrophy (FECD)10 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001722> "The unaffected controls of a multicentre genetic study of Fuchs endothelial corneal dystrophy in the United States: people of European descent aged 60 or older, recruited at the study's clinical sites and matched by age, sex and ancestry to its index cases, whose corneas were graded free of the dystrophy on slit-lamp examination and whose refractive error and central corneal thickness were measured at baseline.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001723> (<http://www.ebi.ac.uk/coho/COHO_0001723>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40429953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40918029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42188008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40429953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12112654/fullTextXML") Annotation(rdfs:comment "In this study, we performed a search for endophenotypes by ranking potential candidate endophenotypes for fatty liver disease using data from 704 non-Hispanic white adults from the Fels Longitudinal Study (FLS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001723> "A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40429953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40918029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42188008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40429953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12112654/fullTextXML") Annotation(rdfs:comment "Lastly, significant and suggestive QTLs identified through linkage for liver fat content and selected endophenotypes were targeted for both univariate and bivariate measured genotype association (MGA) analyses in the search for significant or marginally significant variants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001723> "A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40429953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40918029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42188008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40918029") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12411559/fullTextXML") Annotation(rdfs:comment "Fels Longitudinal Study participants are followed from enrollment, which is usually birth, until death or infirmity rendering their continued participation impossible [30].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001723> "A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40429953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40918029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42188008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40918029") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12411559/fullTextXML") Annotation(rdfs:comment "The Fels Longitudinal Study originated in 1929 in Yellow Springs, Ohio, and continues to this day.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001723> "A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40429953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40918029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42188008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40918029") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12411559/fullTextXML") Annotation(rdfs:comment "The Reproductive Endocrine Research Laboratory at the University of Southern California, Los Angeles, California, conducted biomarker assays after the frozen, never‐thawed samples were shipped from the collection site (Wright State University) in Dayton, Ohio.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001723> "A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40429953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40918029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42188008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42188008") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13208267/fullTextXML") Annotation(rdfs:comment "This study was a cross-sectional analysis of existing data from the Fels Longitudinal Study (FLS), a family-based study of growth, development, and body composition that began in 1929 in Yellow Spring, Ohio.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001723> "A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001724> (<http://www.ebi.ac.uk/coho/COHO_0001724>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:141882") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:879158") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A879158+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "During the period 1973--1975, 2675 out of 3977 still-living members of the Framingham, Massachusetts, study population, who have been under investigation for coronary disease risk factors since 1948 and who were in 1973--1975 aged 52 to 85, were given an eye examination stressing cataract, diabetic retinopathy, macular degeneration and glaucoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001724> "An ophthalmological study nested within the Framingham Heart Study in Framingham, Massachusetts, United States, in which participants of the Heart Study's original cohort were given eye examinations in 1973–1975 to evaluate senile cataract, age-related macular degeneration, glaucoma and retinopathy, and offspring of the original participants were examined in 1989–1991.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:141882") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "A total of 2675 FHS participants were also examined as part of the FES between 1973 and 1975.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001724> "An ophthalmological study nested within the Framingham Heart Study in Framingham, Massachusetts, United States, in which participants of the Heart Study's original cohort were given eye examinations in 1973–1975 to evaluate senile cataract, age-related macular degeneration, glaucoma and retinopathy, and offspring of the original participants were examined in 1989–1991.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:141882") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "Between 1989 and 1991, 1603 offspring of original cohort participants also received ocular examinations26 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001724> "An ophthalmological study nested within the Framingham Heart Study in Framingham, Massachusetts, United States, in which participants of the Heart Study's original cohort were given eye examinations in 1973–1975 to evaluate senile cataract, age-related macular degeneration, glaucoma and retinopathy, and offspring of the original participants were examined in 1989–1991.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:141882") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "The Framingham Eye Study25 (FES) was nested within the Framingham Heart Study (FHS, http://www.framinghamheartstudy.org), which began its first round of extensive physical examinations in 1948 by recruiting 5,209 men and women from the town of Framingham, MA, USA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001724> "An ophthalmological study nested within the Framingham Heart Study in Framingham, Massachusetts, United States, in which participants of the Heart Study's original cohort were given eye examinations in 1973–1975 to evaluate senile cataract, age-related macular degeneration, glaucoma and retinopathy, and offspring of the original participants were examined in 1989–1991.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001726> (<http://www.ebi.ac.uk/coho/COHO_0001726>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738491") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36172703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02075866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21738491") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3128111/fullTextXML") Annotation(rdfs:comment "All the victims of sudden death were autopsied at the Department of Forensic Medicine, University of Oulu, Oulu, Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001726> "A prospective case-control study run from the University of Oulu that since 1998 has collected medical records and medicolegal autopsy data from consecutive victims of out-of-hospital sudden cardiac death in the Oulu University Hospital District, northern Finland, with survivors of an acute coronary event treated at Oulu University Hospital as controls, to study the characteristics and genetic background of sudden cardiac death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738491") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36172703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02075866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21738491") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3128111/fullTextXML") Annotation(rdfs:comment "For the discovery GWAS, the FinGesture study control population consisted of MI patients from the same geographical area than cases and treated in the University of Oulu Hospital [24].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001726> "A prospective case-control study run from the University of Oulu that since 1998 has collected medical records and medicolegal autopsy data from consecutive victims of out-of-hospital sudden cardiac death in the Oulu University Hospital District, northern Finland, with survivors of an acute coronary event treated at Oulu University Hospital as controls, to study the characteristics and genetic background of sudden cardiac death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738491") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36172703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02075866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21738491") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3128111/fullTextXML") Annotation(rdfs:comment "The FinGesture study started in 1999 aimed at collecting consecutive victims of out-of-hospital sudden death from a defined geographical area, Oulu University Hospital District in northern Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001726> "A prospective case-control study run from the University of Oulu that since 1998 has collected medical records and medicolegal autopsy data from consecutive victims of out-of-hospital sudden cardiac death in the Oulu University Hospital District, northern Finland, with survivors of an acute coronary event treated at Oulu University Hospital as controls, to study the characteristics and genetic background of sudden cardiac death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738491") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36172703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02075866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36172703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9748531/fullTextXML") Annotation(rdfs:comment "The study population is derived from The Finnish Genetic Study of Arrhythmic Events (Fingesture) which has gathered medical records and medicolegal autopsy data from 5869 consecutive SCD victims since 1998 from the Oulu University Hospital District (defined geographical area in northern Finland, population ≈600 000).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001726> "A prospective case-control study run from the University of Oulu that since 1998 has collected medical records and medicolegal autopsy data from consecutive victims of out-of-hospital sudden cardiac death in the Oulu University Hospital District, northern Finland, with survivors of an acute coronary event treated at Oulu University Hospital as controls, to study the characteristics and genetic background of sudden cardiac death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001727> (<http://www.ebi.ac.uk/coho/COHO_0001727>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23298696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26407342") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23298696") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4493754/") Annotation(rdfs:comment "Follow-up questionnaires of the twins took place when the twins were aged 17 years, 18.5 years and as young adults (age 24 on average).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001727> "A population-based longitudinal study of Finnish twins from five consecutive birth cohorts (1975–1979) and their families, one of the three cohorts of the Finnish Twin Cohort Study, begun in 1991 with baseline assessments of the twins and their parents when the twins were aged 16 and followed with questionnaire waves at ages 17 and 18½, in young adulthood and later, the fifth wave also assessing the twins' spouses or partners.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23298696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26407342") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23298696") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4493754/") Annotation(rdfs:comment "The Finntwin16 study of twins born 1975–1979 started in 1991, with baseline assessments of twins and their parents when the twins were aged 16.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001727> "A population-based longitudinal study of Finnish twins from five consecutive birth cohorts (1975–1979) and their families, one of the three cohorts of the Finnish Twin Cohort Study, begun in 1991 with baseline assessments of the twins and their parents when the twins were aged 16 and followed with questionnaire waves at ages 17 and 18½, in young adulthood and later, the fifth wave also assessing the twins' spouses or partners.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23298696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26407342") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23298696") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4493754/") Annotation(rdfs:comment "The fifth wave of data collection in Finntwin16 (twins born 1975–1979) included also assessments of their spouses/partners.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001727> "A population-based longitudinal study of Finnish twins from five consecutive birth cohorts (1975–1979) and their families, one of the three cohorts of the Finnish Twin Cohort Study, begun in 1991 with baseline assessments of the twins and their parents when the twins were aged 16 and followed with questionnaire waves at ages 17 and 18½, in young adulthood and later, the fifth wave also assessing the twins' spouses or partners.")
