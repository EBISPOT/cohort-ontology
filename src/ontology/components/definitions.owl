AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21810271") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25265411") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27490645") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28894120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21810271") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3163514/fullTextXML") Annotation(rdfs:comment "The French-Canadian sample was genotyped with the Illumina 660W-Quad Beadchip.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001717> "A family study of five extended French-Canadian pedigrees, identified between 2005 and 2006 at the Thrombosis Clinic of the Ottawa Hospital, Canada, through single probands with objectively diagnosed idiopathic venous thromboembolism who carried the factor V Leiden mutation, whose consenting relatives were genotyped genome-wide and measured for plasma haemostatic factors.")
