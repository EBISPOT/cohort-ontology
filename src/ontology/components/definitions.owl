AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35627158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature12828/MediaObjects/41586_2014_BFnature12828_MOESM230_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature12828/MediaObjects/41586_2014_BFnature12828_MOESM230_ESM.pdf") Annotation(rdfs:comment "All Mexican-mestizo individuals were invited to participate in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002491> "A type 2 diabetes case-control study of Mexican-mestizo adults in Mexico City, whose cases were recruited at the outpatient diabetes clinic of the Department of Endocrinology and Metabolism of the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán (INCMNSZ) and whose normoglycaemic controls were recruited from a cohort of adults aged 45 years or older among government employees, blue-collar workers and people seeking attention in medical units.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35627158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature12828/MediaObjects/41586_2014_BFnature12828_MOESM230_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature12828/MediaObjects/41586_2014_BFnature12828_MOESM230_ESM.pdf") Annotation(rdfs:comment "Control subjects were recruited from a cohort of adults aged 45 years or older among government employees, blue collar workers and subjects seeking for attention in medical units for any condition besides those considered as exclusion criteria (see below).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002491> "A type 2 diabetes case-control study of Mexican-mestizo adults in Mexico City, whose cases were recruited at the outpatient diabetes clinic of the Department of Endocrinology and Metabolism of the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán (INCMNSZ) and whose normoglycaemic controls were recruited from a cohort of adults aged 45 years or older among government employees, blue-collar workers and people seeking attention in medical units.")
