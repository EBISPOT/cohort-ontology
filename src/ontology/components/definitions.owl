# Individual: <http://www.ebi.ac.uk/coho/COHO_0000909> (<http://www.ebi.ac.uk/coho/COHO_0000909>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000909> "A Swedish population-based case-control study of multiple sclerosis in which prevalent cases fulfilling the McDonald criteria were identified from the Swedish MS registry and controls were randomly selected from the national population register, with lifestyle and environmental questionnaires and blood samples for genetic analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000910> (<http://www.ebi.ac.uk/coho/COHO_0000910>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30234784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000910> "A prospective cohort of normotensive children of African or European ancestry aged 5–16 years in 1989, recruited through a county-wide public school screening in Richmond County, Georgia, United States, and re-evaluated repeatedly into adulthood to study the development of cardiovascular risk factors from childhood to adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000911> (<http://www.ebi.ac.uk/coho/COHO_0000911>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36973338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000911> "A longitudinal population study of more than 5000 adults aged 40 and older in Bushbuckridge, rural Mpumalanga, South Africa, recruited in 2014–2015 within the Agincourt Health and Demographic Surveillance System, collecting socio-demographic, infection history and cognitive data to study health and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000912> (<http://www.ebi.ac.uk/coho/COHO_0000912>)

