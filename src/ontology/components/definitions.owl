AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7664011") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853436") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7664011") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7664011+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "From patients randomised to ultrasound surveillance, the natural history of small aneurysms will be determined.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002514> "A multicentre, open, randomised trial at university and general hospitals across the United Kingdom that allocated patients aged 60–76 years with symptomless abdominal aortic aneurysms 4.0–5.5 cm in diameter to early elective open surgical repair or to ultrasonographic surveillance, comparing mortality, health service costs and quality of life, and following the natural history of small aneurysms in the surveillance group.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7664011") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853436") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7664011") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7664011+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Multicentre, random allocation, open trial.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002514> "A multicentre, open, randomised trial at university and general hospitals across the United Kingdom that allocated patients aged 60–76 years with symptomless abdominal aortic aneurysms 4.0–5.5 cm in diameter to early elective open surgical repair or to ultrasonographic surveillance, comparing mortality, health service costs and quality of life, and following the natural history of small aneurysms in the surveillance group.")
