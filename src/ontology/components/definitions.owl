AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41604611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857810/fullTextXML") Annotation(rdfs:comment "Annual cognitive and clinical assessments and blood draws were conducted at JHU beginning in 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41604611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857810/fullTextXML") Annotation(rdfs:comment "For this purpose, during the NIH phase, annual cognitive and clinical assessments were conducted, with CSF, blood, and MRI data collected biennially.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41604611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857810/fullTextXML") Annotation(rdfs:comment "Johns Hopkins University (JHU) School of Medicine was funded to re-establish the cohort in 2009 to continue longitudinal CSF collection and neuroimaging.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41604611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857810/fullTextXML") Annotation(rdfs:comment "The study began in 1995 within the NIH intramural program and was stopped in 2005 for administrative reasons.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41604611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857810/fullTextXML") Annotation(rdfs:comment "The study was structured to enroll from the community and follow primarily middle-aged participants, all cognitively unimpaired at enrollment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41604611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41604611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857810/fullTextXML") Annotation(rdfs:comment "This study sample comprised a subset of individuals enrolled in the BIOCARD study,19 an ongoing longitudinal cohort study focused on the early phases of AD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000817> "An ongoing longitudinal cohort of primarily middle-aged adults, all cognitively unimpaired at enrolment from the community, begun in 1995 in the National Institutes of Health intramural program and later continued at Johns Hopkins University, with repeated cognitive, clinical, CSF, blood and MRI assessments to study the earliest phases of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000818> (<http://www.ebi.ac.uk/coho/COHO_0000818>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22271044") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24163127") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms15724/MediaObjects/41467_2017_BFncomms15724_MOESM23_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24163127") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3919005") Annotation(rdfs:comment "We genotyped cases for four case–control studies, the Los Angeles Bladder Cancer Study (LABCS), the French Center for Research on Prostate Diseases (CeRePP), the French Bladder Study (FBCS) and the Brescia Bladder Cancer Study (BBCS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000818> "A hospital-based case-control collection of urological cancers in France, run by the Centre de Recherche pour les Pathologies Prostatiques (CeRePP) at Hôpital Tenon, Paris, whose prostate cancer cases are patients with histologically confirmed prostate cancer treated in French urology departments and whose controls are men found unaffected in a systematic health screening programme, and which has also supplied pathologically confirmed bladder cancer and renal cell carcinoma cases to genome-wide association studies of those cancers.")
