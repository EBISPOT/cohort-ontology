AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007730") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32448795") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7252979/fullTextXML") Annotation(rdfs:comment "This is a screening study in which HPV testing and Pap will be carried out in up to 50 000 women aged 30–64 years in multiple centres across Latin America.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000250> "A multicentre cohort of women screened for cervical cancer with human papillomavirus testing in Latin America, whose cervical cells were duplex sequenced to explore the somatic driver landscape of healthy and pre-cancerous cervical tissue.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007730") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007730") Annotation(rdfs:comment "Exome NanoSeq in cervical cells obtained from the ESTAMPA cohort, a multicentre study based in Latin America.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000250> "A multicentre cohort of women screened for cervical cancer with human papillomavirus testing in Latin America, whose cervical cells were duplex sequenced to explore the somatic driver landscape of healthy and pre-cancerous cervical tissue.")
