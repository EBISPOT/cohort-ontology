AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15456990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21037568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2652/MediaObjects/41588_2013_BFng2652_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21037568") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4268499/") Annotation(rdfs:comment "ELCCS comprised patients residing in the north of England aged 16-69, with newly diagnosed, non-HIV-related HL, during 1998-2003.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001685> "A population-based case-control study of lymphoma in the north of England, run from York, whose cases are patients aged 16 to 69 newly diagnosed with non-Hodgkin or Hodgkin lymphoma between 1998 and 2003 while resident in defined areas, and whose controls were matched to cases on sex, date of birth and area of residence and drawn from general practice registers.")
