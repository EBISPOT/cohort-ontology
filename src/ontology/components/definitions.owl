AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19060911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20418888") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19060911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2687074/") Annotation(rdfs:comment "Here we report the results of GWA analysis of 16 European studies (total number of persons 17,798-22,562, depending on the lipid trait studied), representing population-based cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002719> "A European research consortium that provides infrastructure to combine large population study samples and datasets across populations of European origin for genetic and genomic epidemiology, conducting genome-wide association meta-analyses of complex traits, including serum lipid levels and smoking behavior, using data from participating population cohorts, twin cohorts and clinical collections.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19060911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20418888") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19060911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2687074/") Annotation(rdfs:comment "Our study samples were compiled from the population cohorts of the ENGAGE project, which aims to provide an infrastructure to combine large study samples and datasets across populations of European origin.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002719> "A European research consortium that provides infrastructure to combine large population study samples and datasets across populations of European origin for genetic and genomic epidemiology, conducting genome-wide association meta-analyses of complex traits, including serum lipid levels and smoking behavior, using data from participating population cohorts, twin cohorts and clinical collections.")
