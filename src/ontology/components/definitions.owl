AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25327703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25327703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4204111/fullTextXML") Annotation(rdfs:comment "Controls were identified by random-digit dialing and matched on 5-year age groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000735> "A population-based multiethnic case-control study of breast cancer in the San Francisco Bay Area, California, in which women aged 35–79 diagnosed with invasive breast cancer in 1995–2002 were identified through the Greater Bay Area Cancer Registry and controls were identified by random-digit dialing and matched on 5-year age group.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25327703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25327703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4204111/fullTextXML") Annotation(rdfs:comment "We initially performed a GWAS of Latina women from the San Francisco Bay Area including 977 cases and 722 controls, from the San Francisco Bay Area Breast Cancer Study (SFBCS), the Northern California site of the Breast Cancer Family Registry (NC-BCFR) and the Genetics of Asthma in Latino Americans (GALA1, controls).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000735> "A population-based multiethnic case-control study of breast cancer in the San Francisco Bay Area, California, in which women aged 35–79 diagnosed with invasive breast cancer in 1995–2002 were identified through the Greater Bay Area Cancer Registry and controls were identified by random-digit dialing and matched on 5-year age group.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25327703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25327703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4204111/unicode") Annotation(rdfs:comment "The SFBCS is a population-based multiethnic case–control study of breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000735> "A population-based multiethnic case-control study of breast cancer in the San Francisco Bay Area, California, in which women aged 35–79 diagnosed with invasive breast cancer in 1995–2002 were identified through the Greater Bay Area Cancer Registry and controls were identified by random-digit dialing and matched on 5-year age group.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000736> (<http://www.ebi.ac.uk/coho/COHO_0000736>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24390345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4127086/") Annotation(rdfs:comment "(f) Forest plot depicting odds ratio estimates at rs75493593 from the four SIGMA cohorts, the SIGMA pooled mega-analysis, the replication cohorts, replication-only meta-analysis, and the overall meta-analysis (including all replication cohorts and the SIGMA mega-analysis).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000736> "A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24390345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4127086/") Annotation(rdfs:comment "Mexico City Diabetes Study (MCDS) Mexico City, Mexico Prospective Cohort Controls 613 (790) 39.3% 62.5 ± 7.7 – 29.4 ± 4.8 5.0 ± 0.5 T2D Cases 287 (358) 41.1% 64.2 ± 7.5 55.1 ± 9.7 29.9 ± 5.4 – Multiethnic Cohort (MEC) Los Angeles, California, USA Case- Control") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000736> "A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24390345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4127086/") Annotation(rdfs:comment "The Slim Initiative in Genomic Medicine for the Americas (SIGMA) Type 2 Diabetes Consortium set out to characterize the genetic basis of T2D in Mexican and Latin American populations, where the prevalence is roughly twice that of U.S. non-Hispanic whites5,6.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000736> "A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24390345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4127086/") Annotation(rdfs:comment "UNAM/INCMNSZ Diabetes Study (UIDS) Mexico City, Mexico Prospective Cohort Controls 1,138 (1,195) 41.1% 55.3 ± 9.4 – 28.1 ± 4.0 4.8 ± 0.5 T2D Cases 815 (872) 40.9% 56.2 ± 12.3 44.2 ± 11.3 28.4 ± 4.5 – Diabetes in Mexico Study (DMS) Mexico City, Mexico Prospective Cohort") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000736> "A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24390345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4127086/") Annotation(rdfs:comment "We analyzed 9.2 million single nucleotide polymorphisms (SNPs) in each of 8,214 Mexicans and Latin Americans: 3,848 with type 2 diabetes (T2D) and 4,366 non-diabetic controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000736> "A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.")

