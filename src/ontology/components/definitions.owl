AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23544013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36203093") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32665703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7521995/fullTextXML") Annotation(rdfs:comment "In this study, we used the largest sample of women with pathogenic BRCA1/2 variants currently available to assess the associations between the most recently developed PRS with cancer risks for BRCA1/2 carriers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001539> "A South African study of BRCA1 and BRCA2 mutations in women with breast cancer and their families, based at the University of Pretoria and funded by the Cancer Association of South Africa. The women it identifies as carriers of pathogenic BRCA1 or BRCA2 variants are contributed to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA) for studies of genetic modifiers of breast and ovarian cancer risk in carriers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23544013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36203093") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32665703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7521995/fullTextXML") Annotation(rdfs:comment "Study participants were enrolled through 63 studies from 29 countries contributing to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA).13 Eligibility was restricted to women who were ≥18 years old at recruitment and carried a pathogenic BRCA1/2 variant.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001539> "A South African study of BRCA1 and BRCA2 mutations in women with breast cancer and their families, based at the University of Pretoria and funded by the Cancer Association of South Africa. The women it identifies as carriers of pathogenic BRCA1 or BRCA2 variants are contributed to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA) for studies of genetic modifiers of breast and ovarian cancer risk in carriers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001540> (<http://www.ebi.ac.uk/coho/COHO_0001540>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21639959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21673961") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21673961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3108970/") Annotation(rdfs:comment "Epidemiological data were collected using structured questionnaires that included socio-demographic and health-related information, menstrual, reproductive, and gynecological histories.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001540> "A case-control study of ovarian cancer in Erlangen, northern Bavaria, Germany, supported by the ELAN programme of the University of Erlangen-Nuremberg, whose cases were recruited through the hospital in Erlangen and whose controls were randomly selected women from Erlangen, both enrolled from May 2002 to August 2008 and interviewed. It is one of the studies of the Ovarian Cancer Association Consortium (study code BAV) and contributes to its pooled epidemiological analyses and genome-wide association studies of ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21639959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21673961") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21673961") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3108970/") Annotation(rdfs:comment "The association of ovarian carcinoma risk with the polymorphism rs1271572 in the estrogen receptor beta (ESR2) gene was examined in 4946 women with primary invasive ovarian carcinoma and 6582 controls in a pooled analysis of ten case-control studies within the Ovarian Cancer Association Consortium (OCAC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001540> "A case-control study of ovarian cancer in Erlangen, northern Bavaria, Germany, supported by the ELAN programme of the University of Erlangen-Nuremberg, whose cases were recruited through the hospital in Erlangen and whose controls were randomly selected women from Erlangen, both enrolled from May 2002 to August 2008 and interviewed. It is one of the studies of the Ovarian Cancer Association Consortium (study code BAV) and contributes to its pooled epidemiological analyses and genome-wide association studies of ovarian cancer.")
