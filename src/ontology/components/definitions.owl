AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21925715") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9665570") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23202125") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") Annotation(rdfs:comment "SHEEP/SCARF are Swedish population based case‐control studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002349> "A combined sample of two Swedish population-based case-control studies of myocardial infarction from Stockholm, the Stockholm Coronary Atherosclerosis Risk Factor (SCARF) study and the Stockholm Heart Epidemiology Program (SHEEP), whose cases had a first confirmed myocardial infarction and whose controls had no history of myocardial infarction, analysed together in genetic studies of coronary artery disease and cardiometabolic traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21925715") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9665570") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9665570") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9665570+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The material is a population-based case-referent study having incident first events of myocardial infarction as outcome (SHEEP: Stockholm Heart Epidemiology Program).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002349> "A combined sample of two Swedish population-based case-control studies of myocardial infarction from Stockholm, the Stockholm Coronary Atherosclerosis Risk Factor (SCARF) study and the Stockholm Heart Epidemiology Program (SHEEP), whose cases had a first confirmed myocardial infarction and whose controls had no history of myocardial infarction, analysed together in genetic studies of coronary artery disease and cardiometabolic traits.")
