AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35390065") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40979826") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40979826") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML") Annotation(rdfs:comment "Between 1985 and 2010, we randomly recruited a family-based population sample, stratified by age and sex, from a geographically defined area in northeastern Belgium, as described previously.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001734> "An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35390065") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40979826") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40979826") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML") Annotation(rdfs:comment "From May 2005 to March 2015, 1,851 FLEMENGHO participants were invited to a detailed in-person study visit that comprised standardized and in-depth registration of medical history, lifestyle, medication use, and biochemical profiling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001734> "An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35390065") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40979826") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40979826") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML") Annotation(rdfs:comment "The Flemish Study on Environment, Genes, and Health Outcomes (FLEMENGHO) is an observational, community-based cohort study on cardiovascular risk factors and outcomes in the adult Belgian population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001734> "An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35390065") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40979826") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40979826") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML") Annotation(rdfs:comment "VTE cases occurring between 2000 and 2024 were identified through standardized health questionnaires, medical records, and expert adjudication.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001734> "An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35390065") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40979826") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40979826") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML") Annotation(rdfs:comment "We conducted secondary analyses of 1,448 participants from the Flemish Study on Environment, Genes, and Health Outcomes (FLEMENGHO), an observational, community-based, prospective cohort study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001734> "An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001735> (<http://www.ebi.ac.uk/coho/COHO_0001735>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20433707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216207") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20433707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2873513/fullTextXML") Annotation(rdfs:comment "Briefly, a first study, FLVS I [11] had been conducted on the children of all 579 families who had at least one child in primary school in 1992 in Fleurbaix or Laventie.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001735> "The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20433707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216207") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20433707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2873513/fullTextXML") Annotation(rdfs:comment "Participation in FLSV II was proposed to 393 families who had not moved and who could be contacted in 1999: 294 families were recruited on a voluntary basis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001735> "The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20433707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216207") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20433707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2873513/fullTextXML") Annotation(rdfs:comment "The dataset is a sample of the community-based Fleurbaix Laventie Ville Santé Study II (FLVS II), whose general aim was to investigate, in the general population, risk factors for weight and adiposity changes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001735> "The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20433707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216207") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20433707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2873513/fullTextXML") Annotation(rdfs:comment "anthropometric data (weight, height, waist circumference, the bicipital, tricipital, subscapular and suprailiac skinfold thicknesses and percent body fat determined using a Tanita TBF 310 tetrapolar foot-to-foot bioimpedance analyzer) were collected by trained technicians at baseline and 2 years later, i.e., in 1999 and 2001.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001735> "The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20433707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216207") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22216207") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3247254/fullTextXML") Annotation(rdfs:comment "Nuclear families, defined as family groups consisting of a father and/or mother and their children who share living quarters, were drawn from the Fleurbaix-Laventie Ville-Santé II (FLVS II) study, a prospective study (1999–2001) aimed at identifying determinants of adiposity and its changes over time in families living in two small towns in Northern France, Fleurbaix and Laventie [16], [17].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001735> "The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.")

