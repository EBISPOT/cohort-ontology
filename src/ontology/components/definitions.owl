AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34887591") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34887591") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-021-04064-3/MediaObjects/41586_2021_4064_MOESM4_ESM.xlsx") Annotation(rdfs:comment "ACD | ACD | South Korea | EAS | 150 | 0.51 | 52.5 | Unknown | Unknown | 43 | 109 | Unknown | 140.1 | 192.4 | | Minimac3 | 1KGP3 | rvtests") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002587> "A Korean genetic study of Avellino corneal dystrophy (granular corneal dystrophy type 2) at the Corneal Dystrophy Research Institute of Yonsei University College of Medicine, Seoul, whose genome-wide genotyped participants have contributed to multi-ancestry meta-analyses of blood lipid levels and body mass index.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34887591") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40691366") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM3_ESM.xlsx") Annotation(rdfs:comment "ACD | Yonsei Avellino Corneal Dystrophy Study | EAS | 150") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002587> "A Korean genetic study of Avellino corneal dystrophy (granular corneal dystrophy type 2) at the Corneal Dystrophy Research Institute of Yonsei University College of Medicine, Seoul, whose genome-wide genotyped participants have contributed to multi-ancestry meta-analyses of blood lipid levels and body mass index.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002588> (<http://www.ebi.ac.uk/coho/COHO_0002588>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10737396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20308568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10737396") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2374437/fullTextXML") Annotation(rdfs:comment "Controls (two per case) were randomly selected from people regis- tered with general practitioners in the study area matched for sex, year of birth and administrative area (FHSA) of residence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002588> "A UK population-based case-control study of Hodgkin's disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin's disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10737396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20308568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10737396") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2374437/fullTextXML") Annotation(rdfs:comment "The objective of the present study was to investigate the late host response model for HD in young adults (16-24 years) and determine whether it applied differently to EBV-positive and EBV-negative disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002588> "A UK population-based case-control study of Hodgkin's disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin's disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10737396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20308568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10737396") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2374437/fullTextXML") Annotation(rdfs:comment "These areas are taken from the Leukaemia Research Fund (LRF) Data Collection Study (DCS) area and methods of ascertainment were those of the DCS (Cartwright et al, 1990).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002588> "A UK population-based case-control study of Hodgkin's disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin's disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10737396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20308568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22286212") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3274508") Annotation(rdfs:comment "Genome-wide genotyping was performed on cHL case samples from five European-based HL studies: the EPILYMPH Study, the Scotland and Newcastle Lymphoma Group, the Young Adult Hodgkin’s Disease Case–Control Study") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002588> "A UK population-based case-control study of Hodgkin's disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin's disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10737396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20308568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22286212") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3274508") Annotation(rdfs:comment "The Young Adult Hodgkin’s Disease Case–Control Study is a case–control study of HL in adolescents and young adults (aged 16–24 years) conducted in the United Kingdom in the regions of Yorkshire, Wessex, Southwest Family Health Service Authority areas, and parts of Cumbria and Lancashire between October 1991 and May 1995 (13).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002588> "A UK population-based case-control study of Hodgkin's disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin's disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10737396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20308568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24920014") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode") Annotation(rdfs:comment "The European Collaborative Study, presented elsewhere, included 1,241 HL cases aged 13–80 (median age = 33 years) from five European-based HL studies and 5,726 generic controls aged 17–94 (mean age = 62) used in the initial GWAS scan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002588> "A UK population-based case-control study of Hodgkin's disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin's disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002590> (<http://www.ebi.ac.uk/coho/COHO_0002590>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") Annotation(rdfs:comment "Additional studies included in this GWAS are the Guangdong Study (GDS), the Hong Kong Study (HKS), the Japanese Female Lung Cancer Collaborative Study (JLCS)14 , the Chonnam National University Lung Cancer Study (CNULCS) Study15 , and the Yunnan Lung Cancer Study (YLCS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002590> "A case-control study of lung cancer in never-smoking ethnic Chinese women in Yunnan Province, China, that enrolled incident lung cancer cases and controls without a history of cancer, all aged at least 18; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") Annotation(rdfs:comment "All subjects were ethnic Chinese.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002590> "A case-control study of lung cancer in never-smoking ethnic Chinese women in Yunnan Province, China, that enrolled incident lung cancer cases and controls without a history of cancer, all aged at least 18; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") Annotation(rdfs:comment "Cases and controls had to be at least 18 years old to be eligible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002590> "A case-control study of lung cancer in never-smoking ethnic Chinese women in Yunnan Province, China, that enrolled incident lung cancer cases and controls without a history of cancer, all aged at least 18; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") Annotation(rdfs:comment "Incident lung cancer cases and controls without history of cancer were enrolled.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002590> "A case-control study of lung cancer in never-smoking ethnic Chinese women in Yunnan Province, China, that enrolled incident lung cancer cases and controls without a history of cancer, all aged at least 18; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") Annotation(rdfs:comment "The YLCS enrolled never smoking female cases and never smoking female controls in the Yunnan Province of China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002590> "A case-control study of lung cancer in never-smoking ethnic Chinese women in Yunnan Province, China, that enrolled incident lung cancer cases and controls without a history of cancer, all aged at least 18; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.")
