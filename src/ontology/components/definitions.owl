AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22344219") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf") Annotation(rdfs:comment "To be eligible, cases had to meet the following criteria: 1) have at least two family members with hypertension;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002379> "A hospital-based case-control genome-wide association study of hypertension among Han Chinese adults aged 37–84 living in the Shanghai metropolitan area, approved by the ethics committee of Ruijin Hospital. Its cases had hypertension diagnosed after age 30 and at least two family members with hypertension, and its controls were normotensive adults over 40; both groups had a BMI under 27 kg/m2 and cases had no diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002381> (<http://www.ebi.ac.uk/coho/COHO_0002381>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24626196") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3953580/fullTextXML") Annotation(rdfs:comment "Data were obtained as part of the scientific expedition Marcopolo 2010 (www.marcopolo2010.it), whose main goals were to analyse individual differences in the human senses (e.g. taste, smell, hearing, vision) across the Silk Road, a major pathway for cultural, commercial, and genetic exchange between individuals from China and Mediterranean countries for almost 3,000 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25476266") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4267745/fullTextXML") Annotation(rdfs:comment "All communities belong to the Terra Madre organization (www.terramadre.org).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25476266") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4267745/fullTextXML") Annotation(rdfs:comment "Approval for information collection and processing has been obtained by the Ethical committee of the Maternal and Child Health Institute IRCCS-Burlo Garofolo Hospital (Trieste, Italy).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25476266") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4267745/fullTextXML") Annotation(rdfs:comment "Samples of saliva were collected in these countries from healthy donors from rural communities (Georgia, Azerbajan, Armenia, Tajikistan or form both rural communities and cities (Uzbekistan, Kahzakstan).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25476266") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4267745/fullTextXML") Annotation(rdfs:comment "With the aim of studying the genetics of several phenotypes (e.g. food preferences, hearing and taste [9-12]), the Marco Polo scientific campaign, collected in 2010 genetic and phenotypic information of 411 individuals from six countries dwelling along the Silk Road (Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26188009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4572074/fullTextXML") Annotation(rdfs:comment "These 223 SNPs were further analyzed by combining data from a completely independent cohort of isolated communities (Silk Road cohort, N = 481), resulting in a total sample size of 2636.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")

