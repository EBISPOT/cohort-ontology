AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22306652") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23041239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23041239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3490334/fullTextXML") Annotation(rdfs:comment "WTCCC2-Munich=The Wellcome Trust Case-Control Consortium II Munich.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001105> "A hospital-based collection of consecutive patients of European ancestry with ischaemic stroke, recruited from 2002 to 2009 at the dedicated stroke unit of the Department of Neurology, Klinikum Großhadern, Ludwig-Maximilians-University, Munich, Germany, with stroke subtypes assigned by TOAST criteria; the cases were genotyped genome-wide in the Wellcome Trust Case Control Consortium 2 ischaemic stroke study and contribute to METASTROKE, the Stroke Genetics Network (SiGN) and MEGASTROKE.")
