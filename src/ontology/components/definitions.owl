AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17715408") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42001100") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42001100") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13093930/fullTextXML") Annotation(rdfs:comment "The SOS study is a prospective, non-randomized, matched intervention study comparing long-term outcomes of bariatric surgery and usual obesity care [22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002401> "A prospective, controlled intervention study in Sweden in which severely obese adults aged 37 to 60, recruited between 1987 and 2001, either underwent bariatric surgery or received usual obesity care as a matched control group, and were followed long term for the effects of surgically induced weight loss.")

