AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25855707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(rdfs:comment "(1) Blood bank healthy donors from Southwest Netherlands recruited in 1996, 2000 or 2007; (2) People who married a person who was part of a family with high breast cancer risk (BRCA1/2/x).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002214> "A hospital-based case-control study of breast cancer in the south-west of the Netherlands, run from Leiden University Medical Centre, whose cases were consecutive patients with invasive or in situ breast cancer diagnosed in 1996–2006 at two hospitals in Leiden and Rotterdam, not selected for family history, and whose controls were healthy blood-bank donors, spouses of members of families at high breast cancer risk, and women tested at the local clinical genetics department for non-cancer conditions; it is a member study of the Breast Cancer Association Consortium.")
