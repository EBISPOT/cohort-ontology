AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "Nondiabetic control subjects were selected according to the following criteria: ≥60 years old, no history of diabetes, no first-degree relatives with diabetes, fasting plasma glucose<6.1 mmol/L, and HbA1c <5.8%.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001410> "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "SNUH SNUHDS Korean 632 761 1393 Case-control") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001410> "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "Seoul National University Hospital (SNUH) Study The Seoul National University Hospital (SNUH) case-control samples were consisted of 761 T2D patients of the Diabetes Clinic of SNUH and 632 nondiabetic control subjects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001410> "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "Subjects positive for GAD antibodies were excluded.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001410> "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3582398/") Annotation(rdfs:comment "Stage 3 included up to, 12,284 cases and 13,172 controls from five different studies comprised of the Japan Cardiometabolic Genome Epidemiology Network (CAGE), the Shanghai Diabetes Study I/II (SDS I/II), the Chinese University of Hong Kong Diabetes Study (CUHKDS), the National Taiwan University Hospital Diabetes Study (NTUHDS) and the Seoul National University Hospital Diabetes Study (SNUHDS) for de novo replication analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001410> "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001411> (<http://www.ebi.ac.uk/coho/COHO_0001411>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24120345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39885687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41294090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24120345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24120345+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants are children aged 8-16 years whose parents/legal guardians participated in the Hispanic Community Health Study/Study of Latinos, a large community-based cohort study of Hispanic/Latino adults living in the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001411> "An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth's lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24120345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39885687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41294090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24120345") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24120345+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Primary study aims are to examine associations of youth's lifestyle behaviors and cardiometabolic risk factors with (1) youth's acculturation and parent-child differences in acculturation; (2) parenting strategies, family behaviors, and parental health behaviors; and (3) youth's psychosocial functioning.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001411> "An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth's lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24120345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39885687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41294090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39885687") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11875162/") Annotation(rdfs:comment "The Hispanic Community Children’s Health Study/Study of Latino Youth (SOL Youth) cohort is an ancillary study of the Hispanic Community Health Study/Study of Latinos (HCHS/SOL) that recruited n = 1,466 children aged 8–16 years between 2012 and 2014 whose parents/legal guardians participated in the HCHS/SOL at one of four field centers (Chicago, Bronx, San Diego, and Miami).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001411> "An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth's lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24120345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39885687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41294090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41294090") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41294090+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We used data from the HCHS/SOL (Hispanic Community Health Study/Study of Latinos) (2008-2011) and its ancillary study SOL Youth (Hispanic Community Children's Health Study/Study of Latino Youth) (2012-2014).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001411> "An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth's lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001412> (<http://www.ebi.ac.uk/coho/COHO_0001412>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40050429") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-02072-3/MediaObjects/41588_2024_2072_MOESM1_ESM.pdf") Annotation(rdfs:comment "The following studies have previously been described: ARIC8 , BBJ9 , deCODE10 , DiscovEHR10 , FHS8 , HUNT10 , KAFN11 , MESA6 , MGI10 , MGH CAMP6 , PHB12 , SiGN13 , SPHFC6 , UKBB14 and WGHS8 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(rdfs:comment "Atrial fibrillation status was determined if either atrial flutter or atrial fibrillation was present on a 12-lead ECG at baseline evaluation or prior and could be confirmed by electronic medical record review.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(rdfs:comment "Different heart failure etiologies were included.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(rdfs:comment "Only patients older than 18 years and with symptomatic heart failure (stage C) were enrolled.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(rdfs:comment "SPHFC: Participants for the Sao Paolo Heart Failure Cohort (SPHFC) were prospectively enrolled from the outpatient clinic at the Heart Institute, the University of Sao Paulo Medical School, Sao Paulo, Brazil.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM308_ESM.xlsx") Annotation(rdfs:comment "BRAZ | SPHFC | Cases | 197 | –  | 131 (63) | 60±12 | 24-84 | – | 130 (66) | 29±6 | 51 (26) | 51 (26) | 197 (100)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001413> (<http://www.ebi.ac.uk/coho/COHO_0001413>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222050") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33222050") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC7116651") Annotation(rdfs:comment "A pre-conception clinic was established in KK Women's and Children's Hospital, the main public maternity hospital in Singapore, to facilitate recruitment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001413> "A preconception, longitudinal cohort of Chinese, Malay or Indian women aged 18–45 who intended to conceive and deliver in Singapore, recruited in February 2015–October 2017 through a preconception clinic at KK Women's and Children's Hospital and through public outreach, and followed with their children from before conception through pregnancy into early childhood. Its aim is to study how nutrition, lifestyle and maternal mood before and during pregnancy affect the offspring's epigenome, duration of gestation, fetal growth, and metabolic and neural phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222050") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33222050") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC7116651") Annotation(rdfs:comment "Public recruitment outside the hospital occurred through a variety of approaches, including distributed brochures, publicly displayed posters at out-patient clinics in general practices, community/religious centers, advertisements on social media platforms and the radio.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001413> "A preconception, longitudinal cohort of Chinese, Malay or Indian women aged 18–45 who intended to conceive and deliver in Singapore, recruited in February 2015–October 2017 through a preconception clinic at KK Women's and Children's Hospital and through public outreach, and followed with their children from before conception through pregnancy into early childhood. Its aim is to study how nutrition, lifestyle and maternal mood before and during pregnancy affect the offspring's epigenome, duration of gestation, fetal growth, and metabolic and neural phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222050") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33222050") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33222050+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Between February 2015 and October 2017, the S-PRESTO study recruited 1039 Chinese, Malay or Indian (or any combinations thereof) women aged 18-45 years and who intended to get pregnant and deliver in Singapore, resulting in 1032 unique participants and 373 children born in the cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001413> "A preconception, longitudinal cohort of Chinese, Malay or Indian women aged 18–45 who intended to conceive and deliver in Singapore, recruited in February 2015–October 2017 through a preconception clinic at KK Women's and Children's Hospital and through public outreach, and followed with their children from before conception through pregnancy into early childhood. Its aim is to study how nutrition, lifestyle and maternal mood before and during pregnancy affect the offspring's epigenome, duration of gestation, fetal growth, and metabolic and neural phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222050") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33222050") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33222050+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Singapore Preconception Study of Long-Term Maternal and Child Outcomes (S-PRESTO) is a preconception, longitudinal cohort study that aims to study the effects of nutrition, lifestyle, and maternal mood prior to and during pregnancy on the epigenome of the offspring and clinically important outcomes including duration of gestation, fetal growth, metabolic and neural phenotypes in the offspring.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001413> "A preconception, longitudinal cohort of Chinese, Malay or Indian women aged 18–45 who intended to conceive and deliver in Singapore, recruited in February 2015–October 2017 through a preconception clinic at KK Women's and Children's Hospital and through public outreach, and followed with their children from before conception through pregnancy into early childhood. Its aim is to study how nutrition, lifestyle and maternal mood before and during pregnancy affect the offspring's epigenome, duration of gestation, fetal growth, and metabolic and neural phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222050") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33222050") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33222050+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This enables prospective assessment of a wide array of potential determinants of future health outcomes in women from preconception to post-delivery and in their offspring across the earliest development from embryonic stages into early childhood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001413> "A preconception, longitudinal cohort of Chinese, Malay or Indian women aged 18–45 who intended to conceive and deliver in Singapore, recruited in February 2015–October 2017 through a preconception clinic at KK Women's and Children's Hospital and through public outreach, and followed with their children from before conception through pregnancy into early childhood. Its aim is to study how nutrition, lifestyle and maternal mood before and during pregnancy affect the offspring's epigenome, duration of gestation, fetal growth, and metabolic and neural phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001414> (<http://www.ebi.ac.uk/coho/COHO_0001414>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30169202") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30169202") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30169202+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Children were eligible if they met criteria for systemic inflammatory response syndrome-according to 2005 paediatric consensus definition- at the time of blood culture sampling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001414> "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30169202") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30169202") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30169202+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We assessed population-based incidence and outcomes of blood culture-proven bacterial sepsis in children in Switzerland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001414> "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30169202") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30169202") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30169202+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We included neonates and children younger than 17 years with blood culture-proven bacterial sepsis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001414> "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30169202") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42241732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC13266212") Annotation(rdfs:comment "The Swiss Pediatric Sepsis Study has defined its incidence, clinical features, and outcomes in Switzerland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001414> "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30169202") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42241732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC13266212") Annotation(rdfs:comment "The Swiss Pediatric Sepsis Study was a nationwide, prospective, multicentre cohort conducted from September 1, 2011, to December 31, 2015, across 10 tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001414> "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001415> (<http://www.ebi.ac.uk/coho/COHO_0001415>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25844303") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4383759/fullTextXML") Annotation(rdfs:comment "After patients signed informed consent for entry into the STEP-BD study registry, all patients enter the SCP.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25844303") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4383759/fullTextXML") Annotation(rdfs:comment "In the RCP, there are three different pathways each addressing unmet needs in the treatment of bipolar disorder: acute depression randomized (RAD) pathway, acute depression psychosocial intervention (PAD) pathway, and refractory depression (REFD) pathway.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25844303") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4383759/fullTextXML") Annotation(rdfs:comment "Its aim was “to generate externally valid answers to treatment effectiveness questions related to bipolar disorder”") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25844303") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4383759/fullTextXML") Annotation(rdfs:comment "STEP-BD is a long-term study of bipolar disorder funded by the National Institute of Mental Health (NIMH).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35773558") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9247121/fullTextXML") Annotation(rdfs:comment "Briefly, the 7-year study followed 4360 outpatient participants, ages 15 years or older, with BD of every subtype.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35773558") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9247121/fullTextXML") Annotation(rdfs:comment "The study was conducted across 22 academic medical centers in the United States and was approved by the institutional review board of the participating institutions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001416> (<http://www.ebi.ac.uk/coho/COHO_0001416>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24832787") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4112925/fullTextXML") Annotation(rdfs:comment "SUCCESS was a prospective, randomized adjuvant study comparing three cycles of fluorouracil-epirubicin-cyclophosphamide (FEC; 500/100/500mg/m2) followed by 3 cycles of docetaxel (100mg/m2) every 3 weeks vs three cycles of FEC followed by 3 cycles of gemcitabine (1000mg/m2 d1,8)-docetaxel (75mg/m2) every 3 weeks.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33097092") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7583247/") Annotation(rdfs:comment "From 2005–2007, 3754 patients from 251 study centers were randomly allocated to treatment groups (1898 FEC → Doc, 1856 FEC → Doc/Gem).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33097092") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7583247/") Annotation(rdfs:comment "SUCCESS-A (NCT02181101) was an open-label, multicenter phase III randomized study and was conducted as an investigator-initiated trial in Germany that enrolled patients ≥ 18 years with an invasive BC and a high recurrence risk") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33097092") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7583247/") Annotation(rdfs:comment "The SUCCESS-A trial had also an affiliated translational research project with focus on circulating tumor cells, serum tumor marker, and pharmacogenetics") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33097092") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7583247/") Annotation(rdfs:comment "There was an additional randomization to treatment with 2 versus 5 years of zoledronate after chemotherapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41711956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12920344/") Annotation(rdfs:comment "SUCCESS A was an open-label, multicenter, 2 × 2 factorial design, randomized controlled, Phase III study comparing the disease-free survival after randomization in patients with early primary breast cancer") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001417> (<http://www.ebi.ac.uk/coho/COHO_0001417>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31294132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6607078/") Annotation(rdfs:comment "Accordingly, we aimed to develop a prospective, comprehensive, multidisciplinary, bio-bank-linked cohort based on standard real practice for PC, renal cell carcinoma (RCC), and urothelial cancer (UC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31294132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6607078/") Annotation(rdfs:comment "It is not limited to localized cancer, thus cytoreductive nephrectomy in metastatic disease is also eligible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31294132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6607078/") Annotation(rdfs:comment "SUPER-RCC 796 SUPER-RCC-Nx March 10, 2016 762") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31294132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6607078/") Annotation(rdfs:comment "SUPER-RCC SUPER-RCC-Nx Clinically diagnosed as renal cell carcinoma patients who undergo surgical treatment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31294132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6607078/fullTextXML") Annotation(rdfs:comment "Collected samples are divided in microvials and stored in a −80℃ deep freezer or −195℃ liquid nitrogen container according to the sample type at the Seoul National University Hospital Human Biobank.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31294132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6607078/fullTextXML") Annotation(rdfs:comment "It includes ablation, partial or radical nephrectomy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001418> (<http://www.ebi.ac.uk/coho/COHO_0001418>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40649094") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40649094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12250419/") Annotation(rdfs:comment "All participants had at least one measurement of the abdominal aortic diameter, either by computed tomography scan (CT scan) or by ultrasound along with anthropometric and clinical information, and blood samples for most follow-up visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001418> "A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40649094") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40649094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12250419/") Annotation(rdfs:comment "Here, we present the Triple-A Barcelona Study (TABS), the first large Spanish prospective hospital-based longitudinal study enrolling consecutive individuals with AAAs treated in two public hospitals in Barcelona") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001418> "A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40649094") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40649094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12250419/") Annotation(rdfs:comment "In this direction, the TABS cohort, with available DNA and RNA data, along with plasma samples collected in longitudinal patient visits, constitutes a powerful resource to move towards a promising improvement in growth prediction, becoming one step closer to precision medicine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001418> "A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40649094") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40649094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC12250419/unicode") Annotation(rdfs:comment "All individuals identified incidentally with AAAs, defined as those with dilation in the infrarenal abdominal aorta with a diameter greater than 30 mm that visited the Vascular and Endovascular Surgery Units of Hospital de la Santa Creu i Sant Pau and Hospital del Mar (Barcelona, Spain) from 2019 to March 2025 were invited to participate in the project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001418> "A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40649094") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40649094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC12250419/unicode") Annotation(rdfs:comment "which aims to provide a global description of growth rates per intervals of AAA diameter size, to pinpoint possible comorbidities associated with the growth rate in individuals in the Spanish population, and to assess optimal surveillance intervals for practitioners.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001418> "A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001419> (<http://www.ebi.ac.uk/coho/COHO_0001419>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "The APCAT Consortium includes 21,858 European‐ancestry subjects (2,055 physician‐diagnosed asthmatics and 19,803 asthma‐free controls) with available genome‐wide data that participated in seven population based‐studies") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "The CARe consortium datasets which contributed to TAGC included African‐American participants from four population‐based studies") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "The GABRIEL Consortium includes 19 studies that contributed to TAGC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5901974/") Annotation(rdfs:comment "To generate larger sample sizes for GWAS meta-analysis of asthma enabling the discovery of common novel risk loci, we established the Trans-National Asthma Genetic Consortium (TAGC) across worldwide groups of investigators with genome-wide data available in >142,000 individuals of diverse ancestries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5901974/") Annotation(rdfs:comment "We combined data from asthma GWAS with high-density genotyped and imputed SNP data (2.83 million SNPs) in the following populations: European-ancestry (19,954 cases, 107,715 controls), African-ancestry (2,149 cases, 6,055 controls), Japanese (1,239 cases, 3,976 controls) and Latino (606 cases, 792 controls) (Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5901974/unicode") Annotation(rdfs:comment "Because childhood-onset asthma may be distinct from later-onset asthma and may represent a more homogeneous subgroup, we also performed analyses on the pediatric subgroup (asthma onset ≤16 years; 8,976 cases, 18,399 controls).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001420> (<http://www.ebi.ac.uk/coho/COHO_0001420>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33045403") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33045403+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Already recruiting subjects at secondary/tertiary care centres across Europe, the Registry is supporting the European Union IMI2-funded LITMUS 'Liver Investigation: Testing Marker Utility in Steatohepatitis' consortium, which is a major international effort to robustly validate biomarkers that diagnose, risk stratify and/or monitor NAFLD progression and liver fibrosis stage.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33045403") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33045403+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The European NAFLD Registry is an international, prospectively recruited observational cohort study that aims to establish a large, highly-phenotyped patient cohort and linked bioresource.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35654975") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01078-z/MediaObjects/41588_2022_1078_MOESM1_ESM.pdf") Annotation(rdfs:comment "The EPoS genetics study and the European NAFLD Registry have been supported by the EPoS (Elucidating Pathways of Steatohepatitis) consortium funded by the European Union Horizon 2020 Framework Program of the European Union under Grant Agreement 634413, the FLIP (Fatty Liver: Inhibition of Progression) consortium") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36958367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36958367+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This was a comparative diagnostic accuracy study in people with biopsy-confirmed NAFLD from 13 countries across Europe, recruited between Jan 6, 2010, and Dec 29, 2017, from the LITMUS metacohort of the prospective European NAFLD Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38421999") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10903803/fullTextXML") Annotation(rdfs:comment "Progress with similar models may be possible with the more complete prospective LITMUS Study Cohort [12].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38421999") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10903803/fullTextXML") Annotation(rdfs:comment "The Metacohort enrolled subjects from sites in Belgium, Finland, France, Germany, Italy, the Netherlands, Spain, Sweden, Switzerland, and the UK between Jan 6, 2010, and Dec 29, 2017.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001421> (<http://www.ebi.ac.uk/coho/COHO_0001421>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16248404") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16248404+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We have established a brain bank for the prevention and treatment of aging-related movement and cognitive disturbances, as a joint project between a rural care hospital and a research institute.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26091809") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4473839/") Annotation(rdfs:comment "From February 2008 to July 2012, we obtained the 286 consecutive autopsy brains (165 men and 121 women) used for this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26091809") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4473839/") Annotation(rdfs:comment "The brain samples used in this study were registered to the Brain Bank for Aging Research (BBAR) with the deceased’s relatives’ informed consent to carry out comprehensive research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33150517") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7785549/fullTextXML") Annotation(rdfs:comment "Information including age, sex, presence or absence of autonomic failures (such as severe constipation, orthostatic hypotension, or urinary dysfunction), Parkinsonism, and dementia was obtained from the BBAR database and extracted from medical records by neurologists.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33150517") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7785549/fullTextXML") Annotation(rdfs:comment "TMGHIG is located in urban Tokyo and provides community-based general and emergency services to the older (+ 65 years) population, including patients with dementia or neurodegenerative diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33150517") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7785549/fullTextXML") Annotation(rdfs:comment "Tissue samples were obtained from autopsy cases that took place at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology (TMGHIG).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001422> (<http://www.ebi.ac.uk/coho/COHO_0001422>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34013049") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42026177") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34013049") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8098929/") Annotation(rdfs:comment "Biobank participants with a diagnosis of nAMD, DMO or RVO and receiving anti-VEGF therapy between 2013 and 2019 in public or private eye clinics in Tasmania were included.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001422> "A biobank of the Menzies Institute for Medical Research at the University of Tasmania, run with the Royal Hobart Hospital and associated public and private eye clinics in Tasmania, Australia, that collects DNA samples and clinical information from Tasmanian residents diagnosed with a range of eye diseases, and from adults without eye disease recruited from the community as controls, to investigate eye disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34013049") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42026177") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34013049") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8098929/") Annotation(rdfs:comment "The Biobank is an initiative of the Menzies Institute for Medical Research, University of Tasmania, and associated clinics that aims to collect DNA samples and clinical information from Tasmanian residents diagnosed with a variety of ocular conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001422> "A biobank of the Menzies Institute for Medical Research at the University of Tasmania, run with the Royal Hobart Hospital and associated public and private eye clinics in Tasmania, Australia, that collects DNA samples and clinical information from Tasmanian residents diagnosed with a range of eye diseases, and from adults without eye disease recruited from the community as controls, to investigate eye disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34013049") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42026177") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42026177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13341751/fullTextXML") Annotation(rdfs:comment "All TOB participants were aged 18 years and over, had no signs of ocular disease, and self-reported British, Scottish, or Irish ancestry") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001422> "A biobank of the Menzies Institute for Medical Research at the University of Tasmania, run with the Royal Hobart Hospital and associated public and private eye clinics in Tasmania, Australia, that collects DNA samples and clinical information from Tasmanian residents diagnosed with a range of eye diseases, and from adults without eye disease recruited from the community as controls, to investigate eye disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34013049") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42026177") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42026177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13341751/fullTextXML") Annotation(rdfs:comment "Participants were recruited to TOB via local newspapers, local community centres and independent living centres between January and February 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001422> "A biobank of the Menzies Institute for Medical Research at the University of Tasmania, run with the Royal Hobart Hospital and associated public and private eye clinics in Tasmania, Australia, that collects DNA samples and clinical information from Tasmanian residents diagnosed with a range of eye diseases, and from adults without eye disease recruited from the community as controls, to investigate eye disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34013049") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42026177") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42026177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13341751/fullTextXML") Annotation(rdfs:comment "The Tasmanian Ophthalmic Biobank (TOB) is an initiative between the Royal Hobart Hospital and the University of Tasmania, set up to investigate eye disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001422> "A biobank of the Menzies Institute for Medical Research at the University of Tasmania, run with the Royal Hobart Hospital and associated public and private eye clinics in Tasmania, Australia, that collects DNA samples and clinical information from Tasmanian residents diagnosed with a range of eye diseases, and from adults without eye disease recruited from the community as controls, to investigate eye disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001423> (<http://www.ebi.ac.uk/coho/COHO_0001423>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27923400") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5139013/fullTextXML") Annotation(rdfs:comment "DNA was isolated from whole blood using standard methods.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27923400") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5139013/fullTextXML") Annotation(rdfs:comment "LV samples were obtained during placement of the LV vent in 76 Caucasian patients undergoing aortic valve replacement for aortic stenosis with or without concomitant coronary artery bypass grafting.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28687077") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5501278/") Annotation(rdfs:comment "Punch biopsies (~3–5 μg total RNA content) were obtained intra-operatively from the site of a routinely placed surgical vent in the anterolateral apical left ventricle at the initiation of cardiopulmonary bypass (CPB) and again after an average of 81.73 ± 27.89 min of aortic cross clamp time.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicaltrials.gov/api/v2/studies/NCT00985049?format=csv") Annotation(rdfs:comment "Brigham and Women's Hospital, Boston, Massachusetts, 02115, United States") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicaltrials.gov/api/v2/studies/NCT00985049?format=csv") Annotation(rdfs:comment "Hypothesis: The investigators hypothesize that genetic variants will alter gene expression in response to ischemia during cardiopulmonary bypass.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicaltrials.gov/api/v2/studies/NCT00985049?format=csv") Annotation(rdfs:comment "OBSERVATIONAL,Observational Model: COHORT | Time Perspective: PROSPECTIVE,2007p002323|R01HL118266,2009-03") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001424> (<http://www.ebi.ac.uk/coho/COHO_0001424>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34315208") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8490197/fullTextXML") Annotation(rdfs:comment "Eighty percent of the participants resided within Trondheim or within 50 miles.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34315208") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8490197/fullTextXML") Annotation(rdfs:comment "In this population-based observational PD study, we report follow-up data from more than 20 years on two key irreversible milestones: cognitive impairment and death.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34315208") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8490197/fullTextXML") Annotation(rdfs:comment "Since 1997, we have prospectively collected data on baseline PD characteristics in sequential new referrals, over the age of 22 years, to the Department of Neurology at St. Olav’s Hospital in Trondheim.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34315208") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8490197/fullTextXML") Annotation(rdfs:comment "The main cause for establishing this cohort was to conduct genetic studies in PD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38849413") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML") Annotation(rdfs:comment "Patients were followed from 1997 onwards, with some having been followed since 1980.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38849413") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML") Annotation(rdfs:comment "The Trondheim PD cohort is a prospective longitudinal study of PD patients at the Department of Neurology at St. Olav’s Hospital in Trondheim, Norway") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001425> (<http://www.ebi.ac.uk/coho/COHO_0001425>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32453789") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24647736") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4284402/supplementaryFiles") Annotation(rdfs:comment "In this Biobank, more than 3300 healthy controls were recruited via a stratified, 3-staged probability clustering sampling scheme through the registry of all the 329 non-aboriginal townships or city districts in Taiwan [15].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001425> "A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32453789") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24647736") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4284402/supplementaryFiles") Annotation(rdfs:comment "Taiwan Super Control Study (TWSC) included 1000 randomly selected individuals, of which genetic data were extracted from the Han-Chinese Cell and Genome Bank in Taiwan [14].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001425> "A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32453789") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24647736") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4284402/supplementaryFiles") Annotation(rdfs:comment "The TWSC study was supported by the Academia Sinica Genomic Medicine Multicenter Study, Taiwan") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001425> "A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32453789") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32453789") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7274451/fullTextXML") Annotation(rdfs:comment "SNPs were genotyped using Illumina Hap550duo chip with call rate ≥ 95%.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001425> "A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32453789") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3405/MediaObjects/41588_2015_BFng3405_MOESM35_ESM.pdf") Annotation(rdfs:comment "Control participants of the Taiwan Super Control Study (Taiwan) who took part in the current analysis included 1,000 randomly selected individuals whose genetic data were extracted from the Han‐Chinese Cell and Genome Bank in Taiwan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001425> "A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001426> (<http://www.ebi.ac.uk/coho/COHO_0001426>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19589173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41663009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19589173") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2715397") Annotation(rdfs:comment "The TZL study was initiated by Fudan University and the Taizhou government in 2007") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001426> "A population-based prospective cohort of adults from urban and rural areas of Taizhou, Jiangsu Province, China, initiated in 2007 by Fudan University and the Taizhou government, with baseline interviews, physical examinations, biochemical assays and collection of blood and other biospecimens, and follow-up through health records and repeated assessments, to study environmental and genetic risk factors for common non-communicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19589173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41663009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19589173") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2715397/") Annotation(rdfs:comment "We initiated a large prospective cohort–the Taizhou Longitudinal Study–in Taizhou (a medium-size city in China) to explore the environmental and genetic risk factors for common non-communicable diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001426> "A population-based prospective cohort of adults from urban and rural areas of Taizhou, Jiangsu Province, China, initiated in 2007 by Fudan University and the Taizhou government, with baseline interviews, physical examinations, biochemical assays and collection of blood and other biospecimens, and follow-up through health records and repeated assessments, to study environmental and genetic risk factors for common non-communicable diseases.")
