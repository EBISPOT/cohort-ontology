AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007321") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40550869") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12185716/fullTextXML") Annotation(rdfs:comment "In the Radar cohort, 77 out of 110 children were born to soldiers with a dose estimation of 0 mGy, 30 to soldiers with a valid exposure estimation > 0 mGy and for the father of 3 offspring, the dose estimation could not be made.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000326> "A cohort of 110 children from 70 families whose fathers were radar technicians with potential exposure to ionizing radiation, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007321") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40550869") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12185716/fullTextXML") Annotation(rdfs:comment "We recruited 110 offspring of former German radar operators, who were likely to have been exposed to IR (Radar cohort, exposure = 0–353 mGy)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000326> "A cohort of 110 children from 70 families whose fathers were radar technicians with potential exposure to ionizing radiation, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007321") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007321") Annotation(rdfs:comment "This dataset contains whole genome sequences from Illumina NovaSeq Devices sequenced at the WGGC Bonn to study effects of prolonged paternal exposure to ionizing radiation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000326> "A cohort of 110 children from 70 families whose fathers were radar technicians with potential exposure to ionizing radiation, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007321") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007321") Annotation(rdfs:comment "Transgenerational signatures of ionizing radiation exposure are primarily implicated to be clustered de-novo mutations (cDNMs, multiple de-novo mutations within 20bp).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000326> "A cohort of 110 children from 70 families whose fathers were radar technicians with potential exposure to ionizing radiation, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007321") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007321") Annotation(rdfs:comment "We sequenced the whole genome of 110 children from 70 families (Radar cohort).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000326> "A cohort of 110 children from 70 families whose fathers were radar technicians with potential exposure to ionizing radiation, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.")

