AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35927272") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35927272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9158790/fullTextXML") Annotation(rdfs:comment "Seven aspects of healthy ageing in the SCHS was assessed by home visits at the third follow-up interview conducted between 2014 and 2016, and among participants who had survival to at least 65 years of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000659> "A population-based prospective cohort of 63,257 Chinese adults aged 45–74 years from the Hokkien and Cantonese dialect groups living in Singapore, recruited from April 1993 to December 1998 and followed with repeated interviews, to study diet, lifestyle, genetic factors and chronic disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35927272") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35927272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9158790/fullTextXML") Annotation(rdfs:comment "The Singapore Chinese Health Study (SCHS) is a population-based prospective cohort study of Chinese adults living in Singapore9.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000659> "A population-based prospective cohort of 63,257 Chinese adults aged 45–74 years from the Hokkien and Cantonese dialect groups living in Singapore, recruited from April 1993 to December 1998 and followed with repeated interviews, to study diet, lifestyle, genetic factors and chronic disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35927272") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35927272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9158790/fullTextXML") Annotation(rdfs:comment "The subjects belonged to two major Chinese dialect groups in Singapore (the Hokkien and the Cantonese).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000659> "A population-based prospective cohort of 63,257 Chinese adults aged 45–74 years from the Hokkien and Cantonese dialect groups living in Singapore, recruited from April 1993 to December 1998 and followed with repeated interviews, to study diet, lifestyle, genetic factors and chronic disease and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000660> (<http://www.ebi.ac.uk/coho/COHO_0000660>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29373861") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5963586/fullTextXML") Annotation(rdfs:comment "By collecting data on a wide range of potential risk factors, including commonly studied and novel exposures, along with environmental and biological samples, we hoped to create a framework from which to think more broadly about environmental causes and gene–environment interactions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29373861") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5963586/fullTextXML") Annotation(rdfs:comment "Extensive exposure data over the life-course and baseline specimens provide important opportunities for studying breast cancer and other health outcomes in women.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29373861") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5963586/fullTextXML") Annotation(rdfs:comment "The Sister Study is a long-term prospective cohort of women residing in the United States (including Puerto Rico) who have had a sister diagnosed with breast cancer but did not have breast cancer themselves at enrollment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29373861") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5963586/fullTextXML") Annotation(rdfs:comment "Women residing in the United States, including Puerto Rico, were eligible for the Sister Study if they were 35–74y of age, had a sister (full or half) diagnosed with primary breast cancer, and had not themselves ever had a diagnosis of ductal carcinoma in situ (DCIS) or invasive breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29373861") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5963586/fullTextXML") Annotation(rdfs:comment "Women were recruited in a “Vanguard” run-in phase in selected cities (Phoenix, AZ, Providence, RI, Tampa, FL, and St. Louis, MO) beginning in July 2003.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37611509") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10592043/unicode") Annotation(rdfs:comment "The Sister Study is an ongoing nationwide cohort established by NIEHS scientists to investigate environmental and genetic risk factors for breast cancer and other chronic diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")

