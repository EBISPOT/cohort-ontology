AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28416818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31113362") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32078373") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32814717") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(rdfs:comment "the Atrial Fibrillation Biobank LMU (AFLMU) in the context of the Arrhythmia-Biobank-LMU (formerly known as AFNET)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001476> "A biobank and ongoing prospective registry of patients with atrial fibrillation from the arrhythmia clinic of the Department of Medicine I, University Hospital Munich, Ludwig-Maximilians-University, Germany, established within the Arrhythmia-Biobank-LMU with support from the German Federal Ministry of Education and Research, which collects blood samples and clinical data and follows patients for recurrence of atrial fibrillation after rhythm-control interventions such as catheter ablation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001477> (<http://www.ebi.ac.uk/coho/COHO_0001477>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34473249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37264683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40737012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01288352") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34473249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8982435/fullTextXML") Annotation(rdfs:comment "Between July 2011 and December 2016, 135 sites in 11 countries randomized 2789 patients to the EAST-AFNET 4 trial.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001477> "An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34473249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37264683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40737012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01288352") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37264683") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10405565/fullTextXML") Annotation(rdfs:comment "Patients with recently diagnosed AF (<1 year) and cardiovascular risk factors were randomized to early rhythm control or usual care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001477> "An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.")
