AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "The cases (n = 190) were probands of type 2 diabetic pedigrees with fasting plasma glucose ≥ 7.0 mmol/L and/or 2-h post plasma glucose ≥ 11.1 mmol/L and diagnosed before 40 years old.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002385> "A study of type 2 diabetes and glucose metabolism in Han Chinese run from the Shanghai Diabetes Institute of Shanghai Jiao Tong University. Its participants, probands of type 2 diabetes pedigrees diagnosed before age 40 with normoglycaemic controls over 50 without a family history of diabetes recruited at the institute, and people with normal glucose tolerance drawn from the community-based Shanghai Diabetes Study I and II, were genotyped for East Asian genome-wide association studies of type 2 diabetes and fasting glucose.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "The controls (n = 198) were subjects with normal glucose regulation with fasting plasma glucose <6.1 mmol/L and 2-h plasma glucose < 7.8 mmol/L as assessed by standard 75g OGTTs, negative diabetic family history and aged over 50 years old.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002385> "A study of type 2 diabetes and glucose metabolism in Han Chinese run from the Shanghai Diabetes Institute of Shanghai Jiao Tong University. Its participants, probands of type 2 diabetes pedigrees diagnosed before age 40 with normoglycaemic controls over 50 without a family history of diabetes recruited at the institute, and people with normal glucose tolerance drawn from the community-based Shanghai Diabetes Study I and II, were genotyped for East Asian genome-wide association studies of type 2 diabetes and fasting glucose.")
