AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007409") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://cordis.europa.eu/project/id/848196/reporting") Annotation(rdfs:comment "Since January 2020, the DIAMONDS consortium has recruited over 13000 patients and 2000 control subjects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000241> "A cohort of children and adults with febrile illness, including multisystem inflammatory syndrome in children, Kawasaki disease and bacterial and viral infections, recruited prospectively at hospitals in the United Kingdom and the European Union by the DIAMONDS consortium to develop blood transcriptomic diagnostic signatures.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007409") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://cordis.europa.eu/project/id/848196/reporting") Annotation(rdfs:comment "Using samples from carefully phenotyped patients, DIAMONDS has undertaken RNA-Seq and bioinformatic analyses to identify the RNA profile of common infectious and inflammatory diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000241> "A cohort of children and adults with febrile illness, including multisystem inflammatory syndrome in children, Kawasaki disease and bacterial and viral infections, recruited prospectively at hospitals in the United Kingdom and the European Union by the DIAMONDS consortium to develop blood transcriptomic diagnostic signatures.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007409") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007409") Annotation(rdfs:comment "Children presenting with MIS-C to participating hospitals in the United Kingdom and the European Union between April 2020-April 2021 were prospectively recruited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000241> "A cohort of children and adults with febrile illness, including multisystem inflammatory syndrome in children, Kawasaki disease and bacterial and viral infections, recruited prospectively at hospitals in the United Kingdom and the European Union by the DIAMONDS consortium to develop blood transcriptomic diagnostic signatures.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007409") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007409") Annotation(rdfs:comment "To identify a diagnostic blood transcriptomic signature that distinguishes multisystem inflammatory syndrome in children (MIS-C) from Kawasaki Disease (KD), bacterial infections and viral infections.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000241> "A cohort of children and adults with febrile illness, including multisystem inflammatory syndrome in children, Kawasaki disease and bacterial and viral infections, recruited prospectively at hospitals in the United Kingdom and the European Union by the DIAMONDS consortium to develop blood transcriptomic diagnostic signatures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000242> (<http://www.ebi.ac.uk/coho/COHO_0000242>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35988656") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35988656+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Matched tumor and control genome/exome and RNA sequencing was carried out for 1485 patients with rare cancers (79%) and/or young adults (77% younger than 51 years) in the National Center for Tumor Diseases/German Cancer Consortium (NCT/DKTK) Molecularly Aided Stratification for Tumor Eradication Research (MASTER) trial, a German multicenter, prospective, observational precision oncology study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000242> "A prospective observational precision oncology cohort of the German Cancer Consortium that enrols adults with advanced cancer who are younger than 51 and patients with rare tumours regardless of age, and uses whole-genome or exome and transcriptome sequencing to inform their care.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005836") Annotation(rdfs:comment "We analyzed the molecular profiles and clinical outcomes of pazopanib-treated sarcoma patients enrolled in a prospective observational study by the German Cancer Consortium, DKTK MASTER, that employs whole-genome/exome sequencing (WGS/WES) and transcriptome sequencing to inform the care of adults with advanced cancer across histologies who are younger than 51 and patients with rare tumors, including rare subtypes of more common entities, regardless of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000242> "A prospective observational precision oncology cohort of the German Cancer Consortium that enrols adults with advanced cancer who are younger than 51 and patients with rare tumours regardless of age, and uses whole-genome or exome and transcriptome sequencing to inform their care.")

