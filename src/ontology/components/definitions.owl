AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23754956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(rdfs:comment "Health2006 was also conducted at the Research Centre for Prevention and Health in Glostrup, Denmark.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000913> "A population-based cohort of 3,471 adults aged 18–69, randomly sampled from the Danish Central Personal Register in the southern part of Copenhagen and examined in 2006–2008 at the Research Centre for Prevention and Health in Glostrup, Denmark, to study general health, allergy, diabetes and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(rdfs:comment "A sample of 7,931 persons 18–69 years of age was invited to a general health examination in the Health2006 study (14).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000913> "A population-based cohort of 3,471 adults aged 18–69, randomly sampled from the Danish Central Personal Register in the southern part of Copenhagen and examined in 2006–2008 at the Research Centre for Prevention and Health in Glostrup, Denmark, to study general health, allergy, diabetes and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(rdfs:comment "A total of 3,471 (43.8%) persons were examined from 2006–2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000913> "A population-based cohort of 3,471 adults aged 18–69, randomly sampled from the Danish Central Personal Register in the southern part of Copenhagen and examined in 2006–2008 at the Research Centre for Prevention and Health in Glostrup, Denmark, to study general health, allergy, diabetes and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(rdfs:comment "They were recruited from the Danish Central Personal Register as random samples of the population in the southern part of Copenhagen and included questionnaires, physical examinations, and blood tests as previously described in detail [9,10].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000913> "A population-based cohort of 3,471 adults aged 18–69, randomly sampled from the Danish Central Personal Register in the southern part of Copenhagen and examined in 2006–2008 at the Research Centre for Prevention and Health in Glostrup, Denmark, to study general health, allergy, diabetes and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000914> (<http://www.ebi.ac.uk/coho/COHO_0000914>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33590662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33590662") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33590662+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "At follow-up, 3268 HeiDE participants (post-QC) were genotyped on single nucleotide polymorphism (SNP) arrays.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000914> "A longitudinal population-based study of 5,133 adults from the German city of Heidelberg and its surroundings, started in the 1990s with a baseline battery of health-related personality questionnaires to characterise associations between personality and somatic disease, and later followed up and genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33590662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33590662") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33590662+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "HeiDE is a longitudinal population-based study that started in the 1990s and, at baseline, assessed an array of health-related personality questionnaires in 5133 individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000914> "A longitudinal population-based study of 5,133 adults from the German city of Heidelberg and its surroundings, started in the 1990s with a baseline battery of health-related personality questionnaires to characterise associations between personality and somatic disease, and later followed up and genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33590662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34659794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(rdfs:comment "Briefly, HeiDE (‘Heidelberger Langzeitstudie zu Risikofaktoren und Diagnose chronischer Erkrankungen’) is a population-based study carried out in the German city of Heidelberg and surrounding area with an initial aim of characterising associations of personality and somatic disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000914> "A longitudinal population-based study of 5,133 adults from the German city of Heidelberg and its surroundings, started in the 1990s with a baseline battery of health-related personality questionnaires to characterise associations between personality and somatic disease, and later followed up and genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33590662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34659794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(rdfs:comment "Data analysed in this study were collected during the baseline assessment (personality traits; 1992 to 1994) and the first follow-up (DNA for genotyping; on average 8.5 years after baseline).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000914> "A longitudinal population-based study of 5,133 adults from the German city of Heidelberg and its surroundings, started in the 1990s with a baseline battery of health-related personality questionnaires to characterise associations between personality and somatic disease, and later followed up and genotyped.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000915> (<http://www.ebi.ac.uk/coho/COHO_0000915>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34480422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8712846/fullTextXML") Annotation(rdfs:comment "At present, HERMES is a collection of 51 studies that have derived genome‐wide genotyping data from community‐based participants or hospitalized patients with clinical HF, including longitudinal population‐based cohort studies, hospital‐based electronic health record cohorts, case–control studies, and clinical trials.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34480422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8712846/fullTextXML") Annotation(rdfs:comment "Subsequent studies will address HF subtypes, including established and novel aetiological and cardiac morpho‐functional phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34480422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8712846/fullTextXML") Annotation(rdfs:comment "The core objective of the HERMES consortium is to conduct large‐scale genetic association studies of HF and related phenotypes in order to identify common and low‐frequency genetic variants associated with HF risk and prognosis (Figure 2 ).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34480422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34480422+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "HERMES is a global collaboration aiming to (i) identify the genetic determinants of heart failure; (ii) generate insights into the causal pathways leading to heart failure and enable genetic approaches to target prioritization; and (iii) develop genomic tools for disease stratification and risk prediction.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34480422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34480422+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The consortium currently includes 51 studies from 11 countries, including 68 157 heart failure cases and 949 888 controls, with data on heart failure events and prognosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000916> (<http://www.ebi.ac.uk/coho/COHO_0000916>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35446358") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC9026225/") Annotation(rdfs:comment "We obtained the summary statistics of the latest CCT GWAS meta-analysis26 conducted by the International Glaucoma Genetics Consortium (IGGC) (17 803 European and 8107 Asian participants).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37386247") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10335935/fullTextXML") Annotation(rdfs:comment "In the multiancestry analysis, we included POAG GWAS results from the Asian ancestry population (IGGC, 6,935 cases and 39,588 controls) and the African ancestry population (IGGC, 3,281 cases and 2,791 controls)6.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37386247") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10335935/fullTextXML") Annotation(rdfs:comment "The IGGC is a large international consortium established to identify glaucoma genetic risk genes through large-scale meta-analysis43,44.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37386247") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10335935/fullTextXML") Annotation(rdfs:comment "The values of mean chi-square were 1.55 and 1.18 in the current MTAG POAG GWAS and the previous largest POAG GWAS from the International Glaucoma Genetic Consortium (IGGC) (with 16,677 POAG cases and 199,580 controls), respectively, indicating that we have tripled the effective sample size for POAG6,7.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37386247") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10335935/fullTextXML") Annotation(rdfs:comment "We also included GWAS results for VCDR (n = 25,180) and IOP (n = 31,269) of European descent43,44.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000917> (<http://www.ebi.ac.uk/coho/COHO_0000917>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21051598") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21051598") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3235490/") Annotation(rdfs:comment "To define host genetic effects on the outcome of a chronic viral infection, we performed genome-wide association analysis in a multiethnic cohort of HIV-1 controllers and progressors, and we analyzed the effects of individual amino acids within the classical human leukocyte antigen (HLA) proteins.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000917> "A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21051598") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21051598") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3235490/") Annotation(rdfs:comment "To determine the genetic basis for this rare phenomenon, we established a multinational consortium (www.hivcontrollers.org) to recruit HIV-1 controllers, who are defined by at least three measurements of plasma virus load (VL) < 2000 RNA copies/ml over at least a 12-month period in the absence of antiviral therapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000917> "A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000918> (<http://www.ebi.ac.uk/coho/COHO_0000918>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4657484/fullTextXML") Annotation(rdfs:comment "Current projects include an incidence cohort (EIMS), post-marketing cohorts of patients on novel disease-modifying drugs (IMSE), and a prevalence cohort (GEMS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000918> "A set of Swedish post-marketing (phase IV) cohorts of patients with multiple sclerosis treated with novel disease-modifying drugs, followed through the Swedish MS registry to monitor the long-term safety and risks of immunomodulatory treatments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4657484/fullTextXML") Annotation(rdfs:comment "Since the launch of Tysabri®(natalizumab, Biogen, Cambridge, MA, USA) in 2006, Swedish MS patients prescribed newly licensed DMDs have been asked to participate in an open-label follow-up study in which the SMSreg has served as an electronic clinical report form.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000918> "A set of Swedish post-marketing (phase IV) cohorts of patients with multiple sclerosis treated with novel disease-modifying drugs, followed through the Swedish MS registry to monitor the long-term safety and risks of immunomodulatory treatments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38630618") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11449136/fullTextXML") Annotation(rdfs:comment "IMSE is an ongoing phase IV clinical trial that monitors long-term safety and risk of immunomodulatory treatments for MS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000918> "A set of Swedish post-marketing (phase IV) cohorts of patients with multiple sclerosis treated with novel disease-modifying drugs, followed through the Swedish MS registry to monitor the long-term safety and risks of immunomodulatory treatments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000919> (<http://www.ebi.ac.uk/coho/COHO_0000919>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31815703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7029327/fullTextXML") Annotation(rdfs:comment "Most recently, the IPDGC has expanded to initiate major research efforts in East Asia and Africa, and has prioritized collaborations with ongoing major efforts in India and South America.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31815703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7029327/fullTextXML") Annotation(rdfs:comment "The IPDGC has grown considerably since its inception, including over 100 scientists from around the World.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31815703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7029327/fullTextXML") Annotation(rdfs:comment "The International Parkinson Disease Genomics Consortium (IPDGC) is a group of highly collaborative researchers focused on understanding the basis of Parkinson disease (PD) and related disorders including Lewy body diseases, progressive supranuclear palsy, and multiple system atrophy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31815703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7029327/fullTextXML") Annotation(rdfs:comment "The focus has also grown, to include clinical and functional investigation of PD at scale.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31815703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7029327/fullTextXML") Annotation(rdfs:comment "The initial formation of the IPDGC, in 2009, was borne out of a realization that no single investigator could deliver on the promise of modern human genetics in isolation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31815703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7029327/fullTextXML") Annotation(rdfs:comment "Using as a basis the large IPDGC genetic datasets (currently including over 20,000 cases and 20,000 controls) multiple advanced analyses are performed to predict disease, assign more “function” or biology to GWAS loci and identifying potential disease relevant pathways.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000920> (<http://www.ebi.ac.uk/coho/COHO_0000920>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855068") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25855068") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25855068+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Japan Pharmacogenomics Data Science Consortium (JPDSC) has assembled a database for conducting pharmacogenomics (PGx) studies in Japanese subjects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000920> "A collection of 2994 healthy Japanese volunteers assembled by the Japan Pharmacogenomics Data Science Consortium, with genotypes of 2.5 million SNPs and 5 HLA loci and 121 kinds of clinical information, as control data for pharmacogenomics studies of drug safety and efficacy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855068") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25855068") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25855068+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The JPDSC database will be useful as control data for conducting PGx studies to explore genetic markers to improve the safety and efficacy of drugs either during clinical development or in post-marketing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000920> "A collection of 2994 healthy Japanese volunteers assembled by the Japan Pharmacogenomics Data Science Consortium, with genotypes of 2.5 million SNPs and 5 HLA loci and 121 kinds of clinical information, as control data for pharmacogenomics studies of drug safety and efficacy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855068") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25855068") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25855068+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The database contains the genotypes of 2.5 million single-nucleotide polymorphisms (SNPs) and 5 human leukocyte antigen loci from 2994 Japanese healthy volunteers, as well as 121 kinds of clinical information, including self-reports, physiological data, hematological data and biochemical data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000920> "A collection of 2994 healthy Japanese volunteers assembled by the Japan Pharmacogenomics Data Science Consortium, with genotypes of 2.5 million SNPs and 5 HLA loci and 121 kinds of clinical information, as control data for pharmacogenomics studies of drug safety and efficacy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000921> (<http://www.ebi.ac.uk/coho/COHO_0000921>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32799709") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32799709") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7660788/fullTextXML") Annotation(rdfs:comment "In brief, JUPITER was a randomized, double‐blind, placebo‐controlled trial of rosuvastatin 20 mg daily versus placebo in the primary prevention of CVD in 17 802 asymptomatic men ≥50 years and women ≥60 years") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000921> "A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32799709") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32799709") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7660788/fullTextXML") Annotation(rdfs:comment "Potential limitations include a relatively short median follow‐up period of 1.9 years as JUPITER was terminated early after proven efficacy of rosuvastatin to reduce incident CVD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000921> "A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32799709") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32799709") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7660788/fullTextXML") Annotation(rdfs:comment "The parent JUPITER trial was funded by AstraZeneca, which had no role in this current study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000921> "A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32799709") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32799709") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7660788/fullTextXML") Annotation(rdfs:comment "with low‐density lipoprotein cholesterol (LDL‐C) <130 mg/dL and hsCRP (high‐sensitivity C‐reactive protein) ≥2.0 mg/L who were monitored for a median follow‐up period of 1.9 years (maximum 5 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000921> "A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000922> (<http://www.ebi.ac.uk/coho/COHO_0000922>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16343090") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16343090+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "First, participants with 'conventional lifestyles' (n = 2343) were retrieved from an ongoing prospective cohort study (n = 7020) on pregnancy-related pelvic girdle pain.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16343090") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16343090+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In addition, pregnant women (n = 491) with 'alternative lifestyles' with regard to child rearing practices, dietary habits (organic, vegetarian), vaccination schemes and/or use of antibiotics, were recruited through organic food shops, anthroposophic doctors and midwives, Steiner schools, and dedicated magazines.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16343090") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16343090+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The aim of the KOALA Birth Cohort Study in the Netherlands is to identify factors that influence the clinical expression of atopic disease with a main focus on lifestyle (e.g., anthroposophy, vaccinations, antibiotics, dietary habits, breastfeeding and breast milk composition, intestinal microflora composition, infections during the first year of life, and gene-environment interaction).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16343090") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16343090+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The recruitment of pregnant women started in October 2000.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42116128") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13335302/fullTextXML") Annotation(rdfs:comment "Between 2000 and 2002, healthy pregnant women were included in the Koala Birth Cohort Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42116128") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13335302/fullTextXML") Annotation(rdfs:comment "Notably, the children from the KOALA Birth Cohort Study have now reached young adulthood, providing a unique opportunity to investigate how early-life FPPs may influence dietary intake and weight status later in life, with a 14-year follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000923> (<http://www.ebi.ac.uk/coho/COHO_0000923>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Cases lived in the six-state region that defines Mayo Clinic's primary service population (Minnesota, Iowa, Wisconsin, Illinois, North Dakota and South Dakota).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and controls without prior cancer other than nonmelanoma skin cancer, frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Consecutive cases were women aged 18 years or older with histologically confirmed primary invasive breast carcinoma who were recruited within 6 months of their date of diagnosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and controls without prior cancer other than nonmelanoma skin cancer, frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Control individuals without prior history of cancer (other than nonmelanoma skin cancer) were frequency matched on age (5-year age category), race and six-state region of residence to cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and controls without prior cancer other than nonmelanoma skin cancer, frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Controls were recruited from the outpatient practice of the Divisions of General Internal Medicine and Primary Care Internal Medicine at Mayo Clinic, where they were seen for routine medical examinations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and controls without prior cancer other than nonmelanoma skin cancer, frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "The Mayo Clinic Breast Cancer study (MCBCS) is an Institutional Review Board-approved, ongoing clinic-based case-control study initiated in February 2001 at Mayo Clinic, Rochester, MN, USA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and controls without prior cancer other than nonmelanoma skin cancer, frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000924> (<http://www.ebi.ac.uk/coho/COHO_0000924>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23152984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23152984") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML") Annotation(rdfs:comment "In this report, we examine the association of the acquisition parameters with mammographic density measures and their influence on the density and breast cancer association within a prospective cohort study from a single large breast practice, the Mayo Mammography Health Study (MMHS) Cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000924> "A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23152984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23152984") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML") Annotation(rdfs:comment "Of 38,883 eligible women, 19,924 provided written informed consented (51.2% adjusted response rate) (Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000924> "A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23152984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23152984") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML") Annotation(rdfs:comment "The MMHS prospectively enrolled patients scheduled for a screening mammogram from October 2003 through September 2006 at the Mayo Clinic in Rochester, MN.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000924> "A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23152984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23152984") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML") Annotation(rdfs:comment "Women were invited to take part if they were at least 35 years old, residents of Minnesota, Iowa, or Wisconsin (tri-state), and had no personal history of breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000924> "A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000925> (<http://www.ebi.ac.uk/coho/COHO_0000925>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11254450") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1275647/") Annotation(rdfs:comment "Moreover, erosion on the hand X-rays of at least one of the affected siblings in a family was a criterion for entry into the study; this was done in order to enhance confidence in the diagnosis of RA, as well as to provide a measure of disease severity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11254450") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1275647/") Annotation(rdfs:comment "These families were gathered by the North American Rheumatoid Arthritis Consortium (NARAC) for the first large multicenter study of RA multiplex families based in the United States (Gregersen 1998).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11254450") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11254450+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The North American Rheumatoid Arthritis Consortium, using well-defined clinical criteria, has collected 257 families containing 301 affected sibling pairs with RA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20453842") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4243840/") Annotation(rdfs:comment "CCP positive cases drawn from North American clinics and controls from the New York Cancer Project (together this collection is called NARAC-II)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.233/MediaObjects/41588_2008_BFng233_MOESM17_ESM.pdf") Annotation(rdfs:comment "The North American Rheumatoid Arthritis Consortium provided a third collection of samples that we used in Stage II replication (NARAC-III).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.233/MediaObjects/41588_2008_BFng233_MOESM17_ESM.pdf") Annotation(rdfs:comment "The North American Rheumatoid Arthritis Consortium provided an additional collection of samples that we used in Stage I replication (NARAC-II).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000926> (<http://www.ebi.ac.uk/coho/COHO_0000926>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24159511") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738708/fullTextXML") Annotation(rdfs:comment "NBK’s functions include securing and distributing population-based cohort biospecimens, planning of the KBP project, providing education for regional biobank staffs, handling public relations, and construction and running of BIMS and the KBP portal site (http://kbn.cdc.go.kr).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24159511") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738708/fullTextXML") Annotation(rdfs:comment "On April 26, 2012, the Korea National Institute of Health officially held the opening ceremony of newly dedicated biobank building, ‘NationalBiobank of Korea’.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24159511") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738708/fullTextXML") Annotation(rdfs:comment "The Korea Biobank Project, which was initiated in 2008, constructed the Korea Biobank Network consisting of the National Biobank of Korea (NBK) with 17 regional biobanks in Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24159511") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738708/fullTextXML") Annotation(rdfs:comment "The population-based human biospecimens come from population-based cohorts, separately run by the KNIH (Division of Epidemiology and Health Index, Division of Health and Nutrition Examination Survey),including the Korean Genome Epidemiology Study (KoGES), Korea National Health and Nutrition Examination Survey") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24159511") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738708/fullTextXML") Annotation(rdfs:comment "The stocked biospecimens and related information have been distributed for medical and public health researches.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39862296") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11842433/fullTextXML") Annotation(rdfs:comment "Furthermore, from the National Biobank of Korea (NBK) (https://biobank.nih.go.kr/cmm/main/engMainPage.do), we obtained genetic data from 803 patients with GC, including 394 with DGC and 409 with IGC, whose genotypes were sequenced using the Affy 6.0 platform.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000927> (<http://www.ebi.ac.uk/coho/COHO_0000927>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39899988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(rdfs:comment "The NSHDS includes three sub-cohorts: the Västerbotten Intervention Programme (VIP), the expanded Northern Sweden Monitoring of Trends and Determinants of Cardiovascular Disease (MONICA) Study, and the Mammography Screening Project (MSP).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39899988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(rdfs:comment "The NSHDS is a population-based prospective longitudinal cohort comprising >140 000 participants in the two northernmost regions in Sweden, Norrbotten and Västerbotten, with >240 000 blood samples and 1.5 million person-years of follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39899988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(rdfs:comment "The NSHDS was initiated with a cancer focus, to complement the cardiovascular disease focus of the VIP and MONICA cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39899988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(rdfs:comment "The Northern Sweden Health and Disease Study (NSHDS) was initiated in the mid-1980s.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39899988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(rdfs:comment "The Section of Biobank and Registry Support within the Department of Public Health and Clinical Medicine (Umeå University) is responsible for managing the NSHDS data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39899988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(rdfs:comment "To improve the cardiometabolic health of the population and to encourage research on aetiology, prevention and early detection of disease, the Västerbotten Intervention Programme (VIP), was initiated in 1985.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000928> (<http://www.ebi.ac.uk/coho/COHO_0000928>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15217505") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC468645/fullTextXML") Annotation(rdfs:comment "At all six sites, permission and assistance were sought from the proband to contact eligible relatives.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15217505") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC468645/fullTextXML") Annotation(rdfs:comment "Control probands were randomly sampled from the general population living in the relevant catchment area of each of the regional cancer registries, using random-digit dialing (San Francisco), lists of randomly selected residential telephone numbers (Ontario), and electoral rolls (Melbourne and Sydney).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "A 25% random sample of individuals in this age category who did not meet the OFBCR definition, 35% of those aged 55–69 at high risk and 8.75% aged 55–69 at low risk were also asked to participate.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "All women with invasive breast cancer aged 20–54 years who met the OFBCR definition for high genetic risk (family history of specific cancers particularly breast and ovarian, early onset disease, Ashkenazi ethnicity or a diagnosis of multiple breast cancer) were asked to participate by completing risk factor questionnaires and providing a blood sample.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Breast cancer cases diagnosed between 1 Jan 1996-31 Dec 1998 were identified from the Ontario Cancer Registry which registers >97% of all cases residing in the province at the time of diagnosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Individuals diagnosed in 2001 and 2002 were also included if they met high -risk criteria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000929> (<http://www.ebi.ac.uk/coho/COHO_0000929>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26151264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26151264") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26151264+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Randomized, double-blind trial (treatment period, 18 months; median follow-up, 24 months); 371 adult patients who had experienced a first episode of symptomatic unprovoked pulmonary embolism (ie, with no major risk factor for thrombosis) and had been treated initially for 6 uninterrupted months with a vitamin K antagonist were randomized") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000929> "A randomised, double-blind trial in which 371 adults with a first unprovoked pulmonary embolism, after six months of vitamin K antagonist treatment, were randomised to a further 18 months of warfarin or placebo and followed between 2007 and 2014 at 14 French centres, comparing recurrent venous thromboembolism and major bleeding.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26151264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26151264") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26151264+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The primary outcome was the composite of recurrent venous thromboembolism or major bleeding at 18 months after randomization.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000929> "A randomised, double-blind trial in which 371 adults with a first unprovoked pulmonary embolism, after six months of vitamin K antagonist treatment, were randomised to a further 18 months of warfarin or placebo and followed between 2007 and 2014 at 14 French centres, comparing recurrent venous thromboembolism and major bleeding.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26151264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26151264") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26151264+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To determine the benefits and harms of an additional 18-month treatment with warfarin vs placebo, after an initial 6-month nonrandomized treatment period on a vitamin K antagonist.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000929> "A randomised, double-blind trial in which 371 adults with a first unprovoked pulmonary embolism, after six months of vitamin K antagonist treatment, were randomised to a further 18 months of warfarin or placebo and followed between 2007 and 2014 at 14 French centres, comparing recurrent venous thromboembolism and major bleeding.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26151264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26151264") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26151264+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "were randomized and followed up between July 2007 and September 2014 in 14 French centers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000929> "A randomised, double-blind trial in which 371 adults with a first unprovoked pulmonary embolism, after six months of vitamin K antagonist treatment, were randomised to a further 18 months of warfarin or placebo and followed between 2007 and 2014 at 14 French centres, comparing recurrent venous thromboembolism and major bleeding.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000930> (<http://www.ebi.ac.uk/coho/COHO_0000930>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "PBCS cases were women aged 20-74 years with newly-diagnosed, pathologically-confirmed in situ or invasive breast carcinoma identified through a rapid identification system organized at five participating hospitals and via cancer registries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000930> "A population-based case-control study of breast cancer in Warsaw and Łódź, Poland, in 2000–2003, funded by the intramural programme of the US National Cancer Institute, in which cases were women aged 20–74 with newly diagnosed in situ or invasive breast cancer identified through a rapid identification system at participating hospitals and through cancer registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "The PBCS was funded by the Intramural Research Program of the National Cancer Institute, Department of Health and Human Services, USA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000930> "A population-based case-control study of breast cancer in Warsaw and Łódź, Poland, in 2000–2003, funded by the intramural programme of the US National Cancer Institute, in which cases were women aged 20–74 with newly diagnosed in situ or invasive breast cancer identified through a rapid identification system at participating hospitals and through cancer registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "The Polish Women’s Breast Cancer Study (PBCS) is a population-based case-control study conducted in two major cities in Poland (Warsaw and Łódź) during 2000-2003 (Garcia-Closas et al., 2006).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000930> "A population-based case-control study of breast cancer in Warsaw and Łódź, Poland, in 2000–2003, funded by the intramural programme of the US National Cancer Institute, in which cases were women aged 20–74 with newly diagnosed in situ or invasive breast cancer identified through a rapid identification system at participating hospitals and through cancer registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000931> (<http://www.ebi.ac.uk/coho/COHO_0000931>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32203222") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7217761/fullTextXML") Annotation(rdfs:comment "131,373 women aged 46–73 years were, in 15 screening areas across Greater Manchester, United Kingdom, invited for routine three-yearly mammographic screening, were mailed information, a consent form and a two-page questionnaire to elicit information about family history, hormonal and lifestyle risk factors") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32203222") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7217761/fullTextXML") Annotation(rdfs:comment "We recruited women (aged 47–73 years) into the PROCAS (Predicting Risk Of Cancer At Screening; Manchester, UK: 2009–2013) Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "In a subset of 10,000 a saliva DNA sample was obtained over sampling in those with breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Over the following 6 years 57,900 women were recruited at routine breast screening appointments in the UK NHS breast screening programme.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.journalslibrary.nihr.ac.uk/pgfar/PGFAR04110") Annotation(rdfs:comment "Mammographic density for the first mammogram while taking part in the PROCAS study was assessed by an area-based method (VAS) and volumetric methods (Volpara and Quantra).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.journalslibrary.nihr.ac.uk/pgfar/PGFAR04110") Annotation(rdfs:comment "The performance of this, and existing risk prediction models, is currently being assessed, as the PROCAS study now has sufficient follow-up data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")

