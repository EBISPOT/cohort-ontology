AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19930545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19951396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912604") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19930545") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3091325/fullTextXML") Annotation(rdfs:comment "Mexican spouse pairs were recruited from both Mexico City and the San Francisco Bay Area. Puerto Rican spouse pairs were recruited from both New York City and from Puerto Rico.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001753> "A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19930545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19951396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912604") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19930545") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3091325/fullTextXML") Annotation(rdfs:comment "We also note that the spouses in our study were parents of children with asthma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001753> "A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19930545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19951396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912604") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19951396") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3091313/") Annotation(rdfs:comment "Spouse pairs were recruited from the ongoing Genetics of Asthma in Latino Americans (GALA) project at the University of California, San Francisco, and were self identified as either Mexican or Puerto Rican with all four grandparents also identified likewise.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001753> "A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19930545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19951396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912604") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21912604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166061/fullTextXML") Annotation(rdfs:comment "The Puerto Rican and Mexican populations consisted of mother, father, child trios enrolled in the GALA Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001753> "A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19930545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19951396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912604") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21912604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166061/fullTextXML") Annotation(rdfs:comment "participating in the Genetics of Asthma in Latino Americans (GALA) Study [12], a multicenter international collaborative effort designed to identify clinical and genetic risk factors associated with asthma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001753> "A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001754> (<http://www.ebi.ac.uk/coho/COHO_0001754>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29917119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30476131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30820706") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29917119") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6555904/") Annotation(rdfs:comment "GALEON wishes to thank the Department of Surgery of University Hospital of Santiago (CHUS),") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001754> "A colon cancer study in Galicia, Spain, carried out with the University Hospital of Santiago de Compostela (its surgery and pathology departments and biobank) and health research institutes in Santiago de Compostela and Vigo, whose participants were included in genome-wide association studies of colorectal cancer that pooled the studies of the CORECT, CCFR and GECCO consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29917119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30476131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30820706") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29917119") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6555904/") Annotation(rdfs:comment "In the discovery stage, we combined genotype and epidemiologic data from individuals with European ancestry from all of our consortium efforts to date (CORECT, CCFR, and GECCO), including the new OncoArray Project (36 948 case subjects and 30 864 control subjects) (Supplementary Table 2, Supplementary Figures 2 and 3, available online).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001754> "A colon cancer study in Galicia, Spain, carried out with the University Hospital of Santiago de Compostela (its surgery and pathology departments and biobank) and health research institutes in Santiago de Compostela and Vigo, whose participants were included in genome-wide association studies of colorectal cancer that pooled the studies of the CORECT, CCFR and GECCO consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29917119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30476131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30820706") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30820706") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6483948/fullTextXML") Annotation(rdfs:comment "the staff of the Department of Pathology and Biobank of CHUS, Instituto de Investigación Sanitaria de Santiago (IDIS), Instituto de Investigación Sanitaria Galicia Sur (IISGS), SERGAS, Vigo, Spain, and Programa Grupos Emergentes, Cancer Genetics Unit, CHUVI Vigo Hospital, Instituto de Salud Carlos III, Spain.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001754> "A colon cancer study in Galicia, Spain, carried out with the University Hospital of Santiago de Compostela (its surgery and pathology departments and biobank) and health research institutes in Santiago de Compostela and Vigo, whose participants were included in genome-wide association studies of colorectal cancer that pooled the studies of the CORECT, CCFR and GECCO consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001755> (<http://www.ebi.ac.uk/coho/COHO_0001755>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39428694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41537461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39428694") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11667495/fullTextXML") Annotation(rdfs:comment "During the same period, additional persons with AD or mild cognitive impairment (MCI) were recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001755> "A community-based longitudinal cohort study of Alzheimer's disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens' centres in the city of Gwangju, with additional people with Alzheimer's disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39428694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41537461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39428694") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11667495/fullTextXML") Annotation(rdfs:comment "In brief, the primary GARD sample included individuals living in local senior citizens centers in the southwestern Korean city of Gwangju.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001755> "A community-based longitudinal cohort study of Alzheimer's disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens' centres in the city of Gwangju, with additional people with Alzheimer's disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39428694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41537461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41537461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12805525/fullTextXML") Annotation(rdfs:comment "Established in 2013, it integrated extensive neuropsychological, neuroimaging (MRI, amyloid positron emission tomography [PET]), biospecimen, and multi‐omics data to track disease from its earliest stages.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001755> "A community-based longitudinal cohort study of Alzheimer's disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens' centres in the city of Gwangju, with additional people with Alzheimer's disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39428694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41537461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41537461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12805525/fullTextXML") Annotation(rdfs:comment "Gwangju Alzheimer's & Related Dementias (GARD) is a large‐scale, longitudinal, community‐based cohort study in South Korea.The study focuses on early detection and monitoring of dementia progression.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001755> "A community-based longitudinal cohort study of Alzheimer's disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens' centres in the city of Gwangju, with additional people with Alzheimer's disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39428694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41537461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41537461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12805525/fullTextXML") Annotation(rdfs:comment "Participants aged ≥60 years undergo comprehensive clinical evaluations, neuroimaging, and biospecimen collection for multi‐omics analyses (genomics, transcriptomics, proteomics, and metagenomics) at baseline and systematic follow‐up visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001755> "A community-based longitudinal cohort study of Alzheimer's disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens' centres in the city of Gwangju, with additional people with Alzheimer's disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39428694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41537461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41537461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12805525/fullTextXML") Annotation(rdfs:comment "The GARD cohort was established in 2013 as a large‐scale, community‐based prospective study to investigate early risk and protective factors across the AD spectrum.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001755> "A community-based longitudinal cohort study of Alzheimer's disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens' centres in the city of Gwangju, with additional people with Alzheimer's disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001756> (<http://www.ebi.ac.uk/coho/COHO_0001756>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31033776") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31033776") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6636808/fullTextXML") Annotation(rdfs:comment "we analyzed a smoking cessation dataset to test for rare variants associated with nicotine dependence which was downloaded from the Database of Genotypes and Phenotypes (accession number phs000404.v1.p1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001756> "A genome-wide association study of the Gene Environment Association Studies initiative (GENEVA), deposited in dbGaP as phs000404, that genotyped nicotine-dependent smokers and non-dependent smoking controls from two projects, the Collaborative Genetic Study of Nicotine Dependence (recruited in Detroit and St. Louis) and the University of Wisconsin Transdisciplinary Tobacco Use Research Center smoking cessation trials (recruited in Madison and Milwaukee, Wisconsin), with harmonised measures, to identify genetic variants that contribute to nicotine dependence, related smoking behaviours and smoking cessation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31033776") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(rdfs:comment "Data cleaning and harmonization were done at the GEI-funded GENEVA Coordinating Center at the University of Washington.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001756> "A genome-wide association study of the Gene Environment Association Studies initiative (GENEVA), deposited in dbGaP as phs000404, that genotyped nicotine-dependent smokers and non-dependent smoking controls from two projects, the Collaborative Genetic Study of Nicotine Dependence (recruited in Detroit and St. Louis) and the University of Wisconsin Transdisciplinary Tobacco Use Research Center smoking cessation trials (recruited in Madison and Milwaukee, Wisconsin), with harmonised measures, to identify genetic variants that contribute to nicotine dependence, related smoking behaviours and smoking cessation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31033776") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(rdfs:comment "Nicotine dependent cases and non-dependent, smoking controls were identified and recruited from Detroit and St. Louis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001756> "A genome-wide association study of the Gene Environment Association Studies initiative (GENEVA), deposited in dbGaP as phs000404, that genotyped nicotine-dependent smokers and non-dependent smoking controls from two projects, the Collaborative Genetic Study of Nicotine Dependence (recruited in Detroit and St. Louis) and the University of Wisconsin Transdisciplinary Tobacco Use Research Center smoking cessation trials (recruited in Madison and Milwaukee, Wisconsin), with harmonised measures, to identify genetic variants that contribute to nicotine dependence, related smoking behaviours and smoking cessation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31033776") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(rdfs:comment "Nicotine dependent smokers seeking cessation treatment were identified and recruited from Madison and Milwaukee, WI.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001756> "A genome-wide association study of the Gene Environment Association Studies initiative (GENEVA), deposited in dbGaP as phs000404, that genotyped nicotine-dependent smokers and non-dependent smoking controls from two projects, the Collaborative Genetic Study of Nicotine Dependence (recruited in Detroit and St. Louis) and the University of Wisconsin Transdisciplinary Tobacco Use Research Center smoking cessation trials (recruited in Madison and Milwaukee, Wisconsin), with harmonised measures, to identify genetic variants that contribute to nicotine dependence, related smoking behaviours and smoking cessation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31033776") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(rdfs:comment "The overall goal of this project is to identify and characterize genetic variants that contribute to the development of nicotine dependence, related smoking behaviors, and smoking cessation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001756> "A genome-wide association study of the Gene Environment Association Studies initiative (GENEVA), deposited in dbGaP as phs000404, that genotyped nicotine-dependent smokers and non-dependent smoking controls from two projects, the Collaborative Genetic Study of Nicotine Dependence (recruited in Detroit and St. Louis) and the University of Wisconsin Transdisciplinary Tobacco Use Research Center smoking cessation trials (recruited in Madison and Milwaukee, Wisconsin), with harmonised measures, to identify genetic variants that contribute to nicotine dependence, related smoking behaviours and smoking cessation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31033776") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") Annotation(rdfs:comment "This study is part of the Gene Environment Association Studies initiative (GENEVA, http://www.genevastudy.org) funded by the trans-NIH Genes, Environment, and Health Initiative (GEI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001756> "A genome-wide association study of the Gene Environment Association Studies initiative (GENEVA), deposited in dbGaP as phs000404, that genotyped nicotine-dependent smokers and non-dependent smoking controls from two projects, the Collaborative Genetic Study of Nicotine Dependence (recruited in Detroit and St. Louis) and the University of Wisconsin Transdisciplinary Tobacco Use Research Center smoking cessation trials (recruited in Madison and Milwaukee, Wisconsin), with harmonised measures, to identify genetic variants that contribute to nicotine dependence, related smoking behaviours and smoking cessation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001757> (<http://www.ebi.ac.uk/coho/COHO_0001757>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37655588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37655588") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") Annotation(rdfs:comment "A total of 4706 (70%) participants provided a saliva sample and were genotyped and 5506 (82%) consented to record linkage of their Pharmaceutical and Medicare Benefits Schedule data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001757> "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37655588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37655588") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") Annotation(rdfs:comment "A total of 6682 participants (68.3% female; aged 44.8 ± 13.6 years [range = 18–90]) were recruited in three waves: a nation-wide media campaign, a mail-out based on prescriptions for lithium carbonate and through the Australian Genetics of Depression Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001757> "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37655588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37655588") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") Annotation(rdfs:comment "Participants then entered their details onto an online form securely hosted on QIMR Berghofer servers and were assigned a unique link to an online questionnaire hosted on the Qualtrics website.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001757> "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37655588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37655588") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") Annotation(rdfs:comment "The Australian Genetics of Bipolar Disorder Study is a nation-wide cohort of adults living with bipolar disorder.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001757> "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37655588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37655588") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") Annotation(rdfs:comment "The campaign focused on recruiting volunteers from the public who had ever been diagnosed with or treated for BD and comprised a media launch on 20 November 2018 with follow-up via television, radio, print and online interviews and social media posts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001757> "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37655588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37655588") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") Annotation(rdfs:comment "The study aims to detect the relationships between genetic risk, symptom severity, and the lifetime prevalence of bipolar disorder, treatment response and medication side effects, and patterns and costs of health care usage.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001757> "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001758> (<http://www.ebi.ac.uk/coho/COHO_0001758>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29083407") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29083407") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3978/MediaObjects/41588_2017_BFng3978_MOESM1_ESM.pdf") Annotation(rdfs:comment "All participants are unrelated Chinese Hans and recruited through advertisement.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001758> "A population-based case-control study of type 2 diabetes conducted from September 2009 to January 2010 in Bijie city, Guizhou province, China, recruiting through advertisement unrelated Han Chinese adults aged 30 to 80 with at least ten years' residence in Bijie city.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29083407") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29083407") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3978/MediaObjects/41588_2017_BFng3978_MOESM1_ESM.pdf") Annotation(rdfs:comment "GBTDS is a population-based case-control study conducted from September 2009 to January 2010 in Bijie city of Guizhou province5 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001758> "A population-based case-control study of type 2 diabetes conducted from September 2009 to January 2010 in Bijie city, Guizhou province, China, recruiting through advertisement unrelated Han Chinese adults aged 30 to 80 with at least ten years' residence in Bijie city.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29083407") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29083407") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3978/MediaObjects/41588_2017_BFng3978_MOESM1_ESM.pdf") Annotation(rdfs:comment "The participants include 1,824 type 2 diabetic cases (955 male and 869 female) and 1,719 nondiabetic controls (828 male and 891 female) aged 30 to 80 years, with at least 10 years residence in Bijie city.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001758> "A population-based case-control study of type 2 diabetes conducted from September 2009 to January 2010 in Bijie city, Guizhou province, China, recruiting through advertisement unrelated Han Chinese adults aged 30 to 80 with at least ten years' residence in Bijie city.")

