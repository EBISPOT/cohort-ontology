AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26956414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(rdfs:comment "Utah 331/420 >=95% 1) Abnormal heterozygosity; 2) Non CEU; 3) Incomplete phenotype 321/405 Illumina HumanHap 610K") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002531> "A case-control study of chronic lymphocytic leukaemia in Utah, United States, whose prevalent cases came from the Huntsman Cancer Hospital's haematology clinics or were identified in the Utah Cancer Registry and verified by medical records and pathology reports, and whose controls, from the same area, were frequency-matched to the cases by sex and birth cohort using the Utah Population Database; it was genotyped genome-wide for studies of genetic susceptibility to the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26956414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(rdfs:comment "Utah Chronic Lymphocytic Leukemia Study UTAH 355 420 Mixed: clinic- and population- based cases and controls, USA Prevalent cases from Huntsman Cancer Hospital's Hematology Clinics and Prevalent cases identified in the Utah Cancer Registry, verified by medical records and pathology report") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002531> "A case-control study of chronic lymphocytic leukaemia in Utah, United States, whose prevalent cases came from the Huntsman Cancer Hospital's haematology clinics or were identified in the Utah Cancer Registry and verified by medical records and pathology reports, and whose controls, from the same area, were frequency-matched to the cases by sex and birth cohort using the Utah Population Database; it was genotyped genome-wide for studies of genetic susceptibility to the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26956414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4786871/") Annotation(rdfs:comment "Our discovery meta-analysis included four CLL GWAS of European ancestry: National Cancer Institute NHL GWAS (NCI GWAS)5, Utah Chronic Lymphocytic Leukemia GWAS (UTAH), Genetic Epidemiology of CLL Consortium GWAS (GEC)4, and Molecular Epidemiology of Non-Hodgkin Lymphoma GWAS (UCSF)9.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002531> "A case-control study of chronic lymphocytic leukaemia in Utah, United States, whose prevalent cases came from the Huntsman Cancer Hospital's haematology clinics or were identified in the Utah Cancer Registry and verified by medical records and pathology reports, and whose controls, from the same area, were frequency-matched to the cases by sex and birth cohort using the Utah Population Database; it was genotyped genome-wide for studies of genetic susceptibility to the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002532> (<http://www.ebi.ac.uk/coho/COHO_0002532>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23770605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2652/MediaObjects/41588_2013_BFng2652_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23770605") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3729927/") Annotation(rdfs:comment "Genotyping for the NCI Rep study was conducted using custom TaqMan genotyping assays (Applied Biosystems) at the NCI Core Genotyping Resource and genotyping for the Utah-Sheffield study was conducted at the Core Research Facilities at the University of Utah.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002532> "A collaborative case-control study of chronic lymphocytic leukemia with sites in Utah, USA, and Sheffield, UK, whose prevalent cases came from the hematology clinics of the Huntsman Cancer Hospital and the Utah Cancer Registry, verified by medical records and pathology reports, and from National Health Service hospitals in the North Trent region of the UK, and whose controls were ascertained from the Utah Population Database; its cases and controls, genotyped at the University of Utah, were a replication series of the genome-wide association studies of chronic lymphocytic leukemia published in 2013 and 2016.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23770605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2652/MediaObjects/41588_2013_BFng2652_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23770605") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3729927/") Annotation(rdfs:comment "In stage 3, 10 SNPs in the most promising loci and one SNP from an established locus were taken forward for de novo replication in an additional 392 cases and 4561 controls from the NCI replication study (NCI Rep) and from the Utah/Sheffield Chronic Lymphocytic Leukemia study (Utah-Sheffield) (Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002532> "A collaborative case-control study of chronic lymphocytic leukemia with sites in Utah, USA, and Sheffield, UK, whose prevalent cases came from the hematology clinics of the Huntsman Cancer Hospital and the Utah Cancer Registry, verified by medical records and pathology reports, and from National Health Service hospitals in the North Trent region of the UK, and whose controls were ascertained from the Utah Population Database; its cases and controls, genotyped at the University of Utah, were a replication series of the genome-wide association studies of chronic lymphocytic leukemia published in 2013 and 2016.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23770605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2652/MediaObjects/41588_2013_BFng2652_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26956414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(rdfs:comment "SHEFFIELD: Prevalent cases from National Health Service Hospitals in the North Trent region of the UK Controls ascertained from the Utah Population Database") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002532> "A collaborative case-control study of chronic lymphocytic leukemia with sites in Utah, USA, and Sheffield, UK, whose prevalent cases came from the hematology clinics of the Huntsman Cancer Hospital and the Utah Cancer Registry, verified by medical records and pathology reports, and from National Health Service hospitals in the North Trent region of the UK, and whose controls were ascertained from the Utah Population Database; its cases and controls, genotyped at the University of Utah, were a replication series of the genome-wide association studies of chronic lymphocytic leukemia published in 2013 and 2016.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23770605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2652/MediaObjects/41588_2013_BFng2652_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26956414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(rdfs:comment "UTAH-SHEFFIELD 234 225 64.1% 39.6% 65.1 (10.4) 67.3 (10.8)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002532> "A collaborative case-control study of chronic lymphocytic leukemia with sites in Utah, USA, and Sheffield, UK, whose prevalent cases came from the hematology clinics of the Huntsman Cancer Hospital and the Utah Cancer Registry, verified by medical records and pathology reports, and from National Health Service hospitals in the North Trent region of the UK, and whose controls were ascertained from the Utah Population Database; its cases and controls, genotyped at the University of Utah, were a replication series of the genome-wide association studies of chronic lymphocytic leukemia published in 2013 and 2016.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23770605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2652/MediaObjects/41588_2013_BFng2652_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26956414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(rdfs:comment "Utah/Sheffield Chronic Lymphocytic Leukemia Collaborative Study UTAH- SHEFFIELD 236 227 Mixed: clinic- and population- based cases and controls UTAH: Prevalent cases from Huntsman Cancer Hospital's Hematology Clinics and Prevalent cases identified in the Utah Cancer Registry, verified by medical records and pathology report.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002532> "A collaborative case-control study of chronic lymphocytic leukemia with sites in Utah, USA, and Sheffield, UK, whose prevalent cases came from the hematology clinics of the Huntsman Cancer Hospital and the Utah Cancer Registry, verified by medical records and pathology reports, and from National Health Service hospitals in the North Trent region of the UK, and whose controls were ascertained from the Utah Population Database; its cases and controls, genotyped at the University of Utah, were a replication series of the genome-wide association studies of chronic lymphocytic leukemia published in 2013 and 2016.")

