AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20852632") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.668/MediaObjects/41588_2010_BFng668_MOESM17_ESM.pdf") Annotation(rdfs:comment "TOR Familial Ovarian Tumor Study (FOTS) Canada Enrollment of patients aged 20-79 years of age and diagnosed between January 1, 1995 and December 31, 1999 with epithelial ovarian cancer identified by the Ontario Cancer Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001738> "A population-based case-control study of epithelial ovarian cancer in Ontario, Canada, whose cases, aged 20–79 and diagnosed from 1995 to 1999, were identified through the Ontario Cancer Registry, with family-based controls and population-based controls drawn from women attending a screening clinic at Women's College Hospital, Toronto; it is the Toronto site of the Ovarian Cancer Association Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20852632") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.668/MediaObjects/41588_2010_BFng668_MOESM17_ESM.pdf") Annotation(rdfs:comment "Two control series are included: family-based controls and population-based controls drawn from women attending a screening clinic at Women’s College Hospital") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001738> "A population-based case-control study of epithelial ovarian cancer in Ontario, Canada, whose cases, aged 20–79 and diagnosed from 1995 to 1999, were identified through the Ontario Cancer Registry, with family-based controls and population-based controls drawn from women attending a screening clinic at Women's College Hospital, Toronto; it is the Toronto site of the Ovarian Cancer Association Consortium.")
