AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38969383") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11227803/fullTextXML") Annotation(rdfs:comment "A longitudinal prospective cohort study of children born with CL/P and their families.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38969383") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11227803/fullTextXML") Annotation(rdfs:comment "At the time of recruitment, parents are asked to provide consent to link the data provided to the Cleft Collective to external data sources.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38969383") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11227803/fullTextXML") Annotation(rdfs:comment "Parental and child questionnaires are collected at key time points throughout the child’s development.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38969383") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11227803/fullTextXML") Annotation(rdfs:comment "Recruitment occurs across the UK and started in November 2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38969383") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11227803/fullTextXML") Annotation(rdfs:comment "The Cleft Collective, a national cohort study in the UK, aims to build a resource, available to collaborators across the globe, to understand causes, best treatments and long-term outcomes for those born with CL/P, ultimately seeking to enhance their quality of life through improved understanding and care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41075272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12627943/") Annotation(rdfs:comment "Children born with an orofacial cleft and their families who were registered at one of 17 cleft centres across the UK were recruited to the Cleft Collective Cohort study between November 2013 and June 2020.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000771> (<http://www.ebi.ac.uk/coho/COHO_0000771>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://childrensoncologygroup.org/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36580335") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9857512/unicode") Annotation(rdfs:comment "We first identified candidate variants by mining an available public large-scale genome-wide association study (GWAS) repository and tested their associations with hepatotoxic effects in 2 large multi-institutional Children’s Oncology Group (COG) trials, AALL0232 (n = 2283) and AALL0434 (n = 1274).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000771> "A clinical trials network of more than 220 hospitals and more than 13,500 researchers, clinicians and specialists that designs and runs clinical trials and research studies to cure and prevent childhood and adolescent cancer; genetic studies use participants of its trials.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://childrensoncologygroup.org/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://childrensoncologygroup.org/about") Annotation(rdfs:comment "Our mission is to cure and prevent childhood and adolescent cancer through scientific discovery and compassionate care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000771> "A clinical trials network of more than 220 hospitals and more than 13,500 researchers, clinicians and specialists that designs and runs clinical trials and research studies to cure and prevent childhood and adolescent cancer; genetic studies use participants of its trials.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://childrensoncologygroup.org/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://childrensoncologygroup.org/about") Annotation(rdfs:comment "We bring together more than 220 hospitals and more than 13,500 researchers, clinicians, and specialists.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000771> "A clinical trials network of more than 220 hospitals and more than 13,500 researchers, clinicians and specialists that designs and runs clinical trials and research studies to cure and prevent childhood and adolescent cancer; genetic studies use participants of its trials.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://childrensoncologygroup.org/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://childrensoncologygroup.org/about") Annotation(rdfs:comment "We design clinical trials, lead research studies, and develop the evidence that guides treatment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000771> "A clinical trials network of more than 220 hospitals and more than 13,500 researchers, clinicians and specialists that designs and runs clinical trials and research studies to cure and prevent childhood and adolescent cancer; genetic studies use participants of its trials.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000772> (<http://www.ebi.ac.uk/coho/COHO_0000772>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37581339") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37581339") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10550787/fullTextXML") Annotation(rdfs:comment "At the study's inception, high‐risk families were ascertained through probands who were undergoing treatment for AUDs at six sites across the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000772> "A multi-site, multi-generational family study in which probands recruited through alcohol treatment centres and their relatives, together with community comparison families, have been assessed over more than 30 years (nearly 18,000 individuals from over 2200 families) with psychiatric interviews, questionnaires, electrophysiology and DNA to identify genetic factors in alcohol use disorder and related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37581339") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37581339") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10550787/fullTextXML") Annotation(rdfs:comment "COGA is a multi‐generational family‐based study in which probands were recruited through alcohol treatment centers, along with a set of community comparison families.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000772> "A multi-site, multi-generational family study in which probands recruited through alcohol treatment centres and their relatives, together with community comparison families, have been assessed over more than 30 years (nearly 18,000 individuals from over 2200 families) with psychiatric interviews, questionnaires, electrophysiology and DNA to identify genetic factors in alcohol use disorder and related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37581339") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37581339") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10550787/fullTextXML") Annotation(rdfs:comment "Nearly 18,000 individuals from >2200 families have been assessed over a period of over 30 years with a rich phenotypic battery that includes semi‐structured psychiatric interviews and questionnaire measures, along with DNA collection and electrophysiological data on a large subset.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000772> "A multi-site, multi-generational family study in which probands recruited through alcohol treatment centres and their relatives, together with community comparison families, have been assessed over more than 30 years (nearly 18,000 individuals from over 2200 families) with psychiatric interviews, questionnaires, electrophysiology and DNA to identify genetic factors in alcohol use disorder and related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37581339") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37581339") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10550787/fullTextXML") Annotation(rdfs:comment "The collaborative study on the genetics of alcoholism (COGA) was designed to identify risk and protective genes for alcohol use disorders and related conditions, with additional objectives to study associations with environmental and neurophysiological factors and their interplay with genes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000772> "A multi-site, multi-generational family study in which probands recruited through alcohol treatment centres and their relatives, together with community comparison families, have been assessed over more than 30 years (nearly 18,000 individuals from over 2200 families) with psychiatric interviews, questionnaires, electrophysiology and DNA to identify genetic factors in alcohol use disorder and related outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000773> (<http://www.ebi.ac.uk/coho/COHO_0000773>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25105248") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML") Annotation(rdfs:comment "The CORECT Study is supported by the National Cancer Institute as part of the GAME-ON consortium (U19 CA148107)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25105248") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML") Annotation(rdfs:comment "The CORECT study meta-analysis was conducted using germline DNA the Molecular Epidemiology of Colorectal Cancer study (MECC) (set 1: 484 cases and 498 controls; set 2: 1,120 cases and 820 controls), CCFR (set 1: 1,977 cases and 999 controls; set 2: 1,660 cases and 1,393 controls), Kentucky case-control study (1,038 cases and 1,134 controls), Newfoundland case-control study (548 cases and 538 controls)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25105248") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML") Annotation(rdfs:comment "The University of Southern California Health Sciences IRB approved all elements of the CORECT study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25105248") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML") Annotation(rdfs:comment "We subsequently replicated these associations in two large colorectal cancer consortia of European-descent populations (allele frequency 0.09): Colorectal Transdisciplinary Study (CORECT) with 7,561 cases and 6,328 controls from 8 participating studies (combined OR = 1.09, P = 0.036, Table 1)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.bmj.com/content/359/bmj.j4761") Annotation(rdfs:comment "The GAME-ON initiative is a network of five cancer specific consortiums: CORECT (ColoRectal Transdisciplinary Study); DRIVE (Discovery, Biology, and Risk of Inherited Variants in Breast Cancer); ELLIPSE (Elucidating Loci Involved in Prostate Cancer Susceptibility);") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001856.v1.p1") Annotation(rdfs:comment "Teams of epidemiologists, basic scientists, and clinicians accomplished this goal by collaborating on follow-up investigations of genomic regions that have been implicated in susceptibility to certain cancer types.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001856.v1.p1") Annotation(rdfs:comment "The post-GWAS continuum of research addressed by this network of consortia includes: Replication of previous findings and identification of new susceptibility loci through pooled or meta analyses and extension of GWAS to diverse populations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000774> (<http://www.ebi.ac.uk/coho/COHO_0000774>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27598322") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5012582/fullTextXML") Annotation(rdfs:comment "GAME-ON is network of genetic epidemiology consortia that contains GWAS data from the Colorectal Transdisciplinary Study (CORECT); Discovery, Biology, and Risk of Inherited Variants in Breast Cancer (DRIVE); Elucidating Loci Involved in Prostate Cancer Susceptibility (ELLIPSE); Follow-up of Ovarian Cancer Genetic Association and Interaction Studies (FOCI); and Transdisciplinary Research in Cancer of the Lung (TRICL).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000774> "A network of cancer genetic epidemiology consortia, the NIH-funded post-cancer-GWAS initiative, that brings together genome-wide association data from colorectal (CORECT), breast (DRIVE), prostate (ELLIPSE), ovarian (FOCI) and lung (TRICL) cancer consortia, mainly of people of European descent.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27598322") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5012582/fullTextXML") Annotation(rdfs:comment "The GAME-ON consortium primarily consists of studies of individuals of European descent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000774> "A network of cancer genetic epidemiology consortia, the NIH-funded post-cancer-GWAS initiative, that brings together genome-wide association data from colorectal (CORECT), breast (DRIVE), prostate (ELLIPSE), ovarian (FOCI) and lung (TRICL) cancer consortia, mainly of people of European descent.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27598322") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5012582/fullTextXML") Annotation(rdfs:comment "The Post-Cancer GWAS (GAME-ON) initiative was supported by NIH grants U19CA148065 (DRIVE, PI: DJH), U19CA148107 (CORECT, PI: SBG), U19CA148127 (TRICL, PI: CIA), and U19CA148537 (ELLIPSE, PI: CAH).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000774> "A network of cancer genetic epidemiology consortia, the NIH-funded post-cancer-GWAS initiative, that brings together genome-wide association data from colorectal (CORECT), breast (DRIVE), prostate (ELLIPSE), ovarian (FOCI) and lung (TRICL) cancer consortia, mainly of people of European descent.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.bmj.com/content/359/bmj.j4761") Annotation(rdfs:comment "The GAME-ON initiative is a network of five cancer specific consortiums: CORECT (ColoRectal Transdisciplinary Study); DRIVE (Discovery, Biology, and Risk of Inherited Variants in Breast Cancer); ELLIPSE (Elucidating Loci Involved in Prostate Cancer Susceptibility);") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000774> "A network of cancer genetic epidemiology consortia, the NIH-funded post-cancer-GWAS initiative, that brings together genome-wide association data from colorectal (CORECT), breast (DRIVE), prostate (ELLIPSE), ovarian (FOCI) and lung (TRICL) cancer consortia, mainly of people of European descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000775> (<http://www.ebi.ac.uk/coho/COHO_0000775>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35039627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8980077/fullTextXML") Annotation(rdfs:comment "A two-stage genome-wide association study was carried out in head and neck cancer (HNC) patients aiming to identify genetic variants associated with either specific radiotherapy-induced (RT) toxicity endpoints or a general proneness to develop toxicity after RT.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000775> "A cohort of patients with head and neck squamous cell carcinoma treated with radiotherapy within the protocols of the Danish Head and Neck Cancer Group (DAHANCA) in Denmark in 2000–2011, pooled from the DAHANCA 10 and DAHANCA 19 trials and the DAHANCA prospective biobank protocol, with standardised scoring of acute and late radiotherapy toxicity, used in radiogenomic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35039627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8980077/fullTextXML") Annotation(rdfs:comment "Acute and late endpoints were registered ordinally according to standardised DAHANCA forms, which are comparable with LENT-SOMA scales [18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000775> "A cohort of patients with head and neck squamous cell carcinoma treated with radiotherapy within the protocols of the Danish Head and Neck Cancer Group (DAHANCA) in Denmark in 2000–2011, pooled from the DAHANCA 10 and DAHANCA 19 trials and the DAHANCA prospective biobank protocol, with standardised scoring of acute and late radiotherapy toxicity, used in radiogenomic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35039627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8980077/fullTextXML") Annotation(rdfs:comment "Patients in the discovery study were treated within The Danish Head and Neck Cancer Group (DAHANCA) protocols in Denmark for head and neck squamous cell carcinoma in the period of 2000–2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000775> "A cohort of patients with head and neck squamous cell carcinoma treated with radiotherapy within the protocols of the Danish Head and Neck Cancer Group (DAHANCA) in Denmark in 2000–2011, pooled from the DAHANCA 10 and DAHANCA 19 trials and the DAHANCA prospective biobank protocol, with standardised scoring of acute and late radiotherapy toxicity, used in radiogenomic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35039627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8980077/fullTextXML") Annotation(rdfs:comment "The cohort was analysed as a pooled dataset of 1183 patients from DAHANCA10, DAHANCA19 and the DAHANCA Prospective biobank protocol as they were eligible by the criteria set.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000775> "A cohort of patients with head and neck squamous cell carcinoma treated with radiotherapy within the protocols of the Danish Head and Neck Cancer Group (DAHANCA) in Denmark in 2000–2011, pooled from the DAHANCA 10 and DAHANCA 19 trials and the DAHANCA prospective biobank protocol, with standardised scoring of acute and late radiotherapy toxicity, used in radiogenomic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000776> (<http://www.ebi.ac.uk/coho/COHO_0000776>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28008009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28008009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28008009+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The DiscovEHR collaboration between the Regeneron Genetics Center and Geisinger Health System couples high-throughput sequencing to an integrated health care system using longitudinal electronic health records (EHRs).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000776> "A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger's MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28008009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28008009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28008009+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The DiscovEHR data set provides a blueprint for large-scale precision medicine initiatives and genomics-guided therapeutic discovery.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000776> "A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger's MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28008009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28008009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28008009+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We sequenced the exomes of 50,726 adult participants in the DiscovEHR study to identify ~4.2 million rare single-nucleotide variants and insertion/deletion events, of which ~176,000 are predicted to result in a loss of gene function.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000776> "A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger's MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28008009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34184762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8457092/fullTextXML") Annotation(rdfs:comment "Genotyping was performed at the Regeneron Genetics Center in two waves.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000776> "A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger's MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28008009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34184762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8457092/fullTextXML") Annotation(rdfs:comment "In short, the DiscovEHR cohort is a subset of individuals enrolled in the Geisinger Healthcare system who consented to participate in Geisinger's MyCode Community Health Initiative.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000776> "A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger's MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000777> (<http://www.ebi.ac.uk/coho/COHO_0000777>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36629499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244060/fullTextXML") Annotation(rdfs:comment "All participants in EIMS/GEMS were asked to provide blood samples for genetic analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000777> "A Swedish population-based case-control study of multiple sclerosis in which incident cases were recruited from hospital-based and privately run neurology units and matched controls were randomly selected from the national population register, with questionnaires on environmental and lifestyle exposures and blood samples for genetic analyses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36629499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244060/fullTextXML") Annotation(rdfs:comment "EIMS recruited incident cases of MS from hospital-based and privately run neurology units.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000777> "A Swedish population-based case-control study of multiple sclerosis in which incident cases were recruited from hospital-based and privately run neurology units and matched controls were randomly selected from the national population register, with questionnaires on environmental and lifestyle exposures and blood samples for genetic analyses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36629499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244060/fullTextXML") Annotation(rdfs:comment "The EIMS and GEMS questionnaires on environmental exposures and lifestyle factors were similar, with most questions identically worded.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000777> "A Swedish population-based case-control study of multiple sclerosis in which incident cases were recruited from hospital-based and privately run neurology units and matched controls were randomly selected from the national population register, with questionnaires on environmental and lifestyle exposures and blood samples for genetic analyses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36629499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244060/fullTextXML") Annotation(rdfs:comment "Two controls per case were randomly selected from the national population register, matched for the case's age 5-year age strata, sex and region (one of 21 counties).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000777> "A Swedish population-based case-control study of multiple sclerosis in which incident cases were recruited from hospital-based and privately run neurology units and matched controls were randomly selected from the national population register, with questionnaires on environmental and lifestyle exposures and blood samples for genetic analyses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36629499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244060/fullTextXML") Annotation(rdfs:comment "We used data from Epidemiological Investigation of Multiple Sclerosis (EIMS) and Genes and Environment in Multiple Sclerosis (GEMS), which are Swedish population-based, case-control studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000777> "A Swedish population-based case-control study of multiple sclerosis in which incident cases were recruited from hospital-based and privately run neurology units and matched controls were randomly selected from the national population register, with questionnaires on environmental and lifestyle exposures and blood samples for genetic analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000778> (<http://www.ebi.ac.uk/coho/COHO_0000778>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4657484/fullTextXML") Annotation(rdfs:comment "Finally, in 2000 an agreement was met and a joint application was submitted to set up a ‘quality registry’ for MS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26046553+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Current projects include an incidence cohort (EIMS), post-marketing cohorts of patients on novel disease-modifying drugs (IMSE), and a prevalence cohort (GEMS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26046553+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "It runs on government funding only and is used in all Swedish neurology departments.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26046553+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "One important function of SMSreg, to which participation is voluntary, is to serve as a tool for decision support and to provide an easy overview of the patient information needed at clinical visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26046553+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "SMSreg data have been used in close to 100 published scientific reports.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26046553") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26046553+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Swedish MS registry (SMSreg) is designed to assure quality health care for patients with multiple sclerosis (MS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000779> (<http://www.ebi.ac.uk/coho/COHO_0000779>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18985156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19789630") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18985156") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2575233/fullTextXML") Annotation(rdfs:comment "Five different European clinical diabetes centres contributed non-diabetic offspring of patients with type 2 diabetes to the EUGENE2 (European network on Functional Genomics of Type 2 Diabetes) consortium") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000779> "A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18985156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19789630") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18985156") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2575233/fullTextXML") Annotation(rdfs:comment "We conducted our study on SGK genetic variance and potential associations with insulin secretory function in the German TUEF cohort and the EUGENE2 consortium (Denmark, Finland, Germany, Italy, and Sweden), as these two European diabetes risk populations were extensively phenotyped for insulin secretion traits at the prediabetic stage.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000779> "A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18985156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19789630") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19789630") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2747270/fullTextXML") Annotation(rdfs:comment "Oral and intravenous glucose stimulated insulin release (n = 849) and insulin sensitivity (n = 596) estimated from a hyperinsulinemic euglycemic clamp were measured in non-diabetic offspring of type 2 diabetic patients from five European populations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000779> "A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18985156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19789630") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19789630") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2747270/fullTextXML") Annotation(rdfs:comment "The study included healthy non-diabetic offspring who had one parent with known type 2 diabetes and the other parent with no family history of type 2 diabetes and/or a normal response to an OGTT.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000779> "A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000780> (<http://www.ebi.ac.uk/coho/COHO_0000780>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17998437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17998437") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17998437+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The hypothesis-generating data set consisted of 753 individuals with AD by National Institute of Neurological and Communicative Diseases and Stroke/Alzheimer's Disease and Related Disorders Association criteria recruited from 9 memory referral clinics in Canada and 736 ethnically matched control subjects; control subjects were recruited from nonbiological relatives, friends, or spouses of the patients and did not exhibit cognitive impairment by history or cognitive testing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000780> "A multi-site case-control study run with GlaxoSmithKline that recruited people with Alzheimer's disease from memory referral clinics in Canada, with cognitively unimpaired controls from their non-biological relatives, friends or spouses, to find genetic variants associated with Alzheimer's disease risk and age at onset.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17998437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17998437") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17998437+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To identify single-nucleotide polymorphisms (SNPs) associated with risk and age at onset of Alzheimer disease (AD) in a genomewide association study of 469 438 SNPs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000780> "A multi-site case-control study run with GlaxoSmithKline that recruited people with Alzheimer's disease from memory referral clinics in Canada, with cognitively unimpaired controls from their non-biological relatives, friends or spouses, to find genetic variants associated with Alzheimer's disease risk and age at onset.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17998437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3219074/unicode") Annotation(rdfs:comment "The genotypic and associated phenotypic data used in the study, 'Multi-Site Collaborative Study for Genotype-Phenotype Associations in Alzheimer's Disease (GenADA)' were provided by GlaxoSmithKline, R&D Limited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000780> "A multi-site case-control study run with GlaxoSmithKline that recruited people with Alzheimer's disease from memory referral clinics in Canada, with cognitively unimpaired controls from their non-biological relatives, friends or spouses, to find genetic variants associated with Alzheimer's disease risk and age at onset.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000781> (<http://www.ebi.ac.uk/coho/COHO_0000781>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15942624") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361487/fullTextXML") Annotation(rdfs:comment "Since soybean products are widely consumed in Japan, a case–control study taking account of the menopausal status was conducted using data from the hospital-based epidemiologic research program at Aichi Cancer Center (HERPACC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15942624") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361487/fullTextXML") Annotation(rdfs:comment "we have conducted the HERPACC study since 1988, whereby questionnaire survey is completed by first-visit outpatients to the Aichi Cancer Center Hospital (ACCH)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34897183") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML") Annotation(rdfs:comment "The J-CGE consists of data analyzed among healthy participants from the Tohoku Medical Megabank Community-Based Cohort (TMM) Study, the Japan Public Health Centre-based Prospective (JPHC) Study, the Japan Multi-Institutional Collaborative Cohort (J-MICC) Study, and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38277453") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10816704/fullTextXML") Annotation(rdfs:comment "In the HERPACC Study, we included 692 cases and 995 age- and sex-matched controls who were selected from participants in HERPACC-2 (2001–2005) (83) and HERPACC-3 (2005–2013) (24).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3041/MediaObjects/41588_2014_BFng3041_MOESM76_ESM.pdf") Annotation(rdfs:comment "Nagoya Study (Hospital-based Epidemiologic Research Program at Aichi Cancer Center, HERPACC-II)17 : This is a hospital-based, comprehensive epidemiologic research program at the Aichi Cancer Center (ACC), Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3041/MediaObjects/41588_2014_BFng3041_MOESM76_ESM.pdf") Annotation(rdfs:comment "The study protocol was approved by the Institutional Review Board at the ACC (Nagoya, Japan).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000782> (<http://www.ebi.ac.uk/coho/COHO_0000782>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34897183") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML") Annotation(rdfs:comment "The J-CGE consists of data analyzed among healthy participants from the Tohoku Medical Megabank Community-Based Cohort (TMM) Study, the Japan Public Health Centre-based Prospective (JPHC) Study, the Japan Multi-Institutional Collaborative Cohort (J-MICC) Study, and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000782> "A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34897183") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML") Annotation(rdfs:comment "To the best of our knowledge, this is the first example of GWAS summary statistics made publicly available for BMI, height, and weight from a Japanese consortium comprised of a general population of Japanese individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000782> "A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34897183") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML") Annotation(rdfs:comment "We also conducted GWAS in the J-CGE for SNP-height and SNP-weight associations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000782> "A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38277453") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10816704/fullTextXML") Annotation(rdfs:comment "The J-CGE consisted of the following Japanese population-based and hospital-based studies: the HERPACC Study (25), the J-MICC Study (26, 27), the JPHC Study (28), and the TMM Study (29).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000782> "A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000783> (<http://www.ebi.ac.uk/coho/COHO_0000783>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11763136") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25104790") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11763136") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11763136+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The survey consisted of the following three components: (1) self-administered questionnaire survey, (2) collection of blood samples (plasma and buffy coat) for deep-freezed storage and (3) collection of health check-up data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000783> "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11763136") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25104790") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11763136") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11763136+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We set up 140,420 cohort subjects (68,722 men and 71,698 women) (61,595 in 1990 as Cohort I and 78,825 in 1993 as Cohort II) based on resident registry of 29 districts under 11 Public Health Center areas and baseline survey were submitted for them.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000783> "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11763136") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25104790") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25104790") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25104790+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Five- and 10-year follow-up surveys were conducted to update information on lifestyle habits and health conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000783> "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11763136") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25104790") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25104790") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25104790+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Japan Public Health Center-based prospective Study conducted a baseline survey for 140 000 registered residents aged 40-69 years within 11 public health center areas nationwide in 1990-94.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000783> "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11763136") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25104790") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30713262") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6908844/fullTextXML") Annotation(rdfs:comment "The JPHC Study has since yielded more than 300 papers published on associations between potential etiologic factors and the incidence of or mortality from cancer, cardiovascular disease and other diseases associated with shorter life expectancy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000783> "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000784> (<http://www.ebi.ac.uk/coho/COHO_0000784>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5968830/") Annotation(rdfs:comment "Analyses were performed for any stroke (AS), comprising ischemic stroke, ICH, and stroke of unknown or undetermined type (n = 67,162); any ischemic stroke (AIS) regardless of subtype (n = 60,341); and ischemic stroke subtypes (LAS, n = 6,688; CES, n = 9,006; SVS, n = 11,710).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000784> "A multi-ancestry consortium that combined genome-wide association data from 29 studies (67,162 stroke cases and 454,450 controls, mainly of European and East Asian ancestry) in a meta-analysis of stroke and its aetiological subtypes, drawing on contributing groups such as METASTROKE, SiGN, CHARGE and COMPASS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5968830/") Annotation(rdfs:comment "Comparison of the 32 loci across Europeans and East Asians, the two largest ancestral subgroups, demonstrated significant correlations of risk-allele frequencies and ORs between populations (Supplementary Fig. 8)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000784> "A multi-ancestry consortium that combined genome-wide association data from 29 studies (67,162 stroke cases and 454,450 controls, mainly of European and East Asian ancestry) in a meta-analysis of stroke and its aetiological subtypes, drawing on contributing groups such as METASTROKE, SiGN, CHARGE and COMPASS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5968830/") Annotation(rdfs:comment "Participants were drawn from 29 studies with genome-wide genotypes imputed to 1000 Genomes Project (1000G) phase 1v3 or similar14 (MEGASTROKE consortium; Supplementary Note and Supplementary Tables 1 and 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000784> "A multi-ancestry consortium that combined genome-wide association data from 29 studies (67,162 stroke cases and 454,450 controls, mainly of European and East Asian ancestry) in a meta-analysis of stroke and its aetiological subtypes, drawing on contributing groups such as METASTROKE, SiGN, CHARGE and COMPASS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5968830/") Annotation(rdfs:comment "We conducted a multiancestry genome-wide-association meta-analysis in 521,612 individuals (67,162 cases and 454,450 controls) and discovered 22 new stroke risk loci, bringing the total to 32.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000784> "A multi-ancestry consortium that combined genome-wide association data from 29 studies (67,162 stroke cases and 454,450 controls, mainly of European and East Asian ancestry) in a meta-analysis of stroke and its aetiological subtypes, drawing on contributing groups such as METASTROKE, SiGN, CHARGE and COMPASS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5968830/unicode") Annotation(rdfs:comment "Consortia providing stroke data: COMPASS Consortium, EPIC-CVD Consortium, EPIC-InterAct Consortium, ISGC, METASTROKE Consortium, Neurology Working Group of the CHARGE Consortium, NINDS-SiGN, UK Young Lacunar DNA Study, and MEGASTROKE Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000784> "A multi-ancestry consortium that combined genome-wide association data from 29 studies (67,162 stroke cases and 454,450 controls, mainly of European and East Asian ancestry) in a meta-analysis of stroke and its aetiological subtypes, drawing on contributing groups such as METASTROKE, SiGN, CHARGE and COMPASS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000785> (<http://www.ebi.ac.uk/coho/COHO_0000785>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28851447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28851447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5576287/") Annotation(rdfs:comment "In the nationwide French MEMENTO cohort study, participants were recruited in memory clinics and screened for either isolated subjective cognitive complaints (SCCs) or mild cognitive impairment (MCI; defined as test performance 1.5 SD below age, sex and education-level norms) while not demented (Clinical Dementia Rating [CDR] <1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000785> "A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer's disease and related disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28851447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28851447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5576287/") Annotation(rdfs:comment "MEMENTO is a large cohort with extensive clinical, neuropsychological and neuroimaging data and represents a platform for studying the natural history of ADRD in a large group of participants with different subtypes of MCI (amnestic or not amnestic) or isolated SCCs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000785> "A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer's disease and related disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28851447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28851447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5576287/") Annotation(rdfs:comment "The 2323 participants, recruited from April 2011 to June 2014, were aged 71 years, on average (SD 8.7), and 62% were women.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000785> "A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer's disease and related disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28851447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28851447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5576287/") Annotation(rdfs:comment "The MEMENTO cohort is a clinic-based study of patients presenting with a large variety of cognitive symptoms and subjective cognitive complaints (SCCs) that will be followed over a 5-year period.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000785> "A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer's disease and related disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28851447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28851447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5576287/") Annotation(rdfs:comment "To be included in the MEMENTO cohort, participants had to agree to undergo both brain magnetic resonance imaging (MRI) and blood sampling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000785> "A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer's disease and related disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000786> (<http://www.ebi.ac.uk/coho/COHO_0000786>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25041610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25041610") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25041610+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Among cases, 123 were Hispanic (58%), almost one third 70 (32%) were of African descent, and 15 (7%) were white.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000786> "A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25041610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25041610") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25041610+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Miami Stroke Registry is a prospective registry which offers enrollment to consecutive patients admitted with a diagnosis of stroke/transient ischemic attack.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000786> "A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25041610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf") Annotation(rdfs:comment "It was established in November of 2008 in order to investigate stroke type, ischemic stroke subtypes, stroke genetics and stroke outcomes in diverse ethnic population of Miami.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000786> "A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25041610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf") Annotation(rdfs:comment "The MIAMISR at the University of Miami/Jackson Memorial Hospital (Miami, FL, U.S.A.) is an ongoing prospective hospital registry of consecutive patients subjects with prevalent stroke (ischemic and hemorrhagic) and TIA with available neuroimaging (CT or MRI) who provide informed consent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000786> "A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25041610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4056331/unicode") Annotation(rdfs:comment "MIAMISR Miami, USA Hospital-based 2008–2011 331 18–92 36 15 29") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000786> "A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000787> (<http://www.ebi.ac.uk/coho/COHO_0000787>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41406505") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(rdfs:comment "MPP is also population-based, including 33,346 participants recruited by pre-specified birth year groups for health examinations from 1974 to 1992.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000787> "A population-based cohort of 33,346 residents of the city of Malmö in southern Sweden, recruited by pre-specified birth-year groups for health examinations from 1974 to 1992, whose samples and data are used in genetic and biomarker studies of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41406505") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(rdfs:comment "We conducted GWAS and meta-analysis using data from the MDCS (n = 4007), MPP (n = 5097), and PREVEND (n = 3344) cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000787> "A population-based cohort of 33,346 residents of the city of Malmö in southern Sweden, recruited by pre-specified birth-year groups for health examinations from 1974 to 1992, whose samples and data are used in genetic and biomarker studies of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41406505") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(rdfs:comment "We included participants from three cohorts for the GWAS meta-analysis: the Malmö Diet and Cancer study (MDCS) and the Malmö Preventive Project (MPP), both consisting of participants from the city of Malmö in southern Sweden") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000787> "A population-based cohort of 33,346 residents of the city of Malmö in southern Sweden, recruited by pre-specified birth-year groups for health examinations from 1974 to 1992, whose samples and data are used in genetic and biomarker studies of disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000788> (<http://www.ebi.ac.uk/coho/COHO_0000788>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24022301") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24022301") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3992562/") Annotation(rdfs:comment "Here, we describe association analysis of the dyslexia candidate genes/locus in the NeuroDys cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000788> "A European cross-linguistic sample of school-age children, including more than 900 with dyslexia sampled with homogeneous inclusion criteria across eight European countries and a comparable number of controls, assembled by the EU-funded NeuroDys consortium to study the genetics of dyslexia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24022301") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24022301") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3992562/") Annotation(rdfs:comment "The NeuroDys Consortium was funded by the EU [Neurodys, 018696].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000788> "A European cross-linguistic sample of school-age children, including more than 900 with dyslexia sampled with homogeneous inclusion criteria across eight European countries and a comparable number of controls, assembled by the EU-funded NeuroDys consortium to study the genetics of dyslexia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24022301") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24022301") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3992562/") Annotation(rdfs:comment "To address this issue, the NeuroDys Consortium embarked in a large sample collection across eight different European countries applying the same inclusion and exclusion criteria for phenotypic characterization39 and collected 958 cases and 1150 controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000788> "A European cross-linguistic sample of school-age children, including more than 900 with dyslexia sampled with homogeneous inclusion criteria across eight European countries and a comparable number of controls, assembled by the EU-funded NeuroDys consortium to study the genetics of dyslexia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24022301") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24022301") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3992562/") Annotation(rdfs:comment "We generated a European cross-linguistic sample of school-age children – the NeuroDys cohort – that includes more than 900 individuals with dyslexia, sampled with homogenous inclusion criteria across eight European countries, and a comparable number of controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000788> "A European cross-linguistic sample of school-age children, including more than 900 with dyslexia sampled with homogeneous inclusion criteria across eight European countries and a comparable number of controls, assembled by the EU-funded NeuroDys consortium to study the genetics of dyslexia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000789> (<http://www.ebi.ac.uk/coho/COHO_0000789>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18633108") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2551696/fullTextXML") Annotation(rdfs:comment "The participants were recruited from two urban districts (400 participants for each district) and one rural district (800 participants), representing people with high to low socioeconomic status, using a multistage sampling method in each city.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34208976") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8308381/fullTextXML") Annotation(rdfs:comment "Among 1242 Chinese people aged 50–70 years who completed the 6-year resurvey, 76 baseline plasma sphingolipids were quantified by high-throughput liquid chromatography-tandem mass spectrometry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34208976") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8308381/fullTextXML") Annotation(rdfs:comment "Briefly, 3289 adults aged 50–70 years from Beijing and Shanghai were recruited in 2005, and 2529 (76.9%) of them were followed for 6 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34208976") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8308381/fullTextXML") Annotation(rdfs:comment "The participants were from a population-based cohort entitled the Nutrition and Health of Aging People in China (NHAPC) study, which was designed to investigate environmental and genetic factors and their interactions on cardiometabolic diseases [21,22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34208976") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8308381/fullTextXML") Annotation(rdfs:comment "after adjusting for age, sex, region (Beijing or Shanghai), and residence (urban or rural)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc") Annotation(rdfs:comment "The study population consisted of 2,888 unrelated individuals from 50 to 70 years of age (1,250 males and 1,638 females) from the Study on Nutrition and Health of Aging Population in China (NHAPC), a population-based study among unrelated Han Chinese from Shanghai and Beijing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000790> (<http://www.ebi.ac.uk/coho/COHO_0000790>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(rdfs:comment "NUgene collects and stores DNA samples and associated health information from patients at Northwestern Medicine–affiliated hospitals and clinics to be used by scientists to examine the role genes play in the development and treatment of common diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000790> "A genomic biobank sponsored by the Center for Genetic Medicine at Northwestern University in partnership with Northwestern Medicine, collecting DNA samples and self-reported and electronic medical record health information from patients of Northwestern Medicine-affiliated hospitals and clinics to study the role of genes in common diseases and their treatment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(rdfs:comment "The NUgene Project is a genomic biobank sponsored by the Center for Genetic Medicine at Northwestern University in partnership with Northwestern Medicine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000790> "A genomic biobank sponsored by the Center for Genetic Medicine at Northwestern University in partnership with Northwestern Medicine, collecting DNA samples and self-reported and electronic medical record health information from patients of Northwestern Medicine-affiliated hospitals and clinics to study the role of genes in common diseases and their treatment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(rdfs:comment "The health information collected is both self-reported and periodically obtained from the participant's electronic medical record at Northwestern.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000790> "A genomic biobank sponsored by the Center for Genetic Medicine at Northwestern University in partnership with Northwestern Medicine, collecting DNA samples and self-reported and electronic medical record health information from patients of Northwestern Medicine-affiliated hospitals and clinics to study the role of genes in common diseases and their treatment.")
