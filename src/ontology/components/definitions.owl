# Individual: <http://www.ebi.ac.uk/coho/COHO_0001188> (<http://www.ebi.ac.uk/coho/COHO_0001188>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32722720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7386560/fullTextXML") Annotation(rdfs:comment "Referral sources included hospital-based specialty clinics, community clinics, and general practitioners.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32722720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7386560/fullTextXML") Annotation(rdfs:comment "The HKDR consecutively enrolled patients referred to the Diabetes Mellitus and Endocrine Centre for comprehensive assessment of complications and metabolic control.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32722720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7386560/fullTextXML") Annotation(rdfs:comment "This study utilized data from the Hong Kong Diabetes Register (HKDR) established in 1995 at the Prince of Wales Hospital (PWH), the teaching hospital of the Chinese University of Hong Kong [22,23].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40171472") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11960639/fullTextXML") Annotation(rdfs:comment "The QI program was complemented by a series of education and research programmes including the set up of a HKDR-biobank with patient consent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40171472") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11960639/fullTextXML") Annotation(rdfs:comment "the Chinese University of Hong Kong (CUHK) Diabetes Research and Care team initiated a data-driven quality improvement programme at the Prince of Wales Hospital (PWH).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3869744/fullTextXML") Annotation(rdfs:comment "Once a diabetic subject is enrolled, he or she will be observed until death.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001189> (<http://www.ebi.ac.uk/coho/COHO_0001189>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37131148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10152008/fullTextXML") Annotation(rdfs:comment "All HostSeq samples undergo whole genome sequencing in a standardized fashion at one of the three CGEn nodes:") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37131148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10152008/fullTextXML") Annotation(rdfs:comment "Beginning June 2020, CGEn developed HostSeq: a national databank of independent clinical and epidemiological studies enrolling SARS-CoV-2-infected participants across Canada.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37131148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10152008/fullTextXML") Annotation(rdfs:comment "CanCOGeN established a coordinated pan-Canadian network of studies in collaboration with Canada’s national platform for genome sequencing and analysis (CGEn).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37131148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10152008/fullTextXML") Annotation(rdfs:comment "Each partner study was required to adhere to core consent elements (Table S1), contribute blood (or in rare cases saliva) samples for whole genome sequencing, and provide clinical information using a standardized case report form (Table S2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37131148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10152008/fullTextXML") Annotation(rdfs:comment "The unique features of the HostSeq project highlighted here present novel opportunities to develop, evaluate, and apply statistical methods that contribute to the understanding of genetic associations with COVID-19-related morbidity and mortality, as well as other phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37131148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10152008/fullTextXML") Annotation(rdfs:comment "Within these studies, eligible participants include individuals of any age with a positive SARS-CoV-2 test performed by any Health Canada approved method.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001190> (<http://www.ebi.ac.uk/coho/COHO_0001190>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19435955") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2713624/fullTextXML") Annotation(rdfs:comment "A total of 275 children and adolescents aged <16 years with newly diagnosed type 1 diabetes presenting to the pediatric departments between August 1999 and December 2000 were included in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19435955") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2713624/fullTextXML") Annotation(rdfs:comment "After 1, 6, and 12 months of diabetes, a standard liquid meal was used to stimulate endogenous C-peptide release (17).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19435955") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2713624/fullTextXML") Annotation(rdfs:comment "The study was a multicenter longitudinal investigation in 18 pediatric departments representing 15 countries in Europe and Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19435955") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2713624/fullTextXML") Annotation(rdfs:comment "To find a simple definition of partial remission in type 1 diabetes that reflects both residual β-cell function and efficacy of insulin treatment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21429197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3072937/fullTextXML") Annotation(rdfs:comment "HbA1c, IDAA1c, insulin regimen, HLA typing, antibodies (except ZnT8Ab) and liquid-meal stimulated C-peptide levels were analyzed centrally [14].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21429197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3072937/fullTextXML") Annotation(rdfs:comment "The study population representing 15 countries in Europe and Japan was collected through HSG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001191> (<http://www.ebi.ac.uk/coho/COHO_0001191>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35578897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908054/fullTextXML") Annotation(rdfs:comment "A fourth reason for new data collection is the expansion of genetic and molecular epidemiology, where 70 517 participants of the HUNT2 or HUNT3 surveys have been genotyped.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001191> "The second survey of the HUNT Study, conducted in 1995–97, to which all residents of Nord-Trøndelag, Norway, aged 20 or over were invited for questionnaires, interviews, a clinical examination and biological sampling. Its participants have consented to linkage with Norwegian health and administrative registries, and many of them have been genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35578897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908054/fullTextXML") Annotation(rdfs:comment "All current residents ≥20 years of age in Nord-Trøndelag have been invited to each survey wave: the HUNT1 (1984–86, 77 202 participants, 89.4% of invitees participated),1 HUNT2 (1995-97, 65 228 participants, 69.5%)2 and HUNT3 (2006-08, 50 800 participants, 54.1%)3 surveys (Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001191> "The second survey of the HUNT Study, conducted in 1995–97, to which all residents of Nord-Trøndelag, Norway, aged 20 or over were invited for questionnaires, interviews, a clinical examination and biological sampling. Its participants have consented to linkage with Norwegian health and administrative registries, and many of them have been genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35578897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908054/fullTextXML") Annotation(rdfs:comment "In the HUNT Study, all residents aged ≥20 years in the Nord-Trøndelag region, Norway, have been invited to repeated surveys since 1984-86.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001191> "The second survey of the HUNT Study, conducted in 1995–97, to which all residents of Nord-Trøndelag, Norway, aged 20 or over were invited for questionnaires, interviews, a clinical examination and biological sampling. Its participants have consented to linkage with Norwegian health and administrative registries, and many of them have been genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35578897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908054/fullTextXML") Annotation(rdfs:comment "The HUNT participants have consented to linkage to the many high-quality health and administrative registries in Norway, and to information from medical records.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001191> "The second survey of the HUNT Study, conducted in 1995–97, to which all residents of Nord-Trøndelag, Norway, aged 20 or over were invited for questionnaires, interviews, a clinical examination and biological sampling. Its participants have consented to linkage with Norwegian health and administrative registries, and many of them have been genotyped.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35578897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908054/fullTextXML") Annotation(rdfs:comment "The study has been running in Nord-Trøndelag since 1984 and is designed to cover a broad range of health-related topics through repeated surveys with questionnaires, interviews, clinical examinations, laboratory measurements and storage of biological samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001191> "The second survey of the HUNT Study, conducted in 1995–97, to which all residents of Nord-Trøndelag, Norway, aged 20 or over were invited for questionnaires, interviews, a clinical examination and biological sampling. Its participants have consented to linkage with Norwegian health and administrative registries, and many of them have been genotyped.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001192> (<http://www.ebi.ac.uk/coho/COHO_0001192>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25682233") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4404207/") Annotation(rdfs:comment "At 5-year follow-up of the CoLaus/PsyCoLaus cohort (in 2009–12), individuals who were willing to return underwent a second physical (n=5064) and psychiatric (n=4001) examination and were given questionnaires by trained interviewers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25682233") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4404207/") Annotation(rdfs:comment "Between Sept 1, 2009, and June 30, 2013, a consecutive sample of 3043 people from the CoLaus/PsyCoLaus study cohort were invited to undergo polysomnography overnight at their home (appendix p 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25682233") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4404207/") Annotation(rdfs:comment "Sleep-related complaints and habits were investigated using the Pittsburgh sleep quality index, the Epworth sleepiness scale, and the Berlin questionnaire for sleep-disordered breathing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25682233") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4404207/") Annotation(rdfs:comment "They equipped participants with a polysomnographic recorder (Titanium, Embla Flaga, Reykjavik, Iceland) between 1700 h and 2000 h at the Center for Investigation and Research in Sleep at the University Hospital of Lausanne.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35861817") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9707830/fullTextXML") Annotation(rdfs:comment "Between 2014 and 2017, participants underwent a second examination in which clinical parameters were reassessed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35861817") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9707830/fullTextXML") Annotation(rdfs:comment "The sample was derived from the prospective CoLaus|PsyCoLaus population‐based cohort 24 , 25 and HypnoLaus, a nested study, designed to assess the prevalence and determinants of sleep disorders in participants randomly selected from the city of Lausanne, Switzerland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001193> (<http://www.ebi.ac.uk/coho/COHO_0001193>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38555957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML") Annotation(rdfs:comment "All of the women were over 18 years old, French speaking, and of European ancestry (defined by self-declaration of the four grandparents born in Europe).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38555957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML") Annotation(rdfs:comment "Among the women included in the maternity department between the 2nd and 5th day postpartum, 91.1% were followed up at 8 weeks postpartum to assess early-onset PPD, and 71.0% at 1 year after childbirth to assess late-onset PPD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38555957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML") Annotation(rdfs:comment "Assessment for depression was performed at three time points (immediately after childbirth, 8 weeks, and 1 year postpartum) by a trained clinician using reliable DSM-5 criteria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38555957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML") Annotation(rdfs:comment "DNA was extracted from blood samples and genotyping was performed using the Illumina Global Screening Array with a multidisease drop-in panel (GSA-MD v1.0).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38555957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML") Annotation(rdfs:comment "IGEDEPP is a French prospective cohort of 3,310 women from 8 maternity departments in the Paris metropolitan area and included between November 2011 and June 2016.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38555957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML") Annotation(rdfs:comment "The study was sponsored by Assistance Publique – Hôpitaux de Paris (Délégation à la Recherche Clinique et à l’Innovation).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001194> (<http://www.ebi.ac.uk/coho/COHO_0001194>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38783053") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11540845/fullTextXML") Annotation(rdfs:comment "Genomic DNA was isolated from saliva samples or buccal swabs collected using Oragene DNA OG-500 or OC-175 kits, respectively (DNA Genotek)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38783053") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11540845/fullTextXML") Annotation(rdfs:comment "The study sample included 4278 school-age children and adolescents from the INSchool cohort (mean age = 10.03 years, SD = 2.95; 43.7% females) from 45 primary and secondary schools across Catalunya, Spain, with GWAS and data on school performance available.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41554769") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12820112/fullTextXML") Annotation(rdfs:comment "ND were determined by trained psychiatrists and neuropsychologists using DSM-IV-TR criteria for assessments conducted before 2014 and DSM-5 criteria for those conducted afterwards.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41554769") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12820112/fullTextXML") Annotation(rdfs:comment "Parents and teachers completed standardized screening instruments for mental health problems and learning difficulties.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41554769") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12820112/fullTextXML") Annotation(rdfs:comment "Specifically, the current investigation analyzes data collected cross-sectionally over 11 academic years (i.e., from 2011–2012 to 2022–2023) using a two-step procedure.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41554769") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12820112/fullTextXML") Annotation(rdfs:comment "The final sample comprised 9018 participants aged 5–17.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001195> (<http://www.ebi.ac.uk/coho/COHO_0001195>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31722307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41350806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31722307") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31722307+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Genomic DNA samples and B-cell lines of patients with ALS were stored and linked to clinical information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001195> "A multicentre patient registry established in Japan in 2006 to register and follow up patients with amyotrophic lateral sclerosis across many participating institutions, collecting DNA samples and clinical data with periodic telephone follow-up to study the natural history, genetic background and prognosis of ALS.")
