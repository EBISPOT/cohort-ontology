AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25588294") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25588294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25588294+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We undertook NMR-stratified multicentre, randomised, placebo-controlled clinical trial from Nov 16, 2010, to Sept 12, 2014, at four sites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000844> "A multicentre, randomised, placebo-controlled smoking-cessation trial (NCT01314001) run from 2010 to 2014 at four academic medical centres in the United States and Canada, in which 1246 treatment-seeking smokers stratified by nicotine metabolite ratio were assigned to placebo, nicotine patch or varenicline.")
