AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12854838") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15068502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24386199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24480136") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24386199") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3875449/fullTextXML") Annotation(rdfs:comment "The Osteoporosis and Ultrasound Study (OPUS) is a multicenter prospective study of risk factors for fractures in post menopausal women.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002220> "A multicentre, population-based prospective study of risk factors for osteoporotic fracture in which women aged over 55 years (with a group of younger women aged 20 to 39 years) were recruited from random population samples at five European centres (Aberdeen, Berlin, Kiel, Paris and Sheffield) between 1999 and 2001 and followed for about six years, with bone densitometry, quantitative ultrasound of bone, spine radiographs and bone turnover markers.")
