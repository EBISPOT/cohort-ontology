AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34000622") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38337670") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-021-03767-x/MediaObjects/41586_2021_3767_MOESM6_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34000622") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8118723/fullTextXML") Annotation(rdfs:comment "Patients admitted to one of the two academic hospitals within Amsterdam UMC were prospectively included if they were admitted on the COVID-19 ward (general ward cohort), COVID-19 ICU (ICU cohort) or on the regular ICU (control ICU cohort).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001485> "A prospective cohort and biobank, set up by the Amsterdam UMC COVID study group, of adult patients admitted with COVID-19 from 2020 to the COVID-19 wards and intensive care units of the two academic hospitals of Amsterdam UMC (locations University of Amsterdam and Vrije Universiteit Amsterdam) in the Netherlands, which stores their clinical data and left-over and serially collected biological samples. Its genotyped patients, with controls, were contributed to the COVID-19 Host Genetics Initiative's genome-wide association meta-analyses of COVID-19.")
