AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22891074") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23047549") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23047549") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3493867/fullTextXML") Annotation(rdfs:comment "Data for this study were drawn from three population-based studies of epithelial ovarian cancer: the Familial Ovarian Tumour Study (FOTS) in Toronto (Risch et al, 2001), the Tampa Bay Ovarian Cancer Study (TBOCS) at the Moffitt Cancer Center (Pal et al, 2005)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002441> "A population-based case-control study of epithelial ovarian cancer run by the Moffitt Cancer Center in Tampa, Florida, United States, which since 2000 has recruited women newly diagnosed with ovarian cancer, through rapid case ascertainment in the two most populous counties of the Tampa Bay region, and control women, with data collected by interview.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22891074") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23047549") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23047549") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3493867/fullTextXML") Annotation(rdfs:comment "Eligibility criteria for study enrolment included diagnosis of incident, pathologically confirmed primary epithelial ovarian cancer, either borderline or invasive, and age 20 years or above.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002441> "A population-based case-control study of epithelial ovarian cancer run by the Moffitt Cancer Center in Tampa, Florida, United States, which since 2000 has recruited women newly diagnosed with ovarian cancer, through rapid case ascertainment in the two most populous counties of the Tampa Bay region, and control women, with data collected by interview.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22891074") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23047549") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23047549") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3493867/fullTextXML") Annotation(rdfs:comment "The TBOCS cases were recruited through a rapid case ascertainment mechanism in the two most populous counties in the Tampa Bay region.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002441> "A population-based case-control study of epithelial ovarian cancer run by the Moffitt Cancer Center in Tampa, Florida, United States, which since 2000 has recruited women newly diagnosed with ovarian cancer, through rapid case ascertainment in the two most populous counties of the Tampa Bay region, and control women, with data collected by interview.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22891074") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23047549") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36688720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10165492/") Annotation(rdfs:comment "TBO (35) USA Tampa Bay Ovarian Cancer Study 2000-present Population-based Interview 60.53 (10.85) 205 (41.8) 285 (58.2)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002441> "A population-based case-control study of epithelial ovarian cancer run by the Moffitt Cancer Center in Tampa, Florida, United States, which since 2000 has recruited women newly diagnosed with ovarian cancer, through rapid case ascertainment in the two most populous counties of the Tampa Bay region, and control women, with data collected by interview.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22891074") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23047549") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36688720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10165492/") Annotation(rdfs:comment "This study included 25 case-control studies (see Table 1) (16-42) from OCAC (43).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002441> "A population-based case-control study of epithelial ovarian cancer run by the Moffitt Cancer Center in Tampa, Florida, United States, which since 2000 has recruited women newly diagnosed with ovarian cancer, through rapid case ascertainment in the two most populous counties of the Tampa Bay region, and control women, with data collected by interview.")

