AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15715680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25273948") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25273948") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML") Annotation(rdfs:comment "All laboratory parameters were determined in the fasting state.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002341> "A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15715680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25273948") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25273948") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML") Annotation(rdfs:comment "Intima-media thickness (IMT) was measured end-diastolic according to the leading edge method for both the near and far walls on the common and internal carotid arteries by high resolution B-mode ultrasound using the ATL HDI 3000 CV (Philips Medical Systems, Bothell, WA, USA) according to the Asymptomatic Carotid Artery Plaque Study (ACAPS) protocol [21].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002341> "A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15715680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25273948") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25273948") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML") Annotation(rdfs:comment "Study participants were recruited by health screening programs in large companies in and around the city of Salzburg, Austria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002341> "A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15715680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25273948") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25273948") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML") Annotation(rdfs:comment "The Salzburg Atherosclerosis Prevention Program in subjects at High Individual Risk (the SAPHIR study) has been initiated in 1999 as a prospective study that investigates genetic and environmental factors contributing to atherosclerotic vascular diseases [20].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002341> "A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15715680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25273948") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25273948") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML") Annotation(rdfs:comment "The study comprises 1770 healthy unrelated Caucasian subjects (663 females and 1107 males aged 39-67 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002341> "A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.")

