# Individual: <http://www.ebi.ac.uk/coho/COHO_0000209> (<http://www.ebi.ac.uk/coho/COHO_0000209>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28572459") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28572459+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The AACR Project GENIE aims to catalyze sharing of integrated genomic and clinical datasets across multiple institutions worldwide, and thereby enable precision cancer medicine research") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000209> "An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28572459") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28572459+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The AACR Project GENIE is an international data-sharing consortium focused on generating an evidence base for precision cancer medicine by integrating clinical-grade cancer genomic data with clinical outcome data for tens of thousands of cancer patients treated at multiple institutions worldwide.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000209> "An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41647353") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41647353+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The American Association for Cancer Research (AACR) Project GENIE (Genomics Evidence Neoplasia Information Exchange) Biopharma Collaborative (BPC) is a multi-phase, pre-competitive collaboration between 10 biopharmaceutical companies and select GENIE-participating academic institutions, focused on detailed clinical annotations of a subset of patients within the GENIE Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000209> "An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://aacrprojectgenie.org/data/") Annotation(rdfs:comment "Through strategic partnerships with Sage Bionetworks and cBioPortal, the registry aggregates and harmonizes clinical-grade, next-generation sequencing data from patients treated at participating institutions and makes the data publicly available ensuring they remain accessible to the global cancer research community for the benefit of all.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000209> "An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000210> (<http://www.ebi.ac.uk/coho/COHO_0000210>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000131") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38811554") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38811554+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To predict outcome to combination bevacizumab (BVZ) therapy, we employed cell-free DNA (cfDNA) to determine chromosomal instability (CIN), nucleosome footprints (NF) and methylation profiles in metastatic colorectal cancer (mCRC) patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000210> "A cohort of patients with metastatic colorectal cancer treated with bevacizumab-containing therapy in the AC-ANGIOPREDICT phase II trial, whose tumour, normal and plasma samples were sequenced to identify biomarkers of response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000131") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000131") Annotation(rdfs:comment "Low-coverage whole-genome sequencing (LC-WGS) was performed on tumor tissue, normal tissue and plasma samples collected from mCRC patients from the AC-ANGIOPREDICT Phase II trial (NCT01822444) and the University Medical Center Mannheim (UMM).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000210> "A cohort of patients with metastatic colorectal cancer treated with bevacizumab-containing therapy in the AC-ANGIOPREDICT phase II trial, whose tumour, normal and plasma samples were sequenced to identify biomarkers of response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000131") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000131") Annotation(rdfs:comment "This dataset includes FASTQ files of low coverage whole genome sequencing of normal tissue (n = 8), tumor tissue (n = 55) and cell free DNA from plasma samples (n=101) from patients with metastatic colorectal cancer treated with bevacizumab.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000210> "A cohort of patients with metastatic colorectal cancer treated with bevacizumab-containing therapy in the AC-ANGIOPREDICT phase II trial, whose tumour, normal and plasma samples were sequenced to identify biomarkers of response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000211> (<http://www.ebi.ac.uk/coho/COHO_0000211>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000525") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26598744") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4872016/") Annotation(rdfs:comment "The ALTTO trial (Breast International Group BIG 2-06/EGF106708 and North Central Cancer Treatment Group [Alliance] N063D) is an international, intergroup, open-label, phase III randomized trial in patients with HER2-positive early breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000211> "A cohort of patients with HER2-positive early breast cancer enrolled in the ALTTO phase III trial of adjuvant trastuzumab and lapatinib, whose tumours have been profiled to define molecular subtypes associated with the risk of distant recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000525") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39613746") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-024-54621-3/MediaObjects/41467_2024_54621_MOESM7_ESM.pdf") Annotation(rdfs:comment "Patients were assigned to study treatment (i.e., 1 year of adjuvant therapy with trastuzumab, lapatinib, their sequence (trastuzumab followed by lapatinib), or their combination (trastuzumab + lapatinib) in accordance with the randomisation schedule.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000211> "A cohort of patients with HER2-positive early breast cancer enrolled in the ALTTO phase III trial of adjuvant trastuzumab and lapatinib, whose tumours have been profiled to define molecular subtypes associated with the risk of distant recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000525") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39613746") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-024-54621-3/MediaObjects/41467_2024_54621_MOESM7_ESM.pdf") Annotation(rdfs:comment "The ALTTO trial recruited patients (women or men) with HER2-positive breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000211> "A cohort of patients with HER2-positive early breast cancer enrolled in the ALTTO phase III trial of adjuvant trastuzumab and lapatinib, whose tumours have been profiled to define molecular subtypes associated with the risk of distant recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000525") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39613746") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11607438/fullTextXML") Annotation(rdfs:comment "Here, by performing gene expression profiling in HER2-positive breast cancers from patients receiving adjuvant trastuzumab in the ALTTO clinical trial (NCT00490139), we identify and characterize five molecular subtypes associated with the risk of distant recurrence: immune-enriched, proliferative/metabolic-enriched, mesenchymal/stroma-enriched, luminal, and ERBB2-dependent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000211> "A cohort of patients with HER2-positive early breast cancer enrolled in the ALTTO phase III trial of adjuvant trastuzumab and lapatinib, whose tumours have been profiled to define molecular subtypes associated with the risk of distant recurrence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000212> (<http://www.ebi.ac.uk/coho/COHO_0000212>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28419249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28419249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837640/fullTextXML") Annotation(rdfs:comment "In this study, we identified women who were at least 18 years old, had had sexual intercourse and had no previous history of cervical abnormalities, cervical cancer or total abdominal hysterectomy, by area sampling in Abuja.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000212> "An H3Africa cohort of women recruited in Abuja, Nigeria, by the African Collaborative Center for Microbiome and Genomics Research to investigate the vaginal microbiome, human papillomavirus persistence and cervical cancer risk, described in the centre's cohort profile.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28419249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28419249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837640/fullTextXML") Annotation(rdfs:comment "The ACCME cohort is located in Nigeria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000212> "An H3Africa cohort of women recruited in Abuja, Nigeria, by the African Collaborative Center for Microbiome and Genomics Research to investigate the vaginal microbiome, human papillomavirus persistence and cervical cancer risk, described in the centre's cohort profile.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28419249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28419249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837640/fullTextXML") Annotation(rdfs:comment "The design of the African Collaborative Center for Microbiome and Genomics Research (ACCME) HPV and Cervical Cancer Cohort Study enables us to study environmental, microbiomic, genetic and epigenetic factors associated with persistent hrHPV infection, in order to improve knowledge of the mechanism of HPV carcinogenesis and discover biomarkers of persistent hrHPV infection and cervical cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000212> "An H3Africa cohort of women recruited in Abuja, Nigeria, by the African Collaborative Center for Microbiome and Genomics Research to investigate the vaginal microbiome, human papillomavirus persistence and cervical cancer risk, described in the centre's cohort profile.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28419249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28419249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837640/fullTextXML") Annotation(rdfs:comment "We are participating in the development of the H3Africa Consortium Genome Analysis Array chip in collaboration with other H3Africa projects and Illumina Inc.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000212> "An H3Africa cohort of women recruited in Abuja, Nigeria, by the African Collaborative Center for Microbiome and Genomics Research to investigate the vaginal microbiome, human papillomavirus persistence and cervical cancer risk, described in the centre's cohort profile.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000213> (<http://www.ebi.ac.uk/coho/COHO_0000213>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001917") Annotation(rdfs:comment "APCDR The African Genome Resource - A continent specific haplotype reference panel, transcriptomic resource and pan-continental data centre") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000213> "A resource of the African Partnership for Chronic Disease Research that combines approximately 3,000 whole-genome sequences and 600 transcriptomes from African populations into a continent-specific haplotype reference panel, an African transcriptome resource and an informatics centre in Uganda.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001917") Annotation(rdfs:comment "RNAseq data from 6 different populations and the first large-scale resource to examine eQTLs within Africa, as well as diversity of splicing isoforms, and help identify novel transcripts, and exons across the genome.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000213> "A resource of the African Partnership for Chronic Disease Research that combines approximately 3,000 whole-genome sequences and 600 transcriptomes from African populations into a continent-specific haplotype reference panel, an African transcriptome resource and an informatics centre in Uganda.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001917") Annotation(rdfs:comment "The African Genome Resource encompasses approximately 3000 whole genome sequences, 600 transcriptomes and an infrastructure for computation and capacity development in the form of a new informatics centre in Uganda.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000213> "A resource of the African Partnership for Chronic Disease Research that combines approximately 3,000 whole-genome sequences and 600 transcriptomes from African populations into a continent-specific haplotype reference panel, an African transcriptome resource and an informatics centre in Uganda.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001917") Annotation(rdfs:comment "Whole genome DNAseq data at 4x-8x depth from approximately 3,000 Africans of 14 distinct ethnicities, which is the largest and most diverse set of haplotypes for the continent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000213> "A resource of the African Partnership for Chronic Disease Research that combines approximately 3,000 whole-genome sequences and 600 transcriptomes from African populations into a continent-specific haplotype reference panel, an African transcriptome resource and an informatics centre in Uganda.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000214> (<http://www.ebi.ac.uk/coho/COHO_0000214>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25470054") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25470054") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4297536/fullTextXML") Annotation(rdfs:comment "The African Genome Variation Project (AGVP) is an international collaboration that expands on these efforts by systematically assessing genetic diversity among 1,481 individuals from 18 ethno-linguistic groups from sub-Saharan Africa (SSA) (Fig. 1 and Supplementary Methods Tables 1 and 2) with the HumanOmni2.5M genotyping array and whole-genome sequences (WGS) from 320 individuals (Supplementary Methods Table 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000214> "A collection of 1,481 individuals from 18 ethno-linguistic groups in sub-Saharan Africa with dense genotype data, and 320 individuals from seven groups with low-coverage whole-genome sequence, assembled by the African Partnership for Chronic Disease Research to characterise population diversity and support the design and interpretation of genomic studies in Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25470054") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25470054") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4297536/fullTextXML") Annotation(rdfs:comment "We also thank the African Partnership for Chronic Disease Research (APCDR) for providing a network to support this study as well as a repository for deposition of curated data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000214> "A collection of 1,481 individuals from 18 ethno-linguistic groups in sub-Saharan Africa with dense genotype data, and 320 individuals from seven groups with low-coverage whole-genome sequence, assembled by the African Partnership for Chronic Disease Research to characterise population diversity and support the design and interpretation of genomic studies in Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25470054") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000959") Annotation(rdfs:comment "The AGVP represents dense genotyping data on 1,481 individuals from 18 ethno-linguistic groups and low coverage whole genome sequencing data on 320 individuals from 7 ethno-linguistic groups in SSA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000214> "A collection of 1,481 individuals from 18 ethno-linguistic groups in sub-Saharan Africa with dense genotype data, and 320 individuals from seven groups with low-coverage whole-genome sequence, assembled by the African Partnership for Chronic Disease Research to characterise population diversity and support the design and interpretation of genomic studies in Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25470054") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000959") Annotation(rdfs:comment "The African Genome Variation Project (AGVP) aims to provide a global resource to understand population diversity and help design, implement and interpret genomic studies in sub-Saharan Africa (SSA), and worldwide.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000214> "A collection of 1,481 individuals from 18 ethno-linguistic groups in sub-Saharan Africa with dense genotype data, and 320 individuals from seven groups with low-coverage whole-genome sequence, assembled by the African Partnership for Chronic Disease Research to characterise population diversity and support the design and interpretation of genomic studies in Africa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000215> (<http://www.ebi.ac.uk/coho/COHO_0000215>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34925446") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8674726/fullTextXML") Annotation(rdfs:comment "The APCDR cohort comprises four studies: the Ugandan Genome Resource (UGR), the Durban Diabetes Study (DDS), the Durban Case–Control Study (DCC), and the Africa America Diabetes Mellitus Study (AADM).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000215> "A consortium of research groups in Africa and the United Kingdom that brings together population cohorts and genomic resources from sub-Saharan Africa, including the African Genome Variation Project, the Uganda General Population Cohort, the Genome Diversity in Africa Project and the Durban diabetes studies, to investigate the genetics of chronic disease in African populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34925446") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8674726/fullTextXML") Annotation(rdfs:comment "The African Partnership for Chronic Disease Research (APCDR) is an organization set out to advance collaboration of epidemiological and genomic research of non-communicable diseases in sub-Saharan Africa.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000215> "A consortium of research groups in Africa and the United Kingdom that brings together population cohorts and genomic resources from sub-Saharan Africa, including the African Genome Variation Project, the Uganda General Population Cohort, the Genome Diversity in Africa Project and the Durban diabetes studies, to investigate the genetics of chronic disease in African populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35393596") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC9009299/") Annotation(rdfs:comment "Uganda-APCDR is a population-based cohort from the General Population Cohort (GPC), Uganda.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000215> "A consortium of research groups in Africa and the United Kingdom that brings together population cohorts and genomic resources from sub-Saharan Africa, including the African Genome Variation Project, the Uganda General Population Cohort, the Genome Diversity in Africa Project and the Durban diabetes studies, to investigate the genetics of chronic disease in African populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000929") Annotation(rdfs:comment "APCDR GDAP: Genome Diversity in Africa Study (set of 9 samples at high depth)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000215> "A consortium of research groups in Africa and the United Kingdom that brings together population cohorts and genomic resources from sub-Saharan Africa, including the African Genome Variation Project, the Uganda General Population Cohort, the Genome Diversity in Africa Project and the Durban diabetes studies, to investigate the genetics of chronic disease in African populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000959") Annotation(rdfs:comment "APCDR AGV Project: The African Genome Variation Project(dense array genotyping data)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000215> "A consortium of research groups in Africa and the United Kingdom that brings together population cohorts and genomic resources from sub-Saharan Africa, including the African Genome Variation Project, the Uganda General Population Cohort, the Genome Diversity in Africa Project and the Durban diabetes studies, to investigate the genetics of chronic disease in African populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000216> (<http://www.ebi.ac.uk/coho/COHO_0000216>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40546727") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40546727+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A strong correlation existed between adverse genomic risk and minimal residual disease (MRD) at the end of consolidation, translating to inferior overall and relapse free survival.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000216> "A cohort of adolescent and young adult patients aged 15–39 with acute lymphoblastic leukaemia treated on the Australasian Leukaemia and Lymphoma Group's ALL06 minimal residual disease-stratified paediatric protocol and profiled genomically to relate genomic risk to outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40546727") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40546727+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We aimed to describe the genomic drivers of ALL in an adolescent and young adult (AYA) cohort (ALL06; target age, 15-39 years; recruited age, 16.6-39 years), treated uniformly on a pediatric-inspired protocol (the Australasian Leukaemia and Lymphoma Group ALL06 study).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000216> "A cohort of adolescent and young adult patients aged 15–39 with acute lymphoblastic leukaemia treated on the Australasian Leukaemia and Lymphoma Group's ALL06 minimal residual disease-stratified paediatric protocol and profiled genomically to relate genomic risk to outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000752") Annotation(rdfs:comment "ALL06 clinical trial described the efficacy and tolerability of AYA ALL patients aged 15-39 years treated on a single minimal residual disease (MRD)-stratified platform.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000216> "A cohort of adolescent and young adult patients aged 15–39 with acute lymphoblastic leukaemia treated on the Australasian Leukaemia and Lymphoma Group's ALL06 minimal residual disease-stratified paediatric protocol and profiled genomically to relate genomic risk to outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000217> (<http://www.ebi.ac.uk/coho/COHO_0000217>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39148102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11325793/fullTextXML") Annotation(rdfs:comment "In brief, adult patients (≥ 18 years) with cancer who were intended to start treatment with fluoropyrimidine-based therapy in 17 hospitals in the Netherlands were included.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000217> "A cohort of 1,181 adult cancer patients starting fluoropyrimidine-based therapy in 17 hospitals in the Netherlands, genotyped prospectively for DPYD variants and analysed genome-wide to identify variants linked to severe fluoropyrimidine toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39148102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11325793/fullTextXML") Annotation(rdfs:comment "In total, 1181 were included in the Alpe-DPD study, of which 1103 were evaluable (Fig. 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000217> "A cohort of 1,181 adult cancer patients starting fluoropyrimidine-based therapy in 17 hospitals in the Netherlands, genotyped prospectively for DPYD variants and analysed genome-wide to identify variants linked to severe fluoropyrimidine toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39148102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39148102+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Alpe-DPD study (NCT02324452) demonstrated that prospective genotyping and dose-individualization using four alleles in DPYD (DPYD*2A/rs3918290, c.1236G > A/rs75017182, c.2846A > T/rs67376798 and c.1679 T > G/rs56038477) can mitigate the risk of severe fluoropyrimidine toxicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000217> "A cohort of 1,181 adult cancer patients starting fluoropyrimidine-based therapy in 17 hospitals in the Netherlands, genotyped prospectively for DPYD variants and analysed genome-wide to identify variants linked to severe fluoropyrimidine toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007855") Annotation(rdfs:comment "A genome-wide association study (GWAS) with patients treated with fluoropyrimidines was performed to identify genetic variants linked to the severe fluoropyrimidine-related toxicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000217> "A cohort of 1,181 adult cancer patients starting fluoropyrimidine-based therapy in 17 hospitals in the Netherlands, genotyped prospectively for DPYD variants and analysed genome-wide to identify variants linked to severe fluoropyrimidine toxicity.")

