AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11176911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11176911+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 2459 community-dwelling Yoruba residents of Ibadan, Nigeria, without dementia, and 2147 community-dwelling African American residents of Indianapolis, Ind, without dementia (all aged 65 years or older).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11176911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11176911+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Each wave followed a 2-stage design, with an in-home screening interview followed by a full diagnostic workup of a subsample of participants based on screening performance.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11176911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11176911+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Indianapolis-Ibadan Dementia Project, a longitudinal, prospective population-based study consisting of a baseline survey (1992-1993) and 2 subsequent follow-up waves after 2 years (1994-1995) and 5 years (1997-1998).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11176911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11176911+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This is the first report of incidence rate differences for dementia and AD in studies of 2 populations from nonindustrialized and industrialized countries using identical methods and the same group of investigators in both sites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11176911") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11176911+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To compare incidence rates of dementia and AD in 2 diverse, elderly community-dwelling populations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26218444") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26218444+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "African-Americans residing in Indianapolis and Yoruba in Ibadan, Nigeria without dementia were enrolled in 1992 and 2001 and evaluated every 2-3 years until 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")

