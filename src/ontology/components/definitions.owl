AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36194120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36194120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML") Annotation(rdfs:comment "Information on participants from national health registries provides prospective data on hospital contacts, diagnoses, prescriptions, vital status and more.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000475> "An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36194120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36194120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML") Annotation(rdfs:comment "The DBDS is an ongoing, national prospective cohort of blood donors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000475> "An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36194120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36194120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML") Annotation(rdfs:comment "The Danish Blood Donor Study (DBDS) was established as a platform for the study of health effects of blood donation and as a public health study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000475> "An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36194120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36194120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML") Annotation(rdfs:comment "The Infinium Global Screening Array (Illumina Inc., USA) was used to genotype more than 650 000 single nucleotide polymorphisms allowing for genome-wide association studies (GWAS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000475> "An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36194120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36194120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML") Annotation(rdfs:comment "The cohort was initiated in 2010 and by 2015 it covered all blood donation facilities in Denmark.As of February 2022, DBDS includes 138 491 participants (51% women, age span at inclusion 18–70 years) who have completed a total of 371 589 questionnaires and with 1 091 499 person-years of follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000475> "An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000476> (<http://www.ebi.ac.uk/coho/COHO_0000476>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34620218") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(rdfs:comment "was a study of AA from the Washington DC metropolitan area (USA) and was designed to investigate the genetic and environmental basis of common complex traits such as hypertension, obesity, and T2D [32].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000476> "A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(rdfs:comment "In order to maximize the utility of this cohort for the study of multiple common traits, families were not ascertained based on any phenotype.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000476> "A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(rdfs:comment "Participant enrollment was carried out at the Howard University General Clinical Research Center (GCRC), which is supported by grant number 2M01RR010284 from the National Center for Research Resources (NCRR), a component of the National Institutes of Health (NIH).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000476> "A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(rdfs:comment "The major objectives of the HUFS were to: 1) enroll and examine a randomly ascertained cohort of African-American families, along with a set of unrelated individuals, from the Washington DC metropolitan area to study the genetic and environmental basis of common complex diseases including hypertension, obesity and associated phenotypes;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000476> "A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(rdfs:comment "The subjects studied were all participants in the Howard University Family Study (HUFS), a population based family study of African Americans in the Washington metropolitan area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000476> "A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000477> (<http://www.ebi.ac.uk/coho/COHO_0000477>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24678955") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24678955+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In a double-blind trial, we randomly assigned 15,828 patients with stable coronary heart disease to receive either once-daily darapladib (at a dose of 160 mg) or placebo.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33439866") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7817029/fullTextXML") Annotation(rdfs:comment "GlaxoSmithKline sponsored the main STABILITY trial and the biobanking of the samples but provided no specific support for this sub-study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33439866") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7817029/fullTextXML") Annotation(rdfs:comment "In the STabilization of Atherosclerotic plaque By Initiation of darapLadIb TherapY (STABILITY) trial (ClinicalTrials.gov ID NCT00799903) randomizing 15,828 patients with chronic CHD to darapladib or placebo, without any significant effect on outcomes during 3 to 5 years follow-up, we obtained plasma aliquots from all patients at baseline [12,13].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33439866") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7817029/fullTextXML") Annotation(rdfs:comment "The initial cohort of the present study was a substudy of the previously published international STABILITY trial, which compared darapladib, a selective inhibitor of Lp-PLA2, with placebo concerning the occurrence of CV events in 15,828 patients with chronic CHD out of whom 14,124 provided blood samples for the biomarker substudy [12,13].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33439866") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7817029/fullTextXML") Annotation(rdfs:comment "The patients were recruited in 663 centers in 39 countries from December 2008 to April 2010.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37563310") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10457199/fullTextXML") Annotation(rdfs:comment "Funding of the GWASs and proteomics studies of STABILITY and ARISTOTLE were supported by GlaxoSmithKline, BristolMyersSquibb and the Swedish Foundation for Strategic Research") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000478> (<http://www.ebi.ac.uk/coho/COHO_0000478>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/one/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/two/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36504281") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9832827/fullTextXML") Annotation(rdfs:comment "All BioFINDER participants with available CSF biomarker data and genotyping data were included.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort, the first Swedish BioFINDER study (BioFINDER-1, NCT01208675), of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and followed for up to 10 years with cerebrospinal fluid, plasma, MRI, amyloid PET and genetic data to develop early and accurate diagnosis of Alzheimer disease, Parkinson disease and related disorders. It is distinct from the later, independent BioFINDER-2 study (NCT03174938), launched in 2017.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/one/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/two/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36504281") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9832827/fullTextXML") Annotation(rdfs:comment "Participants were recruited in the prospective and longitudinal BioFINDER study (NCT01208675) from 2009 to 2014, at three neurology and memory clinics in southern Sweden.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort, the first Swedish BioFINDER study (BioFINDER-1, NCT01208675), of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and followed for up to 10 years with cerebrospinal fluid, plasma, MRI, amyloid PET and genetic data to develop early and accurate diagnosis of Alzheimer disease, Parkinson disease and related disorders. It is distinct from the later, independent BioFINDER-2 study (NCT03174938), launched in 2017.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/one/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/two/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biofinder.se/one/") Annotation(rdfs:comment "1) Develop methods for early and accurate diagnosis of Alzheimer’s disease (AD) and Parkinson’s disease (PD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort, the first Swedish BioFINDER study (BioFINDER-1, NCT01208675), of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and followed for up to 10 years with cerebrospinal fluid, plasma, MRI, amyloid PET and genetic data to develop early and accurate diagnosis of Alzheimer disease, Parkinson disease and related disorders. It is distinct from the later, independent BioFINDER-2 study (NCT03174938), launched in 2017.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/one/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/two/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biofinder.se/one/") Annotation(rdfs:comment "More than 1600 patients with mild cognitive symptoms, dementia and parkinsonian symptoms as well as cognitively healthy elderly was enrolled in the study with longitudnal follow-up up to 10 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort, the first Swedish BioFINDER study (BioFINDER-1, NCT01208675), of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and followed for up to 10 years with cerebrospinal fluid, plasma, MRI, amyloid PET and genetic data to develop early and accurate diagnosis of Alzheimer disease, Parkinson disease and related disorders. It is distinct from the later, independent BioFINDER-2 study (NCT03174938), launched in 2017.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/one/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/two/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biofinder.se/one/") Annotation(rdfs:comment "The subjects underwent repeated examinations of advanced MRI (including fMRI, DTI, DKI, ASL and MPRAGE), CSF and plasma analysis, amyloid PET, detailed clinical assessments and neuropsychological examinations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort, the first Swedish BioFINDER study (BioFINDER-1, NCT01208675), of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and followed for up to 10 years with cerebrospinal fluid, plasma, MRI, amyloid PET and genetic data to develop early and accurate diagnosis of Alzheimer disease, Parkinson disease and related disorders. It is distinct from the later, independent BioFINDER-2 study (NCT03174938), launched in 2017.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/one/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biofinder.se/two/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://biofinder.se/two/") Annotation(rdfs:comment "The Swedish BioFINDER-2 study (NCT03174938) was launched in 2017 and extends the previous BioFINDER-1 study using an independent population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort, the first Swedish BioFINDER study (BioFINDER-1, NCT01208675), of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and followed for up to 10 years with cerebrospinal fluid, plasma, MRI, amyloid PET and genetic data to develop early and accurate diagnosis of Alzheimer disease, Parkinson disease and related disorders. It is distinct from the later, independent BioFINDER-2 study (NCT03174938), launched in 2017.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000479> (<http://www.ebi.ac.uk/coho/COHO_0000479>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") Annotation(rdfs:comment "The CROATIA-Vis study, Croatia, is a population-based, cross-sectional study in the island of Vis including adult participants, aged 18–93 years (mean = 56)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000479> "A population-based cohort of 1,008 adult Croatians aged 18-93 from the isolated villages of Vis and Komiza on the Dalmatian island of Vis, Croatia, recruited in 2003 and 2004, genotyped and richly phenotyped for genetic studies of complex traits in an isolated population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5587582/fullTextXML") Annotation(rdfs:comment "The CROATIA-Vis study includes 1008 Croatians, aged 18–93 years, who were recruited from the villages of Vis and Komiža on the Dalmatian island of Vis during 2003 and 2004 within a larger genetic epidemiology program38.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000479> "A population-based cohort of 1,008 adult Croatians aged 18-93 from the isolated villages of Vis and Komiza on the Dalmatian island of Vis, Croatia, recruited in 2003 and 2004, genotyped and richly phenotyped for genetic studies of complex traits in an isolated population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(rdfs:comment "From the islands of Orkney (Scotland) and Vis (Croatia) respectively, the ORCADES [76] and CROATIA-Vis [77,78] studies are of two isolated population cohorts that are both genotyped and richly phenotyped.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000479> "A population-based cohort of 1,008 adult Croatians aged 18-93 from the isolated villages of Vis and Komiza on the Dalmatian island of Vis, Croatia, recruited in 2003 and 2004, genotyped and richly phenotyped for genetic studies of complex traits in an isolated population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(rdfs:comment "The CROATIA-Vis study includes 1,008 Croatians, aged 18–93 years, who were recruited from the villages of Vis and Komiza on the Dalmatian island of Vis during spring of 2003 and 2004.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000479> "A population-based cohort of 1,008 adult Croatians aged 18-93 from the isolated villages of Vis and Komiza on the Dalmatian island of Vis, Croatia, recruited in 2003 and 2004, genotyped and richly phenotyped for genetic studies of complex traits in an isolated population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000480> (<http://www.ebi.ac.uk/coho/COHO_0000480>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41122833") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41122833+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "NACC worked with Alzheimer's Disease Research Centers (ADRCs) to establish and maintain standardized, rigorous data collection, primarily through the Uniform Data Set.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41122833") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41122833+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The National Alzheimer's Coordinating Center (NACC), founded in 1999 by the author, has many collaborators and contributors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://naccdata.org/") Annotation(rdfs:comment "56,000+ Participants with Data at NACC (20,000+ active participants)217,000 Clinical Assessments 1-20 per participant (median=3)8,700+ Neuropathology Exams from 58% of deceased participants15,000+ MRI & PET Participants 1-14 exams per participant") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://naccdata.org/") Annotation(rdfs:comment "NACC is home to one of the largest, oldest, and most powerful Alzheimer’s disease datasets, built in collaboration with more than 42 Alzheimer’s Disease Research Centers (ADRCs) throughout the US over the past 25+ years. We are on a mission to modernize data collection, integration, and sharing to advance Alzheimer’s Disease and related dementias (AD/ADRD) research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://naccdata.org/") Annotation(rdfs:comment "Researchers can search, visualize, and request curated multimodal data—linking clinical, imaging, genetic, and biomarker information across the ADRC network.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://naccdata.org/") Annotation(rdfs:comment "The National Alzheimer’s Coordinating Center (NACC) functions as the centralized data repository, and collaboration and communication hub, for the National Institute on Aging’s (NIA) Alzheimer’s Disease Research Centers (ADRC) Program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000481> (<http://www.ebi.ac.uk/coho/COHO_0000481>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29477148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29477148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6389173/fullTextXML") Annotation(rdfs:comment "The SP2 is a population-based cross-sectional study of adult Singaporean Chinese, Malay and Asian-Indian subjects aged between 24 to 95 years, and it comprises four previous studies, Thyroid and Heart Study (1982–1984) [27], National Health Survey (1992) [28], National University of Singapore Heart Study (1993–1995) [29], and the National Health Survey (1998) [30] (N = 11,053).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000481> "A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29477148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(rdfs:comment "It first surveyed subjects (Chinese, Malay and Indian) from four cross-sectional studies that were conducted in Singapore between 1982 and 1998.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000481> "A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29477148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(rdfs:comment "SP2 (Singapore Prospective Study Program): The SP2 is a population-based study of diabetes and cardiovascular disease in Singapore.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000481> "A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29477148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(rdfs:comment "Subjects were between the ages of 24-95 years and represented a random sample of the Singapore population. Subjects were re-visited between 2003 and 2007. Among the 10,747 individuals who were eligible, 5,157 subjects completed a questionnaire and the subsequent clinical examinations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000481> "A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000482> (<http://www.ebi.ac.uk/coho/COHO_0000482>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38181729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(rdfs:comment "As of March 2022, 200,673 participants have enrolled in the CCPM Biobank and 103,600 have provided a blood (n = 100,542) or saliva (n = 3,058) sample (Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38181729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(rdfs:comment "Bringing clinical and research interests together fosters unique clinical and translational questions that can be addressed from the large EHR-linked CCPM Biobank resource within a HIPAA- and CLIA-certified environment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38181729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(rdfs:comment "The CCPM Biobank began enrollment in September 2015 with a self-consent, paper-based process for adult participants (age ≥18 years, who could consent for themselves in English) receiving medical care at UCHealth University of Colorado Hospital.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38181729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(rdfs:comment "The CCPM Biobank is a dual-purpose research and clinical resource to accelerate genetic discovery and translation into clinical practice.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38181729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(rdfs:comment "We characterize aspects of genetic and geographic diversity unique to the Rocky Mountain region, the primary catchment area for CCPM Biobank participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38181729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(rdfs:comment "We describe the biobank at the Colorado Center for Personalized Medicine (CCPM Biobank) that was jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth to serve as a unique, dual-purpose research and clinical resource accelerating personalized medicine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000483> (<http://www.ebi.ac.uk/coho/COHO_0000483>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37349795") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10286470/fullTextXML") Annotation(rdfs:comment "Genetic and phenotype data for the ACT, ADNI, NACC, and ROSMAP GWAS datasets are available through the National Institute on Aging Genetics of Alzheimer Disease Data Storage site") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39595838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11592130/fullTextXML") Annotation(rdfs:comment "Between 1994 and 1996, ACT enrolled 2581 GHC members living in the greater Seattle area who were 65 years of age or older, community dwelling, and did not have a diagnosis of dementia at baseline.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39595838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11592130/fullTextXML") Annotation(rdfs:comment "The ACT study is an ongoing population-based prospective cohort study that began in 1994 [20,21,22] and aims to identify risk and preventive factors for dementia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39595838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11592130/fullTextXML") Annotation(rdfs:comment "The study enrolls dementia-free persons aged 65 and older from the membership of Kaiser Permanente Washington [KPWA, previously Group Health Cooperative (GHC)] and follows them longitudinally.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39595838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11592130/fullTextXML") Annotation(rdfs:comment "We summarize select medical and health history information for the chart abstraction cohort overall and among those with a dementia diagnosis and with a completed brain autopsy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39595838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11592130/fullTextXML") Annotation(rdfs:comment "Written informed consent is obtained from all ACT study participants, including permission to examine their medical records and, for those who agree, a brain autopsy upon their death.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000484> (<http://www.ebi.ac.uk/coho/COHO_0000484>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10964005") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10964005+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Blood samples and clinical data were projected to be collected from a sample of 2244 hypertensive siblings diagnosed before age 60 from 960 sibships (half African-American) with two or more affected persons.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10964005") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10964005+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Hypertension Genetic Epidemiology Network (HyperGEN) involves scientists from six universities and the NHLBI who seek to identify and characterize genes promoting hypertension.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-021-03205-y/MediaObjects/41586_2021_3205_MOESM1_ESM.pdf") Annotation(rdfs:comment "The HyperGEN Study is part of the National Heart, Lung, and Blood Institute (NHLBI) Family Blood Pressure Program;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(rdfs:comment "HyperGEN (Hypertension Genetic Epidemiology Network) included field centers in Birmingham AL, which recruited African Americans; the rest of centers in Forsyth County, NC, in Framingham, MA, in Minneapolis, MN, and in Salt Lake City, UT recruited Whites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(rdfs:comment "HyperGEN recruited African American and White hypertensive sibships with 2 or more hypertensive sibs, at least 1 of them having severe HT. In addition, HyperGEN recruited random samples of African American and White participants, and parents.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(rdfs:comment "As part of HyperGEN, hypertensive AA sibships were recruited from the community-at-large in Birmingham, AL, and population-based cohorts in Forsyth County, NC, from 1995 to 2000.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000485> (<http://www.ebi.ac.uk/coho/COHO_0000485>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants will be followed for at least 13 years from randomization to ascertain all cancers of the prostate, lung, colorectum, and ovary, as well as deaths from all causes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The design is a multicenter, two-armed, randomized trial with 37,000 females and 37,000 males in each of the two arms.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The objectives of the Prostate, Lung, Colorectal and Ovarian Cancer Screening Trial are to determine in screenees ages 55-74 at entry whether screening with flexible sigmoidoscopy (60-cm sigmoidoscope) can reduce mortality from colorectal cancer, whether screening with chest X-ray can reduce mortality from lung cancer,") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "whether screening men with digital rectal examination (DRE) plus serum prostate-specific antigen (PSA) can reduce mortality from prostate cancer, and whether screening women with CA125 and transvaginal ultrasound (TVU) can reduce mortality from ovarian cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.353/MediaObjects/41588_2009_BFng353_MOESM7_ESM.pdf") Annotation(rdfs:comment "The Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial (PLCO), a randomized two-arm trial to determine if screening reduced the mortality from these cancers, enrolled during 1993-2001 155,000 men and women, aged 55–74, in 10 U.S. centers") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(rdfs:comment "This study prospectively examines participants from the Prostate, Lung, Colorectal, and Ovarian (PLCO) Cancer Screening Trial, a large-scale randomized clinical trial sponsored by the National Cancer Institute (NCI) from 1993 to 2001 (18).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000486> (<http://www.ebi.ac.uk/coho/COHO_0000486>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40744823") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12673288/fullTextXML") Annotation(rdfs:comment "Additionally, new participants have been enrolled since 2022 as part of an ongoing expansion.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of Korean adults, recruited at baseline in 2004–2013 at ages 20–85 at 18 health promotion centres across Korea during routine health examinations, with further participants enrolled since 2022, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40744823") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12673288/fullTextXML") Annotation(rdfs:comment "At baseline, phenotypic data were collected via self-report questionnaires and health examinations, including anthropometric, demographic, and medical history information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of Korean adults, recruited at baseline in 2004–2013 at ages 20–85 at 18 health promotion centres across Korea during routine health examinations, with further participants enrolled since 2022, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40744823") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12673288/fullTextXML") Annotation(rdfs:comment "From 2004 to 2013, baseline data were collected from 156,701 individuals aged 20-85 years, recruited from 18 health promotion centers across Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of Korean adults, recruited at baseline in 2004–2013 at ages 20–85 at 18 health promotion centres across Korea during routine health examinations, with further participants enrolled since 2022, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40744823") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12673288/fullTextXML") Annotation(rdfs:comment "Outcome data are routinely obtained from Statistics Korea (mortality data), the National Cancer Center (cancer registry data), and the National Health Insurance Service (morbidity data).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of Korean adults, recruited at baseline in 2004–2013 at ages 20–85 at 18 health promotion centres across Korea during routine health examinations, with further participants enrolled since 2022, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40744823") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12673288/fullTextXML") Annotation(rdfs:comment "The Korean Cancer Prevention Study-II (KCPS-II) biobank was initially established as a resource for investigating outcomes related to cancer and cardiovascular disease, with a particular emphasis on metabolic risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of Korean adults, recruited at baseline in 2004–2013 at ages 20–85 at 18 health promotion centres across Korea during routine health examinations, with further participants enrolled since 2022, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40744823") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12673288/fullTextXML") Annotation(rdfs:comment "This population-based cohort, enriched with genetic data, provides a robust foundation for research aimed at elucidating causal relationships in chronic disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of Korean adults, recruited at baseline in 2004–2013 at ages 20–85 at 18 health promotion centres across Korea during routine health examinations, with further participants enrolled since 2022, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000487> (<http://www.ebi.ac.uk/coho/COHO_0000487>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22216169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3245257") Annotation(rdfs:comment "The Leipzig (LIFE) Heart Study provides a basis to identify molecular targets related to atherogenesis and associated metabolic disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22216169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3245257/fullTextXML") Annotation(rdfs:comment "Recruitment of subjects started in December 2006 and is ongoing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22216169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3245257/fullTextXML") Annotation(rdfs:comment "These include subjects undergoing first-time coronary angiography due to suspected CAD but previously unknown coronary status (cohort 1), subjects with acute myocardial infarction as first manifestation of CAD (cohort 2) and subjects with left main coronary artery disease (cohort 3).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22216169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22216169+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We established the Leipzig (LIFE) Heart Study, a biobank and database of patients with different stages of coronary artery disease (CAD) for studies of clinical, metabolic, cellular and genetic factors of cardiovascular diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34822396") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8624973/fullTextXML") Annotation(rdfs:comment "Patients were recruited at the Heart Center Leipzig, Germany, and all underwent coronary angiography.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34822396") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8624973/fullTextXML") Annotation(rdfs:comment "Two studies of the Leipzig Research Centre for Civilization Diseases (LIFE) were analyzed: LIFE-Adult is a population-based cohort of citizens of Leipzig, Germany (n = 10,000) [24].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000488> (<http://www.ebi.ac.uk/coho/COHO_0000488>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25210141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29579158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32114478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6575866/fullTextXML") Annotation(rdfs:comment "Thus, from 2006 and onwards, the rural HDSS consisted of 182 clusters in the nine rural health regions (figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance and research platform in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that has followed women and children in an urban surveillance system in the capital, Bissau, since 1978 and in a nationally representative rural surveillance system of 182 clusters since 1989-1990, to study health interventions, child mortality and the non-specific effects of vaccines. Randomised trials are run within it, such as the 2008-2013 trial of early BCG vaccination in low-birth-weight newborns in Bissau.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25210141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29579158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32114478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Bandim Health Project (BHP) monitors health and survival of women and children in a nationally representative rural Health and Demographic Surveillance System (HDSS) in Guinea-Bissau.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance and research platform in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that has followed women and children in an urban surveillance system in the capital, Bissau, since 1978 and in a nationally representative rural surveillance system of 182 clusters since 1989-1990, to study health interventions, child mortality and the non-specific effects of vaccines. Randomised trials are run within it, such as the 2008-2013 trial of early BCG vaccination in low-birth-weight newborns in Bissau.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25210141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29579158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32114478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Research from the BHP has given rise to the hypothesis that vaccines, in addition to their targeted effects, have important non-specific effects altering the susceptibility to other infections.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance and research platform in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that has followed women and children in an urban surveillance system in the capital, Bissau, since 1978 and in a nationally representative rural surveillance system of 182 clusters since 1989-1990, to study health interventions, child mortality and the non-specific effects of vaccines. Randomised trials are run within it, such as the 2008-2013 trial of early BCG vaccination in low-birth-weight newborns in Bissau.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25210141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29579158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32114478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31189684") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31189684+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The HDSS was set up in 1989-1990 to collect data on health interventions and child mortality.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance and research platform in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that has followed women and children in an urban surveillance system in the capital, Bissau, since 1978 and in a nationally representative rural surveillance system of 182 clusters since 1989-1990, to study health interventions, child mortality and the non-specific effects of vaccines. Randomised trials are run within it, such as the 2008-2013 trial of early BCG vaccination in low-birth-weight newborns in Bissau.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25210141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29579158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32114478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32114478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7050365/fullTextXML") Annotation(rdfs:comment "Bandim Health Project (BHP) runs a Health and Demographic Surveillance Site (HDSS) in six suburban districts in Bissau, the capital of Guinea-Bissau.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance and research platform in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that has followed women and children in an urban surveillance system in the capital, Bissau, since 1978 and in a nationally representative rural surveillance system of 182 clusters since 1989-1990, to study health interventions, child mortality and the non-specific effects of vaccines. Randomised trials are run within it, such as the 2008-2013 trial of early BCG vaccination in low-birth-weight newborns in Bissau.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25210141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29579158") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32114478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32114478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7050365/fullTextXML") Annotation(rdfs:comment "The data used for this study were mostly obtained from BHP’s urban HDSS, which has been following women and children since 1978, where data collection was initiated at the request of the Ministry of Health in Guinea-Bissau.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance and research platform in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that has followed women and children in an urban surveillance system in the capital, Bissau, since 1978 and in a nationally representative rural surveillance system of 182 clusters since 1989-1990, to study health interventions, child mortality and the non-specific effects of vaccines. Randomised trials are run within it, such as the 2008-2013 trial of early BCG vaccination in low-birth-weight newborns in Bissau.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000489> (<http://www.ebi.ac.uk/coho/COHO_0000489>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35690720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9188139/fullTextXML") Annotation(rdfs:comment "We established a new algorithm and demonstrated the feasibility of the electronic algorithm approach to accurately diagnose ADHD and comorbid conditions, verifying the efficiency of our large biorepository for further genetic discovery-based analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35690720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35690720+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants enrolled in various CAG studies at CHOP and completed a broad informed consent, including consent for prospective analyses of EHRs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35690720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35690720+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We developed a multi-source algorithm allowing for a more complete view of the patient's EHR, leveraging the biobank of the Center for Applied Genomics (CAG) at Children's Hospital of Philadelphia (CHOP).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40164604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(rdfs:comment "Subjects were recruited at Children’s Hospital of Philadelphia starting in 2006 and continuing to the present; genotyping of subjects has occurred across the same timeline.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40164604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(rdfs:comment "The cohort from the Center for Applied Genomics is composed of approximately 85,000 juvenile subjects below 18 years of age and of a diverse set of ancestries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000888.v1.p1") Annotation(rdfs:comment "Sites and participants include: Children's Hospital of Pennsylvania (CHOP): The Center for Applied Genomics (CAG) at the Children's Hospital of Philadelphia (CHOP) is a high-throughput, highly automated genotyping and sequencing facility equipped with state-of-the-art genotyping and sequencing platforms.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000888.v1.p1") Annotation(rdfs:comment "as well as using the phenome-wide association study (PheWAS) paradigm to replicate and discover relationships between targeted genotypes with multiple phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000490> (<http://www.ebi.ac.uk/coho/COHO_0000490>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21775358") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21775358+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Because twins have been identified independent of traits and on a population basis, the Danish Twin Registry is well suited for studies to understand the influence of genetic and environmental factors for a wide variety of diseases and traits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23084092") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23084092+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Second, we describe our most recent data collection effort, which was conducted during the period 2008-2011 and included both in-person assessments of 14,000+ twins born 1931-1969 and sampling of biological material, hereby expanding and consolidating the DTR biobank.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31544734") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31544734+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Danish Twin Registry (DTR) was established in the 1950s, when twins born from 1870 to 1910 were ascertained, and has since been extended to include twins from birth cohorts until 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31544734") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31544734+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The combination of data from several surveys, including biological samples and repeated measurements on the same individuals, and data from Danish national registers provides a unique resource for a wide range of twin studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31544734") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8039015/unicode") Annotation(rdfs:comment "By May 2019, the population in the DTR comprised of 175,518 individuals: 86,402 pairs of twins born from 1870 to 2009, and 874 sets of triplets and 23 sets of quadruplets born from 1931 to 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31544734") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8039015/unicode") Annotation(rdfs:comment "In the DTR, the combination of long and nearly complete follow-up of twins with extensive phenotypic and molecular information from surveys and registers provides a valuable resource for studies of the mechanisms of human development, aging and diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31544734") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8039015/unicode") Annotation(rdfs:comment "This makes the DTR the oldest nationwide twin register and among the largest in the world.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000491> (<http://www.ebi.ac.uk/coho/COHO_0000491>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23743551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3795928/fullTextXML") Annotation(rdfs:comment "The eMERGE Network comprises nine geographically distinct groups (Figure 1), each with its own biorepository where DNA specimens are linked to phenotypic data contained within EMRs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23743551") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23743551+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Electronic Medical Records and Genomics Network is a National Human Genome Research Institute-funded consortium engaged in the development of methods and best practices for using the electronic medical record as a tool for genomic research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34347061") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8339934/fullTextXML") Annotation(rdfs:comment "The Electronic Medical Records and Genomics (eMERGE) network is a federated network of academic medical centers in the US and has compiled EMRs and genotype data for genomic research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35047833") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35047833+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "After generating a 105,000 participant-imputed genome-wide association study (GWAS) dataset for discovery, the network enrolled and sequenced 24,998 participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35047833") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35047833+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Recruited cohorts were clinically sequenced off a custom panel for targeted sequencing of variants and monogenic disease risks and returned to participants to investigate the impact of return of genomic results.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35047833") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35047833+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Electronic Medical Records and Genomics (eMERGE) Network, established in 2007, is a consortium of academic and integrated health systems conducting discovery and implementation research in translational genomics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000492> (<http://www.ebi.ac.uk/coho/COHO_0000492>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19729412") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41520650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19729412") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2773272") Annotation(rdfs:comment "All subjects are part of a sample from an extensively phenotyped isolated population from Eastern Germany, the Sorbs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000492> "A volunteer-based cohort of about 1,000 adults from the self-contained population of Sorbs in eastern Germany, recruited and extensively metabolically phenotyped by the University of Leipzig in 2005–2007 for genome-wide studies of metabolic, anthropometric and other quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19729412") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41520650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19729412") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2773272") Annotation(rdfs:comment "At present, about 1000 Sorbian individuals are enrolled in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000492> "A volunteer-based cohort of about 1,000 adults from the self-contained population of Sorbs in eastern Germany, recruited and extensively metabolically phenotyped by the University of Leipzig in 2005–2007 for genome-wide studies of metabolic, anthropometric and other quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19729412") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41520650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19729412") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19729412+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We performed a genome wide association study (GWAS) (approximately 390,000 genetic polymorphisms, Affymetrix gene arrays) on adult height in 929 Sorbian individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000492> "A volunteer-based cohort of about 1,000 adults from the self-contained population of Sorbs in eastern Germany, recruited and extensively metabolically phenotyped by the University of Leipzig in 2005–2007 for genome-wide studies of metabolic, anthropometric and other quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19729412") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41520650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41520650") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12818281/fullTextXML") Annotation(rdfs:comment "Participants included in this volunteer-based study have been recruited from the self-contained population of Sorbs in Germany and extensively metabolically phenotyped between 2005 and 2007 as described elsewhere.16,17") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000492> "A volunteer-based cohort of about 1,000 adults from the self-contained population of Sorbs in eastern Germany, recruited and extensively metabolically phenotyped by the University of Leipzig in 2005–2007 for genome-wide studies of metabolic, anthropometric and other quantitative traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000493> (<http://www.ebi.ac.uk/coho/COHO_0000493>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33742194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(rdfs:comment "After these exclusions, 1410 individuals aged 57–78 y at baseline in 2005–2006 were randomly assigned to the resistance exercise, aerobic exercise, diet, combined resistance exercise and diet, combined aerobic exercise and diet, or control group.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000493> "A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years and living in Kuopio, Finland, in 2002, drawn from the national population registry and examined at baseline in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33742194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(rdfs:comment "The 3000 men and women who were invited to participate in the study were obtained from the national population registry, and finally 1479 of them attended the baseline measurements between 5 April in 2005 and 4 October in 2006.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000493> "A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years and living in Kuopio, Finland, in 2002, drawn from the national population registry and examined at baseline in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33742194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(rdfs:comment "The Dose-Responses to Exercise Training (DR's EXTRA) study is a 4-y RCT on the health effects of regular physical exercise and a healthy diet in a population-based random sample of Finnish men and women aged 55–74 y living in the city of Kuopio in 2002") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000493> "A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years and living in Kuopio, Finland, in 2002, drawn from the national population registry and examined at baseline in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33742194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(rdfs:comment "a general population of middle-aged and older men and women") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000493> "A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years and living in Kuopio, Finland, in 2002, drawn from the national population registry and examined at baseline in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000494> (<http://www.ebi.ac.uk/coho/COHO_0000494>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34836252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(rdfs:comment "As part of the NHLBI Programs in Gene by Environment Interaction (PROGENI), participants took part in diet and/or drug interventions (high-fat meal and/or fenofibrate for 3 weeks) and provided consent for genetic studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000494> "A family intervention study of the NHLBI Programs in Gene by Environment Interaction, of 1,048 white participants in 184 three-generation pedigrees previously screened at the Minnesota and Utah centres of the NHLBI Family Heart Study, who took a standardised high-fat meal challenge and three weeks of fenofibrate treatment, to study genetic determinants of the lipid response to diet and lipid-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34836252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(rdfs:comment "GOLDN participants were identified through 3-generation families previously screened in the NHLBI Family Heart Study Minnesota or Utah centers [33].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000494> "A family intervention study of the NHLBI Programs in Gene by Environment Interaction, of 1,048 white participants in 184 three-generation pedigrees previously screened at the Minnesota and Utah centres of the NHLBI Family Heart Study, who took a standardised high-fat meal challenge and three weeks of fenofibrate treatment, to study genetic determinants of the lipid response to diet and lipid-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34836252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(rdfs:comment "The GOLDN sample consisted of 1048 Caucasian individuals belonging to 184 pedigrees (average family size 6.2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000494> "A family intervention study of the NHLBI Programs in Gene by Environment Interaction, of 1,048 white participants in 184 three-generation pedigrees previously screened at the Minnesota and Utah centres of the NHLBI Family Heart Study, who took a standardised high-fat meal challenge and three weeks of fenofibrate treatment, to study genetic determinants of the lipid response to diet and lipid-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35393526") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(rdfs:comment "GOLDN (Genetics of Lipid Lowering Drugs and Diet Network), the largest study of postprandial dyslipidemia that offers NMR, clinical lipid, and lipidomic measures, was initiated to assess the interaction of genetic factors with environmental interventions (intake of a high-fat meal and/or fenofibrate treatment)74.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000494> "A family intervention study of the NHLBI Programs in Gene by Environment Interaction, of 1,048 white participants in 184 three-generation pedigrees previously screened at the Minnesota and Utah centres of the NHLBI Family Heart Study, who took a standardised high-fat meal challenge and three weeks of fenofibrate treatment, to study genetic determinants of the lipid response to diet and lipid-lowering drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000495> (<http://www.ebi.ac.uk/coho/COHO_0000495>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42076794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(rdfs:comment "SWAN began in 1996–1997 by enrolling women aged 42–52 from seven sites: Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland, and Newark.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000495> "A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women's physical, biological, psychological and social health in midlife affects health during ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42076794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(rdfs:comment "SWAN is a multi-site, longitudinal, epidemiological study that collects data on women’s physical, biological, psychological, and social health in their middle years to understand how midlife experiences affect health during aging.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000495> "A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women's physical, biological, psychological and social health in midlife affects health during ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42076794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(rdfs:comment "The Study of Women’s Health Across the Nation interviewed women in their 40s and 50s from seven U.S. cities approximately yearly to collect information on their physical, biological, psychological, and social health.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000495> "A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women's physical, biological, psychological and social health in midlife affects health during ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42076794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(rdfs:comment "The study sample consisted of 3302 women enrolled in the SWAN, a multiethnic, longitudinal, community-based study of women’s midlife aging.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000495> "A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women's physical, biological, psychological and social health in midlife affects health during ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000496> (<http://www.ebi.ac.uk/coho/COHO_0000496>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39235140") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.folkhalsan.fi/genetics/finndiane-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22721967") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3402313/fullTextXML") Annotation(rdfs:comment "The FinnDiane study is a nationwide multicenter study of >4,800 adult participants with type 1 diabetes") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39235140") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.folkhalsan.fi/genetics/finndiane-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39235140") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML") Annotation(rdfs:comment "Across its operational span of more than 25 years, the observational, nationwide, multicentre Finnish Diabetic Nephropathy (FinnDiane) Study has aimed to unravel mechanisms underlying diabetic kidney disease, with a special focus on its metabolic risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39235140") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.folkhalsan.fi/genetics/finndiane-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39235140") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML") Annotation(rdfs:comment "Additional follow‐up data are acquired from national registries and medical records, encompassing serial laboratory measurements for HbA1c and lipids, among others") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39235140") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.folkhalsan.fi/genetics/finndiane-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39235140") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML") Annotation(rdfs:comment "In 1997, the observational Finnish Diabetic Nephropathy (FinnDiane) Study was established with the goal to understand why one‐third of individuals with type 1 diabetes develop diabetic kidney disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39235140") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.folkhalsan.fi/genetics/finndiane-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39235140") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML") Annotation(rdfs:comment "In addition to the baseline examinations of new participants joining the study, the follow‐up has consistently been updated by re‐examining participants at the local study centre in Helsinki since the longitudinal phase of the FinnDiane Study began in 2003.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39235140") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.folkhalsan.fi/genetics/finndiane-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39235140") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML") Annotation(rdfs:comment "With a mean follow‐up of more than 20 years, the FinnDiane Study continues its mission to identify clinical, environmental and genetic risk factors for diabetic complications, with the goal of improving outcomes for people with type 1 diabetes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000497> (<http://www.ebi.ac.uk/coho/COHO_0000497>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21102431") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32601453") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36603003") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21102431") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21102431+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Comprehensive behavioural and neuropsychological characterization, functional and structural neuroimaging and genome-wide association analyses of 2000 14-year-old adolescents are combined with functional genetics in animal and human models.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000497> "A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21102431") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32601453") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36603003") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21102431") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21102431+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The IMAGEN study is the first multicentre genetic-neuroimaging study aimed at identifying the genetic and neurobiological basis of individual variability in impulsivity, reinforcer sensitivity and emotional reactivity, and determining their predictive value for the development of frequent psychiatric disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000497> "A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21102431") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32601453") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36603003") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32601453") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7577859/fullTextXML") Annotation(rdfs:comment "It includes 8 European centers; each of them recruited at least 250 healthy adolescents aged 14, who have been followed up at ages 16, 19, and 22 [12].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000497> "A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21102431") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32601453") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36603003") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36603003") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9815590/fullTextXML") Annotation(rdfs:comment "Participants were recruited from a diverse range of high schools across eight European sites (Dresden, Berlin, Mannheim, and Hamburg in Germany; London and Nottingham in the U.K.; Dublin in Ireland; and Paris in France).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000497> "A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000498> (<http://www.ebi.ac.uk/coho/COHO_0000498>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18586274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30678080") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18586274") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18586274+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Eight hundred and forty-two inpatients admitted to a psychiatric hospital for treatment of a major depressive episode, recurrent or bipolar depression were thoroughly characterized with respect to demographic factors, clinical history, and the degree of HPA-axis dysregulation evaluated by means of combined dex/CRH tests, and the predictive value of these factors for treatment outcome is investigated.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000498> "A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18586274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30678080") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19736353") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19736353+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We performed a genomewide association study in patients from the Munich Antidepressant Response Signature (MARS) project and in pooled DNA from an independent German replication sample.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000498> "A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18586274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30678080") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30678080") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6387218/fullTextXML") Annotation(rdfs:comment "Antidepressant treatment outcome was monitored weekly for at least six weeks using the 21-items version of the Hamilton Depression Rating Scale (HAMD-21).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000498> "A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18586274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30678080") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30678080") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6387218/fullTextXML") Annotation(rdfs:comment "MARS is a naturalistic open-label longitudinal treatment study with inpatients suffering from a depressive episode.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000498> "A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18586274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30678080") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30678080") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6387218/fullTextXML") Annotation(rdfs:comment "Patients with a moderate to severe depressive episode were recruited from the hospital of the Max Planck Institute of Psychiatry and collaborating hospitals of Southern Bavaria and Switzerland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000498> "A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000499> (<http://www.ebi.ac.uk/coho/COHO_0000499>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471868") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38934297") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22471868") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22471868+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Minority Aging Research Study (MARS) is a longitudinal, epidemiologic cohort study of decline in cognitive function and risk of Alzheimer's disease (AD) in older African Americans, with brain donation after death added as an optional component for those willing to consider organ donation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000499> "A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471868") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38934297") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22471868") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22471868+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We then provide details of ongoing efforts to achieve neuropathologic data on over 100 African Americans participating in MARS and in three other clinical-pathologic cohort studies at Rush University Medical Center.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000499> "A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471868") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38934297") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22471868") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3409294/unicode") Annotation(rdfs:comment "In the present paper, we describe the study design of the Minority Aging Research Study (MARS), a longitudinal, clinical-pathologic cohort study of older African Americans without known dementia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000499> "A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471868") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38934297") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22471868") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3409294/unicode") Annotation(rdfs:comment "Study participants were recruited from a variety of settings including churches, subsidized senior housing facilities, retirement communities, African American clubs, organizations, fraternities and sororities, and social service centers that cater to seniors in the metropolitan Chicago area and outlying suburbs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000499> "A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471868") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38934297") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22471868") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3409294/unicode") Annotation(rdfs:comment "The Minority Aging Research Study, a longitudinal study of risk factors for cognitive decline, began data collection in August 2004 and was re-funded in July 2010 to include an optional arm in which existing and newly recruited participants may participate in brain donation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000499> "A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000500> (<http://www.ebi.ac.uk/coho/COHO_0000500>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19943720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030319") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19943720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19943720+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Older Australian Twins Study (OATS) was recently initiated to investigate genetic and environmental factors and their associations and interactions in healthy brain ageing and ageing-related neurocognitive disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000500> "A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19943720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030319") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19943720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19943720+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The cohort will be assessed every two years, with in-depth assessments being repeated.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000500> "A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19943720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030319") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19943720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19943720+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study extends the classic MZ-DZ design to include one or two equivalently aged siblings for each twin pair and utilizes the rich resources of the Australian Twin Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000500> "A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19943720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030319") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19943720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19943720+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study has a number of distinguishing features including comprehensive psychiatric, neuropsychological, cardiovascular, metabolic, and neuroimaging assessments, a longitudinal design and links with a brain donor program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000500> "A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19943720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030319") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27030319") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4814826/fullTextXML") Annotation(rdfs:comment "Participants aged 65 years and over were recruited through the Australian Twin Registry and a recruitment drive.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000500> "A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000501> (<http://www.ebi.ac.uk/coho/COHO_0000501>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30987580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30987580") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6466793/fullTextXML") Annotation(rdfs:comment "Recruitment has started in April 2015.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000501> "A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30987580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30987580") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6466793/fullTextXML") Annotation(rdfs:comment "This study is a collaboration between the Dutch National Institute for Public Health and the Environment (RIVM, Bilthoven, the Netherlands) and the clinical expert centers for Lyme borreliosis at Amsterdam UMC (location AMC, University of Amsterdam, Amsterdam, the Netherlands), and Radboud university medical center (Radboudumc, Nijmegen, the Netherlands)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000501> "A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30987580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30987580") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30987580+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "During one year of follow-up, participants are subjected to questionnaires every three months and blood is collected repeatedly during the first three months.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000501> "A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30987580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30987580") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30987580+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "LymeProspect is a prospective, observational cohort study among adults with proven or probable Lyme borreliosis, either erythema migrans or disseminated manifestations, included at the start of antibiotic treatment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000501> "A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30987580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30987580") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30987580+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The LymeProspect study has been designed to investigate the prevalence, severity, and a wide range of hypotheses on the etiology of persistent symptoms among patients treated for Lyme borreliosis in the Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000501> "A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000502> (<http://www.ebi.ac.uk/coho/COHO_0000502>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35167808") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC8948159") Annotation(rdfs:comment "Here, we aimed to identify genetic variants modulating cytokine responses in healthy adults of East African ancestry from Tanzania.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35167808") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8948159/") Annotation(rdfs:comment "As previously described,19 ex vivo cytokine stimulation experiments were performed at the biotechnology laboratory facility available at Kilimanjaro Clinical Research Institute in Moshi, Tanzania.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37555575") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10473835/fullTextXML") Annotation(rdfs:comment "Both cohorts were enrolled within the Human Functional Genomics Project (https://www.humanfunctionalgenomics.org).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37555575") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10473835/fullTextXML") Annotation(rdfs:comment "Briefly, the 300TZFG cohort consists of 323 healthy Tanzanian individuals aged between 18 and 65 years residing in the Kilimanjaro region in Northern Tanzania.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37555575") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10473835/fullTextXML") Annotation(rdfs:comment "The present study used samples from two cross-sectional cohorts of healthy volunteers: the 300-Tanzania-FG (300TZFG) and the Dutch 500FG.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37555575") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37555575+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Among the Tanzanian volunteers, food-derived metabolites were identified as an important driver of variation in inflammation-related molecules, emphasizing the potential importance of lifestyle changes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000503> (<http://www.ebi.ac.uk/coho/COHO_0000503>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36085083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36085083") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML") Annotation(rdfs:comment "Bio-samples collected from the UCLA ATLAS Community Health Initiative in the form of blood samples were de-identified and then processed for DNA extraction and genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000503> "An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients to their de-identified electronic health records, for genetic and precision-health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36085083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36085083") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML") Annotation(rdfs:comment "In this study, we investigate the role of genetic ancestry in a disease context within the UCLA ATLAS Community Health Initiative (or ATLAS for brevity), a biobank embedded within the UCLA Health medical system composed of de-identified, EHR-linked genomic data from a diverse patient population") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000503> "An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients to their de-identified electronic health records, for genetic and precision-health research.")
