AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007041") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38510703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10951062/fullTextXML") Annotation(rdfs:comment "Started in 2016, within the RHAPSODY project, we federated 12 patient cohorts totalling over 68000 diabetes patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000277> "An Innovative Medicines Initiative consortium that generated molecular data across large European diabetes cohorts to identify markers of progression from pre-diabetes to type 2 diabetes and of glycaemic deterioration measured as time to insulin initiation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007041") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38510703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10951062/fullTextXML") Annotation(rdfs:comment "We have interrogated data from two independent European T2D cohorts, DCS and GoDARTS, within the RHAPSODY consortium (8).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000277> "An Innovative Medicines Initiative consortium that generated molecular data across large European diabetes cohorts to identify markers of progression from pre-diabetes to type 2 diabetes and of glycaemic deterioration measured as time to insulin initiation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007041") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007041") Annotation(rdfs:comment "Molecular data of large diabetes cohorts was generated to identify markers of diabetes progression measured as time to insulin initiation") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000277> "An Innovative Medicines Initiative consortium that generated molecular data across large European diabetes cohorts to identify markers of progression from pre-diabetes to type 2 diabetes and of glycaemic deterioration measured as time to insulin initiation.")

