AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26387087") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(rdfs:comment "UTAH USA 245 440 62.6 – – 51.4 16.1 – 4.7") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002533> "A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26387087") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(rdfs:comment "We conducted a case–control study based on 20,848 prostate cancers and 20,214 controls of European ancestry from 22 studies in the PRACTICAL consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002533> "A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(rdfs:comment "All 455 prostate cancer cases were drawn from the set of sampled prostate cancer cases belonging to extended Utah high-risk pedigrees.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002533> "A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(rdfs:comment "All cases were selected to have kinship coefficients<=0.0156 with any other case included from the high-risk pedigree set.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002533> "A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(rdfs:comment "The 256 controls were selected from other high-risk pedigree studies as: 1) not related to a prostate kindred, 2) not having cancer, 3) not having a first degree relative with prostate cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002533> "A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer.")

