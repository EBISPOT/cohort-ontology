AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22751097") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3927410/unicode") Annotation(rdfs:comment "BAS study consisted of 505 cases of MI and 1,021 controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000896> "A case-control collection of Han Chinese participants from Beijing, China, with myocardial infarction cases verified by hospital records and cardiologists and controls randomly selected from a community-based survey of cardiovascular risk factors in Beijing, assembled to study genetic susceptibility to coronary artery disease and atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22751097") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3927410/unicode") Annotation(rdfs:comment "Controls were randomly selected from subjects participating in a community-based survey of cardiovascular risk factors in Beijing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000896> "A case-control collection of Han Chinese participants from Beijing, China, with myocardial infarction cases verified by hospital records and cardiologists and controls randomly selected from a community-based survey of cardiovascular risk factors in Beijing, assembled to study genetic susceptibility to coronary artery disease and atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22751097") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3927410/unicode") Annotation(rdfs:comment "Herein, we carried out a two-stage GWAS study of CAD in a sample of ~33,000 Han Chinese (Supplementary Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000896> "A case-control collection of Han Chinese participants from Beijing, China, with myocardial infarction cases verified by hospital records and cardiologists and controls randomly selected from a community-based survey of cardiovascular risk factors in Beijing, assembled to study genetic susceptibility to coronary artery disease and atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22751097") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3927410/unicode") Annotation(rdfs:comment "In the discovery stage (stage 1), we performed two GWAS studies of CAD in two independent Chinese samples, the Beijing Atherosclerosis Study (BAS) and the China Atherosclerosis Study (CAS), respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000896> "A case-control collection of Han Chinese participants from Beijing, China, with myocardial infarction cases verified by hospital records and cardiologists and controls randomly selected from a community-based survey of cardiovascular risk factors in Beijing, assembled to study genetic susceptibility to coronary artery disease and atherosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000897> (<http://www.ebi.ac.uk/coho/COHO_0000897>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42230966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(rdfs:comment "All cohorts agreed to share genotype and phenotype data in a central location for mega-analysis, where QC and genotype imputation were conducted simultaneously and harmonized across all arrays and participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000897> "A nation-wide Dutch collaborative project that combines genotype data from sixteen population and clinical cohorts in the Netherlands with uniform, DSM-based phenotyping of major depressive disorder, pooled centrally for genetic mega-analysis of depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42230966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(rdfs:comment "This nation-wide collaborative project combines genotype data from sixteen Dutch cohorts, and focuses on uniform phenotyping of MDD according to clinical criteria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000897> "A nation-wide Dutch collaborative project that combines genotype data from sixteen population and clinical cohorts in the Netherlands with uniform, DSM-based phenotyping of major depressive disorder, pooled centrally for genetic mega-analysis of depression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42230966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(rdfs:comment "We enriched the existing population and clinical cohorts in the Netherlands with an infrastructure for nation-wide depression phenotyping so that all MDD cases were defined based on DSM-5 (Diagnostic and Statistical Manual of Mental Disorders) criteria [3, 23].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000897> "A nation-wide Dutch collaborative project that combines genotype data from sixteen population and clinical cohorts in the Netherlands with uniform, DSM-based phenotyping of major depressive disorder, pooled centrally for genetic mega-analysis of depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000898> (<http://www.ebi.ac.uk/coho/COHO_0000898>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17311856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34754074") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17311856") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17311856+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Age-, race-, and sex-specific reference curves can be used to help identify children with bone deficits and for monitoring changes in bone in response to chronic diseases or therapies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000898> "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years, with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17311856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34754074") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17311856") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17311856+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants included 1554 healthy children (761 male, 793 female), ages 6-16 yr, of all ethnicities.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000898> "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years, with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17311856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34754074") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17311856") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17311856+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Scans of the whole body, lumbar spine, hip, and forearm were obtained using dual-energy x-ray absorptiometry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000898> "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years, with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17311856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34754074") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17311856") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17311856+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Bone Mineral Density in Childhood Study is an ongoing longitudinal study in which measurements are obtained annually at five clinical centers in the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000898> "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years, with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.")
