AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20565774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20565774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2908055/fullTextXML") Annotation(rdfs:comment "The Personalized Medicine Research Project is a population based cohort of approximately 20,000 individuals ages 18 and up residing within one of 19 zip codes surrounding Marshfield Wisconsin, USA, who have agreed to provide DNA, serum, and plasma samples to be linked with a dynamic medical record for research [26].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000873> "A population-based biobank cohort of about 20,000 adults living in 19 zip codes around Marshfield, Wisconsin, United States, recruited by the Marshfield Clinic from 2002, who provided DNA, serum and plasma samples linked to their electronic medical records for genetic and gene–environment research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20565774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20565774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2908055/fullTextXML") Annotation(rdfs:comment "The genotyping data is available to investigators using the PMRP resource both for identification purposes and as a resource for investigating gene disease interactions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000873> "A population-based biobank cohort of about 20,000 adults living in 19 zip codes around Marshfield, Wisconsin, United States, recruited by the Marshfield Clinic from 2002, who provided DNA, serum and plasma samples linked to their electronic medical records for genetic and gene–environment research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20565774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20565774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2908055/fullTextXML") Annotation(rdfs:comment "The majority of recruitment was accomplished in the first 18 months of enrolment beginning in September of 2002.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000873> "A population-based biobank cohort of about 20,000 adults living in 19 zip codes around Marshfield, Wisconsin, United States, recruited by the Marshfield Clinic from 2002, who provided DNA, serum and plasma samples linked to their electronic medical records for genetic and gene–environment research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20565774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3038887/fullTextXML") Annotation(rdfs:comment "The Marshfield Clinic Personalized Medicine Research Project (PMRP) is a population-based biobank with approximately 20,000 adult participants and access to an average of 30 years of medical history data [5-7].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000873> "A population-based biobank cohort of about 20,000 adults living in 19 zip codes around Marshfield, Wisconsin, United States, recruited by the Marshfield Clinic from 2002, who provided DNA, serum and plasma samples linked to their electronic medical records for genetic and gene–environment research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20565774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000888.v1.p1") Annotation(rdfs:comment "In addition to an average of 30 years of medical history data, a questionnaire about environmental exposures, including a detailed food frequency questionnaire, is available to facilitate gene/environment studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000873> "A population-based biobank cohort of about 20,000 adults living in 19 zip codes around Marshfield, Wisconsin, United States, recruited by the Marshfield Clinic from 2002, who provided DNA, serum and plasma samples linked to their electronic medical records for genetic and gene–environment research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000874> (<http://www.ebi.ac.uk/coho/COHO_0000874>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18385676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18385676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18385676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In the discovery phase, we analyzed 315,450 tagging SNPs in 1,154 current and former (ever) smoking cases of European ancestry and 1,137 frequency-matched, ever-smoking controls from Houston, Texas.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000874> "A hospital-based case–control study of lung cancer at The University of Texas MD Anderson Cancer Center in Houston, Texas, of ever-smoking patients of European ancestry and frequency-matched ever-smoking controls, genotyped genome-wide to find lung cancer susceptibility loci and later pooled in international lung cancer consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18385676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18385676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18385676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To identify risk variants for lung cancer, we conducted a multistage genome-wide association study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000874> "A hospital-based case–control study of lung cancer at The University of Texas MD Anderson Cancer Center in Houston, Texas, of ever-smoking patients of European ancestry and frequency-matched ever-smoking controls, genotyped genome-wide to find lung cancer susceptibility loci and later pooled in international lung cancer consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18385676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22899653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607485/fullTextXML") Annotation(rdfs:comment "The meta-analysis was based on summary data from 16 previously reported lung cancer GWASs undertaken by nine analytical centers providing genotype data on 14 900 lung cancer cases and 29 485 controls of European descent: the MD Anderson Cancer Center lung cancer study;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000874> "A hospital-based case–control study of lung cancer at The University of Texas MD Anderson Cancer Center in Houston, Texas, of ever-smoking patients of European ancestry and frequency-matched ever-smoking controls, genotyped genome-wide to find lung cancer susceptibility loci and later pooled in international lung cancer consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18385676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22899653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3607485/unicode") Annotation(rdfs:comment "MDACCa 1150 1134 Texas, USA Hospital-based case–control 317 K 312 829") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000874> "A hospital-based case–control study of lung cancer at The University of Texas MD Anderson Cancer Center in Houston, Texas, of ever-smoking patients of European ancestry and frequency-matched ever-smoking controls, genotyped genome-wide to find lung cancer susceptibility loci and later pooled in international lung cancer consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000875> (<http://www.ebi.ac.uk/coho/COHO_0000875>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21926416") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21926416") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3298855/") Annotation(rdfs:comment "Data from 1804 cases and 1026 controls were analyzed for the association study of CM susceptibility.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000875> "A hospital-based case–control study of cutaneous melanoma at The University of Texas MD Anderson Cancer Center, with non-Hispanic white patients and cancer-free controls (friends or acquaintances accompanying patients) recruited between 1998 and 2008, genotyped genome-wide to find melanoma susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21926416") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21926416") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3298855/") Annotation(rdfs:comment "Samples and data were available from 931 CM patients and 1026 cancer-free controls (friends or acquaintances of patients reporting to other clinics), who were frequency-matched on age and sex, completed a comprehensive skin lifestyle questionnaire and passed QC filters for genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000875> "A hospital-based case–control study of cutaneous melanoma at The University of Texas MD Anderson Cancer Center, with non-Hispanic white patients and cancer-free controls (friends or acquaintances accompanying patients) recruited between 1998 and 2008, genotyped genome-wide to find melanoma susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21926416") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21926416") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3298855/") Annotation(rdfs:comment "The study participants for the discovery analysis were from a hospital-based case–control study of CM, for which cases were recruited from non-Hispanic white patients and controls at MD Anderson between March 1998 and August 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000875> "A hospital-based case–control study of cutaneous melanoma at The University of Texas MD Anderson Cancer Center, with non-Hispanic white patients and cancer-free controls (friends or acquaintances accompanying patients) recruited between 1998 and 2008, genotyped genome-wide to find melanoma susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21926416") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21926416") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3298855/") Annotation(rdfs:comment "genotypes were available for 1804 Caucasian CM patients presenting to clinics (other than dermatology) at The University of Texas MD Anderson Cancer Center and 1026 Caucasian cancer-free controls who were friends or acquaintances accompanying patients at their clinical visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000875> "A hospital-based case–control study of cutaneous melanoma at The University of Texas MD Anderson Cancer Center, with non-Hispanic white patients and cancer-free controls (friends or acquaintances accompanying patients) recruited between 1998 and 2008, genotyped genome-wide to find melanoma susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000876> (<http://www.ebi.ac.uk/coho/COHO_0000876>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41951582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40045203") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11884146/fullTextXML") Annotation(rdfs:comment "The control subjects were cognitively normal older adults from the NCGG hospital and a cohort study of older adults in the NCGG neighborhood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000876> "A biobank at the National Center for Geriatrics and Gerontology in Obu, Japan, holding DNA samples and clinical data from tens of thousands of patients with dementia and other age-related conditions and cognitively normal older adults from the NCGG hospital and a neighbourhood cohort, used for genetic studies of dementia and ageing in the Japanese population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41951582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41951582") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13183990/fullTextXML") Annotation(rdfs:comment "The National Center for Geriatrics and Gerontology (NCGG) Biobank holds DNA samples and the associated clinical data from tens of thousands of individuals, with WGS data available for thousands of participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000876> "A biobank at the National Center for Geriatrics and Gerontology in Obu, Japan, holding DNA samples and clinical data from tens of thousands of patients with dementia and other age-related conditions and cognitively normal older adults from the NCGG hospital and a neighbourhood cohort, used for genetic studies of dementia and ageing in the Japanese population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41951582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13303076/fullTextXML") Annotation(rdfs:comment "Here, we conducted a GWAS comprising 1001 Japanese individuals from the National Center for Geriatrics and Gerontology (NCGG) Biobank, followed by a meta-analysis with GWAS data from 9479 individuals in the Japan Prospective Studies Collaboration for Aging and Dementia (JPSC-AD), identifying three novel loci significantly associated with WMH volume (P < 5 × 10−8).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000876> "A biobank at the National Center for Geriatrics and Gerontology in Obu, Japan, holding DNA samples and clinical data from tens of thousands of patients with dementia and other age-related conditions and cognitively normal older adults from the NCGG hospital and a neighbourhood cohort, used for genetic studies of dementia and ageing in the Japanese population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41951582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925686/fullTextXML") Annotation(rdfs:comment "The discovery stage of the study consisted of 3962 AD cases and 4074 controls (2974 AD cases and 3096 controls from the National Center for Geriatrics and Gerontology [NCGG biobank]; 988 AD cases and 978 controls from Niigata University16).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000876> "A biobank at the National Center for Geriatrics and Gerontology in Obu, Japan, holding DNA samples and clinical data from tens of thousands of patients with dementia and other age-related conditions and cognitively normal older adults from the NCGG hospital and a neighbourhood cohort, used for genetic studies of dementia and ageing in the Japanese population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41951582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncgg.go.jp/research/biobank/") Annotation(rdfs:comment "National Center for Geriatrics and Gerontology Biobank 7-430, Morioka-cho, Obu City,Aichi Prefecture, Japan, 474-8511") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000876> "A biobank at the National Center for Geriatrics and Gerontology in Obu, Japan, holding DNA samples and clinical data from tens of thousands of patients with dementia and other age-related conditions and cognitively normal older adults from the NCGG hospital and a neighbourhood cohort, used for genetic studies of dementia and ageing in the Japanese population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41951582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncgg.go.jp/research/biobank/") Annotation(rdfs:comment "The Biobank collects and stores samples and information with the informed consent of donors according to relevant laws and guidelines, mainly from elderly patients with dementia or other geriatric disorders in the hospital, and distributes them widely for medical research including academia and industries after approval of the Utilization Review Board.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000876> "A biobank at the National Center for Geriatrics and Gerontology in Obu, Japan, holding DNA samples and clinical data from tens of thousands of patients with dementia and other age-related conditions and cognitively normal older adults from the NCGG hospital and a neighbourhood cohort, used for genetic studies of dementia and ageing in the Japanese population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000877> (<http://www.ebi.ac.uk/coho/COHO_0000877>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42557812") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38714721") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076516/fullTextXML") Annotation(rdfs:comment "By precisely characterizing different aspects of over 10,000 pregnancies, the nuMoM2b cohort has already yielded valuable insights into factors that contribute to APOs11,12.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000877> "A prospective multicentre US cohort of 10,038 nulliparous women with singleton pregnancies recruited in the first trimester at eight clinical sites between 2010 and 2013 and followed through pregnancy, to study the factors that contribute to adverse pregnancy outcomes such as preterm birth, preeclampsia and gestational diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42557812") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38714721") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076516/fullTextXML") Annotation(rdfs:comment "The objective of this study was to test for association between common variants across the maternal genome and four APOs in the nuMoM2b cohort: gestational length (as a proxy for preterm birth), preeclampsia, gestational diabetes mellitus (GDM), and pregnancy loss.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000877> "A prospective multicentre US cohort of 10,038 nulliparous women with singleton pregnancies recruited in the first trimester at eight clinical sites between 2010 and 2013 and followed through pregnancy, to study the factors that contribute to adverse pregnancy outcomes such as preterm birth, preeclampsia and gestational diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42557812") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38714721") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076516/fullTextXML") Annotation(rdfs:comment "The study enrolled 10,038 nulliparous people from the first trimester of their pregnancy to participate in three study visits during pregnancy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000877> "A prospective multicentre US cohort of 10,038 nulliparous women with singleton pregnancies recruited in the first trimester at eight clinical sites between 2010 and 2013 and followed through pregnancy, to study the factors that contribute to adverse pregnancy outcomes such as preterm birth, preeclampsia and gestational diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42557812") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42557812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13511387/fullTextXML") Annotation(rdfs:comment "Briefly, the nuMoM2b study was a prospective multicenter cohort study of 10,038 pregnant individuals with singleton gestations recruited from eight clinical sites in the US.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000877> "A prospective multicentre US cohort of 10,038 nulliparous women with singleton pregnancies recruited in the first trimester at eight clinical sites between 2010 and 2013 and followed through pregnancy, to study the factors that contribute to adverse pregnancy outcomes such as preterm birth, preeclampsia and gestational diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42557812") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42557812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13511387/fullTextXML") Annotation(rdfs:comment "The parent study enrolled 10,038 nulliparous pregnancies from October 2010 to May 2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000877> "A prospective multicentre US cohort of 10,038 nulliparous women with singleton pregnancies recruited in the first trimester at eight clinical sites between 2010 and 2013 and followed through pregnancy, to study the factors that contribute to adverse pregnancy outcomes such as preterm birth, preeclampsia and gestational diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000878> (<http://www.ebi.ac.uk/coho/COHO_0000878>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41287920") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12671915/fullTextXML") Annotation(rdfs:comment "A subsample of participants (N = 1,598) underwent a Magnetic Resonance Imaging (MRI) scan on a 3 T Siemens TIMTrio scanner at the Hospital of the University of Pennsylvania (see Satterthwaite et al., 2014 for all the details regarding the neuroimaging protocol).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41287920") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12671915/fullTextXML") Annotation(rdfs:comment "All participants underwent a clinical assessment using a computerized structured interview (Kiddie Schedule for Affective Disorders and Schizophrenia (K-SADS) Family Study Interview (Kaufman et al., 1997) that was administered to an informant (caregiver or legal guardian), for those between 8 and 10 years old, to an informant and probands, for those between 11 and 17 years old, and to probands only for those aged 18–21 years old.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41287920") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12671915/fullTextXML") Annotation(rdfs:comment "Between 2006 and 2012, 50,293 participants were recruited by the Children’s Hospital of Philadelphia Center for Applied Genomics through a network of non-psychiatric pediatric clinics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41287920") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12671915/fullTextXML") Annotation(rdfs:comment "The Philadelphia Neurodevelopmental Cohort (PNC) is a population-based study of youth living in the greater Philadelphia (United States) area (Calkins et al., 2015) that aims to describe how genetics impacts brain development and cognitive functioning in adolescents (Satterthwaite et al., 2014).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5315539/fullTextXML") Annotation(rdfs:comment "Our primary analytic sample was drawn from the PNC, a Children's Hospital of Philadelphia health network-based sample of ~9500 individuals ages 8–21 years from the greater Philadelphia area (details in Calkins et al.20 and Gur et al.24).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5315539/fullTextXML") Annotation(rdfs:comment "We first used combined genomic and neurocognitive data from the Philadelphia Neurodevelopmental Cohort (4303 participants ages 8–21 years) to screen 26 neurocognitive phenotypes for their association with schizophrenia polygenic risk.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000879> (<http://www.ebi.ac.uk/coho/COHO_0000879>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26034056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4527942/") Annotation(rdfs:comment "Briefly, the ProHealth study focused on ascertaining KP Northern California African-American PCa cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000879> "A study within Kaiser Permanente Northern California that ascertained African-American prostate cancer cases, genotyped together with the Research Program on Genes, Environment and Health cohort and the California Men's Health Study for genome-wide association studies of prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26034056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4527942/") Annotation(rdfs:comment "This process was repeated including ProHealth, CMHS, and additional genotyped individuals not in the originally genotyped GERA cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000879> "A study within Kaiser Permanente Northern California that ascertained African-American prostate cancer cases, genotyped together with the Research Program on Genes, Environment and Health cohort and the California Men's Health Study for genome-wide association studies of prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26034056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4527942/") Annotation(rdfs:comment "To further characterize PCa’s genetic basis, we undertook a GWAS using multiple study cohorts within Kaiser Permanente (KP), a fully integrated health care delivery system: the Research Program on Genes, Environment and Health (RPGEH) cohort (dbGaP phs000674.p1), the ProHealth Study, and the California Men’s Health Study (CMHS) (29).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000879> "A study within Kaiser Permanente Northern California that ascertained African-American prostate cancer cases, genotyped together with the Research Program on Genes, Environment and Health cohort and the California Men's Health Study for genome-wide association studies of prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000880> (<http://www.ebi.ac.uk/coho/COHO_0000880>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31095341") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7019089/fullTextXML") Annotation(rdfs:comment "The Radiogenomics Consortium was established to facilitate data sharing and develop methods for meta-analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35039627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8980077/fullTextXML") Annotation(rdfs:comment "However, increasing evidence also points to an individual inherent predisposition of developing toxicity [5] and in 2009, the Radiogenomics Consortium [6, 7] was established, facilitating research efforts in genetic variations associated with RT-induced toxicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37862240") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10653584/fullTextXML") Annotation(rdfs:comment "Therefore, we aimed to carry out a GWAS meta-analysis of radiation-induced toxicities across tissues among 19 cohorts totaling 12 042 patients representing 4 cancers (prostate, head and neck, breast, and lung) from the Radiogenomic Consortium (https://epi.grants.cancer.gov/radiogenomics/).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC12048210") Annotation(rdfs:comment "Hematuria in the RGC cohorts was assessed prospectively pre-radiotherapy and approximately every six months using outcomes graded according to the NCI Common Terminology Criteria for Adverse Events (CTCAE)v4 such that grade ≥2 (≥G2) corresponded to gross bleeding or worse.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC12058264/unicode") Annotation(rdfs:comment "Other prostate cohorts were available through data sharing agreements through the international Radiogenomics Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000881> (<http://www.ebi.ac.uk/coho/COHO_0000881>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24292867") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4159747/unicode") Annotation(rdfs:comment "Controls, frequency matched to cases by age and geographic region, were selected from the EPIC-Norfolk cohort study recruited between 1992 and 1994 and from general practitioner practices from March 2003 to present.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24292867") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4159747/unicode") Annotation(rdfs:comment "Genotyping for PBCS and SEARCH was performed using pre-designed TaqMan assays (Applied Biosystems, Foster City, CA, USA) according to standard protocols described previously in the framework of the Breast Cancer Association Consortium (BCAC) of which both PBCS and SEARCH are participating studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24292867") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4159747/unicode") Annotation(rdfs:comment "We used data from the SEARCH Breast Cancer Study an ongoing population-based study of women diagnosed with breast cancer in the region of England included in the Eastern Cancer Registration and Information Centre (ECRIC, formerly East Anglia Cancer Registry).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25855707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/fullTextXML") Annotation(rdfs:comment "Study of Epidemiology and Risk factors in Cancer Heredity (SEARCH) was funded by a programme grant from Cancer Research UK (C490/A10124), the UK National Institute for Health Research Biomedical Research Centre at the University of Cambridge, and a Cancer Research UK grant (C8197/A10123) to AMD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(rdfs:comment "Men < 70 years of age registered with prostate cancer at the population-based cancer registry, Eastern Cancer Registration and Information Centre, East Anglia, UK Men attending general practice in East Anglia with no known prostate cancer diagnosis, frequency matched to cases by age and geographic region") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3263985/fullTextXML") Annotation(rdfs:comment "Samples were ascertained through the SEARCH (Studies of Epidemiology and Risk Factors in Cancer Heredity, http://www.cancerhelp.org.uk/trials/a-study-looking-at-genetic-causes-of-cancer) study based in Cambridge, UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000882> (<http://www.ebi.ac.uk/coho/COHO_0000882>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15465616") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15465616") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15465616+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Data collection involves patient interviews, physical examinations, laboratory measurements (diabetes autoantibodies, fasting/stimulating C-peptide, hemoglobin A1c, blood glucose, lipids, urine albumin, creatinine), medical records reviews, and documentation of risk factors for complications and processes of care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000882> "An observational multicentre study in the United States of physician-diagnosed diabetes in people under 20 years old, ascertaining prevalent and incident cases in geographically defined populations and health plans, with interviews, examinations and laboratory measurements, to estimate the prevalence, incidence and classification of diabetes in youth.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15465616") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15465616") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15465616+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "SEARCH for Diabetes in Youth is an observational, multicenter study focusing on physician-diagnosed diabetes in individuals <20 years old.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000882> "An observational multicentre study in the United States of physician-diagnosed diabetes in people under 20 years old, ascertaining prevalent and incident cases in geographically defined populations and health plans, with interviews, examinations and laboratory measurements, to estimate the prevalence, incidence and classification of diabetes in youth.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15465616") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15465616") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15465616+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study will estimate the population prevalence and incidence of diabetes by type, age, gender, and ethnicity and develop practical approaches to diabetes classification in 5 million children ( approximately 6% of the <20 U.S. population) with wide ethnic and socioeconomic representation from four geographically defined populations and two health plans.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000882> "An observational multicentre study in the United States of physician-diagnosed diabetes in people under 20 years old, ascertaining prevalent and incident cases in geographically defined populations and health plans, with interviews, examinations and laboratory measurements, to estimate the prevalence, incidence and classification of diabetes in youth.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15465616") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25414389") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4237981/fullTextXML") Annotation(rdfs:comment "Each site identified prevalent (in 2001 and 2009) and incident cases (ongoing since 2002) of diagnosed diabetes (excluding gestational diabetes) in youth <20 years of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000882> "An observational multicentre study in the United States of physician-diagnosed diabetes in people under 20 years old, ascertaining prevalent and incident cases in geographically defined populations and health plans, with interviews, examinations and laboratory measurements, to estimate the prevalence, incidence and classification of diabetes in youth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000883> (<http://www.ebi.ac.uk/coho/COHO_0000883>)

