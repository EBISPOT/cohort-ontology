# Individual: <http://www.ebi.ac.uk/coho/COHO_0001929> (<http://www.ebi.ac.uk/coho/COHO_0001929>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29025017") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29025017") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837578/") Annotation(rdfs:comment "As part of a Lymphoma Specialized Program of Research Excellence (SPORE) programme, the Molecular Epidemiology Resource (MER) was initiated as an observational epidemiology cohort study of prospectively enrolled newly diagnosed lymphoma patients evaluated at the Mayo Clinic (Rochester, MN) and the University of Iowa (Iowa City, IA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001929> "An observational epidemiology cohort of consecutive patients with newly diagnosed lymphoma (including Hodgkin lymphoma and chronic lymphocytic leukaemia), US residents aged 18 or over enrolled within 9 months of diagnosis at the Mayo Clinic in Rochester, Minnesota, and the University of Iowa in Iowa City from September 2002 to June 2015 as part of the University of Iowa/Mayo Clinic Lymphoma Specialized Program of Research Excellence (SPORE), set up to identify clinical, epidemiological, germline genetic, tumour and treatment factors that affect lymphoma outcomes and survivorship.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29025017") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29025017") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837578/") Annotation(rdfs:comment "The Lymphoma Specialized Program of Research Excellence (SPORE) Molecular Epidemiology Resource (MER) is a prospective cohort study designed to identify clinical, epidemiological, host genetic, biological, tumour and treatment factors that impact on lymphoma outcomes and survivorship.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001929> "An observational epidemiology cohort of consecutive patients with newly diagnosed lymphoma (including Hodgkin lymphoma and chronic lymphocytic leukaemia), US residents aged 18 or over enrolled within 9 months of diagnosis at the Mayo Clinic in Rochester, Minnesota, and the University of Iowa in Iowa City from September 2002 to June 2015 as part of the University of Iowa/Mayo Clinic Lymphoma Specialized Program of Research Excellence (SPORE), set up to identify clinical, epidemiological, germline genetic, tumour and treatment factors that affect lymphoma outcomes and survivorship.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29025017") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29025017") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837578/") Annotation(rdfs:comment "all consecutive cases of lymphoma, including Hodgkin lymphoma (HL) and chronic lymphocytic leukaemia (CLL), who were within 9 months of their initial diagnosis at presentation, a US resident and age 18 years and older, were eligible for enrolment into the MER from 1 September 2002 to 30 June 2015.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001929> "An observational epidemiology cohort of consecutive patients with newly diagnosed lymphoma (including Hodgkin lymphoma and chronic lymphocytic leukaemia), US residents aged 18 or over enrolled within 9 months of diagnosis at the Mayo Clinic in Rochester, Minnesota, and the University of Iowa in Iowa City from September 2002 to June 2015 as part of the University of Iowa/Mayo Clinic Lymphoma Specialized Program of Research Excellence (SPORE), set up to identify clinical, epidemiological, germline genetic, tumour and treatment factors that affect lymphoma outcomes and survivorship.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001930> (<http://www.ebi.ac.uk/coho/COHO_0001930>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5448553/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21602798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3102788/unicode") Annotation(rdfs:comment "Stage 1 included 3,621 African American prostate cancer cases and 3,502 African American controls drawn from 11 studies (Supplementary Table 1, Online Methods).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001930> "A case–control study of prostate cancer in African American men in Maryland, United States, with cases from the Johns Hopkins Hospital and Sidney Kimmel Cancer Center and controls from men undergoing prostate cancer screening at the same institutions, one of the studies of the African Ancestry Prostate Cancer (AAPC) GWAS consortium's genome-wide association studies of prostate cancer in men of African ancestry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5448553/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29117387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5448553/fullTextXML") Annotation(rdfs:comment "To investigate the genetic basis of prostate cancer in men of African ancestry, we performed a genome-wide association meta-analysis using two-sided statistical tests in 10 202 case subjects and 10 810 control subjects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001930> "A case–control study of prostate cancer in African American men in Maryland, United States, with cases from the Johns Hopkins Hospital and Sidney Kimmel Cancer Center and controls from men undergoing prostate cancer screening at the same institutions, one of the studies of the African Ancestry Prostate Cancer (AAPC) GWAS consortium's genome-wide association studies of prostate cancer in men of African ancestry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5448553/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29117387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5448553/supplementaryFiles") Annotation(rdfs:comment "Identifying Prostate Cancer Genes | IPCG | AAPC GWAS | 368 | 172 | 354 | 157 | Case-control, Maryland, U.S. | Johns Hopkins Hospital and Sidney Kimmel Cancer Center | Men undergoing screening for prostate cancer at the same institutions | [PMID:17401366]") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001930> "A case–control study of prostate cancer in African American men in Maryland, United States, with cases from the Johns Hopkins Hospital and Sidney Kimmel Cancer Center and controls from men undergoing prostate cancer screening at the same institutions, one of the studies of the African Ancestry Prostate Cancer (AAPC) GWAS consortium's genome-wide association studies of prostate cancer in men of African ancestry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001932> (<http://www.ebi.ac.uk/coho/COHO_0001932>)

