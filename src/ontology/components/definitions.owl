AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000052") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25898923") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4795224") Annotation(rdfs:comment "A female subject was referred to the outpatient clinic of the Academic Medical Center (Amsterdam, the Netherlands) for analysis after she suffered from an acute myocardial infarction at the age of 39 years (Figure 1; index II.6).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000322> "A collection of pedigrees with premature atherosclerosis from the Academic Medical Center, Amsterdam, exome sequenced to identify rare genetic variants contributing to cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000052") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000052") Annotation(rdfs:comment "Due to the low MAF, PAS-causing mutations cannot be identified by indirect genotyping because their presence cannot be inferred from common haplotypes, as has been done successfully to uncover common risk variants by GWAS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000322> "A collection of pedigrees with premature atherosclerosis from the Academic Medical Center, Amsterdam, exome sequenced to identify rare genetic variants contributing to cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000052") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000052") Annotation(rdfs:comment "We expect exome sequencing to result in a high number of mutations and non-causitive coding variants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000322> "A collection of pedigrees with premature atherosclerosis from the Academic Medical Center, Amsterdam, exome sequenced to identify rare genetic variants contributing to cardiovascular disease.")

