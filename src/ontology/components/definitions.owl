AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24270294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35414113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "The Breast Cancer Environment and Employment Study (BCEES) is a large, population-based case–control study of women aged between 18 and 80 years") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001059> "A population-based case-control study of women aged 18-80 recruited in Western Australia between May 2009 and January 2011 to investigate occupational and environmental risk factors for breast cancer.")
