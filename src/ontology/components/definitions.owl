AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20385819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000182.v3.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000182.v3.p1") Annotation(rdfs:comment "Affected with geographic atrophy, neovascularization, or large drusen in at least one eye.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002072> "A case-control collection for a joint genome-wide association study of age-related macular degeneration, assembled by researchers from the University of Michigan, the Mayo Clinic, the University of Pennsylvania and the Age-Related Eye Disease Study group with National Eye Institute intramural investigators, who contributed patients with macular degeneration characterised by geographic atrophy, neovascularisation or large drusen and examined unaffected controls enrolled from 1998 through ophthalmology clinics in Michigan, Pennsylvania, Minnesota and Texas and through the Age-Related Eye Disease Study, genotyped together at the Center for Inherited Disease Research.")
