AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000381") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22832583") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3662966/") Annotation(rdfs:comment "As a first phase of the International Cancer Genome Consortium (ICGC) PedBrain Tumor Project (www.pedbraintumor.org), we have collected matched tumour and germline samples from 125 medulloblastoma patients aged from 0–17 years (Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000274> "A collection of paediatric brain tumours, including medulloblastomas, low-grade astrocytomas and glioblastomas, with matched normal samples, characterised by whole-genome, RNA and methylation sequencing within the International Cancer Genome Consortium's PedBrain Tumor Project.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000381") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23817572") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23817572+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Here we describe whole-genome sequencing of 96 pilocytic astrocytomas, with matched RNA sequencing (n = 73), conducted by the International Cancer Genome Consortium (ICGC) PedBrain Tumor Project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000274> "A collection of paediatric brain tumours, including medulloblastomas, low-grade astrocytomas and glioblastomas, with matched normal samples, characterised by whole-genome, RNA and methylation sequencing within the International Cancer Genome Consortium's PedBrain Tumor Project.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000381") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000381") Annotation(rdfs:comment "In order to investigate the full range of genetic alterations contributing to the tumourigenesis of low-grade astrocytoma, we have conducted a next-generation sequencing-based analysis on a large series of matched tumor-normal pairs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000274> "A collection of paediatric brain tumours, including medulloblastomas, low-grade astrocytomas and glioblastomas, with matched normal samples, characterised by whole-genome, RNA and methylation sequencing within the International Cancer Genome Consortium's PedBrain Tumor Project.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000381") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5627533") Annotation(rdfs:comment "Sixteen recently published pediatric glioblastoma RNA-seq samples were chosen as the first training data (International Cancer Genome Consortium PedBrain Tumor Project, 2016).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000274> "A collection of paediatric brain tumours, including medulloblastomas, low-grade astrocytomas and glioblastomas, with matched normal samples, characterised by whole-genome, RNA and methylation sequencing within the International Cancer Genome Consortium's PedBrain Tumor Project.")

