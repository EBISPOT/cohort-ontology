# Individual: <http://www.ebi.ac.uk/coho/COHO_0002565> (<http://www.ebi.ac.uk/coho/COHO_0002565>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25429064") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429064") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4351379/") Annotation(rdfs:comment "Stage 1 was meta-analysis of study-specific results on the association between SNPs and height from 11 GWAS that participated in the consortium and included a total of 36 227 individuals of East Asian ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002565> "A case-control genome-wide association study sample of Chinese adults that combines participants of the Dongfeng-Tongji cohort study, a cohort of retired employees of a state-owned automobile enterprise in China, with patients with oesophageal squamous-cell carcinoma recruited at the Cancer Hospital of the Chinese Academy of Medical Sciences in Beijing; it was one of the Stage 1 studies of the 2015 meta-analysis of genome-wide association studies of adult height in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25429064") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429064") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc") Annotation(rdfs:comment "Other 1,964 subjects with esophageal squamous-cell cancer were recruited at the cancer Hospital, Chinese Academy of Medical Sciences in China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002565> "A case-control genome-wide association study sample of Chinese adults that combines participants of the Dongfeng-Tongji cohort study, a cohort of retired employees of a state-owned automobile enterprise in China, with patients with oesophageal squamous-cell carcinoma recruited at the Cancer Hospital of the Chinese Academy of Medical Sciences in Beijing; it was one of the Stage 1 studies of the 2015 meta-analysis of genome-wide association studies of adult height in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25429064") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429064") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc") Annotation(rdfs:comment "The Dongfeng-tongji cohort study enrolled with 27,009 retired employees from a state-owned automobile enterprise in China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002565> "A case-control genome-wide association study sample of Chinese adults that combines participants of the Dongfeng-Tongji cohort study, a cohort of retired employees of a state-owned automobile enterprise in China, with patients with oesophageal squamous-cell carcinoma recruited at the Cancer Hospital of the Chinese Academy of Medical Sciences in Beijing; it was one of the Stage 1 studies of the 2015 meta-analysis of genome-wide association studies of adult height in East Asians.")
