AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000820.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001189.v5.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001189.v5.p1") Annotation(rdfs:comment "This study is part of the NHLBI Trans-Omics for Precision Medicine (TOPMed) Whole Genome Sequencing Program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001066> "A collection of clinical and genetic data from patients with atrial fibrillation and controls enrolled at the Cleveland Clinic in its CV/Arrhythmia Biobank, including the Cleveland Clinic Lone Atrial Fibrillation GeneBank of patients with atrial fibrillation without significant structural heart disease, for genetic studies of atrial fibrillation; its early-onset cases were whole-genome sequenced in the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001067> (<http://www.ebi.ac.uk/coho/COHO_0001067>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29348612") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5773513/fullTextXML") Annotation(rdfs:comment "Therefore, active genotyping for CCRLP specifically for this project involved an approximately equal number of cases and controls (see Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29348612") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5773513/fullTextXML") Annotation(rdfs:comment "We linked statewide birth records maintained by the California Department of Public Health (for the years of 1982–2009) to cancer diagnosis data from the California Cancer Registry (CCR, for the years of 1988–2011).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36810956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10484172/fullTextXML") Annotation(rdfs:comment "Archived neonatal dried blood spot samples for cases and controls were provided by the California Biobank Program (CBP SIS#311).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36810956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10484172/fullTextXML") Annotation(rdfs:comment "California-born cancer-free controls were matched to cases based on date of birth, sex, and self-reported maternal race and/or ethnicity via the California Vital Statistics records.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36810956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10484172/fullTextXML") Annotation(rdfs:comment "Californian glioma cases and controls (ncases = 3150, ncontrols = 3154) were selected from the California Childhood Cancer Record Linkage Project, a matched case–control study previously described in detail.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36810956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10484172/fullTextXML") Annotation(rdfs:comment "In short, cases were born in California between 1982 and 2009, with a primary glioma diagnosis made before the age of 15 years registered from 1988 to 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")

