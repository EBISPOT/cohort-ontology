AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM3_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10363502") Annotation(rdfs:comment "Genome wide genotyping data was generated on Well- Gen and PMNS participants using Affymetrix SNP 6.0 Chips (Affymetrix, CA, USA) as previously described") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001823> "A collection of Indian cohorts brought together for genetic studies of type 2 diabetes by the Genomic Research on Complex Diseases group at the CSIR-Centre for Cellular and Molecular Biology (CCMB), Hyderabad, including the Indian Diabetes Prevention Study 3, the Pune Maternal Nutrition Study and the Wellcome Genetics (WellGen) study, whose type 2 diabetes cases (by history, treatment or WHO 1999 oral glucose tolerance criteria) and normoglycaemic controls were genotyped genome-wide.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM3_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf") Annotation(rdfs:comment "Genomic Research Cohort for CCMB Diabetes Study (GRCCDS) comprises of various cohorts that are supported by: Council of Scientific Industrial Research (CSIR); Ministry of Science and Technology, Govt. of India, India; and Wellcome Trust, London, UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001823> "A collection of Indian cohorts brought together for genetic studies of type 2 diabetes by the Genomic Research on Complex Diseases group at the CSIR-Centre for Cellular and Molecular Biology (CCMB), Hyderabad, including the Indian Diabetes Prevention Study 3, the Pune Maternal Nutrition Study and the Wellcome Genetics (WellGen) study, whose type 2 diabetes cases (by history, treatment or WHO 1999 oral glucose tolerance criteria) and normoglycaemic controls were genotyped genome-wide.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM3_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM3_ESM.xlsx") Annotation(rdfs:comment "GRCCDS | Genomic Research Cohort for CCMB Diabetes Study | 11285330, 17093941 | History of T2D or medication for it, and diagnosis of T2D by OGTT WHO 1999 criteria. | No history of diabetes or medication for it, and fasting glucose <6.1mmol/l, and 2hr glucose <7.8mmol/l. | SAS") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001823> "A collection of Indian cohorts brought together for genetic studies of type 2 diabetes by the Genomic Research on Complex Diseases group at the CSIR-Centre for Cellular and Molecular Biology (CCMB), Hyderabad, including the Indian Diabetes Prevention Study 3, the Pune Maternal Nutrition Study and the Wellcome Genetics (WellGen) study, whose type 2 diabetes cases (by history, treatment or WHO 1999 oral glucose tolerance criteria) and normoglycaemic controls were genotyped genome-wide.")
