AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11876192") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11876192") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11876192+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Bogalusa, LA, is a biracial (black/white) rural community 70 miles north of New Orleans, comparable to many other communities in southeastern United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000464> "A long-term community-based cohort of Black and white children and adolescents in the rural biracial community of Bogalusa, Louisiana, United States, begun in 1972 by an NHLBI-funded research centre to study cardiovascular risk factors from early life and followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11876192") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11876192") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11876192+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Bogalusa Heart Study was begun in 1972 as an epidemiology study of cardiovascular risk factors in children and adolescents; it eventually evolved into observations of young adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000464> "A long-term community-based cohort of Black and white children and adolescents in the rural biracial community of Bogalusa, Louisiana, United States, begun in 1972 by an NHLBI-funded research centre to study cardiovascular risk factors from early life and followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11876192") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11876192") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11876192+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Bogalusa Heart Study, a long-term population study with a continued relationship with a community, addresses the problem of capacity building in minority health research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000464> "A long-term community-based cohort of Black and white children and adolescents in the rural biracial community of Bogalusa, Louisiana, United States, begun in 1972 by an NHLBI-funded research centre to study cardiovascular risk factors from early life and followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11876192") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11876192") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11876192+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study was originally funded as a Specialized Center of Research-Arteriosclerosis (SCOR-A) by the National Heart Lung and Blood Institute (NHLBI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000464> "A long-term community-based cohort of Black and white children and adolescents in the rural biracial community of Bogalusa, Louisiana, United States, begun in 1972 by an NHLBI-funded research centre to study cardiovascular risk factors from early life and followed into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000465> (<http://www.ebi.ac.uk/coho/COHO_0000465>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34315907") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8316336/fullTextXML") Annotation(rdfs:comment "As previously described, families were ascertained through a proband with SSD identified from caseloads of speech-language pathologists in the Greater Cleveland area and referred to the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34315907") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8316336/fullTextXML") Annotation(rdfs:comment "We conducted a GWAS in the Cleveland Family Speech and Reading Study (CFSRS), a cohort ascertained through a proband with SSD, and replicated findings in a population-based cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41118674") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12614917/fullTextXML") Annotation(rdfs:comment "Children with a diagnosis of SSD were referred to the study from the clinical caseloads of SLPs in Ohio.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41118674") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12614917/fullTextXML") Annotation(rdfs:comment "Next, we describe the Cleveland Family Speech and Reading Study (CFSRS), one of the few longitudinal studies of SSD of unknown etiology that identified phenotypes and genetic influences on speech and language disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41118674") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41118674+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Probands and available siblings were assessed on a battery of speech, language, and literacy measures at preschool (4;0-6;11 [years;months]), school age (7;0-11;11), and adolescence/young adulthood (12-25 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41118674") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41118674+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This article reviews findings from the Cleveland Family Speech and Reading Study, a 25-year longitudinal study of speech sound disorders (SSDs) of unknown etiology.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000466> (<http://www.ebi.ac.uk/coho/COHO_0000466>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36207451") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36207451") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/fullTextXML") Annotation(rdfs:comment "Among the 10 independent EA cohorts contributing to GENOA, OA was defined by Diagnostic and Statistical Manual criteria for opioid abuse or dependence (DSM-based; N = 17,061) or by frequency of use (FOU) of illicit opioids (e.g., injecting heroin 10 or more times in the past 30 days; FOU-based; N = 11,976; Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000466> "A consortium of investigators who attend the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team meetings and have genome-wide association data on opioid addiction, pooling previously unpublished genome-wide association studies of opioid addiction from twelve cohort samples, ten with European-ancestry and seven with African-ancestry participants, among them Yale-Penn, the Collaborative Study on the Genetics of Alcoholism and the Urban Health Study in the United States, the Vancouver Injection Drug Users Study in Canada, deCODE in Iceland, the Genetic Epidemiology of Opioid Dependence in Bulgaria study, the Comorbidity and Trauma Study in Australia and the AIDS Linked to the IntraVenous Experience cohort, to study the genetics of opioid addiction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36207451") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36207451") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/fullTextXML") Annotation(rdfs:comment "Descriptive statistics for the GENOA studies contributing previously unpublished GWAS of opioid addiction (OA) to this investigation are provided in Supplementary Table 1, and full descriptions of the studies are provided in the Supplementary Methods.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000466> "A consortium of investigators who attend the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team meetings and have genome-wide association data on opioid addiction, pooling previously unpublished genome-wide association studies of opioid addiction from twelve cohort samples, ten with European-ancestry and seven with African-ancestry participants, among them Yale-Penn, the Collaborative Study on the Genetics of Alcoholism and the Urban Health Study in the United States, the Vancouver Injection Drug Users Study in Canada, deCODE in Iceland, the Genetic Epidemiology of Opioid Dependence in Bulgaria study, the Comorbidity and Trauma Study in Australia and the AIDS Linked to the IntraVenous Experience cohort, to study the genetics of opioid addiction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36207451") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36207451") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/fullTextXML") Annotation(rdfs:comment "GENOA is a new consortium comprised of investigators who attend the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team Meetings and who have GWAS data on OA (Supplementary Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000466> "A consortium of investigators who attend the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team meetings and have genome-wide association data on opioid addiction, pooling previously unpublished genome-wide association studies of opioid addiction from twelve cohort samples, ten with European-ancestry and seven with African-ancestry participants, among them Yale-Penn, the Collaborative Study on the Genetics of Alcoholism and the Urban Health Study in the United States, the Vancouver Injection Drug Users Study in Canada, deCODE in Iceland, the Genetic Epidemiology of Opioid Dependence in Bulgaria study, the Comorbidity and Trauma Study in Australia and the AIDS Linked to the IntraVenous Experience cohort, to study the genetics of opioid addiction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36207451") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36207451") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/supplementaryFiles") Annotation(rdfs:comment "(1) The Comorbidity and Trauma Study (CATS) is a retrospective case-control study examining genetic and environmental factors contributing to heroin dependence liability.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000466> "A consortium of investigators who attend the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team meetings and have genome-wide association data on opioid addiction, pooling previously unpublished genome-wide association studies of opioid addiction from twelve cohort samples, ten with European-ancestry and seven with African-ancestry participants, among them Yale-Penn, the Collaborative Study on the Genetics of Alcoholism and the Urban Health Study in the United States, the Vancouver Injection Drug Users Study in Canada, deCODE in Iceland, the Genetic Epidemiology of Opioid Dependence in Bulgaria study, the Comorbidity and Trauma Study in Australia and the AIDS Linked to the IntraVenous Experience cohort, to study the genetics of opioid addiction.")
