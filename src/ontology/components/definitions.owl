AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12922955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21156761") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12922955") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1754669/") Annotation(rdfs:comment "To quantify the influence of cigarette smoking on the risk of developing rheumatoid arthritis (RA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000458> "A population-based case-control study established in Sweden in 1996, enrolling incident rheumatoid arthritis cases from the middle and southern regions of Sweden together with population controls, used to study genetic risk factors for rheumatoid arthritis and its ACPA-defined subsets and environmental factors such as cigarette smoking.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12922955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21156761") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21156761") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3015094/fullTextXML") Annotation(rdfs:comment "EIRA is a population-based case–control study enrolling incident (predominantly <1 year after clinical onset) cases of RA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000458> "A population-based case-control study established in Sweden in 1996, enrolling incident rheumatoid arthritis cases from the middle and southern regions of Sweden together with population controls, used to study genetic risk factors for rheumatoid arthritis and its ACPA-defined subsets and environmental factors such as cigarette smoking.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12922955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21156761") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21156761") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3015094/fullTextXML") Annotation(rdfs:comment "we have performed genome-wide association analyses in both RA subsets in two different collections of RA cases and controls defined by ACPA status") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000458> "A population-based case-control study established in Sweden in 1996, enrolling incident rheumatoid arthritis cases from the middle and southern regions of Sweden together with population controls, used to study genetic risk factors for rheumatoid arthritis and its ACPA-defined subsets and environmental factors such as cigarette smoking.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12922955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21156761") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37326842") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11065441/fullTextXML") Annotation(rdfs:comment "EIRA, a case–control study established in 1996, currently contains >5000 incident RA cases from the middle and southern regions of Sweden [18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000458> "A population-based case-control study established in Sweden in 1996, enrolling incident rheumatoid arthritis cases from the middle and southern regions of Sweden together with population controls, used to study genetic risk factors for rheumatoid arthritis and its ACPA-defined subsets and environmental factors such as cigarette smoking.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000459> (<http://www.ebi.ac.uk/coho/COHO_0000459>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39003598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.luric.online") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17185364") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17185364+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In 2543 persons with and 695 without coronary artery disease (CAD) identified by angiography we measured ADMA and recorded total and cardiovascular mortality during a median follow-up of 5.45 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,808 patients from the Ludwigshafen, Mannheim and Heidelberg area of south-west Germany, enrolled between July 1997 and March 2002 when they underwent coronary angiography at the municipal hospital of Ludwigshafen, with and without coronary artery disease, examined at baseline (medical history, physical examination, glucose tolerance test and blood sampling) and followed up from 2004, to investigate genetic and environmental risk factors for cardiovascular diseases. Most analyses use its 3,316 participants of German ancestry recruited between July 1997 and January 2000.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39003598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.luric.online") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32915819") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7485803/fullTextXML") Annotation(rdfs:comment "The LURIC health study is a prospective cohort study aimed at assessing the genetic and environmental risk factors in cardiovascular diseases for 3,316 Caucasians of German ancestry (2,309 male and 1,007 female) between 1997 and 2000 [9].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,808 patients from the Ludwigshafen, Mannheim and Heidelberg area of south-west Germany, enrolled between July 1997 and March 2002 when they underwent coronary angiography at the municipal hospital of Ludwigshafen, with and without coronary artery disease, examined at baseline (medical history, physical examination, glucose tolerance test and blood sampling) and followed up from 2004, to investigate genetic and environmental risk factors for cardiovascular diseases. Most analyses use its 3,316 participants of German ancestry recruited between July 1997 and January 2000.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39003598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.luric.online") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39003598") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11631318/fullTextXML") Annotation(rdfs:comment "A total of 3316 patients, who were referred for coronary angiography to the Ludwigshafen Heart Center in South‐West Germany, were recruited between July 1997 and January 2000.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,808 patients from the Ludwigshafen, Mannheim and Heidelberg area of south-west Germany, enrolled between July 1997 and March 2002 when they underwent coronary angiography at the municipal hospital of Ludwigshafen, with and without coronary artery disease, examined at baseline (medical history, physical examination, glucose tolerance test and blood sampling) and followed up from 2004, to investigate genetic and environmental risk factors for cardiovascular diseases. Most analyses use its 3,316 participants of German ancestry recruited between July 1997 and January 2000.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39003598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.luric.online") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.luric.online") Annotation(rdfs:comment "3.808 Personen aus dem Großraum Ludwigshafen · Mannheim · Heidelberg werden im Rahmen einer Koronarangiographie am Klinikum der Stadt Ludwigshafen in die Studie eingeschlossen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,808 patients from the Ludwigshafen, Mannheim and Heidelberg area of south-west Germany, enrolled between July 1997 and March 2002 when they underwent coronary angiography at the municipal hospital of Ludwigshafen, with and without coronary artery disease, examined at baseline (medical history, physical examination, glucose tolerance test and blood sampling) and followed up from 2004, to investigate genetic and environmental risk factors for cardiovascular diseases. Most analyses use its 3,316 participants of German ancestry recruited between July 1997 and January 2000.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39003598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.luric.online") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.luric.online") Annotation(rdfs:comment "Krankengeschichte, körperliche Untersuchung, Glukosetoleranztest und Blutentnahme bilden bis heute die Grundlage aller Auswertungen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,808 patients from the Ludwigshafen, Mannheim and Heidelberg area of south-west Germany, enrolled between July 1997 and March 2002 when they underwent coronary angiography at the municipal hospital of Ludwigshafen, with and without coronary artery disease, examined at baseline (medical history, physical examination, glucose tolerance test and blood sampling) and followed up from 2004, to investigate genetic and environmental risk factors for cardiovascular diseases. Most analyses use its 3,316 participants of German ancestry recruited between July 1997 and January 2000.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39003598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.luric.online") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.luric.online") Annotation(rdfs:comment "Zwischen Juli 1997 und März 2002 wurden 3.808 Personen aus dem Großraum Ludwigshafen · Mannheim · Heidelberg eingeschlossen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,808 patients from the Ludwigshafen, Mannheim and Heidelberg area of south-west Germany, enrolled between July 1997 and March 2002 when they underwent coronary angiography at the municipal hospital of Ludwigshafen, with and without coronary artery disease, examined at baseline (medical history, physical examination, glucose tolerance test and blood sampling) and followed up from 2004, to investigate genetic and environmental risk factors for cardiovascular diseases. Most analyses use its 3,316 participants of German ancestry recruited between July 1997 and January 2000.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000460> (<http://www.ebi.ac.uk/coho/COHO_0000460>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29221444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21409311") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21409311+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A second, parallel study, the African American DHS, has expanded the sample of African Americans to investigate marked racial differences in subclinical CVD between European Americans and African Americans.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29221444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21409311") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21409311+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Initially, participants were comprehensively examined for measures of subclinical cardiovascular disease (CVD) including computed tomography measurement of vascular calcified plaque, ultrasound imaging of carotid artery wall thickness, and electrocardiographic intervals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29221444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21409311") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21409311+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Diabetes Heart Study (DHS) is a genetic and epidemiological study of 1,443 European American and African American participants from 564 families with multiple cases of type 2 diabetes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29221444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23230101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3609509/fullTextXML") Annotation(rdfs:comment "The Diabetes Heart Study (DHS) is a community-based study of the genetic and epidemiological contributions to diabetic heart disease in which siblings concordant for type 2 diabetes mellitus (T2DM), as well as unaffected family members, were recruited from internal medicine and endocrinology clinics in western North Carolina.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29221444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23230101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3609509/fullTextXML") Annotation(rdfs:comment "The participant examinations were conducted in the General Clinical Research Center of the Wake Forest Baptist Medical Center and included interviews for medical history and health behaviors, including smoking history, and anthropometric measurements.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29221444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29221444") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5723099/fullTextXML") Annotation(rdfs:comment "As reported, AA-DHS consisted of AAs with T2D recruited from two Wake Forest School of Medicine (WFSM) studies: the family-based Diabetes Heart Study (DHS) and unrelated individuals in the AA-DHS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000461> (<http://www.ebi.ac.uk/coho/COHO_0000461>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25993607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25993607+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Neuroticism scores harmonized across all 29 discovery cohorts by item response theory analysis, and clinical MDD case-control status in 2 of the cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25993607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25993607+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Genetics of Personality Consortium has created a resource for genome-wide association analyses of personality traits in more than 63,000 participants (including MDD cases).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25993607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25993607+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study included 63,661 participants from 29 discovery cohorts and 9786 participants from a replication cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4667957/unicode") Annotation(rdfs:comment "After harmonizing all item data on neuroticism from multiple instruments, comparable neuroticism scores were obtained for all cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4667957/unicode") Annotation(rdfs:comment "Importantly, polygenic scores also predicted MDD in these cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4667957/unicode") Annotation(rdfs:comment "Personality item data were harmonized in >160,000 participants from the Genetics of Personality Consortium (GPC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")

