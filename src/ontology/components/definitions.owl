# Individual: <http://www.ebi.ac.uk/coho/COHO_0002175> (<http://www.ebi.ac.uk/coho/COHO_0002175>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18633668") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20966103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20966103") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20966103+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Case-control analysis was conducted using two large cohorts of Caucasian postmenopausal women--the North of Scotland Osteoporosis Study (n = 1,245) and the Aberdeen Prospective Osteoporosis Screening Study (n = 2,918)--for whom self-reported falls status and DNA samples were available.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002175> "A population-based osteoporosis screening programme of postmenopausal women aged 60-82 at baseline, recruited at centres in Aberdeen and Dingwall in the north of Scotland, who underwent bone mineral density measurement in 2001-2003 and gave questionnaire data and DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18633668") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20966103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1007/s00198-008-0681-4") Annotation(rdfs:comment "At baseline, women underwent risk factor assessment by questionnaire and bone density measurement of the lumbar spine (2nd to 4th lumbar vertebrae; LS), total right (RH) and left hip (LH) was carried out by DXA using LUNAR PRODIGY™ scanners (Lunar Corporation, GE Healthcare, Madison, WI, USA);") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002175> "A population-based osteoporosis screening programme of postmenopausal women aged 60-82 at baseline, recruited at centres in Aberdeen and Dingwall in the north of Scotland, who underwent bone mineral density measurement in 2001-2003 and gave questionnaire data and DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18633668") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20966103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1007/s00198-008-0681-4") Annotation(rdfs:comment "Participants attended the Osteoporosis Units in Aberdeen (a city with a population of 250,000 in the northeast of Scotland) and Dingwall (a town with a population of 5,500 in the Scottish Highlands).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002175> "A population-based osteoporosis screening programme of postmenopausal women aged 60-82 at baseline, recruited at centres in Aberdeen and Dingwall in the north of Scotland, who underwent bone mineral density measurement in 2001-2003 and gave questionnaire data and DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18633668") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20966103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1007/s00198-008-0681-4") Annotation(rdfs:comment "The current participants were subjects from the North of Scotland Osteoporosis Study (NOSOS), which is a population-based screening programme for osteoporotic fracture that involved 1,847 women aged 60–82 years at baseline (2001–2003).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002175> "A population-based osteoporosis screening programme of postmenopausal women aged 60-82 at baseline, recruited at centres in Aberdeen and Dingwall in the north of Scotland, who underwent bone mineral density measurement in 2001-2003 and gave questionnaire data and DNA samples.")
