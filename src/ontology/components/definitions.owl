AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23461817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9294370") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9413795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9294370") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9294370+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Twins and their parents were asked systematically about risk factors and current psychiatric symptoms by means of investigator-based psychiatric interviews and questionnaires.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001248> "A population-based, cohort-sequential longitudinal study of European-ancestry twin pairs born in 1974-1983, ascertained at ages 8 to 16 through the state and participating private schools of Virginia, United States, who with their parents were assessed by psychiatric interviews and questionnaires in four waves about 18 months apart and again in their mid-20s, to study genetic and environmental influences on the development of child and adolescent psychopathology and substance use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23461817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9294370") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9413795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9413795") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9413795+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A population-based, unselected sample of 1412 Caucasian twin pairs aged 8-16 years was ascertained through Virginia schools.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001248> "A population-based, cohort-sequential longitudinal study of European-ancestry twin pairs born in 1974-1983, ascertained at ages 8 to 16 through the state and participating private schools of Virginia, United States, who with their parents were assessed by psychiatric interviews and questionnaires in four waves about 18 months apart and again in their mid-20s, to study genetic and environmental influences on the development of child and adolescent psychopathology and substance use.")

