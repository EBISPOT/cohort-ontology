# Individual: <http://www.ebi.ac.uk/coho/COHO_0002029> (<http://www.ebi.ac.uk/coho/COHO_0002029>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20860503") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25930191") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8503671/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20860503") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4260321") Annotation(rdfs:comment "MAGICS Germany 630 630 (67) — 572 572 (50) —") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002029> "An observational study of children with physician-diagnosed asthma recruited from secondary and tertiary care centres in Germany and Austria for the genetics of childhood asthma, whose cases have been compared in genome-wide association studies with controls from the German arm of the International Study of Asthma and Allergies in Childhood Phase II, and whose participants were re-examined as adolescents and young adults in a follow-up stage, followMAGICS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20860503") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25930191") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8503671/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20860503") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4260321") Annotation(rdfs:comment "The rs3771166 SNP was imputed in the MRC Asthma and United Kingdom Control panel (MRCA-UKC) and in the Multicenter Asthma Genetics in Childhood Study (MAGICS) panel.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002029> "An observational study of children with physician-diagnosed asthma recruited from secondary and tertiary care centres in Germany and Austria for the genetics of childhood asthma, whose cases have been compared in genome-wide association studies with controls from the German arm of the International Study of Asthma and Allergies in Childhood Phase II, and whose participants were re-examined as adolescents and young adults in a follow-up stage, followMAGICS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20860503") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25930191") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8503671/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25930191") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595482/") Annotation(rdfs:comment "The combined use of both study cohorts (Multicentre Asthma Genetics in Childhood and International Study of Asthma and Allergies in Childhood Phase II) and previous allergy testing has been described earlier.26-28") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002029> "An observational study of children with physician-diagnosed asthma recruited from secondary and tertiary care centres in Germany and Austria for the genetics of childhood asthma, whose cases have been compared in genome-wide association studies with controls from the German arm of the International Study of Asthma and Allergies in Childhood Phase II, and whose participants were re-examined as adolescents and young adults in a follow-up stage, followMAGICS.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20860503") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25930191") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8503671/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8503671/") Annotation(rdfs:comment "The followMAGICS study is the follow-up study of the observational Multicenter Asthma Genetics in Childhood Study (MAGICS), which includes physician-diagnosed asthmatic children and young adults (age: 7–25 years)15 recruited from secondary and tertiary centers in Germany and Austria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002029> "An observational study of children with physician-diagnosed asthma recruited from secondary and tertiary care centres in Germany and Austria for the genetics of childhood asthma, whose cases have been compared in genome-wide association studies with controls from the German arm of the International Study of Asthma and Allergies in Childhood Phase II, and whose participants were re-examined as adolescents and young adults in a follow-up stage, followMAGICS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002031> (<http://www.ebi.ac.uk/coho/COHO_0002031>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(rdfs:comment "MALOVA, DenmarkIncident cases (35–79 years) diagnosed 1994–1999 from municipalities of Copenhagen and Frederiksberg and surrounding counties.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002031> "A Danish population-based case-control study of the Danish Cancer Society, in which women aged 35 to 79 diagnosed in 1994 to 1999 with ovarian cancer or a borderline ovarian tumour in the municipalities of Copenhagen and Frederiksberg and the surrounding counties, and controls drawn at random from the female population of the same area through the Central Population Register, gave questionnaire data, blood and tumour tissue, to identify risk factors and prognostic factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(rdfs:comment "Random sample of general female population (35–79 years) in study area, selected using computerised Central Population Register, matched to cases for age and geographical region") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002031> "A Danish population-based case-control study of the Danish Cancer Society, in which women aged 35 to 79 diagnosed in 1994 to 1999 with ovarian cancer or a borderline ovarian tumour in the municipalities of Copenhagen and Frederiksberg and the surrounding counties, and controls drawn at random from the female population of the same area through the Central Population Register, gave questionnaire data, blood and tumour tissue, to identify risk factors and prognostic factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(rdfs:comment "Briefly, preoperative blood samples and tumor tissue samples were obtained from the majority of the 681 OC patients and from the 235 women with borderline ovarian tumor were included in the MALOVA study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002031> "A Danish population-based case-control study of the Danish Cancer Society, in which women aged 35 to 79 diagnosed in 1994 to 1999 with ovarian cancer or a borderline ovarian tumour in the municipalities of Copenhagen and Frederiksberg and the surrounding counties, and controls drawn at random from the female population of the same area through the Central Population Register, gave questionnaire data, blood and tumour tissue, to identify risk factors and prognostic factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(rdfs:comment "The MALOVA study (\"MALignant OVArian cancer study\") is a multidisciplinary Danish study covering epidemiology, lifestyle factors, biochemistry and molecular biology with the purpose of identifying risk factors and prognostic factors for OC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002031> "A Danish population-based case-control study of the Danish Cancer Society, in which women aged 35 to 79 diagnosed in 1994 to 1999 with ovarian cancer or a borderline ovarian tumour in the municipalities of Copenhagen and Frederiksberg and the surrounding counties, and controls drawn at random from the female population of the same area through the Central Population Register, gave questionnaire data, blood and tumour tissue, to identify risk factors and prognostic factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(rdfs:comment "Epidemiological data were collected using structured questionnaires that included socio-demographic and health-related information, menstrual, reproductive, and gynecological histories.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002031> "A Danish population-based case-control study of the Danish Cancer Society, in which women aged 35 to 79 diagnosed in 1994 to 1999 with ovarian cancer or a borderline ovarian tumour in the municipalities of Copenhagen and Frederiksberg and the surrounding counties, and controls drawn at random from the female population of the same area through the Central Population Register, gave questionnaire data, blood and tumour tissue, to identify risk factors and prognostic factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361465/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2645422/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108970/fullTextXML") Annotation(rdfs:comment "MALOVA Ovarian Cancer Case-Control Study, Danish Cancer Society, Denmark (MAL);") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002031> "A Danish population-based case-control study of the Danish Cancer Society, in which women aged 35 to 79 diagnosed in 1994 to 1999 with ovarian cancer or a borderline ovarian tumour in the municipalities of Copenhagen and Frederiksberg and the surrounding counties, and controls drawn at random from the female population of the same area through the Central Population Register, gave questionnaire data, blood and tumour tissue, to identify risk factors and prognostic factors for ovarian cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002033> (<http://www.ebi.ac.uk/coho/COHO_0002033>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20637138") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20637138") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20637138+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Non-demented community-dwelling individuals (N = 1037) aged 70-90 were recruited from two areas of Sydney, following a random approach to 8914 individuals on the electoral roll.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002033> "A longitudinal cohort of non-demented, community-dwelling people aged 70 to 90, recruited by random approach from the electoral roll in two areas of Sydney, Australia, and begun in 2005 to examine the clinical characteristics and prevalence of mild cognitive impairment and related syndromes and the rate of change in cognitive function over time, with annual telephone reviews and periodic detailed neuropsychiatric and medical assessments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20637138") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20637138") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20637138+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Sydney Memory and Ageing Study (Sydney MAS) was initiated in 2005 to examine the clinical characteristics and prevalence of mild cognitive impairment (MCI) and related syndromes, and to determine the rate of change in cognitive function over time.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002033> "A longitudinal cohort of non-demented, community-dwelling people aged 70 to 90, recruited by random approach from the electoral roll in two areas of Sydney, Australia, and begun in 2005 to examine the clinical characteristics and prevalence of mild cognitive impairment and related syndromes and the rate of change in cognitive function over time, with annual telephone reviews and periodic detailed neuropsychiatric and medical assessments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20637138") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20637138") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20637138+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The cohort is to be followed up with brief telephone reviews annually, and detailed assessments biannually.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002033> "A longitudinal cohort of non-demented, community-dwelling people aged 70 to 90, recruited by random approach from the electoral roll in two areas of Sydney, Australia, and begun in 2005 to examine the clinical characteristics and prevalence of mild cognitive impairment and related syndromes and the rate of change in cognitive function over time, with annual telephone reviews and periodic detailed neuropsychiatric and medical assessments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20637138") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21491632") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21491632+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants received a comprehensive neuropsychological test battery measuring four cognitive domains.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002033> "A longitudinal cohort of non-demented, community-dwelling people aged 70 to 90, recruited by random approach from the electoral roll in two areas of Sydney, Australia, and begun in 2005 to examine the clinical characteristics and prevalence of mild cognitive impairment and related syndromes and the rate of change in cognitive function over time, with annual telephone reviews and periodic detailed neuropsychiatric and medical assessments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002034> (<http://www.ebi.ac.uk/coho/COHO_0002034>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12537875") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23218199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31608855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31608855") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cambridge.org/core/journals/twin-research-and-human-genetics/article/midatlantic-twin-registry-of-virginia-commonwealth-university/D6A17F0CECC43803BF9437EDDC2061EB") Annotation(rdfs:comment "In addition, the MATR houses the MATR Repository, with over 1700 DNA samples primarily from whole blood available for researchers interested in DNA genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002034> "A population-based registry of twins and their families, primarily born or living in Virginia, North Carolina and South Carolina and ascertained mainly from birth records (and formerly school records), formed in 1997 by merging the Virginia Twin Registry (established around 1975) with the North Carolina Twin Registry, with South Carolina added in 1998; based at Virginia Commonwealth University, it recruits its twins into research studies, collects data and DNA, and keeps a DNA repository.")
