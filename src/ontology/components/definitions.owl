AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "GALA II and SAGE are two clinic-based case-control studies focused on untangling the genetic and environmental basis of childhood-onset asthma disease in minority ethnic groups of the United States of America [22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000794> "A clinic-based case–control study of childhood-onset asthma in African American children and youth recruited in the San Francisco Bay Area, United States, run by the University of California, San Francisco, to untangle the genetic and environmental basis of asthma in minority populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "Inclusion criteria were self-identification as Latino or African American for GALA II or SAGE, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000794> "A clinic-based case–control study of childhood-onset asthma in African American children and youth recruited in the San Francisco Bay Area, United States, run by the University of California, San Francisco, to untangle the genetic and environmental basis of asthma in minority populations.")
