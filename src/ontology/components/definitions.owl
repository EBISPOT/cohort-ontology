# Individual: <http://www.ebi.ac.uk/coho/COHO_0002425> (<http://www.ebi.ac.uk/coho/COHO_0002425>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22105620") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25648963") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(rdfs:comment "A total of 1,561 healthy, young Swiss university students or age-matched employees/trainees (658 from the University of Zürich and 903 from the University of Basel) were recruited for a genetic study of memory performance.(71) All were between 18 and 45 years of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002425> "A genetic study of memory performance in healthy young Swiss adults aged 18 to 45 years, university students or age-matched employees and trainees recruited at the University of Zürich and the University of Basel, whose verbal episodic memory is measured by an unexpected delayed free recall of visually presented words and who are genotyped at the Biozentrum of the University of Basel.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22105620") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25648963") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(rdfs:comment "After 5 min, subjects undergo an unexpected delayed free-recall test of the learned words.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002425> "A genetic study of memory performance in healthy young Swiss adults aged 18 to 45 years, university students or age-matched employees and trainees recruited at the University of Zürich and the University of Basel, whose verbal episodic memory is measured by an unexpected delayed free recall of visually presented words and who are genotyped at the Biozentrum of the University of Basel.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22105620") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25648963") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(rdfs:comment "In this test, subjects view six series of five semantically unrelated nouns presented at a rate of one word per second with the instruction to learn the words for immediate free recall after each series.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002425> "A genetic study of memory performance in healthy young Swiss adults aged 18 to 45 years, university students or age-matched employees and trainees recruited at the University of Zürich and the University of Basel, whose verbal episodic memory is measured by an unexpected delayed free recall of visually presented words and who are genotyped at the Biozentrum of the University of Basel.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22105620") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25648963") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0006322314008920-mmc1.pdf") Annotation(rdfs:comment "Participants were genotyped at the Biozentrum, University of Basel, Switzerland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002425> "A genetic study of memory performance in healthy young Swiss adults aged 18 to 45 years, university students or age-matched employees and trainees recruited at the University of Zürich and the University of Basel, whose verbal episodic memory is measured by an unexpected delayed free recall of visually presented words and who are genotyped at the Biozentrum of the University of Basel.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002427> (<http://www.ebi.ac.uk/coho/COHO_0002427>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16195252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35689423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16195252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4579566") Annotation(rdfs:comment "Between 1998 and 2002 all general practitioners in Southampton were asked to help us recruit their female patients aged 20-34 years to the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002427> "A prospective mother-offspring cohort of non-pregnant women aged 20 to 34 years from the general population of Southampton, UK, recruited through their general practitioners between 1998 and 2002 and characterised before pregnancy; the women who later became pregnant were followed through pregnancy, and their children through infancy and childhood, to study how maternal characteristics and the children's prenatal and postnatal growth affect their development and their risk factors for chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16195252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35689423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16195252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4579566") Annotation(rdfs:comment "Southampton is in the more affluent southern part of England") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002427> "A prospective mother-offspring cohort of non-pregnant women aged 20 to 34 years from the general population of Southampton, UK, recruited through their general practitioners between 1998 and 2002 and characterised before pregnancy; the women who later became pregnant were followed through pregnancy, and their children through infancy and childhood, to study how maternal characteristics and the children's prenatal and postnatal growth affect their development and their risk factors for chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16195252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35689423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16195252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4579566") Annotation(rdfs:comment "The Southampton Women’s Survey (SWS) was thus established to measure the pre-pregnant characteristics of women aged 20-34 years living in the city, and then follow-up those women who subsequently become pregnant.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002427> "A prospective mother-offspring cohort of non-pregnant women aged 20 to 34 years from the general population of Southampton, UK, recruited through their general practitioners between 1998 and 2002 and characterised before pregnancy; the women who later became pregnant were followed through pregnancy, and their children through infancy and childhood, to study how maternal characteristics and the children's prenatal and postnatal growth affect their development and their risk factors for chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16195252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35689423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16195252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4579566") Annotation(rdfs:comment "To date, follow up of the children of these pregnancies has been 95%, 93%, 86% and 81% at 6 months, 1 year, 2 years and 3 years of age respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002427> "A prospective mother-offspring cohort of non-pregnant women aged 20 to 34 years from the general population of Southampton, UK, recruited through their general practitioners between 1998 and 2002 and characterised before pregnancy; the women who later became pregnant were followed through pregnancy, and their children through infancy and childhood, to study how maternal characteristics and the children's prenatal and postnatal growth affect their development and their risk factors for chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16195252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35689423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16195252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4579566") Annotation(rdfs:comment "Women were recruited from the general population whether or not they were planning a pregnancy, making the study unique in the Western world.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002427> "A prospective mother-offspring cohort of non-pregnant women aged 20 to 34 years from the general population of Southampton, UK, recruited through their general practitioners between 1998 and 2002 and characterised before pregnancy; the women who later became pregnant were followed through pregnancy, and their children through infancy and childhood, to study how maternal characteristics and the children's prenatal and postnatal growth affect their development and their risk factors for chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16195252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35689423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16195252") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4579566") Annotation(rdfs:comment "to examine how maternal and intrauterine factors interact with the offspring’s genes and postnatal environment to influence: i) weight gain, head growth and linear growth in infancy; ii) the pathways of growth and development during childhood that lead to poor adult health;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002427> "A prospective mother-offspring cohort of non-pregnant women aged 20 to 34 years from the general population of Southampton, UK, recruited through their general practitioners between 1998 and 2002 and characterised before pregnancy; the women who later became pregnant were followed through pregnancy, and their children through infancy and childhood, to study how maternal characteristics and the children's prenatal and postnatal growth affect their development and their risk factors for chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002428> (<http://www.ebi.ac.uk/coho/COHO_0002428>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2563/MediaObjects/41588_2013_BFng2563_MOESM7_ESM.pdf") Annotation(rdfs:comment "Prospectively ascertained cases of invasive breast cancer patients diagnosed at the Regional Oncology Hospital (2002-2003 and 2006-2007) or the University Hospital (2002-2007), both in Szczecin, West Pomerania, Poland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002428> "A breast cancer case-control study in Szczecin, West Pomerania, Poland, run from the International Hereditary Cancer Center of the Pomeranian Medical University and a member study of the Breast Cancer Association Consortium, whose cases are prospectively ascertained patients with invasive breast cancer diagnosed at the Regional Oncology Hospital or the University Hospital in Szczecin in 2002–2007, and whose controls were drawn from a population-based study of the inhabitants of West Pomerania in 2003–2004, matched to cases for year of birth, sex and region.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2563/MediaObjects/41588_2013_BFng2563_MOESM7_ESM.pdf") Annotation(rdfs:comment "SZBCS IHCC-Szczecin Breast Cancer Study 39 Poland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002428> "A breast cancer case-control study in Szczecin, West Pomerania, Poland, run from the International Hereditary Cancer Center of the Pomeranian Medical University and a member study of the Breast Cancer Association Consortium, whose cases are prospectively ascertained patients with invasive breast cancer diagnosed at the Regional Oncology Hospital or the University Hospital in Szczecin in 2002–2007, and whose controls were drawn from a population-based study of the inhabitants of West Pomerania in 2003–2004, matched to cases for year of birth, sex and region.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2563/MediaObjects/41588_2013_BFng2563_MOESM7_ESM.pdf") Annotation(rdfs:comment "Selected from a population-based study of the 1.3 million inhabitants of West Pomerania (2003-2004); matched to cases for year of birth, sex and region.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002428> "A breast cancer case-control study in Szczecin, West Pomerania, Poland, run from the International Hereditary Cancer Center of the Pomeranian Medical University and a member study of the Breast Cancer Association Consortium, whose cases are prospectively ascertained patients with invasive breast cancer diagnosed at the Regional Oncology Hospital or the University Hospital in Szczecin in 2002–2007, and whose controls were drawn from a population-based study of the inhabitants of West Pomerania in 2003–2004, matched to cases for year of birth, sex and region.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002429> (<http://www.ebi.ac.uk/coho/COHO_0002429>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29371263") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29371263") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML") Annotation(rdfs:comment "Recruitment into the T-1000 study at the Laureate Institute for Brain Research will be ongoing for 4 years from January 2015 through December 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002429> "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29371263") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29371263") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML") Annotation(rdfs:comment "The T-1000 is a naturalistic study that will recruit, assess and longitudinally follow 1000 participants, including healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002429> "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29371263") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29371263") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML") Annotation(rdfs:comment "The overall aim of the Tulsa 1000 (T-1000) study is to use the NIMH Research Domain Criteria framework in order to establish a robust and reliable dimensional set of variables that quantifies the positive and negative valence, cognition and arousal domains, including interoception, to generate clinically useful treatment predictions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002429> "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29371263") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29371263") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML") Annotation(rdfs:comment "This is a multilevel, longitudinal observational study of healthy controls (HC) and treatment-seeking individuals with mental health problems in Tulsa and the surrounding regions of Oklahoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002429> "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29371263") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29371263") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML") Annotation(rdfs:comment "Using self-report, behaviour, physiology, neural circuit, cell, molecule and gene unit of analysis measures, we will apply these constructs to a clinical population of individuals with dysregulation of affect, SU and eating behaviour recruited from treatment providers across different sites in the community.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002429> "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29371263") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37178517") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37178517+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We employed the Tulsa-1000 study, a large database of deeply phenotyped individuals recruited between 2015 and 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002429> "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002430> (<http://www.ebi.ac.uk/coho/COHO_0002430>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38374256") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38374256") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937372/fullTextXML") Annotation(rdfs:comment "The first three axes of genetic variation (PC1, PC2 and PC3) from multi-dimensional scaling of the Euclidean distance matrix between populations are sufficient to separate GWASs from six ancestry groups: African American (AFA), East Asian (EAS), European (EUR), Hispanic (HIS), South African (SAF), and South Asian (SAS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002430> "An international initiative that assembled genome-wide association studies of type 2 diabetes from studies in six ancestry groups (African American, East Asian, European, Hispanic, South African and South Asian), among them the DIAMANTE Consortium and the Million Veteran Program, and meta-analysed them to characterise the genetic contribution to type 2 diabetes and its aetiological heterogeneity across populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38374256") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38374256") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937372/fullTextXML") Annotation(rdfs:comment "Through the newly established Type 2 Diabetes Global Genomics Initiative, we present findings from a very large meta-analysis of T2D GWAS data, comprising more than 2.5 million individuals of diverse ancestry—an increase of nearly threefold in the effective sample size compared with previous efforts8,9.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002430> "An international initiative that assembled genome-wide association studies of type 2 diabetes from studies in six ancestry groups (African American, East Asian, European, Hispanic, South African and South Asian), among them the DIAMANTE Consortium and the Million Veteran Program, and meta-analysed them to characterise the genetic contribution to type 2 diabetes and its aetiological heterogeneity across populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38374256") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38374256") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937372/fullTextXML") Annotation(rdfs:comment "To better understand the aetiological heterogeneity of T2D across diverse populations, we assembled a large collection of T2D GWASs for six ancestry groups through the Type 2 Diabetes Global Genomics Initiative.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002430> "An international initiative that assembled genome-wide association studies of type 2 diabetes from studies in six ancestry groups (African American, East Asian, European, Hispanic, South African and South Asian), among them the DIAMANTE Consortium and the Million Veteran Program, and meta-analysed them to characterise the genetic contribution to type 2 diabetes and its aetiological heterogeneity across populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38374256") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38374256") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937372/fullTextXML") Annotation(rdfs:comment "To gain insight into true positive signals meeting conventional genome-wide significance (P < 5 × 10−8) that would be overlooked at this more stringent threshold, we considered loci reported by the DIAMANTE Consortium, which contributed 39.5% of the effective sample size of the current study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002430> "An international initiative that assembled genome-wide association studies of type 2 diabetes from studies in six ancestry groups (African American, East Asian, European, Hispanic, South African and South Asian), among them the DIAMANTE Consortium and the Million Veteran Program, and meta-analysed them to characterise the genetic contribution to type 2 diabetes and its aetiological heterogeneity across populations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38374256") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38374256") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937372/supplementaryFiles") Annotation(rdfs:comment "This research is based on data from the MVP, Office of Research and Development, Veterans Health Administration and was supported by award MVP000.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002430> "An international initiative that assembled genome-wide association studies of type 2 diabetes from studies in six ancestry groups (African American, East Asian, European, Hispanic, South African and South Asian), among them the DIAMANTE Consortium and the Million Veteran Program, and meta-analysed them to characterise the genetic contribution to type 2 diabetes and its aetiological heterogeneity across populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002431> (<http://www.ebi.ac.uk/coho/COHO_0002431>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27322543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27322543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "All of the individual GWA studies have been published previously for migraine or other population-based phenotypes, except for the Danish Headache Center (1,771 new cases) and the Tromsø Study (660 new cases) datasets, which represent new data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002431> "A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium's genome-wide meta-analysis of migraine.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27322543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27322543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "In the 6th wave of the study, which was used in the current study, 19,762 residents were invited and 12,984 (65.7%) participated (53% women, age range 30–87 years). 660 migraine cases and 2,407 controls were genotyped and in included in this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002431> "A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium's genome-wide meta-analysis of migraine.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27322543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27322543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "Migraine cases were defined as those who 1) reported suffering from headache during the last year, and satisfied ICHD criteria1 for migraine") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002431> "A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium's genome-wide meta-analysis of migraine.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27322543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27322543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "Subjects who were not classified as migraine sufferers from these criteria were included as controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002431> "A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium's genome-wide meta-analysis of migraine.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27322543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27322543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "The Tromsø Study is a population based health study of the Tromsø municipality of Northern Norway.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002431> "A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium's genome-wide meta-analysis of migraine.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27322543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27322543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "This resulted in a slightly conservative definition of migraine for this group; or 2) self- reported previous or current migraine headache.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002431> "A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium's genome-wide meta-analysis of migraine.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002433> (<http://www.ebi.ac.uk/coho/COHO_0002433>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(rdfs:comment "Clinically relevant information is also available through a comprehensive electronic medical records database that includes information on drug use and surgical interventions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002433> "A hospital-based cohort of patients with angina pectoris and objective documentation of myocardial ischaemia who underwent diagnostic coronary angiography or revascularisation at National Taiwan University Hospital at any time after October 2000, with questionnaire data including cardiovascular medication, electronic medical records and fasting blood samples taken before cardiac catheterisation. Collected independently of the similar TCAGEN study at the same hospital, it is one of the seven Taiwan-based cohorts of the TAICHI consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(rdfs:comment "Fasting blood samples were collected before cardiac catheterization.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002433> "A hospital-based cohort of patients with angina pectoris and objective documentation of myocardial ischaemia who underwent diagnostic coronary angiography or revascularisation at National Taiwan University Hospital at any time after October 2000, with questionnaire data including cardiovascular medication, electronic medical records and fasting blood samples taken before cardiac catheterisation. Collected independently of the similar TCAGEN study at the same hospital, it is one of the seven Taiwan-based cohorts of the TAICHI consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(rdfs:comment "Participants provided clinically relevant information including use of cardiovascular related medication through a standardized questionnaire.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002433> "A hospital-based cohort of patients with angina pectoris and objective documentation of myocardial ischaemia who underwent diagnostic coronary angiography or revascularisation at National Taiwan University Hospital at any time after October 2000, with questionnaire data including cardiovascular medication, electronic medical records and fasting blood samples taken before cardiac catheterisation. Collected independently of the similar TCAGEN study at the same hospital, it is one of the seven Taiwan-based cohorts of the TAICHI consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(rdfs:comment "TACT (TAiwan Coronary and Transcatheter intervention) cohort study enrolled patients with angina pectoris and objective documentation of myocardial ischemia who underwent diagnostic coronary angiography and/or revascularization any time after October 2000 at the National Taiwan University Hospital (NTUH).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002433> "A hospital-based cohort of patients with angina pectoris and objective documentation of myocardial ischaemia who underwent diagnostic coronary angiography or revascularisation at National Taiwan University Hospital at any time after October 2000, with questionnaire data including cardiovascular medication, electronic medical records and fasting blood samples taken before cardiac catheterisation. Collected independently of the similar TCAGEN study at the same hospital, it is one of the seven Taiwan-based cohorts of the TAICHI consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(rdfs:comment "This cohort is very similar to TCAGEN but was collected independently.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002433> "A hospital-based cohort of patients with angina pectoris and objective documentation of myocardial ischaemia who underwent diagnostic coronary angiography or revascularisation at National Taiwan University Hospital at any time after October 2000, with questionnaire data including cardiovascular medication, electronic medical records and fasting blood samples taken before cardiac catheterisation. Collected independently of the similar TCAGEN study at the same hospital, it is one of the seven Taiwan-based cohorts of the TAICHI consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(rdfs:comment "The TaiChi consortium consists of 7 studies that collaborated initially in a large scale metabochip study, and became an ongoing consortium for studies of cardiometabolic disease in the Chinese population in Taiwan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002433> "A hospital-based cohort of patients with angina pectoris and objective documentation of myocardial ischaemia who underwent diagnostic coronary angiography or revascularisation at National Taiwan University Hospital at any time after October 2000, with questionnaire data including cardiovascular medication, electronic medical records and fasting blood samples taken before cardiac catheterisation. Collected independently of the similar TCAGEN study at the same hospital, it is one of the seven Taiwan-based cohorts of the TAICHI consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002434> (<http://www.ebi.ac.uk/coho/COHO_0002434>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28604730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32393777") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15901990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3715303/") Annotation(rdfs:comment "All control subjects were recruited after an initial verbal screening to determine that they had no previous diagnosis of cancer, and none of the controls recruited into this study were diagnosed with any form of cancer or premalignancy after screening.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002434> "A hospital-based case-control study of lung cancer run from Washington State University at the H. Lee Moffitt Cancer Center in Tampa, Florida, United States, whose cases were patients with histologically confirmed primary lung cancer identified at the centre in 1999–2002 and recruited within a year of diagnosis, and whose cancer-free controls, matched to cases on age, race and sex, were recruited at the centre's affiliated Lifetime Cancer Screening Center.")
