AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32649918") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7429152/supplementaryFiles") Annotation(rdfs:comment "The Normative Aging Study (NAS) is a longitudinal study of health and aging6,7") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002112> "A longitudinal study of health and aging, established by the Veterans Administration in 1963, of healthy men aged 21 to 80 from the greater Boston area, United States, who were free of known chronic medical conditions at enrolment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5010417/fullTextXML") Annotation(rdfs:comment "Briefly, the VA Normative Aging Study is a closed cohort of 2,280 male volunteers from the greater Boston area (Massachusetts), 21–80 years of age at study entry, who enrolled after an initial health screening determined that they were free of known chronic medical conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002112> "A longitudinal study of health and aging, established by the Veterans Administration in 1963, of healthy men aged 21 to 80 from the greater Boston area, United States, who were free of known chronic medical conditions at enrolment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5010417/fullTextXML") Annotation(rdfs:comment "an ongoing longitudinal study of aging established by the VA in 1963, details of which have been published previously") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002112> "A longitudinal study of health and aging, established by the Veterans Administration in 1963, of healthy men aged 21 to 80 from the greater Boston area, United States, who were free of known chronic medical conditions at enrolment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002115> (<http://www.ebi.ac.uk/coho/COHO_0002115>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1480765") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29496148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8360654") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:1480765") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1480765+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This has become possible by a close collaboration of numerous nursing homes in Amsterdam and its vicinity and with the neuropathologists of the Free University in Amsterdam.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002115> "A brain bank established at the end of 1985 at the Netherlands Institute for Brain Research, in collaboration with nursing homes in and around Amsterdam, the Netherlands, which performs rapid autopsies of donors who gave informed consent during life for the research use of their brain tissue and medical files, originally to supply post-mortem brain tissue from Alzheimer's disease patients and controls.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1480765") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29496148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8360654") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29496148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29496148+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Netherlands Brain Bank (NBB) performs rapid autopsies of donors who gave written informed consent during life for the use of their brain tissue and medical files for research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002115> "A brain bank established at the end of 1985 at the Netherlands Institute for Brain Research, in collaboration with nursing homes in and around Amsterdam, the Netherlands, which performs rapid autopsies of donors who gave informed consent during life for the research use of their brain tissue and medical files, originally to supply post-mortem brain tissue from Alzheimer's disease patients and controls.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1480765") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29496148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8360654") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8360654") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8360654+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In order to provide research groups with post-mortem brain tissue from Alzheimer's disease (AD) patients and controls, a brain bank was established by the end of 1985 in The Netherlands Institute for Brain Research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002115> "A brain bank established at the end of 1985 at the Netherlands Institute for Brain Research, in collaboration with nursing homes in and around Amsterdam, the Netherlands, which performs rapid autopsies of donors who gave informed consent during life for the research use of their brain tissue and medical files, originally to supply post-mortem brain tissue from Alzheimer's disease patients and controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002116> (<http://www.ebi.ac.uk/coho/COHO_0002116>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(rdfs:comment "Buccal cell samples were collected via two methods: Oragene saliva collection kits (DNA GenoteK, Ottawa, Canada) and mouthwash samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002116> "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(rdfs:comment "Controls were identified via random digit dialing (RDD) of households in the same geographic area as cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002116> "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(rdfs:comment "Eligible cases were women diagnosed between April 1, 2001 and March 31, 2008 with invasive breast cancer or ductal carcinoma in situ, who were between the ages of 25 and 75") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002116> "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(rdfs:comment "Information on demographic factors, as well as known and suspected risk factors for breast cancer, was ascertained through a structured questionnaire administered via telephone interview, and through a self-administered food frequency questionnaire.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002116> "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(rdfs:comment "The Nashville Breast Health Study (NBHS) is a population-based case-control study of breast cancer conducted in the eight-county Nashville metropolitan area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002116> "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf") Annotation(rdfs:comment "Through a rapid case- ascertainment system, we identified newly-diagnosed breast cancer cases through the Tennessee State Cancer Registry and five major hospitals in the city that provide medical care for breast cancer patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002116> "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002117> (<http://www.ebi.ac.uk/coho/COHO_0002117>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23341777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23469231") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23341777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3547794/fullTextXML") Annotation(rdfs:comment "As a result, 833 SqCC cases and 3,094 controls were included in the GWAS scan stage, including 428 cases and 1977 controls from Nanjing and Shanghai (Nanjing Study), and 405 cases and 1,117 controls from Beijing (Beijing Study).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002117> "A two-centre case-control genome-wide association study of lung cancer in Han Chinese in China, made up of the Nanjing Study (with participants from Nanjing and Shanghai) and the Beijing Study, whose cases had histopathologically or cytologically confirmed lung cancer and whose controls, frequency-matched to the cases for age, sex and region, were people receiving routine physical examinations in local hospitals or taking part in community screening for noncommunicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23341777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23469231") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23469231") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3585721/fullTextXML") Annotation(rdfs:comment "All controls were selected from those receiving routine physical examinations in local hospitals or those participating in the community screening of noncommunicable diseases and frequency-matched for age, gender and geographic regions to each set of the lung cancer cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002117> "A two-centre case-control genome-wide association study of lung cancer in Han Chinese in China, made up of the Nanjing Study (with participants from Nanjing and Shanghai) and the Beijing Study, whose cases had histopathologically or cytologically confirmed lung cancer and whose controls, frequency-matched to the cases for age, sex and region, were people receiving routine physical examinations in local hospitals or taking part in community screening for noncommunicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23341777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23469231") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23469231") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3585721/fullTextXML") Annotation(rdfs:comment "All lung cancer cases were histopathologically or cytologically confirmed by at least two local pathologists.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002117> "A two-centre case-control genome-wide association study of lung cancer in Han Chinese in China, made up of the Nanjing Study (with participants from Nanjing and Shanghai) and the Beijing Study, whose cases had histopathologically or cytologically confirmed lung cancer and whose controls, frequency-matched to the cases for age, sex and region, were people receiving routine physical examinations in local hospitals or taking part in community screening for noncommunicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23341777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23469231") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23469231") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3585721/fullTextXML") Annotation(rdfs:comment "The study subjects were from an ongoing two-center GWAS of lung cancer in China, including Nanjing study and Beijing study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002117> "A two-centre case-control genome-wide association study of lung cancer in Han Chinese in China, made up of the Nanjing Study (with participants from Nanjing and Shanghai) and the Beijing Study, whose cases had histopathologically or cytologically confirmed lung cancer and whose controls, frequency-matched to the cases for age, sex and region, were people receiving routine physical examinations in local hospitals or taking part in community screening for noncommunicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23341777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23469231") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23469231") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23469231+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In this study, in order to identify important pathways involving the lung carcinogenesis, we performed a two-stage pathway analysis in GWAS of lung cancer in Han Chinese using gene set enrichment analysis (GSEA) method.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002117> "A two-centre case-control genome-wide association study of lung cancer in Han Chinese in China, made up of the Nanjing Study (with participants from Nanjing and Shanghai) and the Beijing Study, whose cases had histopathologically or cytologically confirmed lung cancer and whose controls, frequency-matched to the cases for age, sex and region, were people receiving routine physical examinations in local hospitals or taking part in community screening for noncommunicable diseases.")

