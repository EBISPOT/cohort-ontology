AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29546429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29546429") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6124629/fullTextXML") Annotation(rdfs:comment "Between 1999 and 2001, 550 of the SMS1932 were recruited to Wave 1 of the LBC1921 study, at a mean age of 79 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000700> "A cohort of 550 people born in 1921 who took an intelligence test at age 11 in the Scottish Mental Survey of 1932, recruited in 1999–2001 at a mean age of 79, mostly living in Edinburgh and the Lothians, and followed up five times to age 92 to study non-pathological cognitive ageing from childhood to older age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29546429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29546429") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6124629/fullTextXML") Annotation(rdfs:comment "Participants of LBC1921 were originally tested on the Moray House Test No.12 intelligence test as part of the Scottish Mental Survey 1932 (N = 87 498) at a mean age of 10.9 years (SD = 0.3).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000700> "A cohort of 550 people born in 1921 who took an intelligence test at age 11 in the Scottish Mental Survey of 1932, recruited in 1999–2001 at a mean age of 79, mostly living in Edinburgh and the Lothians, and followed up five times to age 92 to study non-pathological cognitive ageing from childhood to older age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29546429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29546429") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6124629/fullTextXML") Annotation(rdfs:comment "The LBC studies set out principally to examine the nature and determinants of non-pathological cognitive ageing from childhood to older age, and within in older age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000700> "A cohort of 550 people born in 1921 who took an intelligence test at age 11 in the Scottish Mental Survey of 1932, recruited in 1999–2001 at a mean age of 79, mostly living in Edinburgh and the Lothians, and followed up five times to age 92 to study non-pathological cognitive ageing from childhood to older age.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29546429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29546429") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6124629/fullTextXML") Annotation(rdfs:comment "Waves of testing have been conducted at roughly 3-yearly intervals since inception: the LBC1921 have been followed up five times, from age 79 to age 92 years;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000700> "A cohort of 550 people born in 1921 who took an intelligence test at age 11 in the Scottish Mental Survey of 1932, recruited in 1999–2001 at a mean age of 79, mostly living in Edinburgh and the Lothians, and followed up five times to age 92 to study non-pathological cognitive ageing from childhood to older age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000701> (<http://www.ebi.ac.uk/coho/COHO_0000701>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42084756") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13522009/fullTextXML") Annotation(rdfs:comment "Briefly, we included social, behavioural, genetic, and contextual data collected at Wave 1 (W1; aged 12–21; N = 20,745), and depression symptom information at Wave 2 (W2; aged 13–22; N = 14,738), and Wave 4 (W4; aged 24–34; N = 15,701) to reflect early adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42084756") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13522009/fullTextXML") Annotation(rdfs:comment "Given the complexity and scope of the life experiences, characteristics, and surroundings associated with depression, we identified hundreds of risk and protective factors relevant to depression that were measured in Add Health at Wave 1, collected across multiple data sources (self-report, parent-report, and geocoded data).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42084756") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13522009/fullTextXML") Annotation(rdfs:comment "We used data from Add Health: a U.S. nationally representative cohort of people born between 1976 and 1982.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6857761/") Annotation(rdfs:comment "Add Health is a nationally representative cohort study of more than 20 000 adolescents in grades 7–12 (aged 12–19) in the USA in 1994–95, who have been followed through adolescence and into adulthood with five in-home interviews in 1995 (Wave I), 1996 (Wave II), 2001–02 (Wave III), 2008–09 (Wave IV) and 2016–18 (Wave V).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6857761/") Annotation(rdfs:comment "The original purpose of Add Health was to understand the causes of adolescent health and health behaviour, with special emphasis on the multiple contexts of adolescent life.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6857761/") Annotation(rdfs:comment "The original study design included important features for understanding biological processes in health and developmental trajectories across the life course") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001367.v3.p1") Annotation(rdfs:comment "Add Health was designed to understand how social environments and behaviors in adolescence are linked to health and achievement outcomes in young adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000702> (<http://www.ebi.ac.uk/coho/COHO_0000702>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30379906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(rdfs:comment "A saliva sample was collected from each participant with Oragene saliva kits (OG-500, DNA Genotek Inc., Canada) and corresponding DNA was extracted following manufacturer’s instructions") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30379906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(rdfs:comment "A total of 4678 saliva samples were collected from children at schools all over Spain.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30379906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(rdfs:comment "Children with IQ lower than 80 were excluded from the analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30379906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(rdfs:comment "Related to reading and attention, the variables examined were word reading (high and low frequency words), pseudoword reading, PA, RAN, syllable discrimination, Verbal-Stroop, Numerical-Stroop, and ANT (S1 File).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30379906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(rdfs:comment "We examined 4 SNPs located on genes previously associated to dyslexia (KIAA0319, DCDC2, DYX1C1 and FOXP2) and 3 SNPs within genes related to ADHD (COMT, MAOA and DBH) in a cohort of Spanish children (N = 2078) that met the criteria of having one, both or none of these disorders (dyslexia and ADHD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35998220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436320/supplementaryFiles") Annotation(rdfs:comment "BCBL | Population-based | Spain | European | [5] | 10 | 6-16 | other | 1196 | 585 | 610 | other | 1194 | 587 | 611 | - | - | - | 373 | Phoneme deletion | 1120 | 546 | 574 | NWR | 1179 | 566 | 612 | Kaufman Brief intelligence test | 1236 | 601 | 635") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000703> (<http://www.ebi.ac.uk/coho/COHO_0000703>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19017778") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2628694/fullTextXML") Annotation(rdfs:comment "The participants in this study were subjects who participated in the Botnia Study (17), were free of diabetes at baseline, had their plasma glucose and insulin concentrations measured during an OGTT, and had a repeat OGTT after 7–8 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19017778") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2628694/fullTextXML") Annotation(rdfs:comment "The purpose of this study was to assess the efficacy of the postload plasma glucose concentration in predicting future risk of type 2 diabetes, compared with prediction models based on measurement of the fasting plasma glucose (FPG) concentration.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8866565") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8866565+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A subset of the subjects underwent a euglycemic insulin clamp combined with indirect calorimetry to measure insulin sensitivity and energy expenditure.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8866565") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8866565+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To address this question, we studied 2,152 first-degree relatives of patients with NIDDM (FH+) and 528 age- and weight-matched spouses without a family history of NIDDM (FH-) in Western Finland (the Botnia study).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3636608/") Annotation(rdfs:comment "The Botnia study is a family-based, observational familial study started in 1990 on the West coast of Finland aiming at identifying diabetes susceptibility genes (11).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3636608/") Annotation(rdfs:comment "The prospective part included 2,770 nondiabetic family members and/or their spouses (1,263 men and 1,507 women; mean age, 45 years), 151 of whom developed T2D during a median 9.5-year follow-up period (7).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")

