AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32381493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7469973/fullTextXML") Annotation(rdfs:comment "Participants were enroled in the Agricultural Lung Health Study (ALHS), a case-control study of adult current asthma nested within the Agricultural Health Study (AHS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32381493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7469973/fullTextXML") Annotation(rdfs:comment "The AHS is a cohort of farmers and their spouses from Iowa and North Carolina.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32381493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7469973/fullTextXML") Annotation(rdfs:comment "The ALHS enroled 3301 participants in the period 2009–2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36914875") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf") Annotation(rdfs:comment "Genotyping based on the UK Biobank Axiom Array (Axiom_UKB_WCSG) by Affymetrix Axiom Genotyping Services (Affymetrix, Inc., Santa Clara, CA) was completed using DNA extracted from blood (96%) or saliva (4%) collected from ALHS participants during the home visit.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36914875") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf") Annotation(rdfs:comment "Pulmonary function was measured by trained staff during in-home visits with an EasyOne® Spirometer (NDD Medical Technologies, Chelmsford, MA) based on American Thoracic Society guidelines.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36914875") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf") Annotation(rdfs:comment "The Agricultural Lung Health Study (ALHS) is a case-control study of current asthma among farmers and their spouses nested within the prospective Agricultural Health Study (AHS data releases P3REL201209.00, PIREL201209.00 and AHSREL201304.00)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")

