AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005979") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38878324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11233924/fullTextXML") Annotation(rdfs:comment "The lungNENomics series is a multicentre, international, retrospective cohort of 259 patients diagnosed with an LNET, whose clinical data are summarised in Table 1.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000292> "A cohort of patients with lung neuroendocrine neoplasms, including typical and atypical carcinoids, assembled by the IARC-led lungNENomics project for whole-genome, transcriptome and methylation profiling to characterise these tumours molecularly.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005979") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005979") Annotation(rdfs:comment "The study includes whole-genome sequencing (WGS), RNA sequencing (RNA-seq), and Infinium MethylationEPIC array data from samples in the lungNENomics cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000292> "A cohort of patients with lung neuroendocrine neoplasms, including typical and atypical carcinoids, assembled by the IARC-led lungNENomics project for whole-genome, transcriptome and methylation profiling to characterise these tumours molecularly.")
