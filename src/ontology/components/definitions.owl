AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28416190") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29988820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28416190") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5496669/fullTextXML") Annotation(rdfs:comment "We investigated the role of FMD as a potential biomarker of AAA by assessments of FMD during the natural history in individuals with AAAs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002223> "A single-centre prospective cohort of patients with abdominal aortic aneurysm managed on the routine NHS pathway at the Oxford University Hospitals NHS Trust in England, followed with repeated measurements of aneurysm diameter to study the pathogenesis and growth of aneurysms and biomarkers of their progression such as flow-mediated dilatation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28416190") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29988820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29988820") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6033055/fullTextXML") Annotation(rdfs:comment "AAA size was measured by the anteroposterior diameter (APD) (outer to outer) on ultrasound.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002223> "A single-centre prospective cohort of patients with abdominal aortic aneurysm managed on the routine NHS pathway at the Oxford University Hospitals NHS Trust in England, followed with repeated measurements of aneurysm diameter to study the pathogenesis and growth of aneurysms and biomarkers of their progression such as flow-mediated dilatation.")
