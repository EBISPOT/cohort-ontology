AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40930089") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC12539258") Annotation(rdfs:comment "The IMMUcan project has received funding from the Innovative Medicines Initiative 2 Joint Undertaking under grant agreement no. 821558.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000278> "An Innovative Medicines Initiative consortium that builds prospective cohorts of cancer patients, including head and neck, lung and breast cancer cohorts, with integrated tumour immune profiling and longitudinal clinical data to understand how the immune system interacts with tumours and therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40930089") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12539258/fullTextXML") Annotation(rdfs:comment "The broad profiling team of the IMMUcan project collects and analyzes imaging data from five cancer types: breast cancer (BC), renal cell carcinoma (RCC), squamous cell carcinoma of head and neck (SCCHN), colorectal carcinoma (CRC), and non-small cell lung cancer (NSCLC) (Figure 1A; STAR Methods).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000278> "An Innovative Medicines Initiative consortium that builds prospective cohorts of cancer patients, including head and neck, lung and breast cancer cohorts, with integrated tumour immune profiling and longitudinal clinical data to understand how the immune system interacts with tumours and therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40930089") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40930089+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The integrated immunoprofiling of large adaptive cancer patient cohorts (IMMUcan) consortium collects multi-modal imaging data from thousands of patients with cancer to perform broad molecular and cellular spatial profiling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000278> "An Innovative Medicines Initiative consortium that builds prospective cohorts of cancer patients, including head and neck, lung and breast cancer cohorts, with integrated tumour immune profiling and longitudinal clinical data to understand how the immune system interacts with tumours and therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001533") Annotation(rdfs:comment "The goal of IMMUcan is to understand how the immune system interacts with tumors and how therapeutic interventions influence this interaction.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000278> "An Innovative Medicines Initiative consortium that builds prospective cohorts of cancer patients, including head and neck, lung and breast cancer cohorts, with integrated tumour immune profiling and longitudinal clinical data to understand how the immune system interacts with tumours and therapy.")

