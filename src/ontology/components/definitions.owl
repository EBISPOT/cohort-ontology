AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17982455") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19898481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852893") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19898481") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.479/MediaObjects/41588_2009_BFng479_MOESM310_ESM.pdf") Annotation(rdfs:comment "Cases and controls were recruited from Manchester, Aberdeen, Leeds, Sheffield, London, and Oxford.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002513> "A collection of adult patients with rheumatoid arthritis fulfilling the 1987 American College of Rheumatology criteria, and of healthy controls, assembled for genetic studies by the UK Rheumatoid Arthritis Genetics consortium, a collaboration of six UK rheumatology research groups. Cases were recruited in Manchester, Aberdeen, Leeds, Sheffield, London and Oxford, mostly from NHS rheumatology clinics but also from the Arthritis Research Campaign National Repository of Family Material and the Norfolk Arthritis Register, and controls in five of these centres; its samples were used to replicate and extend rheumatoid arthritis susceptibility loci from genome-wide association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17982455") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19898481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852893") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20852893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2978888/fullTextXML") Annotation(rdfs:comment "DNA samples for 3,838 RA cases and 2,719 healthy unrelated controls were made available from the UK Rheumatoid Arthritis Genetics (UKRAG) consortium, a collaboration of six UK rheumatology research groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002513> "A collection of adult patients with rheumatoid arthritis fulfilling the 1987 American College of Rheumatology criteria, and of healthy controls, assembled for genetic studies by the UK Rheumatoid Arthritis Genetics consortium, a collaboration of six UK rheumatology research groups. Cases were recruited in Manchester, Aberdeen, Leeds, Sheffield, London and Oxford, mostly from NHS rheumatology clinics but also from the Arthritis Research Campaign National Repository of Family Material and the Norfolk Arthritis Register, and controls in five of these centres; its samples were used to replicate and extend rheumatoid arthritis susceptibility loci from genome-wide association studies.")

