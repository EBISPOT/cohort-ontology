AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://lsmu.lt/en/about-lsmu/structure/medical-academy/faculty-of-medicine/departments/department-of-endocrinology/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://lsmu.lt/en/research-and-innovations/research-institutes/institute-of-endocrinology/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.endocrine-abstracts.org/ea/0081/ea0081ep1182") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.endocrine-abstracts.org/ea/0081/ea0081ep1182") Annotation(rdfs:comment "18-67-year-old 100 patients with type 1 diabetes were enrolled in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002005> "A study of people with type 1 diabetes at the Lithuanian University of Health Sciences in Kaunas, Lithuania, run with the Finnish Diabetic Nephropathy Study group as the Lithuanian part of the InterDiane project, to identify clinical, genetic and environmental risk factors for the late complications of type 1 diabetes, in particular genes related to diabetic nephropathy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002006> (<http://www.ebi.ac.uk/coho/COHO_0002006>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23650146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26916295") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26916295") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4769380/") Annotation(rdfs:comment "The LITE study is a prospective study of VTE occurrence in 2 pooled, multi-center, longitudinal population-based cohort studies: the ARIC Study [17] and the Cardiovascular Health Study (CHS) [18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002006> "A prospective study of venous thromboembolism occurrence in the United States that pools two multi-center, longitudinal, population-based cohort studies of white and African American men and women, the Atherosclerosis Risk in Communities (ARIC) Study and the Cardiovascular Health Study (CHS).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23650146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26916295") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26916295") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4769380/") Annotation(rdfs:comment "The cohorts comprised white and African American men and women, aged 50 years and older at study onset in the early 1990s.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002006> "A prospective study of venous thromboembolism occurrence in the United States that pools two multi-center, longitudinal, population-based cohort studies of white and African American men and women, the Atherosclerosis Risk in Communities (ARIC) Study and the Cardiovascular Health Study (CHS).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23650146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26916295") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26916295") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4769380/") Annotation(rdfs:comment "We used the Longitudinal Investigation of Thromboembolism Etiology (LITE), involving two pooled population-based cohorts in the United States including 16,234 participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002006> "A prospective study of venous thromboembolism occurrence in the United States that pools two multi-center, longitudinal, population-based cohort studies of white and African American men and women, the Atherosclerosis Risk in Communities (ARIC) Study and the Cardiovascular Health Study (CHS).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002007> (<http://www.ebi.ac.uk/coho/COHO_0002007>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29881818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35102341") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29280273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/fullTextXML") Annotation(rdfs:comment "Individuals with increased alcohol intake (men, >30 g day−1; women, >20 g day−1), use of steatogenic medications or other liver diseases were excluded.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002007> "A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca' Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29881818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35102341") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29280273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/fullTextXML") Annotation(rdfs:comment "To test the causal role of hepatic fat, we selected genetic variants with validated effects on hepatic fat accumulation and/or NAFLD severity (in LBC, DHS and previous GWAS 12, 13, 14, 16, 28) and with experimental data supporting the causality of the association, as instruments.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002007> "A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca' Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29881818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35102341") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29280273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/supplementaryFiles") Annotation(rdfs:comment "Briefly, a total of 1515 adult individuals of European descent were consecutively enrolled from the Metabolic Liver Diseases outpatient service and bariatric surgery center, Fondazione IRCCS Ca’ Granda Ospedale Policlinico Milano, Milan, Italy") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002007> "A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca' Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29881818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35102341") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29280273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/supplementaryFiles") Annotation(rdfs:comment "and from the Northern Savo Hospital District, Kuopio, Finland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002007> "A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca' Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29881818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35102341") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29280273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/supplementaryFiles") Annotation(rdfs:comment "the Gastrointestinal & Liver Unit of the Palermo University Hospital, Palermo, Italy") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002007> "A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca' Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29280273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29881818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35102341") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35102341") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8803605/fullTextXML") Annotation(rdfs:comment "The LBC is a cross-sectional study of individuals of European descent who underwent liver biopsy for suspected NASH or severe obesity, consecutively enrolled in three European centres13,24.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002007> "A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca' Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002008> (<http://www.ebi.ac.uk/coho/COHO_0002008>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24691493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24691493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3972120/fullTextXML") Annotation(rdfs:comment "Asthma (n = 683) was defined as having a respiratory physician-diagnosis of asthma based upon clinical history, spirometry, salbutamol reversibility and/or positive methacholine challenge tests.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002008> "A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24691493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24691493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3972120/fullTextXML") Annotation(rdfs:comment "Mild, moderate and severe asthmatic cohorts were similarly recruited but enriched by recruiting from specialty asthma clinics and hospital databases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002008> "A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24691493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24691493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3972120/fullTextXML") Annotation(rdfs:comment "Non-asthmatic controls (n = 200) were recruited through contacting individuals randomly selected from the metropolitan telephone directory.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002008> "A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24691493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24691493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3972120/fullTextXML") Annotation(rdfs:comment "Statistical analyses were performed to determine the relationship between ADRβ2 gene and asthma severity and presence of atopy by looking at the frequency of various genotypes, haplotypes as well as haplotype pairs in the relevant patients groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002008> "A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24691493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24691493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3972120/fullTextXML") Annotation(rdfs:comment "The LIWA cohort included a total of 883 unrelated Caucasians (125 severe, 172 moderate, 386 mild and 200 non-asthmatics) aged between 18 and 85.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002008> "A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002009> (<http://www.ebi.ac.uk/coho/COHO_0002009>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12212983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16273220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16273220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16273220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Cohort study subjects will be followed up over a 10-year period.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002009> "A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12212983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16273220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16273220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16273220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Secondly, a prospective cohort study will recruit 7,500 individuals to identify markers of pre-clinical carcinogenesis in a high-risk population and validate and strengthen the molecular genetic and epidemiological risk assessment model.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002009> "A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12212983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16273220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16273220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16273220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The LLP has two components: Firstly, a case-control study of 800 newly diagnosed cases of lung cancer matched 2:1 for age (+/-2 years) and gender will facilitate the development of the molecular genetic and epidemiological model to assess an individual's risk of developing lung cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002009> "A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12212983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16273220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16273220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16273220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Liverpool Lung Project (LLP) is being conducted within a defined geographic area of Merseyside, based on contiguous districts with a high incidence of lung cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002009> "A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12212983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16273220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16273220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16273220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "the LLP aims to develop a model which predicts lung cancer risk from an extensive record of epidemiological risk factors, molecular/genetic risk factors and from changes in molecular biomarkers, which maybe used in early detection programmes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002009> "A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002011> (<http://www.ebi.ac.uk/coho/COHO_0002011>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17507702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00156819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17507702") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Treatment was administered for 16 weeks in a double-blind manner.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002011> "A randomised, double-blind trial of the American Lung Association Asthma Clinical Research Centers, run at centres in the United States from 2003 to 2006, in which people whose asthma was well controlled on twice-daily low-dose inhaled fluticasone were assigned to continue it or to switch to once-daily montelukast or once-daily fluticasone plus salmeterol for 16 weeks, to test whether treatment could be stepped down without loss of asthma control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17507702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00156819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17507702") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We randomly assigned 500 patients with asthma that was well controlled by inhaled fluticasone (100 microg twice daily) to receive continued fluticasone (100 microg twice daily) (169 patients), montelukast (5 or 10 mg each night) (166 patients), or fluticasone (100 microg) plus salmeterol (50 microg) each night (165 patients).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002011> "A randomised, double-blind trial of the American Lung Association Asthma Clinical Research Centers, run at centres in the United States from 2003 to 2006, in which people whose asthma was well controlled on twice-daily low-dose inhaled fluticasone were assigned to continue it or to switch to once-daily montelukast or once-daily fluticasone plus salmeterol for 16 weeks, to test whether treatment could be stepped down without loss of asthma control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17507702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00156819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17507702") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Whether patients with asthma that is well controlled with the use of inhaled corticosteroids twice daily can receive a step-down treatment with once-daily montelukast (our primary hypothesis) or once-daily fluticasone propionate plus salmeterol (our secondary hypothesis) has not yet been determined.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002011> "A randomised, double-blind trial of the American Lung Association Asthma Clinical Research Centers, run at centres in the United States from 2003 to 2006, in which people whose asthma was well controlled on twice-daily low-dose inhaled fluticasone were assigned to continue it or to switch to once-daily montelukast or once-daily fluticasone plus salmeterol for 16 weeks, to test whether treatment could be stepped down without loss of asthma control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17507702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00156819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26083242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4470685/fullTextXML") Annotation(rdfs:comment "the American Lung Association Asthma Clinical Research Center (ALA-ACRC)-supported trials, the Leukotriene Modifier Or Corticosteroid or Corticosteroid-Salmeterol Trial (LOCCS)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002011> "A randomised, double-blind trial of the American Lung Association Asthma Clinical Research Centers, run at centres in the United States from 2003 to 2006, in which people whose asthma was well controlled on twice-daily low-dose inhaled fluticasone were assigned to continue it or to switch to once-daily montelukast or once-daily fluticasone plus salmeterol for 16 weeks, to test whether treatment could be stepped down without loss of asthma control.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002012> (<http://www.ebi.ac.uk/coho/COHO_0002012>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16998094") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00046644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16998094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16998094+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants were monitored for 24 wk to measure the rate of episodes of poor asthma control (EPACs) defined by decreased peak flow, increased beta-agonist use, increased oral corticosteroid use, or unscheduled health care visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002012> "A randomised, double-masked, placebo-controlled trial of the American Lung Association Asthma Clinical Research Centers in which people with poorly controlled asthma were assigned to add once-daily low-dose theophylline, montelukast or placebo to their existing medication and were followed for 24 weeks, to compare the rate of episodes of poor asthma control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16998094") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00046644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16998094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16998094+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We compared the effectiveness of once-daily oral controller therapy with either an antileukotriene receptor antagonist (montelukast) or low-dose theophylline added to existing medications in patients with poorly controlled asthma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002012> "A randomised, double-masked, placebo-controlled trial of the American Lung Association Asthma Clinical Research Centers in which people with poorly controlled asthma were assigned to add once-daily low-dose theophylline, montelukast or placebo to their existing medication and were followed for 24 weeks, to compare the rate of episodes of poor asthma control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16998094") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00046644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16998094") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16998094+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We conducted a randomized, double-masked, placebo-controlled trial in 489 participants with poorly controlled asthma randomly assigned to placebo, theophylline (300 mg/d), or montelukast (10 mg/d).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002012> "A randomised, double-masked, placebo-controlled trial of the American Lung Association Asthma Clinical Research Centers in which people with poorly controlled asthma were assigned to add once-daily low-dose theophylline, montelukast or placebo to their existing medication and were followed for 24 weeks, to compare the rate of episodes of poor asthma control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16998094") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26083242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00046644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26083242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4470685/fullTextXML") Annotation(rdfs:comment "The discovery cohort included two asthmatic clinical trials with treatment arms evaluating montelukast response, the American Lung Association Asthma Clinical Research Center (ALA-ACRC)-supported trials") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002012> "A randomised, double-masked, placebo-controlled trial of the American Lung Association Asthma Clinical Research Centers in which people with poorly controlled asthma were assigned to add once-daily low-dose theophylline, montelukast or placebo to their existing medication and were followed for 24 weeks, to compare the rate of episodes of poor asthma control.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002013> (<http://www.ebi.ac.uk/coho/COHO_0002013>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21471957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27336024") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29036523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21471957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3138651/") Annotation(rdfs:comment "All subjects were thoroughly screened for past or current physical and mental health status by the army medical authorities, the study nurse and a trained research psychologist.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002013> "A Greek study of healthy young male army conscripts, randomly selected and recruited from June 2008 in waves at the Greek Army Training Camp in Heraklion, Crete, within their first two months of service and screened to exclude mental and physical illness, who were assessed on schizophrenia-related intermediate phenotypes (prepulse inhibition of the startle reflex, cognition, personality and schizotypal traits) and gave DNA, to study the genetics of the schizophrenia spectrum.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21471957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27336024") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29036523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21471957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3138651/") Annotation(rdfs:comment "Briefly here, following presentation of the study and written informed consent, 703 randomly selected young male conscripts were recruited between June 2008 and July 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002013> "A Greek study of healthy young male army conscripts, randomly selected and recruited from June 2008 in waves at the Greek Army Training Camp in Heraklion, Crete, within their first two months of service and screened to exclude mental and physical illness, who were assessed on schizophrenia-related intermediate phenotypes (prepulse inhibition of the startle reflex, cognition, personality and schizotypal traits) and gave DNA, to study the genetics of the schizophrenia spectrum.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21471957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27336024") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29036523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21471957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3138651/") Annotation(rdfs:comment "Inclusion criteria were recent (last 2 months) conscript status in the camp and written informed consent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002013> "A Greek study of healthy young male army conscripts, randomly selected and recruited from June 2008 in waves at the Greek Army Training Camp in Heraklion, Crete, within their first two months of service and screened to exclude mental and physical illness, who were assessed on schizophrenia-related intermediate phenotypes (prepulse inhibition of the startle reflex, cognition, personality and schizotypal traits) and gave DNA, to study the genetics of the schizophrenia spectrum.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21471957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27336024") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29036523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21471957") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3138651/") Annotation(rdfs:comment "healthy, young male army conscripts (n=703) originating from the Greek LOGOS project (Learning On Genetics Of Schizophrenia Spectrum) underwent PPI of the acoustic startle reflex, working memory, and personality assessment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002013> "A Greek study of healthy young male army conscripts, randomly selected and recruited from June 2008 in waves at the Greek Army Training Camp in Heraklion, Crete, within their first two months of service and screened to exclude mental and physical illness, who were assessed on schizophrenia-related intermediate phenotypes (prepulse inhibition of the startle reflex, cognition, personality and schizotypal traits) and gave DNA, to study the genetics of the schizophrenia spectrum.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21471957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27336024") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29036523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27336024") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4849437/fullTextXML") Annotation(rdfs:comment "A total of N=1,493 healthy males (age mean±s.d.: 22.05±3.45, range: 18–30 years), who were recruited for the LOGOS (Learning on Genetics of Schizophrenia) study, underwent cognitive assessment and consented to providing DNA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002013> "A Greek study of healthy young male army conscripts, randomly selected and recruited from June 2008 in waves at the Greek Army Training Camp in Heraklion, Crete, within their first two months of service and screened to exclude mental and physical illness, who were assessed on schizophrenia-related intermediate phenotypes (prepulse inhibition of the startle reflex, cognition, personality and schizotypal traits) and gave DNA, to study the genetics of the schizophrenia spectrum.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21471957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27336024") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29036523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29036523") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5814832/") Annotation(rdfs:comment "The LOGOS acquired the same recruitment procedures as the ASPIS, assessing Caucasian healthy male conscripts (N = 690; mean age: 22.3 ± 3.7) on multiple cognitive and psychometric phenotypes, at the Greek Army Training Camp in Heraklion, Crete, Greece.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002013> "A Greek study of healthy young male army conscripts, randomly selected and recruited from June 2008 in waves at the Greek Army Training Camp in Heraklion, Crete, within their first two months of service and screened to exclude mental and physical illness, who were assessed on schizophrenia-related intermediate phenotypes (prepulse inhibition of the startle reflex, cognition, personality and schizotypal traits) and gave DNA, to study the genetics of the schizophrenia spectrum.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002014> (<http://www.ebi.ac.uk/coho/COHO_0002014>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24997018") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41529745") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42646838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41529745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13173443/fullTextXML") Annotation(rdfs:comment "After their enrollment, LonGenity participants are followed longitudinally until death and have been extensively characterized with serum biomarkers, genotyping, proteomics, cognitive function assessments, frailty measures, and adjudication of adverse outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002014> "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24997018") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41529745") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42646838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41529745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13173443/fullTextXML") Annotation(rdfs:comment "LonGenity is a longitudinal cohort study of individuals of Ashkenazi Jewish ancestry aged ≥ 65 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002014> "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24997018") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41529745") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42646838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41529745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13173443/fullTextXML") Annotation(rdfs:comment "Participants were prospectively enrolled in a CT substudy from the parent LonGenity study at the Albert Einstein College of Medicine Institute for Aging Research (Bronx, NY) between January 2018 and October 2021.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002014> "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24997018") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41529745") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42646838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41529745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13173443/fullTextXML") Annotation(rdfs:comment "We measured EAT, IAT, and IGFBP-1 from n = 102 participants from the LonGenity parent study at the Albert Einstein Institute of Aging, Bronx NY, who were enrolled to investigate healthy aging in Ashkenazi Jewish offspring of parents with exceptional longevity (OPEL) vs usual survival (OPUS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002014> "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24997018") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41529745") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42646838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42646838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13519853/fullTextXML") Annotation(rdfs:comment "From 2008 through 2024, the study enrolled Ashkenazi Jewish individuals from the New York City area, aged 65 years or older, and free of significant cognitive, visual, or hearing impairments.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002014> "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24997018") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41529745") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42646838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42646838") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13519853/fullTextXML") Annotation(rdfs:comment "Participants in study groups either had at least 1 parent who survived to 95 years of age or older or both parents who died before 95 years of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002014> "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002015> (<http://www.ebi.ac.uk/coho/COHO_0002015>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14500058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23796131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41575388") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23796131") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3791615/") Annotation(rdfs:comment "The primary outcome was the first post-randomization occurrence of a composite cardiovascular outcome (cardiovascular death, non-fatal myocardial infarction, non-fatal stroke, or hospitalized angina) over a planned maximum follow-up of 13.5 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002015> "A randomised clinical trial at 16 centres in the United States that assigned overweight or obese people aged 45 to 76 with type 2 diabetes to an intensive lifestyle intervention for weight loss, through reduced caloric intake and increased physical activity, or to diabetes support and education, with major cardiovascular events as the primary outcome; after the intervention ended, follow-up of the cohort continued as a study of ageing-related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14500058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23796131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41575388") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23796131") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3791615/") Annotation(rdfs:comment "To be eligible for participation in the trial, volunteers were required to be 45 to 76 years of age") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002015> "A randomised clinical trial at 16 centres in the United States that assigned overweight or obese people aged 45 to 76 with type 2 diabetes to an intensive lifestyle intervention for weight loss, through reduced caloric intake and increased physical activity, or to diabetes support and education, with major cardiovascular events as the primary outcome; after the intervention ended, follow-up of the cohort continued as a study of ageing-related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14500058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23796131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41575388") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23796131") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3791615/") Annotation(rdfs:comment "We randomly assigned 5,145 overweight or obese individuals with type 2 diabetes recruited at 16 US centers to intensive lifestyle intervention (the intervention group), which promoted weight loss through decreased calorie intake and increased physical activity, or diabetes support and education (the control group).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002015> "A randomised clinical trial at 16 centres in the United States that assigned overweight or obese people aged 45 to 76 with type 2 diabetes to an intensive lifestyle intervention for weight loss, through reduced caloric intake and increased physical activity, or to diabetes support and education, with major cardiovascular events as the primary outcome; after the intervention ended, follow-up of the cohort continued as a study of ageing-related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14500058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23796131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41575388") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41575388") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC13294790/") Annotation(rdfs:comment "Follow-up of the cohort continues to add other aging-related outcomes and conditions to identify the long-term consequences of factors related to lifestyle and medical care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002015> "A randomised clinical trial at 16 centres in the United States that assigned overweight or obese people aged 45 to 76 with type 2 diabetes to an intensive lifestyle intervention for weight loss, through reduced caloric intake and increased physical activity, or to diabetes support and education, with major cardiovascular events as the primary outcome; after the intervention ended, follow-up of the cohort continued as a study of ageing-related outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14500058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23796131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41575388") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41575388") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC13294790/") Annotation(rdfs:comment "It is striking that this benefit has largely been sustained not only throughout the 10-year intervention but also through the 8 years following its cessation despite potential influences of mortality, loss to follow-up, and the many life events and changes participants experienced over time.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002015> "A randomised clinical trial at 16 centres in the United States that assigned overweight or obese people aged 45 to 76 with type 2 diabetes to an intensive lifestyle intervention for weight loss, through reduced caloric intake and increased physical activity, or to diabetes support and education, with major cardiovascular events as the primary outcome; after the intervention ended, follow-up of the cohort continued as a study of ageing-related outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002016> (<http://www.ebi.ac.uk/coho/COHO_0002016>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42086565") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42086565") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13350093/fullTextXML") Annotation(rdfs:comment "LOOP was a randomized clinical trial, including 6004 participants at risk of AF but without diagnosed AF, with 1:3 randomization to screening with an implantable loop recorder (ILR) and anticoagulation upon detection of AF or usual care (Supplementary Note 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002016> "A Danish randomised clinical trial, Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals, which randomised 6,004 individuals aged 70 years or older without atrial fibrillation but with risk factors for atrial fibrillation and stroke to screening with an implantable loop recorder, with anticoagulation upon detection of atrial fibrillation, or usual care; its participants’ genetic data are used to evaluate polygenic scores for atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42086565") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42086565") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13350093/fullTextXML") Annotation(rdfs:comment "We also assessed the Mult-t-EUR score in the LOOP study, a Danish clinical trial assessing implantable loop recorder (ILR) screening in older participants without AF but at elevated cardiovascular risk28.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002016> "A Danish randomised clinical trial, Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals, which randomised 6,004 individuals aged 70 years or older without atrial fibrillation but with risk factors for atrial fibrillation and stroke to screening with an implantable loop recorder, with anticoagulation upon detection of atrial fibrillation, or usual care; its participants’ genetic data are used to evaluate polygenic scores for atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42086565") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(rdfs:comment "The LOOP study (Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals) randomised 6,004 individuals aged 70 years or older without AF but with risk factors for AF and stroke to either screening with ILR or usual care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002016> "A Danish randomised clinical trial, Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals, which randomised 6,004 individuals aged 70 years or older without atrial fibrillation but with risk factors for atrial fibrillation and stroke to screening with an implantable loop recorder, with anticoagulation upon detection of atrial fibrillation, or usual care; its participants’ genetic data are used to evaluate polygenic scores for atrial fibrillation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42086565") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(rdfs:comment "This study aimed to investigate the association between a PRS for AF and AF burden and the occurrence of long-lasting AF episodes using continuous monitoring data from individuals with implantable loop recorders (ILR).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002016> "A Danish randomised clinical trial, Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals, which randomised 6,004 individuals aged 70 years or older without atrial fibrillation but with risk factors for atrial fibrillation and stroke to screening with an implantable loop recorder, with anticoagulation upon detection of atrial fibrillation, or usual care; its participants’ genetic data are used to evaluate polygenic scores for atrial fibrillation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002017> (<http://www.ebi.ac.uk/coho/COHO_0002017>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17658394") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20511662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26457986") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26964624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28112199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20511662") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2948096/") Annotation(rdfs:comment "A broad panel of clinical and laboratory markers, measured at randomization in patients entering the LRF CLL4 trial, was assessed with respect to treatment response, progression-free and overall survival, at a median follow-up of 68 months.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002017> "The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17658394") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20511662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26457986") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26964624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28112199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20511662") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2948096/") Annotation(rdfs:comment "The LRF CLL4 trial randomized 777 previously untreated patients with Binet stage progressive A, B or C disease between January 1999 and October 2004 to receive either chlorambucil, fludarabine or fludarabine and cyclophosphamide.10") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002017> "The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17658394") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20511662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26457986") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26964624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28112199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28112199") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253627/fullTextXML") Annotation(rdfs:comment "The CLL-UK1 GWAS comprised 517 cases: (i) 155 cases (95 male; mean age at diagnosis: 59 years) from ICLLLC; and (ii) 362 cases (269 male; mean age at diagnosis: 63 years) from the Leukaemia Research CLL-4 trial.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002017> "The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17658394") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20511662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26457986") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26964624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28112199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4795533/") Annotation(rdfs:comment "Briefly, CLL4 was a randomized phase III trial established to compare the efficacy of fludarabine, chlorambucil, and the combination of fludarabine plus cyclophosphamide as a first-line treatment for Binet stages B, C and A-progressive CLL.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002017> "The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17658394") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20511662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26457986") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26964624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28112199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4795533/") Annotation(rdfs:comment "Of the 777 patients entered into the trial the current analysis is based on a random subset of 356 patients of White Caucasian ethnicity who had blood samples taken for clinical diagnostic purposes and cell marker studies at participating centres.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002017> "The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17658394") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20511662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26457986") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26964624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28112199") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4795533/") Annotation(rdfs:comment "To determine whether rs45446698 was associated with outcome for other site-specific cancers we genotyped the GELCAPS lung cancer cases (11) (Table 2) and the CLL4 trial series (12) (Table 3).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002017> "The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002019> (<http://www.ebi.ac.uk/coho/COHO_0002019>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29133979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36076291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37678951") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36076291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC9454202/") Annotation(rdfs:comment "First, the LSC is a community-based volunteer cohort enrolling moderate and heavy smokers who have concerns about their health due to past and/or ongoing smoking history.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002019> "A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29133979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36076291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37678951") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36076291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9454202/fullTextXML") Annotation(rdfs:comment "Cohort members returned every 18 months to update smoking status, general health status and respiratory symptoms, undergo spirometry, and provide biological samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002019> "A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29133979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36076291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37678951") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36076291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9454202/fullTextXML") Annotation(rdfs:comment "In brief, subjects were included in the study if they were 40–75 years of age, former or current smokers with at least 10 pack-years of smoking history, free of prior LC history, and able to understand English.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002019> "A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29133979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36076291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37678951") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36076291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9454202/fullTextXML") Annotation(rdfs:comment "Incident lung cancer (n = 72) was identified through NDI searches, obituary data, or by self-report from study subjects or their next of kin.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002019> "A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29133979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36076291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37678951") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36076291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9454202/fullTextXML") Annotation(rdfs:comment "The LSC was established in 2001 to study sputum and blood biomarkers for LC risk assessment and COPD development in current and former smokers enrolled from the greater Albuquerque area of New Mexico.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002019> "A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29133979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36076291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37678951") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36076291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9454202/fullTextXML") Annotation(rdfs:comment "Two National Death Index (NDI) searches were completed in 2014 and mid 2020 and in total identified 380 deaths out of the 2372 subjects (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002019> "A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.")

