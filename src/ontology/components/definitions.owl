AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "150 families were recruited in Tomsk Region Children Hospital and Tomsk Region Hospital (Tomsk, Russia), and 46 families were recruited in the city of Irkutsk hospitals") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002465> "A family study of asthma conducted from 1998 onwards by the Research Institute of Medical Genetics and Siberian State Medical University in Tomsk, Russia, which recruited nuclear families and extended pedigrees of Russian or mixed East Slavonic origin through probands with atopic bronchial asthma at hospitals in Tomsk and Irkutsk, with probands and relatives clinically examined for asthma and atopy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "All participants were Russians or of a mixed ethnic origin due to marriages between Russians and major East Slavonic populations (Ukrainians, Byelorussians).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002465> "A family study of asthma conducted from 1998 onwards by the Research Institute of Medical Genetics and Siberian State Medical University in Tomsk, Russia, which recruited nuclear families and extended pedigrees of Russian or mixed East Slavonic origin through probands with atopic bronchial asthma at hospitals in Tomsk and Irkutsk, with probands and relatives clinically examined for asthma and atopy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "Both nuclear families and extended pedigrees were recruited through atopic bronchial asthmatic probands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002465> "A family study of asthma conducted from 1998 onwards by the Research Institute of Medical Genetics and Siberian State Medical University in Tomsk, Russia, which recruited nuclear families and extended pedigrees of Russian or mixed East Slavonic origin through probands with atopic bronchial asthma at hospitals in Tomsk and Irkutsk, with probands and relatives clinically examined for asthma and atopy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "Bothprobandsandtheirrelativeswereclinicallyexaminedtoestablish diagnosis of asthma and atopy by the GINA criteria") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002465> "A family study of asthma conducted from 1998 onwards by the Research Institute of Medical Genetics and Siberian State Medical University in Tomsk, Russia, which recruited nuclear families and extended pedigrees of Russian or mixed East Slavonic origin through probands with atopic bronchial asthma at hospitals in Tomsk and Irkutsk, with probands and relatives clinically examined for asthma and atopy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "Is a population‐based family study conducted by the Research Institute of Medical Genetics and Siberian State Medical University (Tomsk, Russia) from 1998 onwards.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002465> "A family study of asthma conducted from 1998 onwards by the Research Institute of Medical Genetics and Siberian State Medical University in Tomsk, Russia, which recruited nuclear families and extended pedigrees of Russian or mixed East Slavonic origin through probands with atopic bronchial asthma at hospitals in Tomsk and Irkutsk, with probands and relatives clinically examined for asthma and atopy.")

