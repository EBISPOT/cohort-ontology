AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24861484") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42225636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00836524") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24861484") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24861484+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "All women had ultrasound and blood sample collection at the nuchal translucency scan, a 20-week malformation scan and 25-week and 32-week fetal growth examinations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001228> "A prospective cohort of unselected pregnant women enrolled from 2009 at the nuchal translucency scan in the obstetrics and gynaecology department of Roskilde Hospital, Region Zealand, Denmark, with ultrasound, uterine artery Doppler and blood samples at about 12, 20, 25 and 32 weeks of gestation and outcomes taken from medical records, set up to study whether serum YKL-40 predicts preeclampsia and fetal growth restriction, and later used in genetic studies of gestational diabetes and glucose levels in pregnancy.")
