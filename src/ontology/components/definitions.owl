AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17052657") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17052657+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We did genome-wide, single-nucleotide-polymorphism (SNP) genotyping of publicly available samples from a cohort of Parkinson's disease patients (n=267) and neurologically normal controls (n=270).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17052657") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17052657+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We generated publicly available genotype data for Parkinson's disease patients and controls so that these data can be mined and augmented by other researchers to identify common genetic variability that results in minor and moderate risk for disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33583074") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8601399/") Annotation(rdfs:comment "PD data also included the NINDS Parkinson’s Disease dataset provided through dbGaP accession phs001172.v1.p2.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001172.v1.p2") Annotation(rdfs:comment "Substudies phs000089.v4.p2 : NINDS- Genome-Wide Genotyping in Parkinson's Disease") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001172.v1.p2") Annotation(rdfs:comment "This study utilized the well characterized collection of North American Caucasians with Parkinson's disease, and neurologically normal controls from the sample population which are banked in the National Institute of Neurological Disorders and Stroke (NINDS Repository) collection.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17052657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001172.v1.p2") Annotation(rdfs:comment "genome wide exome DNA sequencing was done in 618 Parkinson's disease samples deposited in Coriell NINDS repository.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000837> "A collection of Parkinson's disease patients and neurologically normal controls whose samples are held in the NINDS repository at the Coriell Institute and were genotyped genome-wide and publicly released through dbGaP (phs001172, including phs000089) for studies of genetic risk of Parkinson's disease.")

