AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18243582") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18519132") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18519132") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2582594/") Annotation(rdfs:comment "Eligibility requirements included meeting criteria for DSM-IV cocaine dependence, being 18 years of age or older, and having a full sibling within five years of age who was willing to participate in the family-arm of the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001745> "A family study of cocaine dependence at Washington University School of Medicine in St. Louis, Missouri, in which adults with cocaine dependence recruited from chemical dependency treatment centres in the St. Louis area, and community controls matched to them on age, ethnicity, gender and zip code and recruited through driver's licence records, each took part with a full sibling, to study family, neighbourhood and genetic contributions to substance dependence; recruitment targeted equal numbers of men and women and of European-Americans and African-Americans.")
