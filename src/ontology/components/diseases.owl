ClassAssertion(Annotation(rdfs:comment "In the ensuing 50 years, the Cancer and Leukemia Group B has expanded to national and even international membership, and its research programs have expanded to include all of the common adult solid tumors and hematologic malignancies in a multidisciplinary effort to improve the outcomes for patients with cancer and to better understand the biology of malignant disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16740784+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004992) coho:COHO_0000022)
ClassAssertion(Annotation(rdfs:comment "TCGA is a collaboration between the National Cancer Institute (NCI) and the National Human Genome Research Institute (NHGRI) that has generated comprehensive, multi-dimensional maps of the key genomic changes in 33 types of cancer.") Annotation(oboInOwl:hasDbXref "https://www.cancer.gov/ccg/research/genome-sequencing") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004992) coho:COHO_0000023)
ClassAssertion(Annotation(rdfs:comment "The Cancer Prevention Study II (CPS-II), which began in 1982, is a prospective mortality study of approximately 1.2 million American men and women.") Annotation(oboInOwl:hasDbXref "https://www.cancer.org/research/population-science/pop-sci/prevention-studies/cps-2.html") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004992) coho:COHO_0000024)
ClassAssertion(Annotation(rdfs:comment "The population-based, case–control study in Sweden, named Cancer Prostate in Sweden (CAPS) was used to complete fine-mapping in the study.18 Cases with pathologically diagnosed PCa were recruited from regional cancer registries in Sweden, between July 2001 and October 2003.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3364485/") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0000025)
ClassAssertion(Annotation(rdfs:comment "CHARM is intended to randomize 6,500 patients with symptomatic heart failure from 26 countries in Europe, the United States, Canada, South Africa, and Australia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10496201+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "heart failure") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005252) coho:COHO_0000026)
ClassAssertion(Annotation(rdfs:comment "The Cardiogenics Study is a European collaboration on genetics of coronary artery disease.14 This initiative recruited 918 participants (459 patients with myocardial infarction and 459 normal controls) in five centres: Cambridge (UK), Leicester (UK), Lübeck (Germany), Regensburg (Germany), and Paris (France).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3314981/fullTextXML") Annotation(obo:IAO_0000116 "coronary artery disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0000028)
