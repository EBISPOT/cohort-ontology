ClassAssertion(Annotation(rdfs:comment "Following quality control as outlined in the ANZgene GWAS [28], this dataset consisted of 1618 MS cases of European ancestry from Australia and New Zealand, and 3413 healthy controls of European ancestry from Australia, the UK and the US.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3035668/fullTextXML") Annotation(obo:IAO_0000116 "multiple sclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005301) coho:COHO_0001488)
ClassAssertion(Annotation(rdfs:comment "The Australian and New Zealand Registry of Advanced Glaucoma is a prospective study that aims to develop a large cohort of glaucoma cases with severe visual field loss to identify novel genetic risk factors for glaucoma blindness.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22171965+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "glaucoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005041) coho:COHO_0001489)
ClassAssertion(Annotation(rdfs:comment "Patients were sampled from an ongoing study of ovarian histological types comprising approximately 1,000 women with ovarian carcinomas (300 endometrioid, 300 clear cell, 300 mucinous, and 100 high-grade serous).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3794544/fullTextXML") Annotation(obo:IAO_0000116 "ovarian carcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005140) coho:COHO_0001490)
ClassAssertion(Annotation(rdfs:comment "This retrospective study was an assessment of 114 men with prostate cancer who provided radical prostatectomy samples to the Australian Prostate Cancer Bioresource between 2006 and 2014.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37370825+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0001491)
ClassAssertion(Annotation(rdfs:comment "Subjects are women from the Aberdeen Prospective Osteoporosis Screening Study (APOSS) cohort, a population-based screening program for assessing osteoporotic fracture risk, which initially recruited 5119 women aged 45–54 years between 1990 and 1994 using random selection from Community Health Index [15].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5506508/fullTextXML") Annotation(obo:IAO_0000116 "osteoporosis") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005298) coho:COHO_0001492)
ClassAssertion(Annotation(rdfs:comment "In this randomized, double-blind trial, we compared apixaban (at a dose of 5 mg twice daily) with warfarin (target international normalized ratio, 2.0 to 3.0) in 18,201 patients with atrial fibrillation and at least one additional risk factor for stroke.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21870978+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atrial fibrillation") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004981) coho:COHO_0001493)
ClassAssertion(Annotation(rdfs:comment "AROS (Aarhus Osteoporosis Study) is a case–control study, including 462 osteoporotic patients (vertebral fracture and T-score < −2.5) and 336 controls.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4102322/unicode") Annotation(obo:IAO_0000116 "osteoporosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005298) coho:COHO_0001494)
