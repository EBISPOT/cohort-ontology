ClassAssertion(Annotation(rdfs:comment "The Ocular Hypertension Treatment Study (OHTS) seeks to evaluate the safety and efficacy of topical ocular hypotensive medication in preventing or delaying the onset of visual field loss and/or optic nerve damage in subjects with ocular hypertension at moderate risk for developing primary open angle glaucoma.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10326953+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "primary open angle glaucoma") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005338) coho:COHO_0002205)
