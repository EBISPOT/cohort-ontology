ClassAssertion(Annotation(rdfs:comment "Eligibility criteria for inclusion in the St. Jude Lifetime Cohort (SJLIFE) study include: (1) diagnosis of childhood malignancy treated at SJCRH; (2) survival ≥ 10 years from diagnosis; and (3) current age ≥ 18 years.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21370418+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "childhood cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006517) coho:COHO_0001120)
