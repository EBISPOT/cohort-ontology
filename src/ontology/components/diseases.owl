ClassAssertion(Annotation(rdfs:comment "Families were selected through a proband with idiopathic thrombophilia, which was defined as recurrent thrombotic events (at least one of which was spontaneous), a single spontaneous thrombotic episode plus a first-degree relative also affected, or onset of thrombosis before age 45.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4718515/fullTextXML") Annotation(obo:IAO_0000116 "venous thrombosis") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005399) coho:COHO_0001445)
ClassAssertion(Annotation(rdfs:comment "The samples used in this study are part of the SerGenCovid-19 project (https://sergencovid19.d4science.org), an initiative of the Italian National Research Council (Consiglio Nazionale delle Ricerche, CNR) aimed at identifying the genetic and serological factors involved in response to vaccination against COVID-19 and susceptibility to SARS-CoV-2 infection.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML") Annotation(obo:IAO_0000116 "COVID-19") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0100096) coho:COHO_0001447)
ClassAssertion(Annotation(rdfs:comment "Cancer and Leukemia Group B 40502 was a randomized trial of first-line taxane-based chemotherapy for patients with metastatic breast cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33981951+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "metastatic breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001448)
ClassAssertion(Annotation(rdfs:comment "The Asklepios Study is a longitudinal population study focusing on the interplay between ageing, cardiovascular haemodynamics and inflammation in (preclinical) cardiovascular disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17446795+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0001449)
ClassAssertion(Annotation(rdfs:comment "We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22773825+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "young-onset breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001453)
ClassAssertion(Annotation(rdfs:comment "Reproductive-aged women with laparoscopically-confirmed endometriosis (n = 282) and controls (n = 293) who participated in The Women’s Health Study: From Adolescence to Adulthood (A2A), a cohort of adolescents and young women enrolled from 2012–2018, were included in this cross-sectional analysis.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7444809/fullTextXML") Annotation(obo:IAO_0000116 "endometriosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005133) coho:COHO_0001454)
ClassAssertion(Annotation(rdfs:comment "In this study, we used genetic data from the AABCG, a consortium for a genetic study of breast cancer for females of African ancestry, including genetic data from over 20 studies conducted in the U.S. and Africa.") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC11284829") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001455)
ClassAssertion(Annotation(rdfs:comment "We did a genome-wide association study (GWAS) in 2669 physician-diagnosed asthmatics and 4528 controls from Australia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21907864+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "asthma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004979) coho:COHO_0001456)
ClassAssertion(Annotation(rdfs:comment "Patients treated for prostate adenocarcinoma at Department of Urology, Aarhus University Hospital, Skejby (Aarhus, Denmark)") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0001457)
ClassAssertion(Annotation(rdfs:comment "Amsterdam Breast Cancer Study Netherlands Pre-iCOGS: All breast cancer patients (with operable, invasive mammacarcinoma) aged <50 years and diagnosed from 1970-1994 in four Dutch hospitals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9585761/supplementaryFiles") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001458)
ClassAssertion(Annotation(rdfs:comment "The samples included in this study were from two Dutch breast cancer case-control studies: RBCS and ABCS-F.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4948019/fullTextXML") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001459)
ClassAssertion(Annotation(rdfs:comment "Fresh frozen tumors and matching blood samples were accessed from the Brisbane Breast Bank (BBB) at the University of Queensland Centre for Clinical Research (UQCCR) and from the Australian Breast Cancer Tissue Bank (ABCTB) based at the Westmead Institute for Medical Research.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6597578/fullTextXML") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001460)
ClassAssertion(Annotation(rdfs:comment "Aneurysm Consortium (AC), cases of AAA together with available DNA recruited in eight centers in the UK, Australia, and New Zealand and also samples from the United Kingdom Small Aneurysm Trial from inpatient populations, outpatient clinics, or population screening programs in the participating centers.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/supplementaryFiles") Annotation(obo:IAO_0000116 "abdominal aortic aneurysm") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005350) coho:COHO_0001463)
ClassAssertion(Annotation(rdfs:comment "To boost power for identifying these associations, we examined an Autism Case-Control cohort (ACC cohort, Table 1), comprising 1,453 subjects with ASDs from several US sites, and 7,070 control subjects without ASDs from the Children's Hospital of Philadelphia, who were also genotyped on the same platform.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2943511/") Annotation(obo:IAO_0000116 "autism spectrum disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005258) coho:COHO_0001464)
ClassAssertion(Annotation(rdfs:comment "The Action to Control Cardiovascular Risk in Diabetes (ACCORD) trial is a randomized, multicenter, double 2 x 2 factorial design study involving 10,251 middle-aged and older participants with type 2 diabetes who are at high risk for CVD events because of existing CVD or additional risk factors.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17599422+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004995) coho:COHO_0001465)
ClassAssertion(Annotation(rdfs:comment "The Action to Control Cardiovascular Risk in Diabetes (ACCORD) trial is a randomized, multicenter, double 2 x 2 factorial design study involving 10,251 middle-aged and older participants with type 2 diabetes who are at high risk for CVD events because of existing CVD or additional risk factors.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17599422+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0001465)
ClassAssertion(Annotation(rdfs:comment "We performed a genome-wide association study for alcohol-related cirrhosis in individuals of European descent (712 cases and 1,426 controls) with subsequent validation in two independent European cohorts (1,148 cases and 922 controls).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26482880+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "alcohol-related cirrhosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006644) coho:COHO_0001467)
ClassAssertion(Annotation(rdfs:comment "The St. Göran Bipolar Project (SBP) is a longitudinal outpatient study investigation aimed at identifying predictive factors associated with long-term outcomes in individuals with bipolar disorder.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39746340+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "bipolar disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004985) coho:COHO_0001469)
ClassAssertion(Annotation(rdfs:comment "Sporadic AD and control plasma samples [n = 504 control, 912 EOAD (onset < 65 years), 492 LOAD (onset > 65 years)] were a subset of the AD Cardiff Cohort, collected between 2004 and 2020 from individuals recruited from UK community and hospital settings using MRC, Moondance Foundation, and Health and Care Research Wales (HCRW) funding (Table 1).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10362776/fullTextXML") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0001470)
ClassAssertion(Annotation(rdfs:comment "Inclusion criteria for ADELAHYDE were age 60–85 years with arterial hypertension (>1 year from diagnosis, receiving antihypertensive treatment for at least one month), presenting with low-grade subjective memory complaints (SMCs) defined as a McNair scale >15 (revised validated French version of 26 items).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7175941/fullTextXML") Annotation(obo:IAO_0000116 "hypertension") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005044) coho:COHO_0001471)
ClassAssertion(Annotation(rdfs:comment "Inclusion criteria for ADELAHYDE were age 60–85 years with arterial hypertension (>1 year from diagnosis, receiving antihypertensive treatment for at least one month), presenting with low-grade subjective memory complaints (SMCs) defined as a McNair scale >15 (revised validated French version of 26 items).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7175941/fullTextXML") Annotation(obo:IAO_0000116 "subjective memory complaints") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0850292) coho:COHO_0001471)
ClassAssertion(Annotation(rdfs:comment "All patients were adults of Caucasian origin, recruited and evaluated at the Hospital Universitari Vall d’Hebron located in Barcelona (Spain), and met Diagnostic and Statistical Manual for Mental Disorders-IV (DSM-IV) criteria for ADHD.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnpp.2014.267/MediaObjects/41386_2015_BFnpp2014267_MOESM62_ESM.pdf") Annotation(obo:IAO_0000116 "attention-deficit hyperactivity disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007743) coho:COHO_0001473)
ClassAssertion(Annotation(rdfs:comment "The study is a 2 x 2 factorial randomised controlled trial that will include 10000 adults with Type II diabetes at high risk of vascular disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11596665+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0001474)
ClassAssertion(Annotation(rdfs:comment "The Aneurysm-Express study (which is a derivative of the previously mentioned Athero-Express study) is a longitudinal biobank study that includes aneurysm tissue from all patients undergoing open surgical abdominal aortic aneurysm (AAA) repair in two Dutch hospitals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4220929/fullTextXML") Annotation(obo:IAO_0000116 "arterial aneurysm") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005160) coho:COHO_0001475)
ClassAssertion(Annotation(rdfs:comment "The Aneurysm-Express study (which is a derivative of the previously mentioned Athero-Express study) is a longitudinal biobank study that includes aneurysm tissue from all patients undergoing open surgical abdominal aortic aneurysm (AAA) repair in two Dutch hospitals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4220929/fullTextXML") Annotation(obo:IAO_0000116 "abdominal aortic aneurysm") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005350) coho:COHO_0001475)
ClassAssertion(Annotation(rdfs:comment "Third, while the AFLMU data set is rather large for an AF ablation cohort with biomarkers, further studies in independent patient data sets, ideally assessing atrial PITX2 and plasma BMP10 concentrations in the same patients, are warranted to confirm our findings.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7455124/fullTextXML") Annotation(obo:IAO_0000116 "atrial fibrillation") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004981) coho:COHO_0001476)
ClassAssertion(Annotation(rdfs:comment "The randomized Early Treatment of Atrial Fibrillation for Stroke Prevention Trial found that early rhythm control reduces cardiovascular events in patients with recently diagnosed atrial fibrillation (AF) compared with usual care.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37264683+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atrial fibrillation") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004981) coho:COHO_0001477)
ClassAssertion(Annotation(rdfs:comment "Single nucleotide polymorphisms (SNPs) in candidate genes were tested for association with overt diabetic nephropathy (persistent albuminuria >300 mg/24 h) in a large (n=2499) Type 1 diabetes case/control study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17704113+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "diabetic nephropathy") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005016) coho:COHO_0001478)
ClassAssertion(Annotation(rdfs:comment "Single nucleotide polymorphisms (SNPs) in candidate genes were tested for association with overt diabetic nephropathy (persistent albuminuria >300 mg/24 h) in a large (n=2499) Type 1 diabetes case/control study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17704113+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005147) coho:COHO_0001478)
ClassAssertion(Annotation(rdfs:comment "The first phase of the AGP involved examining genetic linkage and chromosomal rearrangements in 1,168 families with at least two ASD-affected individuals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4067558/fullTextXML") Annotation(obo:IAO_0000116 "autism spectrum disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005258) coho:COHO_0001479)
ClassAssertion(Annotation(rdfs:comment "Our study sample comprised individuals from the Autism Genetic Resource Exchange (AGRE), a volunteer research repository of families from across the United States in which typically two or more siblings have a diagnosis of ASD (multiplex families).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6071802/fullTextXML") Annotation(obo:IAO_0000116 "autism spectrum disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005258) coho:COHO_0001480)
ClassAssertion(Annotation(rdfs:comment "The UCSF adult glioma case–control study (SFAGS–GWAS) included participants of the San Francisco Bay Area Adult Glioma Study (AGS).") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5558246/unicode") Annotation(obo:IAO_0000116 "glioma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0021042) coho:COHO_0001481)
ClassAssertion(Annotation(rdfs:comment "The Aichi CRC Study: This study had two case-control collections (Aichi-1 and Aichi-2) with a total of 640 cases and 1,414 controls") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0001482)
ClassAssertion(Annotation(rdfs:comment "We combined samples and data from four large epidemiologic studies of breast cancer in AA women, two cohort and two case-control, creating the African American Breast Cancer Epidemiology and Risk consortium.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24343304+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001483)
ClassAssertion(Annotation(rdfs:comment "Between 2004 and 2006, we enrolled a cohort of 809 consecutive men younger than 65 and suffering from non-ST-segment elevation MI or ST- segment elevation MI with an onset of symptoms less than 24 hours before admission.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(obo:IAO_0000116 "myocardial infarction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005068) coho:COHO_0001484)
ClassAssertion(Annotation(rdfs:comment "The Amsterdam UMC COVID-19 biobank is a prospective cohort study containing clinical data and archive material from adult patients admitted with COVID-19 in two academic hospitals of Amsterdam UMC.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8118723/fullTextXML") Annotation(obo:IAO_0000116 "COVID-19") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0100096) coho:COHO_0001485)
ClassAssertion(Annotation(rdfs:comment "ANECS was a population-based case-control study conducted from 2005 to 2007, in which 1,399 women with newly diagnosed histologically confirmed primary endometrial cancer and 740 control women provided risk factor information via telephone interview.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22245995+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "endometrial cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0011962) coho:COHO_0001486)
ClassAssertion(Annotation(rdfs:comment "Consecutive patients referred for coronary angiography, classified as CAD/MI cases based on the coronary angiogram") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") Annotation(obo:IAO_0000116 "structural heart disease") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0001627) coho:COHO_0001487)
