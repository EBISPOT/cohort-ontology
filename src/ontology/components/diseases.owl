ClassAssertion(Annotation(rdfs:comment "we are recruiting high-risk drinkers who are either cases (with alcoholic cirrhosis) or controls (drinking comparable amounts over similar time, but free of significant liver disease).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25872595+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "alcoholic cirrhosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006644) coho:COHO_0001334)
ClassAssertion(Annotation(rdfs:comment "Our discovery phase included 2,981 individuals with melanoma and 1,982 study-specific control individuals of European ancestry, as well as an additional 6,426 control subjects from French or British populations, all of whom were genotyped for 317,000 or 610,000 single-nucleotide polymorphisms (SNPs).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21983787+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "melanoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005105) coho:COHO_0001335)
ClassAssertion(Annotation(rdfs:comment "GEN-SEP is a multicentre, observational study conducted in a Spanish network of ICUs comprising adult patients with all-cause sepsis of European ancestry recruited in two periods (in 2002-2015 and in 2016-2019) (Hernandez-Beeftink et al., 2022).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/supplementaryFiles") Annotation(obo:IAO_0000116 "acute respiratory distress syndrome") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006502) coho:COHO_0001336)
ClassAssertion(Annotation(rdfs:comment "GEN-SEP is a multicentre, observational study conducted in a Spanish network of ICUs comprising adult patients with all-cause sepsis of European ancestry recruited in two periods (in 2002-2015 and in 2016-2019) (Hernandez-Beeftink et al., 2022).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/supplementaryFiles") Annotation(obo:IAO_0000116 "sepsis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1040015) coho:COHO_0001336)
ClassAssertion(Annotation(rdfs:comment "The Genetics of Early Onset Stroke Study is a population-based case-control study designed to identify genetic determinants of early-onset arterial ischemic stroke and to characterize interactions with environmental risk factors.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10718488/fullTextXML") Annotation(obo:IAO_0000116 "early-onset ischemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0001337)
ClassAssertion(Annotation(rdfs:comment "Here, we conduct a genome-wide association study meta-analysis across 826,690 individuals (177,517 with osteoarthritis) and identify 100 independently associated risk variants across 11 osteoarthritis phenotypes, 52 of which have not been associated with the disease before.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34450027+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "osteoarthritis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005178) coho:COHO_0001338)
