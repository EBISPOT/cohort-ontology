ClassAssertion(Annotation(rdfs:comment "The second study was conducted in parallel in the University Hospital of Bellvitge and in the Hospital of León, León, during 2007–2015 and recruited a total of 633 incident CRC cases (313 Bellvitge and 320 León) and 571 population controls (free of CRC, 164 Bellvitge and 407 León).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000585)
