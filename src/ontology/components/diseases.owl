ClassAssertion(Annotation(rdfs:comment "761 cases with lymphoma (310 diffuse large B-cell [DLBCL]; 226 follicular [FL]; and 225 Hodgkin [HL]) and 761 unaffected age and sex matched controls were recruited and their histories of infection and non-infection diagnoses in primary care records were compared using negative binomial regression.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20832384+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lymphoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005062) coho:COHO_0001685)
