ClassAssertion(Annotation(rdfs:comment "1239 cases with schizophrenia, schizoaffective disorder, or psychotic bipolar disorder; 857 of their unaffected relatives, and 2739 healthy controls were genotyped with the Affymetrix 6.0 single nucleotide polymorphism (SNP) array.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23871474+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "schizoaffective disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005487) coho:COHO_0000201)
ClassAssertion(Annotation(rdfs:comment "Methods: This retrospective cohort study analysed genomics data for 121,771 patients who had undergone targeted sequencing compiled by the Genomics Evidence Neoplasia Information Exchange (GENIE) or Foundation Medicine (FM). A statistical approach was developed to identify patients with GCV-associated mutational signature (GCVsig) from targeted sequenced data of tumour samples.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001006707") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004992) coho:COHO_0000209)
ClassAssertion(Annotation(rdfs:comment "Low-coverage whole-genome sequencing (LC-WGS) was performed on tumor tissue, normal tissue and plasma samples collected from mCRC patients from the AC-ANGIOPREDICT Phase II trial (NCT01822444) and the University Medical Center Mannheim (UMM).") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS50000000131") Annotation(obo:IAO_0000116 "metastatic colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000210)
ClassAssertion(Annotation(rdfs:comment "Here, by performing gene expression profiling in HER2-positive breast cancers from patients receiving adjuvant trastuzumab in the ALTTO clinical trial, we identified and characterized five molecular subtypes associated with the risk of distant recurrence") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS50000000525") Annotation(obo:IAO_0000116 "HER2-positive breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006244) coho:COHO_0000211)
ClassAssertion(Annotation(rdfs:comment "The design of the African Collaborative Center for Microbiome and Genomics Research (ACCME) HPV and Cervical Cancer Cohort Study enables us to study environmental, microbiomic, genetic and epigenetic factors associated with persistent hrHPV infection, in order to improve knowledge of the mechanism of HPV carcinogenesis and discover biomarkers of persistent hrHPV infection and cervical cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837640/fullTextXML") Annotation(obo:IAO_0000116 "persistent high-risk HPV infection") ObjectSomeValuesFrom(coho:is_population_study_of obo:HP_0020114) coho:COHO_0000212)
ClassAssertion(Annotation(rdfs:comment "The design of the African Collaborative Center for Microbiome and Genomics Research (ACCME) HPV and Cervical Cancer Cohort Study enables us to study environmental, microbiomic, genetic and epigenetic factors associated with persistent hrHPV infection, in order to improve knowledge of the mechanism of HPV carcinogenesis and discover biomarkers of persistent hrHPV infection and cervical cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837640/fullTextXML") Annotation(obo:IAO_0000116 "cervical cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0002974) coho:COHO_0000212)
ClassAssertion(Annotation(rdfs:comment "ALL06 clinical trial described the efficacy and tolerability of AYA ALL patients aged 15-39 years treated on a single minimal residual disease (MRD)-stratified platform.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS50000000752") Annotation(obo:IAO_0000116 "acute lymphoblastic leukaemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004967) coho:COHO_0000216)
