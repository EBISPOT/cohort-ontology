ClassAssertion(Annotation(rdfs:comment "Between 1985 and 1996, 514 children (279 male) who developed type 1 diabetes before the age of 16 years (91% of those eligible from a region where ascertainment of new cases is 95%) were recruited for a longitudinal study with central annual assessment of HbAlc and albumin excretion (three urine samples).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10097935+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "microalbuminuria") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0012594) coho:COHO_0001437)
