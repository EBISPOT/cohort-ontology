ClassAssertion(Annotation(rdfs:comment "However, because the initial aim of the Norfolk Island Health Study (NIHS) was to study cardiovascular diseases, only serum biomarkers were collected.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8484585/fullTextXML") Annotation(obo:IAO_0000116 "cardiovascular diseases") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0002153)
ClassAssertion(Annotation(rdfs:comment "For the NIMH/Pritzker GWAS, 1,177 BP I cases (473 sibling pairs and 231 unrelated individuals) from the NIMH and Prechter Repositories and 772 controls from the NIMH Repository (Table 1) were genotyped on the Illumina HumanHap 550K chip; 512,844 autosomal SNPs passed QC (see Methods) and had minor allele frequency (MAF)≥1%.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2678639/") Annotation(obo:IAO_0000116 "bipolar I disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001866) coho:COHO_0002156)
ClassAssertion(Annotation(rdfs:comment "The study included 798 histologically confirmed primary intracranial glioma cases (45 % with proxy respondents) and 1,175 population-based controls, all adult (age 18–80) non-metropolitan residents of Iowa, Michigan, Minnesota, and Wisconsin.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3406961/") Annotation(obo:IAO_0000116 "glioma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0021042) coho:COHO_0002158)
ClassAssertion(Annotation(rdfs:comment "Cases were newly diagnosed histologically confirmed cases of invasive epithelial ovarian cancer identified between January 2004 and May 2008 through rapid case ascertainment by the New Jersey State Cancer Registry (NJSCR), a population-based SEER cancer registry that has collected data since 1978.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3196697/fullTextXML") Annotation(obo:IAO_0000116 "epithelial ovarian cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005140) coho:COHO_0002160)
ClassAssertion(Annotation(rdfs:comment "In the first GWAS stage, 1,049 colorectal cancer cases were enrolled from the Cancer Center of Nanjing Medical University and 1,315 controls were from the same districts of Nanjing beginning in September 2010 (Nanjing-1).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4858728/fullTextXML") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0002162)
ClassAssertion(Annotation(rdfs:comment "Cases were diagnosed with probable or definite ALS according to the revised El-Escorial Criteria by neurologists specialized in motor neuron diseases11 . Both cases with and without a family history for ALS were included. Tertiary referral centers for ALS were University Medical Center Utrecht, Academic Medical Centre Amsterdam and Radboud University Medical Center Nijmegen.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3622/MediaObjects/41588_2016_BFng3622_MOESM43_ESM.pdf") Annotation(obo:IAO_0000116 "amyotrophic lateral sclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004976) coho:COHO_0002163)
ClassAssertion(Annotation(rdfs:comment "The Dutch series consists of 3 groups: population controls, patients with urinary bladder cancer, and patients with lung cancer.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.573/MediaObjects/41588_2010_BFng573_MOESM34_ESM.pdf") Annotation(obo:IAO_0000116 "urinary bladder cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001187) coho:COHO_0002164)
ClassAssertion(Annotation(rdfs:comment "The Dutch series consists of 3 groups: population controls, patients with urinary bladder cancer, and patients with lung cancer.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.573/MediaObjects/41588_2010_BFng573_MOESM34_ESM.pdf") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008903) coho:COHO_0002164)
ClassAssertion(Annotation(rdfs:comment "The Netherlands patients with lung cancer were identified through the population-based cancer registry of the Netherlands Comprehensive Cancer Organisation in Nijmegen, the Netherlands.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008903) coho:COHO_0002165)
ClassAssertion(Annotation(rdfs:comment "In this biomarker sub-study of the Nashville Men's Health Study (NMHS), we included 494 NMHS participants, consisting of 98 high-grade (Gleason≥7) and 100 low-grade cancer cases, 133 prostate intraepithelial neoplasia (PIN) cases, and 163 controls without cancer or PIN at biopsy.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3081812/fullTextXML") Annotation(obo:IAO_0000116 "prostate intraepithelial neoplasia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005193) coho:COHO_0002167)
