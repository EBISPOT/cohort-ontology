ClassAssertion(Annotation(rdfs:comment "To address this gap, we performed integrated DNA and RNA sequencing on 88 BPDCN patients representing the largest and most ancestrally diverse cohort described to date (~77% European, ~16% Asian, ~7% African).") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS50000001346") Annotation(obo:IAO_0000116 "blood cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002334) coho:COHO_0000219)
