ClassAssertion(Annotation(rdfs:comment "The sample of the Comorbidity and Trauma Study, a genetic association study of heroin dependence, consists of Australian heroin dependent cases ascertained from opioid replacement therapy clinics and controls ascertained in nearby economically disadvantaged neighborhoods.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23245376+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "heroin dependence") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005367) coho:COHO_0001573)
