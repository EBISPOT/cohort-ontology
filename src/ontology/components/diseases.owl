ClassAssertion(Annotation(rdfs:comment "The phase III COntinuous or INtermittent (COIN) trial failed to show non-inferiority of intermittent compared with continuous chemotherapy for advanced colorectal cancer in overall survival (OS).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26889974+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "advanced colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000040)
