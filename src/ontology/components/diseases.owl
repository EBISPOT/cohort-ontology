ClassAssertion(Annotation(rdfs:comment "Participants in the investigation (Table 1) were from two studies of South Asian individuals; the United Kingdom Asian Diabetes Study (UKADS; 857 participants with type 2 diabetes, 417 without) [2], [3] and the Diabetes Genetics in Pakistan study (DGP; 821 participants with type 2 diabetes, 1167 without) [3].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176767/fullTextXML") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000049)
ClassAssertion(Annotation(rdfs:comment "811 unrelated healthy subjects older than 45 years and with fasting glucose levels below 100 mg/dL were classified as controls. 569 unrelated individuals, older than 18 years, with either previous T2D diagnosis or fasting glucose levels above 125 mg/dL were included as T2D cases.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature12828/MediaObjects/41586_2014_BFnature12828_MOESM230_ESM.pdf") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000050)
ClassAssertion(Annotation(rdfs:comment "The Diabetes Prevention Program is a randomized clinical trial testing strategies to prevent or delay the development of type 2 diabetes in high-risk individuals with elevated fasting plasma glucose concentrations and impaired glucose tolerance.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10189543+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005148) coho:COHO_0000051)
ClassAssertion(Annotation(rdfs:comment "People with impaired fasting glucose or impaired glucose tolerance were randomised to ramipril (15 mg/day) or placebo and rosiglitazone (8 mg/day) or placebo with a 2x2 factorial design.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15322749+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005015) coho:COHO_0000052)
ClassAssertion(Annotation(rdfs:comment "Prediabetic participants (target sample size 2,200-2,700) and patients with newly diagnosed type 2 diabetes (target sample size ~1,000) are undergoing detailed metabolic phenotyping at baseline and 18 months and 36 months later.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24695864+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000053)
ClassAssertion(Annotation(rdfs:comment "Prediabetic participants (target sample size 2,200-2,700) and patients with newly diagnosed type 2 diabetes (target sample size ~1,000) are undergoing detailed metabolic phenotyping at baseline and 18 months and 36 months later.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24695864+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prediabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006920) coho:COHO_0000053)
ClassAssertion(Annotation(rdfs:comment "The aim of the population-based Dortmund health study (DHS) is the assessment of the prevalence and incidence of different headache types as well as other chronic conditions and to analyse their consequences on daily activities of those affected.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22736161+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "headache") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0021146) coho:COHO_0000054)
ClassAssertion(Annotation(rdfs:comment "HGSOC patients were determined from pathology records and were included in the study where there was matched tumour and whole blood samples.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001004410") Annotation(obo:IAO_0000116 "high-grade serous ovarian cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005211) coho:COHO_0000056)
ClassAssertion(Annotation(rdfs:comment "We therefore established the DDS as a population-based research framework to investigate a broad range of lifestyle, medical and genetic factors and their association with diabetes – the primary research focus of the study – together with other chronic diseases and traits") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5732575/fullTextXML") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005015) coho:COHO_0000057)
ClassAssertion(Annotation(rdfs:comment "NELSON investigates whether 16-detector multi-slice computed tomography screening will decrease lung cancer mortality compared to no screening.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17131307+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008903) coho:COHO_0000058)
ClassAssertion(Annotation(rdfs:comment "We prospectively recruited all consenting patients with recent stroke from the emergency department; medical, neurology, and occasionally other (e.g., surgical) wards; stroke unit; and neurovascular clinics of the Western General Hospital, Edinburgh, United Kingdom, between April 2002 and May 2005 into the Edinburgh Stroke Study") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2730573/fullTextXML") Annotation(obo:IAO_0000116 "stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005098) coho:COHO_0000060)
ClassAssertion(Annotation(rdfs:comment "ENGAGE AF-TIMI 48 is a phase 3 comparison of the novel oral factor Xa inhibitor edoxaban to warfarin for the prevention of thromboembolism in patients with atrial fibrillation.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20934556+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atrial fibrillation") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004981) coho:COHO_0000061)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC) is an ongoing multi-centre prospective cohort study designed to investigate the relationship between nutrition and cancer, with the potential for studying other diseases as well.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12639222+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004992) coho:COHO_0000065)
ClassAssertion(Annotation(rdfs:comment "The EPIC-Norfolk study (https://www.epic-norfolk.org.uk) is a population-based prospective cohort study, nested within the European Prospective Investigation of Cancer (EPIC) study, which had the primary aim of exploring the connections between cancer, diet and lifestyle.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9671801/fullTextXML") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004992) coho:COHO_0000066)
