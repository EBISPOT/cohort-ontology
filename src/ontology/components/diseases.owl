ClassAssertion(Annotation(rdfs:comment "Bonn OMNI cohort: the Bonn OMNI cohort consists of AD patients and controls derived from a larger German GWAS cohort which was recruited from the following three sources: (i) the German Dementia Competence Network; (ii) the German study on Aging, Cognition, and Dementia in primary care patients (AgeCoDe); and (iii) the interdisciplinary Memory Clinic at the University Hospital of Bonn.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0001062)
ClassAssertion(Annotation(rdfs:comment "The BRAINS (Bio-repository of DNA in stroke) study aims to recruit subjects with all subtypes of stroke as well as controls from UK, India, Sri Lanka and Qatar.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738328/fullTextXML") Annotation(obo:IAO_0000116 "stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005098) coho:COHO_0001063)
ClassAssertion(Annotation(rdfs:comment "The BREast Oncology GAlicia Network (BREOGAN) is a population-based study conducted since 1997 in two main cities in Galicia, Spain (Vigo and Santiago de Compostela), which cover approximately 700,000 inhabitants.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001064)
ClassAssertion(Annotation(rdfs:comment "The Kita-Nagoya Genomic Epidemiology (KING) Study (ClinicalTrials.gov identifier NCT00262691) is an ongoing community-based prospective observational study of the genetic basis of cardiovascular disease and its risk factors") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6453927/fullTextXML") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0001065)
ClassAssertion(Annotation(rdfs:comment "The Cleveland Clinic Atrial Fibrillation Study consists of clinical and genetic data of patients with atrial fibrillation and control cohorts from the Cleveland Clinic CV/Arrhythmia Biobank, including the Cleveland Clinic Lone Atrial Fibrillation GeneBank.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001189.v5.p1") Annotation(obo:IAO_0000116 "atrial fibrillation") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004981) coho:COHO_0001066)
