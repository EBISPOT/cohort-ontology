ClassAssertion(Annotation(rdfs:comment "Postmenopausal hormone receptor-positive BC patients, for whom an upfront five-year therapy with letrozole (2.5 mg/day) was indicated, were eligible.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10853028/fullTextXML") Annotation(obo:IAO_0000116 "hormone receptor-positive breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004989) coho:COHO_0002277)
ClassAssertion(Annotation(rdfs:comment "The PREMIER consortium (May 2019 and December 2022) recruited a research cohort to establish an R&BD platform for the development of early diagnosis and precision medicine-based treatment of mild cognitive impairment (MCI) and dementia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11538854/fullTextXML") Annotation(obo:IAO_0000116 "dementia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001627) coho:COHO_0002278)
