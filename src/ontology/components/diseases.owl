ClassAssertion(Annotation(rdfs:comment "Pancreatic tumor tissues from resected PDAC patients were collected at the University of Maryland Medical System (UMMS) in Baltimore, MD, through an NCI-UMD resource contract and at the University Medical Center Göttingen, Germany.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10842852/fullTextXML") Annotation(obo:IAO_0000116 "pancreatic ductal adenocarcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005184) coho:COHO_0002738)
ClassAssertion(Annotation(rdfs:comment "NR-SAFE is a double-blinded randomized safety study aiming to determine the safety and tolerability of nicotinamide riboside (NR) at a daily dose of 3000mg, in individuals with Parkinson's disease (PD).") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/api/v2/studies/NCT05344404") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002739)
ClassAssertion(Annotation(rdfs:comment "Extremely preterm infants are at high risk for retinopathy of prematurity (ROP), a potentially blinding disease characterized by abnormalities in retinal vascularization.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML") Annotation(obo:IAO_0000116 "retinopathy of prematurity") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0006952) coho:COHO_0002740)
ClassAssertion(Annotation(rdfs:comment "The “Towards A Cure for Early Rheumatoid Arthritis” (TACERA) study12 was designed to detect distinct disease subtypes and the immunological correlates of disease activity and autoimmunity in patients with early, seropositive RA, with a secondary objective to investigate biomarkers of initial drug response to methotrexate.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(obo:IAO_0000116 "rheumatoid arthritis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008383) coho:COHO_0002741)
ClassAssertion(Annotation(rdfs:comment "Patients with early untreated seropositive RA were recruited from 28 UK centres.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8544781/fullTextXML") Annotation(obo:IAO_0000116 "rheumatoid arthritis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008383) coho:COHO_0002742)
ClassAssertion(Annotation(rdfs:comment "The cross-sectional thin-on-the-outside-fat-on-the-inside (TOFI)_Asia study investigated adipose depots and clinical biomarkers as predictors of fasting plasma glucose (FPG) and insulin resistance (IR; assessed using the updated homeostatic model assessment of IR) in lean and overweight normo- and dysglycemic Chinese (n = 199) and Caucasian (n = 158) individuals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33040488+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005148) coho:COHO_0002744)
ClassAssertion(Annotation(rdfs:comment "Eligibility criteria were pregnant women with a singleton pregnancy, with and without risk factors for preterm birth.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8514602/fullTextXML") Annotation(obo:IAO_0000116 "preterm birth") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:HP_0001622) coho:COHO_0002746)
ClassAssertion(Annotation(rdfs:comment "Women were defined as being at risk of preterm birth if they had a history of cervical excisional treatment for pre-cancerous cells, a previous preterm birth or mid-trimester loss, or other risk factors such as previous caesarean section at full cervical dilation or congenital uterine anomaly.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12423329/fullTextXML") Annotation(obo:IAO_0000116 "preterm birth") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:HP_0001622) coho:COHO_0002747)
ClassAssertion(Annotation(rdfs:comment "All HIV-seropositive pregnant subjects electing to breastfeed their child will be counselled to exclusively breastfeed through 4 months of age.") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/api/v2/studies/NCT00310726") Annotation(obo:IAO_0000116 "HIV infection") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005109) coho:COHO_0002748)
ClassAssertion(Annotation(rdfs:comment "This retrospective real-world study used data from two registries, International Pediatric Peritoneal Dialysis Network (IPPN) and International Pediatric Hemodialysis Network (IPHN), to characterize the efficacy and safety of continuous erythropoietin receptor activator (C.E.R.A.) in pediatric patients with chronic kidney disease (CKD) on peritoneal dialysis (PD) or hemodialysis (HD).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37566114+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic kidney disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005300) coho:COHO_0002749)
)
