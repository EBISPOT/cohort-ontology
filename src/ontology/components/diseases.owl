ClassAssertion(Annotation(rdfs:comment "The primary goal of AddNeuroMed has been to assess longitudinal MRI changes in AD, MCI, and healthy controls using image-acquisition protocols compatible with those used in ADNI [17].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6804515/fullTextXML") Annotation(obo:IAO_0000116 "mild cognitive impairment") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002039) coho:COHO_0000003)
ClassAssertion(Annotation(rdfs:comment "The primary goal of AddNeuroMed has been to assess longitudinal MRI changes in AD, MCI, and healthy controls using image-acquisition protocols compatible with those used in ADNI [17].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6804515/fullTextXML") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0000003)
ClassAssertion(Annotation(rdfs:comment "The Adenoma Prevention with Celecoxib Trial examined the efficacy and safety of the cyclooxygenase (Cox)-2 inhibitor, celecoxib, for sporadic colorectal adenoma prevention in patients at high risk for colorectal cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19336730+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "colorectal adenoma") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005484) coho:COHO_0000004)
ClassAssertion(Annotation(rdfs:comment "The Adenoma Prevention with Celecoxib Trial examined the efficacy and safety of the cyclooxygenase (Cox)-2 inhibitor, celecoxib, for sporadic colorectal adenoma prevention in patients at high risk for colorectal cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19336730+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005575) coho:COHO_0000004)
ClassAssertion(Annotation(rdfs:comment "Briefly, the ASAP cohort is a single-centre, observational cohort study of consecutive patients with aortic valve and/or ascending aortic disease undergoing elective open-heart surgery at the Cardiothoracic Surgery Unit, Karolinska University Hospital in Stockholm, Sweden.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10961501/fullTextXML") Annotation(obo:IAO_0000116 "ascending aortic disease") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0004970) coho:COHO_0000005)
ClassAssertion(Annotation(rdfs:comment "Briefly, the ASAP cohort is a single-centre, observational cohort study of consecutive patients with aortic valve and/or ascending aortic disease undergoing elective open-heart surgery at the Cardiothoracic Surgery Unit, Karolinska University Hospital in Stockholm, Sweden.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10961501/fullTextXML") Annotation(obo:IAO_0000116 "aortic valve disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0003803) coho:COHO_0000005)
ClassAssertion(Annotation(rdfs:comment "Arthritis Research UK Osteoarthritis Genetics (arcOGEN) is a collection of 7410 unrelated, UK-based individuals of European ancestry with knee and/or hip osteoarthritis from the arcOGEN Consortium (Zeggini et al., 2012).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8459317/fullTextXML") Annotation(obo:IAO_0000116 "osteoarthritis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005178) coho:COHO_0000007)
ClassAssertion(Annotation(rdfs:comment "In the present analysis, we attempted to replicate these associations using the BCAC component of COGS, comprising 53 835 female breast cancer cases and 50 156 controls (Table 1).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4204770/fullTextXML") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0000008)
ClassAssertion(Annotation(rdfs:comment "involving 28,980 men and women aged 50 to 75 years living in central Scotland, free of clinical cardiovascular disease, recruited from a community health registry, and had an ABI screening test. Of those, 3350 with a low ABI (< or = 0.95) were entered into the trial, which was powered to detect a 25% proportional risk reduction in events.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20197530+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0004995) coho:COHO_0000009)
ClassAssertion(Annotation(rdfs:comment "involving 28,980 men and women aged 50 to 75 years living in central Scotland, free of clinical cardiovascular disease, recruited from a community health registry, and had an ABI screening test. Of those, 3350 with a low ABI (< or = 0.95) were entered into the trial, which was powered to detect a 25% proportional risk reduction in events.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20197530+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atherosclerosis") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005311) coho:COHO_0000009)
ClassAssertion(Annotation(rdfs:comment "A data linkage study was performed using patients from the Athero-Express biobank study who underwent CEA in two Dutch tertiary referral hospitals between 2002 and 2020.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC13308645/") Annotation(obo:IAO_0000116 "carotid stenosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001612) coho:COHO_0000010)
ClassAssertion(Annotation(rdfs:comment "A data linkage study was performed using patients from the Athero-Express biobank study who underwent CEA in two Dutch tertiary referral hospitals between 2002 and 2020.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC13308645/") Annotation(obo:IAO_0000116 "atherosclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005311) coho:COHO_0000010)
ClassAssertion(Annotation(rdfs:comment "Atherosclerosis Risk in Communities (ARIC) is a new prospective study to investigate the etiology of atherosclerosis and its clinical sequelae and variation in cardiovascular risk factors, medical care, and disease by race, sex, place, and time.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2646917+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000011)
