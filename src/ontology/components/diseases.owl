ClassAssertion(Annotation(rdfs:comment "A multicenter case-control study comprising 811 upper aerodigestive tract cancer cases and 1,083 controls was conducted in: Bucharest (Romania), Lodz (Poland), Moscow (Russia), Banska Bystrika (Slovakia), and Olomouc and Prague (Czech Republic).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16614111+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "upper aerodigestive tract cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005398) coho:COHO_0001087)
ClassAssertion(Annotation(rdfs:comment "The International Collaboration for the Genomics of HIV was established as a platform to combine all available genome-wide SNP data sets obtained on HIV-1 infected individuals worldwide.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3723635/fullTextXML") Annotation(obo:IAO_0000116 "HIV-1 infection") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005109) coho:COHO_0001089)
ClassAssertion(Annotation(rdfs:comment "The IEGC is a collaborative effort that aggregates data from multiple international studies to investigate the genetic factors of endometriosis4.") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC13195585") Annotation(obo:IAO_0000116 "endometriosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005133) coho:COHO_0001090)
ClassAssertion(Annotation(rdfs:comment "The ISGS is a prospective case-control genetic association study of patients with first-ever ischemic stroke at 5 US tertiary stroke centers.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17845914+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "ischaemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0001092)
ClassAssertion(Annotation(rdfs:comment "The KARMA study aims to study and determine the roles and interactions of mammographic density, genetic determinants and lifestyle in the risk of breast cancer to build a comprehensive risk prediction model including all known and established risk factors for breast cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837703/fullTextXML") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0007254) coho:COHO_0001093)
ClassAssertion(Annotation(rdfs:comment "Based in Australia, the primary aim of kConFab is to facilitate high-quality research by amassing a large and comprehensive resource of epidemiological and clinical data with biospecimens from individuals at high risk of breast and/or ovarian cancer, and from their close relatives.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16507150+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0007254) coho:COHO_0001094)
