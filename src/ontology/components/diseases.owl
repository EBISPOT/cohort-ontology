ClassAssertion(Annotation(rdfs:comment "The PICNICS study recruited newly diagnosed cases of PD and parkinsonism resident in Cambridgeshire between 1 April 2008 and 31 January 2010.") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1136/jnnp-2015-312581") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002258)
