ClassAssertion(Annotation(rdfs:comment "Consecutive patients referred for coronary angiography, classified as CAD/MI cases based on the coronary angiogram") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") Annotation(obo:IAO_0000116 "dilated cardiomyopathy") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005021) coho:COHO_0001487)
