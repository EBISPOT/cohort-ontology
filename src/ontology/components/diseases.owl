ClassAssertion(Annotation(rdfs:comment "Patients were recruited from neurology clinics of university and regional hospitals in the western part of The Netherlands and all fulfilled the United Kingdom Parkinson’s disease Society Brain Bank criteria for idiopathic PD") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4893359/fullTextXML") Annotation(obo:IAO_0000116 "idiopathic Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002290)
