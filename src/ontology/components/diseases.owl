ClassAssertion(Annotation(rdfs:comment "Thus, the Dallas Heart Study provides a phenotypically well-characterized probability sample for multidisciplinary research that will be used to improve the mechanistic understanding and prevention of cardiovascular disease, especially in black Americans.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15194016+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0001309)
