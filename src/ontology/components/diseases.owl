ClassAssertion(Annotation(rdfs:comment "We enrolled 4162 patients who had been hospitalized for an acute coronary syndrome within the preceding 10 days and compared 40 mg of pravastatin daily (standard therapy) with 80 mg of atorvastatin daily (intensive therapy).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15007110+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "acute coronary syndrome") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005542) coho:COHO_0002294)
ClassAssertion(Annotation(rdfs:comment "The Pumwani sex worker cohort was established in Nairobi, Kenya, in 1985 (27, 48) and has become well known for a small group of women who remain seronegative and PCR negative to HIV despite repeated exposure through active high-risk sex work.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3486297/") Annotation(obo:IAO_0000116 "HIV-1 infection") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005109) coho:COHO_0002298)
