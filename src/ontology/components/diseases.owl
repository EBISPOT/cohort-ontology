ClassAssertion(Annotation(rdfs:comment "The study population consisted of children and adolescents from the HOLBAEK Study (previously known as The Danish Childhood Obesity Biobank),17 including an obesity clinic cohort with a BMI above the 90th percentile for sex and age (BMI standard deviation score [SDS] > 1.28) according to a Danish reference; and a population-based cohort, recruited from schools in 11 municipalities in Zealand, Denmark.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11754075/fullTextXML") Annotation(obo:IAO_0000116 "obesity") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0011122) coho:COHO_0000402)
ClassAssertion(Annotation(rdfs:comment "Participants with AD (211) had neuropsychological profiles which were consistent with AD, and were more impaired than participants with mild cognitive impairment (133) or healthy controls (768), who performed within expected norms for age on neuropsychological testing.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19470201+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "mild cognitive impairment") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002039) coho:COHO_0000405)
