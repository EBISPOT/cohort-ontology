ClassAssertion(Annotation(rdfs:comment "From 1995-2006, the Oxford Endometriosis Gene (OXEGENE) study, Oxford, UK, recruited 245 families with ≥2 affected sisters with surgically confirmed endometriosis, and 785 single cases.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.731/MediaObjects/41588_2011_BFng731_MOESM17_ESM.pdf") Annotation(obo:IAO_0000116 "endometriosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005133) coho:COHO_0002224)
ClassAssertion(Annotation(rdfs:comment "We assessed a cross-sectional cohort of people diagnosed with diabetes between the ages of 20 and 40 years (n=223), who had diabetes for more than 3 years and self-reported as white European, from Devon and Cornwall in South West England.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5642867/unicode") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005015) coho:COHO_0002225)
ClassAssertion(Annotation(rdfs:comment "The Pancreatic Cancer: Investigation into Finding Causes (PACIFIC) Study is a case-control study of pancreatic cancer based in the defined populations of two large health plans (Group Health Cooperative (GHC) in Seattle, WA and Kaiser Permanente Northern California, (KPNC)).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3808252/") Annotation(obo:IAO_0000116 "pancreatic cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0009831) coho:COHO_0002226)
ClassAssertion(Annotation(rdfs:comment "Finally, 1,782 participants (1,038 PAF cases and 744 controls) were included in the GWAS and PRS analyses.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13138623/fullTextXML") Annotation(obo:IAO_0000116 "paroxysmal atrial fibrillation") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1030011) coho:COHO_0002227)
ClassAssertion(Annotation(rdfs:comment "So far 2220 cases of pancreatic adenocarcinoma, a smaller number of cases of endocrine pancreatic tumours (n=86), chronic pancreatitis (n=272) and 3847 healthy controls have been collected.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23206934+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic pancreatitis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005003) coho:COHO_0002229)
ClassAssertion(Annotation(rdfs:comment "So far 2220 cases of pancreatic adenocarcinoma, a smaller number of cases of endocrine pancreatic tumours (n=86), chronic pancreatitis (n=272) and 3847 healthy controls have been collected.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23206934+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "endocrine pancreatic tumours") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005815) coho:COHO_0002229)
ClassAssertion(Annotation(rdfs:comment "So far 2220 cases of pancreatic adenocarcinoma, a smaller number of cases of endocrine pancreatic tumours (n=86), chronic pancreatitis (n=272) and 3847 healthy controls have been collected.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23206934+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "pancreatic adenocarcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006047) coho:COHO_0002229)
ClassAssertion(Annotation(rdfs:comment "Briefly, subject recruitment took place between 1992 and 1995 at five general university hospitals in eastern Spain, where 602 patients with biliopancreatic diseases, including 185 incident cases of PDAC, were prospectively identified.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7689512/") Annotation(obo:IAO_0000116 "pancreatic ductal adenocarcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005184) coho:COHO_0002230)
ClassAssertion(Annotation(rdfs:comment "They were recruited for having an LDL-cholesterol concentration ≥3.5 mmol/L (>135 mg/dL) or a history of myocardial infarction, stroke, or coronary revascularization regardless of their baseline LDL-cholesterol.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0004995) coho:COHO_0002231)
ClassAssertion(Annotation(rdfs:comment "Potential PD patients in this cohort were first identified from self-reports in its follow-up survey in 2004–2006, and then were confirmed either by their treating physicians or by medical record review.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3172377/unicode") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002232)
ClassAssertion(Annotation(rdfs:comment "All participants were derived from the Norwegian ParkWest project, a population-based longitudinal study of the incidence, neurobiology and prognosis of PD.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5302042/fullTextXML") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002234)
ClassAssertion(Annotation(rdfs:comment "The aim of the longitudinal PARTAGE study was to determine the predictive value of blood pressure (BP) and pulse pressure amplification, a marker of arterial function, for overall mortality (primary endpoint) and major cardiovascular (CV) events, in subjects older than 80 years of age living in a nursing home.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22999729+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0002235)
ClassAssertion(Annotation(rdfs:comment "Between 2008 and 2017, Canary PASS prospectively enrolled 1,455 patients with clinically localized prostate cancer (cT1-cT2 and Gleason Grade 1–2) to undergo AS at 1 of 10 national sites81.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11821537/fullTextXML") Annotation(obo:IAO_0000116 "clinically localized prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002236)
ClassAssertion(Annotation(rdfs:comment "Eligibility includes any woman diagnosed with invasive breast cancer within KPNC, no previous diagnosis of other invasive cancer, age 21 years or older, and ability to speak English, Spanish, Cantonese, or Mandarin.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2581640/") Annotation(obo:IAO_0000116 "invasive breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006256) coho:COHO_0002237)
ClassAssertion(Annotation(rdfs:comment "PCaP is a population-based cohort of incident prostate cancer cases from North Carolina (NC) and Louisiana (LA) collected from 2004 to 2009 designed to examine prostate cancer populations from two states with variable prostate cancer incidence and study the racial disparities associated with the disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11377453/fullTextXML") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002238)
ClassAssertion(Annotation(rdfs:comment "The PCBP study is a nationwide case-control study conducted in Barbados, West Indies between July, 2002 and January, 2011.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3551989/") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002239)
ClassAssertion(Annotation(rdfs:comment "PCMUS Prostate Cancer study Medical University Sofia Sofia Bulgaria Case-control - Sofia, Bulgaria Radka Kaneva, Vanio Mitev, Chavdar Slavov European 195 90 192 89 Patients of Clinic of Urology, Alexandrovska University Hospital, Sofia, Bulgaria, PrCa histopathologically confirmed") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002240)
ClassAssertion(Annotation(rdfs:comment "The foundation of this risk-modeling program, the PCPT, was designed to establish whether finasteride, a 5α-reductase type II inhibitor, prevents prostate cancer.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3058741/") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0008315) coho:COHO_0002241)
ClassAssertion(Annotation(rdfs:comment "The Pathobiological Determinants of Atherosclerosis in Youth (PDAY) study is a bi-racial investigation of the development and progression of atherosclerosis involving 3013 individuals aged 15–34 who underwent autopsy within 48 h following death from external causes including accidents, homicides, and suicide [9].") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3272499/") Annotation(obo:IAO_0000116 "atherosclerosis") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005311) coho:COHO_0002242)
ClassAssertion(Annotation(rdfs:comment "Subjects with PD (n=1031) were recruited through the French network for the study of Parkinson's disease genetics associating 15 university hospitals across France.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3646288/unicode") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002243)
ClassAssertion(Annotation(rdfs:comment "Eligible cases were diagnosed with incident pathologically confirmed endometrial cancer.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3431573/") Annotation(obo:IAO_0000116 "endometrial cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0011962) coho:COHO_0002245)
ClassAssertion(Annotation(rdfs:comment "We randomly assigned, in a double-blind 1:1:1 fashion, 21,162 patients who had had a myocardial infarction 1 to 3 years earlier to ticagrelor at a dose of 90 mg twice daily, ticagrelor at a dose of 60 mg twice daily, or placebo.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25773268+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "myocardial infarction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005068) coho:COHO_0002246)
ClassAssertion(Annotation(rdfs:comment "Women were invited to participate if they had a diagnosis of invasive breast cancer in 2010 or later and were between 21 and 79 years of age when diagnosed.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10013058/fullTextXML") Annotation(obo:IAO_0000116 "invasive breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006256) coho:COHO_0002248)
ClassAssertion(Annotation(rdfs:comment "A total of 836 unrelated asthma cases and 574 non-asthmatic controls were recruited from the Social Security Clinic and outpatient health centers in Cartagena from 2002 to 2005.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf") Annotation(obo:IAO_0000116 "asthma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004979) coho:COHO_0002249)
ClassAssertion(Annotation(rdfs:comment "Unlike previous studies that focused primarily on sporadic PD, we have performed the first genomewide association study (GWAS) in familial PD.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18985386+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "familial Parkinson disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0002250)
ClassAssertion(Annotation(rdfs:comment "Briefly, PhACS was a UK 16-site prospective observational study between 2008 and 2013 that recruited 1470 patients hospitalised with an NSTE-ACS.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7687685/fullTextXML") Annotation(obo:IAO_0000116 "non-ST elevation acute coronary syndrome") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005542) coho:COHO_0002251)
ClassAssertion(Annotation(rdfs:comment "Men and women aged 70-82 years were recruited if they had pre-existing vascular disease or were at increased risk of such disease because of smoking, hypertension, or diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3207930/fullTextXML") Annotation(obo:IAO_0000116 "vascular disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005385) coho:COHO_0002252)
ClassAssertion(Annotation(rdfs:comment "We combined genome-wide association data from 12 cohorts of individuals with epilepsy and controls from population-based datasets.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25087078+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "epilepsy") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005027) coho:COHO_0002255)
ClassAssertion(Annotation(rdfs:comment "Eligibility in CIMBA is restricted to females aged 18 years or older with pathogenic variants in BRCA1 or BRCA2.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5612337/") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0007254) coho:COHO_0002256)
