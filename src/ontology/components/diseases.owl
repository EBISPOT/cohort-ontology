ClassAssertion(Annotation(rdfs:comment "The Cambridgeshire case-control study is a population-based study of T2D cases, aged 45–76 y, and age- and sex-matched controls.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3201934/fullTextXML") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0001575)
