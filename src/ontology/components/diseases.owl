ClassAssertion(Annotation(rdfs:comment "Inclusion criteria were (1) confirmed or suspected diagnosis of schizophrenia or schizoaffective disorder according to DSM-IV and (2) at least some ability to cooperate.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002316/fullTextXML") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0001822)
