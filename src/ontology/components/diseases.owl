ClassAssertion(Annotation(rdfs:comment "Within the beatAML cohort 39 , a bone marrow sample and a paired skin sample were taken from 261 AML patients.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8355079/fullTextXML") Annotation(obo:IAO_0000116 "acute myeloid leukaemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0018874) coho:COHO_0000222)
ClassAssertion(Annotation(rdfs:comment "This 2-year study involves the consortium of 9 cooperating Belgian NGS laboratories and will enroll 936 metastatic or locally advanced cancer patients coming from 13 different Belgian hospitals and cancer centers.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS50000000478") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004992) coho:COHO_0000223)
