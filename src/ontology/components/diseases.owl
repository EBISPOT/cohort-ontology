ClassAssertion(Annotation(rdfs:comment "DN cohort recruited 2080 outpatient participants with T2D from the diabetes centre (Chinese N = 1309, Malay = 411, Asian Indian = 360) in a regional hospital between March 2004 and December 2015 with the primary aim to study the development and progression of DN and the secondary aim to study the major cardiovascular diseases (CVD) in T2D patients.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6542096/fullTextXML") Annotation(obo:IAO_0000116 "diabetic nephropathy") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005016) coho:COHO_0000407)
ClassAssertion(Annotation(rdfs:comment "DN cohort recruited 2080 outpatient participants with T2D from the diabetes centre (Chinese N = 1309, Malay = 411, Asian Indian = 360) in a regional hospital between March 2004 and December 2015 with the primary aim to study the development and progression of DN and the secondary aim to study the major cardiovascular diseases (CVD) in T2D patients.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6542096/fullTextXML") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000407)
ClassAssertion(Annotation(rdfs:comment "A total of 2258 patients with type 2 diabetes mellitus (T2DM) were recruited at baseline.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38059349+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes mellitus") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000408)
ClassAssertion(Annotation(rdfs:comment "The Netherlands Epidemiology of Obesity (NEO) study is designed to investigate the pathways that lead to obesity-related diseases and conditions in a population-based prospective cohort study of individuals aged 45–65 years, with an oversampling of individuals with overweight or obesity.") Annotation(oboInOwl:hasDbXref "https://link.springer.com/article/10.1007/s10654-013-9801-3") Annotation(obo:IAO_0000116 "obesity") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0011122) coho:COHO_0000412)
ClassAssertion(Annotation(rdfs:comment "The Wisconsin Registry for Alzheimer's Prevention is a longitudinal observational cohort study enriched with persons with a parental history (PH) of probable Alzheimer's disease (AD) dementia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29322089+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0004975) coho:COHO_0000413)
ClassAssertion(Annotation(rdfs:comment "The WADRC, previously described92, is a longitudinal cohort study of memory, aging, and AD in middle and older-aged adults who were recruited into one of six subgroups: (1) mild late-onset AD; (2) mild cognitive impairment (MCI); (3) age-matched healthy older controls (age > 65); (4) middle-aged adults with a positive parental history of AD; (5) middle-aged adults with a negative parental history of AD; and (6) middle-aged adults with indeterminate parental history of AD.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7803963/fullTextXML") Annotation(obo:IAO_0000116 "mild cognitive impairment") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002039) coho:COHO_0000414)
