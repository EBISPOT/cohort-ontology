ClassAssertion(Annotation(rdfs:comment "The Edinburgh Osteoporosis Study (EDOS) consists of a clinical referral population of patients assessed for evaluation of osteoporosis in Edinburgh, United Kingdom.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4102322/") Annotation(obo:IAO_0000116 "osteoporosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005298) coho:COHO_0001680)
