ClassAssertion(Annotation(rdfs:comment "Currently published GWASs include eight Europe-originated psoriasis-associated GWAS cohorts, including CASP [7], Kiel [8], Genizon [8], PsA GWAS [9], WTCCC2 [10], Exomechip [11], PAGE [12], and GAPC [12], two South Asia-originated psoriasis-associated GWAS cohort including three batches [13], and one East Asia-originated psoriasis-associated GWAS cohort [14].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11783861/fullTextXML") Annotation(obo:IAO_0000116 "psoriasis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005083) coho:COHO_0001174)
