ClassAssertion(Annotation(rdfs:comment "The biospecimens of the GUB, including blood samples for DNA extraction, were obtained from the patients attending clinics for the suspicion, diagnosis and/or treatment of a genito-urinary tumor (prostate, kidney, bladder, testis, penis) within the Genito-Urinary Oncology division of The Princess Margaret’s Hospital.") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S2210776226000724-mmc1.docx") Annotation(obo:IAO_0000116 "genito-urinary tumor") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0007379) coho:COHO_0000683)
