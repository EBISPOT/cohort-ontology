ClassAssertion(Annotation(rdfs:comment "Between 1981 and 2000, 6609 children (<18 years of age) were treated in five consecutive trials of the Berlin-Frankfurt-Münster (BFM) study group for childhood acute lymphoblastic leukemia (ALL).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20010625+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "acute lymphoblastic leukemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004967) coho:COHO_0000017)
ClassAssertion(Annotation(rdfs:comment "The BCPP is a prospective longitudinal cohort study of all patients with newly diagnosed bladder cancer within the West Midlands (UK), investigating the influence of lifestyle factors on recurrence and progression, health-related quality of life, the predictive effect of a panel of molecular markers on recurrence or progression, and the establishment of Europe's largest comprehensive bladder cancer bio-repository.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19751260+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "bladder cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001187) coho:COHO_0000018)
ClassAssertion(Annotation(rdfs:comment "The sample comprised 45 babies (26 males aged mean ± SD 25.50 ± 7.17 months; 19 females aged mean ± SD 24.79 ± 6.73 months), 44 with confirmed Zika-associated congenital microcephaly and one baby with familial congenital microcephaly.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7578642/fullTextXML") Annotation(obo:IAO_0000116 "congenital microcephaly") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0011451) coho:COHO_0000019)
