ClassAssertion(Annotation(rdfs:comment "The individuals with ischemic stroke were recruited from seven hospitals in Fukuoka Prefecture, Japan (Kyushu University Hospital, Hakujyuji Hospital, Fukuoka Red Cross Hospital, Kyushu Medical Center, Imazu Red Cross Hospital, Fukuoka Higashi Medical Center, and Seiai Rehabilitation Hospital) in 2004 (The Fukuoka Stroke Registry [FSR]) .") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "ischemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0000684)
ClassAssertion(Annotation(rdfs:comment "International Genomics of Alzheimer's Project (IGAP) is a large study that used genotyped and imputed data on 7,055,881 single nucleotide polymorphisms (SNPs) to meta‐analyze four previously published GWAS datasets consisting of 17,008 AD cases and 37,154 controls") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6001515/fullTextXML") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0000685)
ClassAssertion(Annotation(rdfs:comment "Family members of probands with documented coronary artery disease were recruited from the Los Angeles area.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(obo:IAO_0000116 "coronary artery disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005010) coho:COHO_0000686)
ClassAssertion(Annotation(rdfs:comment "We assembled the GUARDIAN Consortium to address knowledge gaps concerning the increased risk of T2D observed in Mexican Americans compared to European populations.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005148) coho:COHO_0000687)
ClassAssertion(Annotation(rdfs:comment "The METASTROKE collaboration brings together GWAS data from more than 12 000 cases of ischaemic stroke and 60 000 controls from 15 cohorts all of European ancestry.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3490334/fullTextXML") Annotation(obo:IAO_0000116 "ischaemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0000688)
