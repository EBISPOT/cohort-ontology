ClassAssertion(Annotation(rdfs:comment "Risk Assessment of Cerebrovascular Events (RACE) is an on-going existing case-control study of stroke now involving over 5000 imaging confirmed cases of stroke and 5000 controls, recruited from seven centers in Pakistan.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000456.v1.p1") Annotation(obo:IAO_0000116 "stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005098) coho:COHO_0000691)
ClassAssertion(Annotation(rdfs:comment "The REGARDS study is one of the largest ongoing prospective population-based studies in the U.S. and was designed to measure stroke incidence and associated risk factors in AA and European-Americans adults ≥45 years of age (8).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9554233/fullTextXML") Annotation(obo:IAO_0000116 "stroke") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005098) coho:COHO_0000692)
ClassAssertion(Annotation(rdfs:comment "The Selenium and Vitamin E Cancer Prevention Trial (SELECT) was conducted to assess the efficacy of selenium and vitamin E alone, and in combination, on the incidence of prostate cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23552052+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0008315) coho:COHO_0000693)
ClassAssertion(Annotation(rdfs:comment "The SIFAP study is a multicenter study carried out to determine the frequency of Fabry disease in an unselected group of young adult patients with acute cerebrovascular events defined as having had an acute ischemic stroke or transient ischemic attack less than three months before enrollment into the study.") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "transient ischemic attack") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005264) coho:COHO_0000694)
ClassAssertion(Annotation(rdfs:comment "The SIFAP study is a multicenter study carried out to determine the frequency of Fabry disease in an unselected group of young adult patients with acute cerebrovascular events defined as having had an acute ischemic stroke or transient ischemic attack less than three months before enrollment into the study.") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "ischemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0000694)
ClassAssertion(Annotation(rdfs:comment "This study was undertaken to increase understanding of environmental risk factors for posttraumatic stress disorder (PTSD) and major depressive disorder (MDD) within an urban, impoverished, population.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19892208+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "major depressive disorder") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0002009) coho:COHO_0000697)
ClassAssertion(Annotation(rdfs:comment "This study was undertaken to increase understanding of environmental risk factors for posttraumatic stress disorder (PTSD) and major depressive disorder (MDD) within an urban, impoverished, population.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19892208+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "posttraumatic stress disorder") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005146) coho:COHO_0000697)
ClassAssertion(Annotation(rdfs:comment "We examined 4 SNPs located on genes previously associated to dyslexia (KIAA0319, DCDC2, DYX1C1 and FOXP2) and 3 SNPs within genes related to ADHD (COMT, MAOA and DBH) in a cohort of Spanish children (N = 2078) that met the criteria of having one, both or none of these disorders (dyslexia and ADHD).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(obo:IAO_0000116 "dyslexia") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005489) coho:COHO_0000702)
ClassAssertion(Annotation(rdfs:comment "We examined 4 SNPs located on genes previously associated to dyslexia (KIAA0319, DCDC2, DYX1C1 and FOXP2) and 3 SNPs within genes related to ADHD (COMT, MAOA and DBH) in a cohort of Spanish children (N = 2078) that met the criteria of having one, both or none of these disorders (dyslexia and ADHD).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6209299/fullTextXML") Annotation(obo:IAO_0000116 "attention deficit hyperactivity disorder") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0007743) coho:COHO_0000702)
ClassAssertion(Annotation(rdfs:comment "To address this question, we studied 2,152 first-degree relatives of patients with NIDDM (FH+) and 528 age- and weight-matched spouses without a family history of NIDDM (FH-) in Western Finland (the Botnia study).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8866565+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005148) coho:COHO_0000703)
ClassAssertion(Annotation(rdfs:comment "The other two were family-based samples selected for dyslexia: one from the United Kingdom (UKdys), n = 930 (595 families); the other from the United States (Colorado Learning Disabilities Research Center, CLDRC), n = 717 (336 families)92.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9649434/fullTextXML") Annotation(obo:IAO_0000116 "dyslexia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005489) coho:COHO_0000704)
ClassAssertion(Annotation(rdfs:comment "A total of 550 subjects with increased risk of type 2 diabetes were investigated; they underwent a 75-g oral glucose tolerance test, repeated after 3 years.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16801592+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005148) coho:COHO_0000705)
ClassAssertion(Annotation(rdfs:comment "ECLIPSE plans to recruit 2,180 COPD subjects in Global Initiative for Chronic Obstructive Lung Disease categories II-IV and 343 smoking and 223 nonsmoking control subjects.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18216052+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic obstructive pulmonary disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005002) coho:COHO_0000706)
ClassAssertion(Annotation(rdfs:comment "We analyzed the natural course of atopic diseases and the role of life-style, environmental, and genetic factors for disease onset, intermediate phenotypes, and genes involved in detoxification and oxidative stress.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30402607+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atopic diseases") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005202) coho:COHO_0000708)
ClassAssertion(Annotation(rdfs:comment "From two large Danish cohorts we selected all extremely overweight young men and women (n = 2,633), and equal numbers of population-based controls (n = 2,740, drawn randomly from the same populations as the extremes, representing ∼212,000 individuals).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21935397+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "obesity") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0011122) coho:COHO_0000710)
