ClassAssertion(Annotation(rdfs:comment "Atopic dermatitis patients were recruited from tertiary dermatology clinics based at three centers (Technische Universität München, as part of the GENEVA study, University of Kiel, University of Bonn) and diagnosed on the basis of skin examination by experienced dermatologists according to standard criteria 31 .") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3985/MediaObjects/41588_2017_BFng3985_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "atopic dermatitis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004980) coho:COHO_0001783)
ClassAssertion(Annotation(rdfs:comment "The Dental Caries: GENEVA Genome Wide Association Study (Caries GENEVA Study) is a multi-site collaboration that is part of the GENEVA consortium (www.genevastudy.org).") Annotation(oboInOwl:hasDbXref "https://www.downstate.edu/research/centers-departments/henri-begleiter-neurodynamics-laboratory/_documents/2012-Hartz-IncreasedgeneticvulnerabilitytosmokingatCHRNA5inearly-onsetsmokers-Supplement.pdf") Annotation(obo:IAO_0000116 "dental caries") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005276) coho:COHO_0001784)
