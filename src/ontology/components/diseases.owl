ClassAssertion(Annotation(rdfs:comment "Through collaborative efforts across North America, Europe and Australia, we established the International FTLD-TDP WGS Consortium and identified 1,154 unrelated patients with a pathologically confirmed diagnosis of FTLD-TDP and a source of DNA available for basic genetic characterization (Table 1).") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6533145/unicode") Annotation(obo:IAO_0000116 "frontotemporal lobar degeneration with TDP-43 inclusions") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0700038) coho:COHO_0001006)
ClassAssertion(Annotation(rdfs:comment "To identify susceptibility genes for familial lung cancer, we conducted a genomewide linkage analysis of 52 extended pedigrees ascertained through probands with lung cancer who had several first-degree relatives with the same disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15272417+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008903) coho:COHO_0001007)
ClassAssertion(Annotation(rdfs:comment "GenHAT is an ancillary study of the Antihypertensive and Lipid Lowering Treatment to Prevent Heart Attack Trial, ALLHAT, a double-blind, randomized trial of 42 418 hypertensives, 55 years of age or older, with systolic or diastolic hypertension and one or more risk factors for cardiovascular disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12439737+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "hypertension") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005044) coho:COHO_0001008)
ClassAssertion(Annotation(rdfs:comment "We conducted a genome-wide association study (GWAS) in a homogenous case-control cohort from Bergen, Norway (823 COPD cases and 810 smoking controls) and evaluated the top 100 single nucleotide polymorphisms (SNPs) in the family-based International COPD Genetics Network (ICGN; 1891 Caucasian individuals from 606 pedigrees) study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19300482+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic obstructive pulmonary disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005002) coho:COHO_0001009)
