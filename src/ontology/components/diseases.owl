ClassAssertion(Annotation(rdfs:comment "Here, we investigated the complexity of B and T cell receptor (BCR and TCR) repertoires, reflecting antigen-specific immune response, in the context of two phase III trials, namely NeoALTTO and CALGB 40601, evaluating neoadjuvant paclitaxel with trastuzumab and/or lapatinib in women affected by HER2-positive breast cancer.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001007563") Annotation(obo:IAO_0000116 "HER2-positive breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006244) coho:COHO_0000227)
ClassAssertion(Annotation(rdfs:comment "In this study, we prospectively enrolled patients with iSGS, trauma-induced subglottic stenosis, and controls to investigate the clinical, transcriptional, and genetic features that may be associated with disease pathogenesis and treatment outcomes.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS50000000879") Annotation(obo:IAO_0000116 "trauma-induced subglottic stenosis") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0001607) coho:COHO_0000229)
