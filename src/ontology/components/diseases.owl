ClassAssertion(Annotation(rdfs:comment "We combined three existing GWAS datasets (hereafter referred to as Kiel3, CASP4 and WTCCC25) with two independent European-descent case-control datasets genotyped on the Immunochip: the Psoriasis Association Genetics Extension (PAGE: 3,580 cases and 5,902 controls) and the Genetic Analysis of Psoriasis Consortium (GAPC: 2,997 cases and 9,183 controls)") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML") Annotation(obo:IAO_0000116 "psoriasis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005083) coho:COHO_0001332)
