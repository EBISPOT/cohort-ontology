ClassAssertion(Annotation(rdfs:comment "The DRIVE data included under this dbGAP submission include OncoArray data from 60,015 breast cancer cases and controls genotyped at the Center for Inherited Disease Research (CIDR), University of Cambridge, National Cancer Institute, University of Copenhagen, University of Southern California and Mayo Clinic.") Annotation(oboInOwl:hasDbXref "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001265/phs001265.v1.p1/GapExchange_phs001265.v1.p1.xml") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001003)
