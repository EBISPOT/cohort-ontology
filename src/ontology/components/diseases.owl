ClassAssertion(Annotation(rdfs:comment "The GRaD study is a multisite, case–control study of RD in minority youth across the USA, Canada and Puerto Rico.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6678051/fullTextXML") Annotation(obo:IAO_0000116 "dyslexia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005489) coho:COHO_0001012)
ClassAssertion(Annotation(rdfs:comment "It must be noted that the UK GRID cohort included only those individuals with type 1 diabetes, and as such, in this study we do not have access to a population without type 1 diabetes for comparison of C-peptide levels.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9233242/fullTextXML") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005147) coho:COHO_0001013)
ClassAssertion(Annotation(rdfs:comment "The HCMR (Hypertrophic Cardiomyopathy Registry) is a National Heart, Lung, and Blood Institute-funded, prospective registry of 2,755 patients with hypertrophic cardiomyopathy (HCM) recruited from 44 sites in 6 countries.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31699273+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "hypertrophic cardiomyopathy") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005045) coho:COHO_0001014)
ClassAssertion(Annotation(rdfs:comment "The Hypertension-Insulin Resistance Family Study (HTN-IR) was designed as a family study to examine the genetic basis of hypertension and insulin resistance.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(obo:IAO_0000116 "insulin resistance") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:HP_0000855) coho:COHO_0001015)
ClassAssertion(Annotation(rdfs:comment "The Hypertension-Insulin Resistance Family Study (HTN-IR) was designed as a family study to examine the genetic basis of hypertension and insulin resistance.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") Annotation(obo:IAO_0000116 "hypertension") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005044) coho:COHO_0001015)
ClassAssertion(Annotation(rdfs:comment "Advanced age-related macular degeneration (AMD) is the leading cause of blindness in the elderly, with limited therapeutic options. Here we report on a study of >12 million variants, including 163,714 directly genotyped, mostly rare, protein-altering variants. Analyzing 16,144 patients and 17,832 controls, we identify 52 independently associated common and rare variants (P < 5 × 10(-8)) distributed across 34 loci.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26691988+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "age-related macular degeneration") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005150) coho:COHO_0001016)
ClassAssertion(Annotation(rdfs:comment "We report a genome-wide association study of this condition that meta-analyzed data from six studies that enrolled individuals of European ancestry. Case subjects were ascertained by neurologists blinded to genotype data and classified as lobar or nonlobar based on brain computed tomography. ICH-free control subjects were sampled from ambulatory clinics or random digit dialing.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24656865+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "intracerebral hemorrhage") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0013792) coho:COHO_0001017)
ClassAssertion(Annotation(rdfs:comment "We conducted a genome-wide association (GWA) study of lung cancer comparing 511,919 SNP genotypes in 1,952 cases and 1,438 controls.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18978787+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008903) coho:COHO_0001018)
ClassAssertion(Annotation(rdfs:comment "We tested the hypotheses that rural-to-urban migrants have a higher prevalence of obesity and diabetes than rural nonmigrants, that migrants would have an intermediate prevalence of obesity and diabetes compared with life-long urban and rural dwellers, and that longer time since migration would be associated with a higher prevalence of obesity and of diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20436961+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005015) coho:COHO_0001019)
ClassAssertion(Annotation(rdfs:comment "We tested the hypotheses that rural-to-urban migrants have a higher prevalence of obesity and diabetes than rural nonmigrants, that migrants would have an intermediate prevalence of obesity and diabetes compared with life-long urban and rural dwellers, and that longer time since migration would be associated with a higher prevalence of obesity and of diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20436961+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "obesity") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0011122) coho:COHO_0001019)
ClassAssertion(Annotation(rdfs:comment "The IORRA cohort is a registry of patients with RA at Tokyo Women’s Medical University.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13249915/fullTextXML") Annotation(obo:IAO_0000116 "rheumatoid arthritis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008383) coho:COHO_0001020)
