ClassAssertion(Annotation(rdfs:comment "We enrolled 782 patients through hospitals in Phoenix, Arizona; Boston; and Pittsburgh; 489 had histologically confirmed glioma, 197 had meningioma, and 96 had acoustic neuroma. The 799 controls were patients admitted to the same hospitals as the patients with brain tumors for a variety of nonmalignant conditions.") Annotation(oboInOwl:hasDbXref "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=11150357&retmode=xml") Annotation(obo:IAO_0000116 "glioma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0021042) coho:COHO_0002721)
ClassAssertion(Annotation(rdfs:comment "Carriers of pathogenic variants (mutations) in the BRCA1 and BRCA2 genes are at very high risk of developing breast cancer (BC) and ovarian cancer.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7611162/") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0007254) coho:COHO_0002722)
