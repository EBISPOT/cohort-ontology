ClassAssertion(Annotation(rdfs:comment "The participants were from the Georgia Stress and Heart (GSH) study, an ongoing longitudinal study designed to evaluate the development of cardiovascular risk factors from childhood to adulthood") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6355367/unicode") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000910)
