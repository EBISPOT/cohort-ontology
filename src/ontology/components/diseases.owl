ClassAssertion(Annotation(rdfs:comment "We describe a joint GWA study (using the Affymetrix GeneChip 500K Mapping Array Set) undertaken in the British population, which has examined approximately 2,000 individuals for each of 7 major diseases and a shared set of approximately 3,000 controls.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17554300+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "tuberculosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0018076) coho:COHO_0000182)
ClassAssertion(Annotation(rdfs:comment "Basque-colon cohort included 873 participants with colon cancer, biobanked between 2009- 2019. Participants were diagnosed and/or treated according to usual clinical practice in the Donostia University Hospital, San Sebastian, Spain, including follow-up to this date.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "colon cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0021063) coho:COHO_0000183)
ClassAssertion(Annotation(rdfs:comment "Here, using low-coverage whole-genome sequencing of 5,303 Chinese women with recurrent MDD selected to reduce phenotypic heterogeneity, and 5,337 controls screened to exclude MDD, we identified, and subsequently replicated in an independent sample, two loci contributing to risk of MDD on chromosome 10") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26176920+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "major depressive disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002009) coho:COHO_0000185)
ClassAssertion(Annotation(rdfs:comment "CAS consisted of 1,010 cases of CAD and 3,998 controls. 1,010 cases from the Northern provinces in China were enrolled from Fuwai Hospital, National Center of Cardiovascular Diseases. 83.8% of cases have a family history of CAD.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3927410/unicode") Annotation(obo:IAO_0000116 "coronary artery disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0000187)
ClassAssertion(Annotation(rdfs:comment "The carriers of the genotype DQB1*02/DQB1*03:02 or DQB1*03:02/x genotypes (here x≠ DQB1*02, DQB1*03:01, DQB1*06:02, or DQB1*06:03 alleles) were categorized into the T1D risk group and recruited for the DIPP follow up program.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6045612/fullTextXML") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005147) coho:COHO_0000188)
ClassAssertion(Annotation(rdfs:comment "This study investigated the association of clinical, demographic, and genetic factors with severe coronary artery stenosis phenotypes in our population composed of 1734 individuals with severe coronary stenosis (≥ 50% in coronary vessels) and comparing them to 757 controls with no evidence of stenosis on angiography.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33766035+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "coronary artery disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0000189)
ClassAssertion(Annotation(rdfs:comment "The German Chronic Kidney Disease (GCKD) study is a prospective observational national cohort study. It aims to enrol a total of 5000 patients with CKD of various aetiologies, who are under nephrological care, and to follow them for up to 10 years.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21862458+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic kidney disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005300) coho:COHO_0000190)
ClassAssertion(Annotation(rdfs:comment "GRACE (the Global Registry of Acute Coronary Events) is a large, prospective, multinational observational study of patients hospitalized with ACS.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11174331+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "acute coronary syndromes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005542) coho:COHO_0000192)
ClassAssertion(Annotation(rdfs:comment "ULSAM started as a health investigation, focused at identifying metabolic risk factors for cardiovascular disease, to which all 50 year-old men living in Uppsala in 1970 were invited.") Annotation(oboInOwl:hasDbXref "https://www.uu.se/en/research/ulsam") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000194)
ClassAssertion(Annotation(rdfs:comment "Adults attending one of 20 UK hospitals and who had been diagnosed with ALS by two consultant neurologists were invited to participate in the UK National DNA Bank for Motor Neuron Disease Research (MND DNA bank), a national collection of ALS DNA samples derived from whole blood.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3257853/fullTextXML") Annotation(obo:IAO_0000116 "amyotrophic lateral sclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004976) coho:COHO_0000196)
ClassAssertion(Annotation(rdfs:comment "The diabetic cohort (DC) was set up to study the determinants of complications in individuals with type 2 diabetes and examine the role of genetic, physiological and lifestyle factors in the development of complications in these individuals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32474429+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000197)
ClassAssertion(Annotation(rdfs:comment "The Ely study, established in 1990, is a prospective study of the etiology of type 2 diabetes, as described in detail elsewhere (18, 19).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10348471/fullTextXML") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005148) coho:COHO_0000198)
ClassAssertion(Annotation(rdfs:comment "A total of 436 Peruvian children (aged 9-19 years) with asthma and 291 without asthma were genotyped by using the Illumina Multi-Ethnic Global Array.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33713768+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "asthma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004979) coho:COHO_0000199)
ClassAssertion(Annotation(rdfs:comment "The Parkinson's Progression Markers Initiative (PPMI) is an observational, international study designed to establish biomarker-defined cohorts and identify clinical, imaging, genetic, and biospecimen Parkinson's disease (PD) progression markers to accelerate disease-modifying therapeutic trials.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30564614+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0000200)
ClassAssertion(Annotation(rdfs:comment "1239 cases with schizophrenia, schizoaffective disorder, or psychotic bipolar disorder; 857 of their unaffected relatives, and 2739 healthy controls were genotyped with the Affymetrix 6.0 single nucleotide polymorphism (SNP) array.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23871474+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "psychotic bipolar disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004985) coho:COHO_0000201)
ClassAssertion(Annotation(rdfs:comment "1239 cases with schizophrenia, schizoaffective disorder, or psychotic bipolar disorder; 857 of their unaffected relatives, and 2739 healthy controls were genotyped with the Affymetrix 6.0 single nucleotide polymorphism (SNP) array.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23871474+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0000201)
