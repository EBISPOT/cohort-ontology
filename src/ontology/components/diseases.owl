ClassAssertion(Annotation(rdfs:comment "The CSDC is a harmonized collection of merged small datasets (comprising the existing datasets of BIOCARD, CHAP2, EAS, RMAYO, ROSMAP2, and WASHU2) used in common variant analyses to deal with small case and control counts within the individual studies.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0001070)
