ClassAssertion(Annotation(rdfs:comment "This prospective cohort study, “Prospective Imaging Study of Ageing: Genes, Brain and Behaviour” (PISA) seeks to characterise the phenotype and natural history of healthy adult Australians at high future risk of Alzheimer’s disease (AD).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7750170/fullTextXML") Annotation(obo:IAO_0000116 "Alzheimer's disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0004975) coho:COHO_0002260)
