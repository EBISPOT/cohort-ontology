ClassAssertion(Annotation(rdfs:comment "The prevalence of extremely rare variants in the combined childhood AML cohort (n=72) was compared to that in the Medical Genome Reference Bank (MGRB; n=2570) comprising individuals aged at least 70 years with no history of cardiovascular disease, dementia or cancer.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001006276") Annotation(obo:IAO_0000116 "acute myeloid leukaemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0018874) coho:COHO_0000220)
