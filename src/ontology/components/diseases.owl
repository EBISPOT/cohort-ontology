ClassAssertion(Annotation(rdfs:comment "A cohort of Caribbean Hispanics with familial LOAD was recruited in a different study at the Taub Institute for Research on Alzheimer’s Disease and the Aging Brain in New York and from clinics in the Dominican Republic as part of the EFIGA study.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4000602/unicode") Annotation(obo:IAO_0000116 "late-onset Alzheimer disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0001683)
