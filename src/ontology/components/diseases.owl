ClassAssertion(Annotation(rdfs:comment "Individuals are eligible for inclusion in EMBRACE if they (i) carry a pathogenic mutation in BRCA1 or BRCA2, (ii) are noncarriers in families with a pathogenic BRCA1 or BRCA2 mutation, or (iii) are potential carriers but opt not to undergo a predictive genetic test.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6033314/fullTextXML") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0007254) coho:COHO_0001688)
ClassAssertion(Annotation(rdfs:comment "Individuals are eligible for inclusion in EMBRACE if they (i) carry a pathogenic mutation in BRCA1 or BRCA2, (ii) are noncarriers in families with a pathogenic BRCA1 or BRCA2 mutation, or (iii) are potential carriers but opt not to undergo a predictive genetic test.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6033314/fullTextXML") Annotation(obo:IAO_0000116 "ovarian cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008170) coho:COHO_0001688)
ClassAssertion(Annotation(rdfs:comment "Lymphoid neoplasms (LNs), including non-Hodgkin's lymphoma (NHL), Hodgkin's lymphoma (HL), lymphoproliferative syndrome (LPS) and multiple myeloma (MM), are among the most frequent cancers ( approximately 17,000 new cases per year in France), after those related to smoking.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19058175+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lymphoid neoplasms") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005157) coho:COHO_0001689)
