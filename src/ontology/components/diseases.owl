ClassAssertion(Annotation(rdfs:comment "As part of the NIDA-funded Gene-Environment-Development Initiative (GEDI) our goal is to identify exactly which genes, which environments, and which developmental transitions together predict the development of drug use and misuse.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3609892/") Annotation(obo:IAO_0000116 "drug misuse") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0002491) coho:COHO_0001766)
