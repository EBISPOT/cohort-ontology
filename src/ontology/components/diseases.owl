ClassAssertion(Annotation(rdfs:comment "These encouraging data led Cancer and Leukemia Group B (CALGB) to conduct a double-blind, placebo-controlled, randomized phase III trial of gemcitabine/bevacizumab versus gemcitabine/placebo in advanced pancreatic cancer patients.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20606091+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "advanced pancreatic cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0009831) coho:COHO_0001134)
ClassAssertion(Annotation(rdfs:comment "A randomized, placebo-controlled study based on preclinical and clinical data that supports the potential role of vascular endothelial growth factor in prostate cancer was performed to evaluate the addition of bevacizumab to standard docetaxel and prednisone therapy in patients with metastatic castration-resistant prostate cancer (mCRPC).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22454414+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "metastatic castration-resistant prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004956) coho:COHO_0001135)
ClassAssertion(Annotation(rdfs:comment "Here we present Colonomics (https://www.colonomics.org/), a multi-omics dataset that comprises 100 stage II colon cancer patients from which samples of tumoral tissue (T) and paired normal adjacent tissue (N) were obtained from the surgical specimen.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9526730/unicode") Annotation(obo:IAO_0000116 "colon cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0021063) coho:COHO_0001136)
ClassAssertion(Annotation(rdfs:comment "Women with hormone receptor-positive MBC were randomly assigned 1:1 in a multicenter, open-label, phase III trial of letrozole (2.5 mg orally per day) with or without bevacizumab (15 mg/kg intravenously once every 3 weeks) within strata defined by measurable disease and disease-free interval.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27138575+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "hormone receptor-positive metastatic breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006256) coho:COHO_0001137)
ClassAssertion(Annotation(rdfs:comment "The Age-Related Eye Disease Study (AREDS) was initially conceived as a long-term multicenter, prospective study of the clinical course of age-related macular degeneration (AMD) and age-related cataract.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10588299+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "age-related cataract") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004847) coho:COHO_0001142)
ClassAssertion(Annotation(rdfs:comment "The Age-Related Eye Disease Study (AREDS) was initially conceived as a long-term multicenter, prospective study of the clinical course of age-related macular degeneration (AMD) and age-related cataract.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10588299+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "age-related macular degeneration") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005150) coho:COHO_0001142)
ClassAssertion(Annotation(rdfs:comment "The Age-Related Eye Disease Study 2 (AREDS2), a multicenter, randomized, double-masked, placebo-controlled phase 3 study with a 2 × 2 factorial design, conducted in 2006-2012 and enrolling 4203 participants aged 50 to 85 years at risk for progression to advanced AMD with bilateral large drusen or large drusen in 1 eye and advanced AMD in the fellow eye.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23644932+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "age-related macular degeneration") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005150) coho:COHO_0001143)
ClassAssertion(Annotation(rdfs:comment "The optimal methods to estimate glomerular filtration rate (GFR) and therefore to determine the presence of CKD in SSA are uncertain. We plan to measure iohexol excretion to accurately determine GFR in Malawi, South Africa and Uganda.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31941441+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic kidney disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005300) coho:COHO_0001144)
ClassAssertion(Annotation(rdfs:comment "Between 1989 and 1996, 505 British families with at least two siblings affected by Type 1 diabetes were recruited.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15049939+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005147) coho:COHO_0001146)
ClassAssertion(Annotation(rdfs:comment "The National Cancer Institute Breast and Prostate Cancer Cohort Consortium--a pooled analysis of multiple large cohort studies with a total of more than 5,000 cases of breast cancer and 8,000 cases of prostate cancer--was therefore initiated.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16341085+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0001148)
ClassAssertion(Annotation(rdfs:comment "The National Cancer Institute Breast and Prostate Cancer Cohort Consortium--a pooled analysis of multiple large cohort studies with a total of more than 5,000 cases of breast cancer and 8,000 cases of prostate cancer--was therefore initiated.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16341085+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0001148)
ClassAssertion(Annotation(rdfs:comment "BSTOP is an ongoing prospective observational study of patients with a primary diagnosis of moderate‒severe plaque psoriasis across > 70 UK dermatology centres, which includes biological sample collection.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857016/fullTextXML") Annotation(obo:IAO_0000116 "psoriasis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005083) coho:COHO_0001149)
ClassAssertion(Annotation(rdfs:comment "CACTI was designed to examine the prevalence of subclinical atherosclerosis in adults with type 1 diabetes and a comparable group of controls without any diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3898750/fullTextXML") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005147) coho:COHO_0001151)
ClassAssertion(Annotation(rdfs:comment "CACTI was designed to examine the prevalence of subclinical atherosclerosis in adults with type 1 diabetes and a comparable group of controls without any diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3898750/fullTextXML") Annotation(obo:IAO_0000116 "subclinical atherosclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005311) coho:COHO_0001151)
ClassAssertion(Annotation(rdfs:comment "To identify psoriasis susceptibility loci, we genotyped 438,670 SNPs in 1,409 psoriasis cases and 1,436 controls of European ancestry.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19169254+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "psoriasis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005083) coho:COHO_0001152)
ClassAssertion(Annotation(rdfs:comment "For men of African ancestry, GRS replication was conducted among 1,586 cases and 1,086 controls from California and Uganda (CA UG Study) genotyped with the Illumina H3 Africa array and imputed using Phase 3 of the 1000 Genomes Project15 as the reference panel and Minimac4 on the Michigan Imputation Server27 (Supplementary Table 1 and 2).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8148035/fullTextXML") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0001153)
ClassAssertion(Annotation(rdfs:comment "Cryptosporidiosis is a major cause of childhood diarrhea in low- and middle-income countries and has been linked to impairment of child growth. This study investigated the burden of cryptosporidiosis and its impact on child growth in both a rural and an urban site in Bangladesh.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29897482+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cryptosporidiosis") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0015474) coho:COHO_0001154)
ClassAssertion(Annotation(rdfs:comment "In 1994, the US National Cancer Institute funded the Childhood Cancer Survivor Study, a multi-institutional research initiative designed to establish a large and extensively characterized cohort of more than 14,000 5-year survivors of childhood and adolescent cancer diagnosed between 1970 and 1986.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19364948+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "childhood cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006517) coho:COHO_0001155)
ClassAssertion(Annotation(rdfs:comment "This multicenter, longitudinal, prospective, observational study in 22 countries across Europe and Israel will collect detailed data from 5400 consenting patients, presenting within 24 hours of injury, with a clinical diagnosis of TBI and an indication for computed tomography.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25525693+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "traumatic brain injury") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0858950) coho:COHO_0001156)
ClassAssertion(Annotation(rdfs:comment "The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University)") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/") Annotation(obo:IAO_0000116 "cystic fibrosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0009061) coho:COHO_0001157)
ClassAssertion(Annotation(rdfs:comment "The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University)") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/") Annotation(obo:IAO_0000116 "cystic fibrosis-related diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_7770003) coho:COHO_0001157)
ClassAssertion(Annotation(rdfs:comment "All subjects were part of the CF Twin-Sibling Study (n = 1038 individuals in 575 families) and were recruited from CF centers in the United States (n = 952), Australia (n = 48), Israel (n = 24), and United Kingdom (Scotland)(n = 14) between 2000 and 2013 on the basis of having CF and having a twin or sibling with CF.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4195986/fullTextXML") Annotation(obo:IAO_0000116 "cystic fibrosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0009061) coho:COHO_0001158)
