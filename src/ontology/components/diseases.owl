ClassAssertion(Annotation(rdfs:comment "Extremely low gestational age newborns (ELGANs) are at increased risk for structural and functional brain abnormalities.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19765918+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cerebral palsy") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0006497) coho:COHO_0000068)
