ClassAssertion(Annotation(rdfs:comment "A total of 24 971 black patients with an incident histologically proven (>95%) cancer of any type were enrolled between 1995-2016.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004992) coho:COHO_0000823)
