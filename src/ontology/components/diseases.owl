ClassAssertion(Annotation(rdfs:comment "To investigate this in sickle cell disease (SCD), we performed whole-genome sequencing (WGS) of 722 individuals with hemoglobin HbSS or HbSβ0-thalassemia from Baylor College of Medicine and from the St. Jude Children's Research Hospital Sickle Cell Clinical Research and Intervention Program (SCCRIP) longitudinal cohort study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34283174+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "sickle cell disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0011382) coho:COHO_0001117)
