ClassAssertion(Annotation(rdfs:comment "The GABRIEL Advanced Surveys (GABRIELA) were conducted to determine factors in farming environments which are fundamental to protecting against asthma and atopic disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21819425+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "asthma") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004979) coho:COHO_0000073)
ClassAssertion(Annotation(rdfs:comment "The GABRIEL Advanced Surveys (GABRIELA) were conducted to determine factors in farming environments which are fundamental to protecting against asthma and atopic disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21819425+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atopic disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005202) coho:COHO_0000073)
ClassAssertion(Annotation(rdfs:comment "The GENESIS (GENE SISter) study was designed to identify new breast cancer susceptibility genes in women attending cancer genetics clinics and with no BRCA1/2 mutation.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26758370+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0000075)
ClassAssertion(Annotation(rdfs:comment "We created these data in order to identify genetic variants associated with increased susceptibility to multiple sclerosis. Cases from many parts of the world were genotyped with the Illumina 660 chip along with Swedish controls.") Annotation(oboInOwl:hasDbXref "https://metadata.ega-archive.org/studies/EGAS00000000101") Annotation(obo:IAO_0000116 "multiple sclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005301) coho:COHO_0000076)
ClassAssertion(Annotation(rdfs:comment "In recognition of the need for large-scale sample collections to empower GWAS, we established the Genetic Consortium for Anorexia Nervosa (GCAN) in 2007—a worldwide collaboration combining existing DNA samples of AN patients into a single resource.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4325090/unicode") Annotation(obo:IAO_0000116 "anorexia nervosa") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005351) coho:COHO_0000077)
ClassAssertion(Annotation(rdfs:comment "In this study, we evaluated the interplay between the plasma metabolome and transcriptome as it relates to total IgE levels among children with asthma from two independent cohorts: 1) the Childhood Asthma Management Program (CAMP) cohort 14 (N=564); and 2) the Genetic Epidemiology of Asthma in Costa Rica Study (GACRS) 15 (N=309).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11178010/") Annotation(obo:IAO_0000116 "asthma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004979) coho:COHO_0000078)
ClassAssertion(Annotation(rdfs:comment "The Genetic Overlap between Metabolic and Psychiatric Diseases (GOMAP) study comprises samples from four patient groups: 964 schizophrenia samples, 921 type 2 diabetes patients, 582 patients with comorbid schizophrenia and type 2 diabetes and 280 samples with another psychiatric diagnosis.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001002723") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0000079)
ClassAssertion(Annotation(rdfs:comment "The Genetic Overlap between Metabolic and Psychiatric Diseases (GOMAP) study comprises samples from four patient groups: 964 schizophrenia samples, 921 type 2 diabetes patients, 582 patients with comorbid schizophrenia and type 2 diabetes and 280 samples with another psychiatric diagnosis.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001002723") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000079)
ClassAssertion(Annotation(rdfs:comment "The PROFILE pilot study explored the feasibility of using SNP profiling in men with a family history (FH) of PrCa to investigate the probability of detecting PrCa at prostate biopsy (PB).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27151655+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008315) coho:COHO_0000080)
ClassAssertion(Annotation(rdfs:comment "This gives a current total GoDARTS cohort of 18 306 participants, 10 149 of whom have T2D ( ∼ 44.8% of the DARTS study, representing the diabetic population in Tayside) and 8157 of whom were healthy controls at baseline.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5913637/fullTextXML") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000082)
ClassAssertion(Annotation(rdfs:comment "Durchführung akademischer Phase II und III Studien Für Patienten in allen Krankheitsstadien des Multiplen Myeloms") Annotation(oboInOwl:hasDbXref "https://gmmg.info/") Annotation(obo:IAO_0000116 "multiple myeloma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0009693) coho:COHO_0000085)
ClassAssertion(Annotation(rdfs:comment "We thus examined the relationship between obesity and prostate cancer using a case-control study conducted in Accra, Ghana in 2004 to 2012. Cases and controls were drawn from a population-based sample of 1037 men screened for prostate cancer, yielding 73 cases and 964 controls. An additional 493 incident cases were recruited from the Korle-Bu Teaching Hospital.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32350862+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0000086)
ClassAssertion(Annotation(rdfs:comment "Between 1994 and 1996 an audit of Tasmanian patients diagnosed with glaucoma was performed. Identified probands along with their family members were invited to participate.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18173405+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "primary open angle glaucoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005338) coho:COHO_0000087)
ClassAssertion(Annotation(rdfs:comment "Men and women aged 40 to 80 years were eligible provided they were considered to be at elevated risk of coronary heart disease death because of past history of myocardial infarction or other coronary heart disease, occlusive disease of non-coronary arteries, diabetes mellitus or treated hypertension") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10329064+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "coronary heart disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005010) coho:COHO_0000091)
ClassAssertion(Annotation(rdfs:comment "The DCS consists of persons with T2D in primary care from the West-Friesland region of the Netherlands. Enrolment in the cohort started in 1998 and this prospective dynamic cohort currently holds 12 673 persons with T2D.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28588112+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000092)
ClassAssertion(Annotation(rdfs:comment "The NIMH-RGR is a principal biorepository resource with more than 200,000 well-characterized, high-quality patient and control samples from a wide-range of mental disorders across diverse ethnicities.") Annotation(oboInOwl:hasDbXref "https://www.nimh.nih.gov/about/advisory-boards-and-groups/namhc/2016/may/namhc-minutes-of-the-245th-meeting") Annotation(obo:IAO_0000116 "mental disorders") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005084) coho:COHO_0000094)
ClassAssertion(Annotation(rdfs:comment "Data from the ICR for the period 1955-2009 (41 994 cancer diagnoses) were used, applying established quantitative and semi-quantitative methods.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22974093+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004992) coho:COHO_0000096)
ClassAssertion(Annotation(rdfs:comment "Men aged 40-69 years from families with BRCA1 or BRCA2 mutations were offered annual prostate specific antigen (PSA) testing, and those with PSA > 3 ng/mL, were offered a prostate biopsy. Controls were men age-matched (± 5 years) who were negative for the familial mutation.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20840664+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008315) coho:COHO_0000097)
ClassAssertion(Annotation(rdfs:comment "We used 55 Immunochip-wide datasets that included 19,735 IBD cases (10,856 CD cases and 8879 UC cases) of known smoking status.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28506689+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "Crohn's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005011) coho:COHO_0000098)
ClassAssertion(Annotation(rdfs:comment "The Chronic Lymphocytic Leukemia (CLL) Genome Project aims to identify genetic alterations involved in the development and progression of the CLL, which are still unknown, with the objective of generating a comprehensive catalogue of genetic alterations in 500 independent tumours.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00000000092") Annotation(obo:IAO_0000116 "chronic lymphocytic leukemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004948) coho:COHO_0000101)
ClassAssertion(Annotation(rdfs:comment "We performed a meta-analysis of 22 genome-wide association (GWA) studies, consisting of 59,674 cases and 316,078 controls collected from six tertiary headache clinics and 27 population-based cohorts through our worldwide collaboration in the International Headache Genetics Consortium (IHGC).") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5331903/unicode") Annotation(obo:IAO_0000116 "migraine") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005277) coho:COHO_0000102)
ClassAssertion(Annotation(rdfs:comment "Cases were recruited through the International Multiple Sclerosis Genetics Consortium (IMSGC) and compared with the WTCCC2 common control set12,13 supplemented by data from the control arms of existing GWAS.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3182531/fullTextXML") Annotation(obo:IAO_0000116 "multiple sclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005301) coho:COHO_0000103)
ClassAssertion(Annotation(rdfs:comment "We genotyped the International Schizophrenia Consortium (ISC) case-control sample for up to ~1 million single nucleotide polymorphisms (SNPs) augmented by imputed common HapMap SNPs.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3912837/unicode") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0000104)
ClassAssertion(Annotation(rdfs:comment "Significant (P < 5 × 10-8) results were investigated in the Leeds Melanoma Cohort (LMC; 1,947 patients with melanoma; 370 melanoma deaths).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36064556+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "melanoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005105) coho:COHO_0000106)
ClassAssertion(Annotation(rdfs:comment "The Women's CARE Study is a population-based case-control study designed to examine risk factors for breast cancer among White and African-American women aged 35 to 64 years in five United States (US) regions (Atlanta, Seattle, Detroit, Philadelphia, and Los Angeles).") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2754711/unicode") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0000110)
ClassAssertion(Annotation(rdfs:comment "Ten-year follow-up was conducted among the survivors from a population-based group of 416 patients included in the Lund Stroke Register, Sweden, between March 1, 2001, and February 28, 2002.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24803595+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005098) coho:COHO_0000112)
ClassAssertion(Annotation(rdfs:comment "MARTHA patients (n = 1,592) are unrelated VT patients, mainly of French origin, consecutively recruited at the Thrombophilia center of La Timone hospital (Marseille, France) between January 1994 and October 2005.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3181335/fullTextXML") Annotation(obo:IAO_0000116 "venous thrombosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005399) coho:COHO_0000113)
ClassAssertion(Annotation(rdfs:comment "MIRAGE is a family-based genetic epidemiological study of AD that enrolled AD cases and unaffected sibling controls at 17 clinical centers in the United States, Canada, Germany and Greece.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3365264/") Annotation(obo:IAO_0000116 "Alzheimer disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0000115)
ClassAssertion(Annotation(rdfs:comment "We carried out a genome-wide association study (GWAS) of common SNPs in the Molecular Genetics of Schizophrenia (MGS) case-control sample, and then a meta-analysis of data from the MGS, International Schizophrenia Consortium (ISC) and SGENE datasets.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2775422/unicode") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0000116)
ClassAssertion(Annotation(rdfs:comment "Follow-up data were collected in 43 cohorts in 18 populations in 8 European countries surveyed for cardiovascular risk factors.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19520994+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000117)
ClassAssertion(Annotation(rdfs:comment "Its objective is to measure trends in cardiovascular mortality and morbidity and to assess the extent to which these trends are related to changes in risk factor levels and/or medical care, measured at the same time in defined communities in different countries.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2807705+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000118)
ClassAssertion(Annotation(rdfs:comment "The Multi-Ethnic Study of Atherosclerosis was initiated in July 2000 to investigate the prevalence, correlates, and progression of subclinical cardiovascular disease (CVD) in a population-based sample of 6,500 men and women aged 45-84 years.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12397006+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000119)
ClassAssertion(Annotation(rdfs:comment "The authors used a genome-wide association study (GWAS) of multiply affected families to investigate the association of schizophrenia to common single-nucleotide polymorphisms (SNPs) and rare copy number variants (CNVs).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22885689+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0000120)
ClassAssertion(Annotation(rdfs:comment "The authors describe the design and implementation of a large multiethnic cohort established to study diet and cancer in the United States.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10695593+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cancer") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004992) coho:COHO_0000121)
ClassAssertion(Annotation(rdfs:comment "Between March 1999 and September 2004, consecutive patients aged <70 years with a first episode of deep venous thrombosis (leg or arm) or pulmonary embolism were included from the files of six participating anticoagulation clinics in the Netherlands (Amersfoort, Amsterdam, The Hague, Leiden, Rotterdam, and Utrecht).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2726929/fullTextXML") Annotation(obo:IAO_0000116 "venous thrombosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005399) coho:COHO_0000122)
ClassAssertion(Annotation(rdfs:comment "In 2003, the National Study of Colorectal Cancer Genetics (NSCCG) was established with the aim of collecting DNA and clinicopathological data from 20,000 CRC cases and a series of spouse/partner controls, thereby creating a unique resource for identifying low-penetrance CRC susceptibility alleles.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17895893+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000124)
ClassAssertion(Annotation(rdfs:comment "The project recruited cases from Eastern Massachusetts and New Hampshire, and became known as the New England-based Case-Control study (NECC) of ovarian cancer. 3957 ovarian cancer cases diagnosed at ages 18-80 and residing in Eastern Massachusetts and New Hampshire were identified through tumor boards and registries.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001034.v1.p1") Annotation(obo:IAO_0000116 "ovarian cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008170) coho:COHO_0000126)
ClassAssertion(Annotation(rdfs:comment "We carried out a genome-wide association study (GWAS) meta-analysis on (i) 478 GP patients from the National Institute of Diabetes and Digestive and Kidney Diseases Gastroparesis Clinical Research Consortium (GpCRC) compared to 9931 population-based controls from the University of Michigan Health and Retirement Study") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37688361+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "gastroparesis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006769) coho:COHO_0000127)
ClassAssertion(Annotation(rdfs:comment "People aged > or = 50 years with evidence of CV disease and with IFG, IGT, newly detected or established diabetes (on 0 or 1 oral agent), and a local glycated hemoglobin < 150% of the upper limit of normal for that assay were recruited") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18082485+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "dysglycemia") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0011015) coho:COHO_0000133)
ClassAssertion(Annotation(rdfs:comment "People aged > or = 50 years with evidence of CV disease and with IFG, IGT, newly detected or established diabetes (on 0 or 1 oral agent), and a local glycated hemoglobin < 150% of the upper limit of normal for that assay were recruited") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18082485+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004995) coho:COHO_0000133)
ClassAssertion(Annotation(rdfs:comment "People aged > or = 50 years with evidence of CV disease and with IFG, IGT, newly detected or established diabetes (on 0 or 1 oral agent), and a local glycated hemoglobin < 150% of the upper limit of normal for that assay were recruited") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18082485+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005015) coho:COHO_0000133)
ClassAssertion(Annotation(rdfs:comment "The array was used to genotype ovarian cancer cases and controls from multiple studies participating in the Ovarian Cancer Association Consortium, of which 54,747 passes QC.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001002305") Annotation(obo:IAO_0000116 "ovarian cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008170) coho:COHO_0000134)
ClassAssertion(Annotation(rdfs:comment "Survival after cancer diagnosed during childhood or adolescence continues to improve with new treatments and supportive therapies. Optimal long-term care requires that risks to vulnerable organs are clearly defined and translated into guidelines that are implemented into practice. PanCareLIFE is a pan-European consortium that addresses survivorship issues comprising fertility, hearing impairment and quality of life.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30273888+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "childhood cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006517) coho:COHO_0000137)
ClassAssertion(Annotation(rdfs:comment "The Parkinson Environment and Genes (PEG) study in California (June 1, 2000, to July 31, 2017) included 634 patients with PD and 733 controls") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40094665+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "Parkinson disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0000138)
ClassAssertion(Annotation(rdfs:comment "CHD cases were recruited from four European countries (UK, Italy, Sweden and Germany) between 2004 and 2008") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5922567/") Annotation(obo:IAO_0000116 "coronary heart disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0000142)
ClassAssertion(Annotation(rdfs:comment "Studies in hypertensive patients suggest that ambulatory blood pressure (BP) is prognostically superior to office BP. Much less information is available in the general population, however. Obtaining this information was the purpose of the Pressioni Arteriose Monitorate e Loro Associazioni (PAMELA) study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15809377+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000143)
ClassAssertion(Annotation(rdfs:comment "Studies in hypertensive patients suggest that ambulatory blood pressure (BP) is prognostically superior to office BP. Much less information is available in the general population, however. Obtaining this information was the purpose of the Pressioni Arteriose Monitorate e Loro Associazioni (PAMELA) study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15809377+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "hypertension") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005044) coho:COHO_0000143)
ClassAssertion(Annotation(rdfs:comment "The PIVUS study is a population-based study of the cardiovascular health in the elderly [28].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6827221/fullTextXML") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000144)
ClassAssertion(Annotation(rdfs:comment "We combined three existing GWAS datasets (hereafter referred to as Kiel3, CASP4 and WTCCC25) with two independent European-descent case-control datasets genotyped on the Immunochip: the Psoriasis Association Genetics Extension (PAGE: 3,580 cases and 5,902 controls) and the Genetic Analysis of Psoriasis Consortium (GAPC: 2,997 cases and 9,183 controls)") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML") Annotation(obo:IAO_0000116 "psoriasis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005083) coho:COHO_0000145)
ClassAssertion(Annotation(rdfs:comment "The Psychiatric GWAS Consortium was founded with the aim of conducting statistically rigorous and comprehensive GWAS meta-analyses for five major psychiatric disorders: ADHD, autism, bipolar disorder, major depressive disorder, and schizophrenia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20955924+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "major depressive disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002009) coho:COHO_0000146)
ClassAssertion(Annotation(rdfs:comment "The Psychiatric GWAS Consortium was founded with the aim of conducting statistically rigorous and comprehensive GWAS meta-analyses for five major psychiatric disorders: ADHD, autism, bipolar disorder, major depressive disorder, and schizophrenia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20955924+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "bipolar disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004985) coho:COHO_0000146)
ClassAssertion(Annotation(rdfs:comment "The Psychiatric GWAS Consortium was founded with the aim of conducting statistically rigorous and comprehensive GWAS meta-analyses for five major psychiatric disorders: ADHD, autism, bipolar disorder, major depressive disorder, and schizophrenia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20955924+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "schizophrenia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005090) coho:COHO_0000146)
ClassAssertion(Annotation(rdfs:comment "The Psychiatric GWAS Consortium was founded with the aim of conducting statistically rigorous and comprehensive GWAS meta-analyses for five major psychiatric disorders: ADHD, autism, bipolar disorder, major depressive disorder, and schizophrenia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20955924+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "autism") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005260) coho:COHO_0000146)
ClassAssertion(Annotation(rdfs:comment "The Psychiatric GWAS Consortium was founded with the aim of conducting statistically rigorous and comprehensive GWAS meta-analyses for five major psychiatric disorders: ADHD, autism, bipolar disorder, major depressive disorder, and schizophrenia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20955924+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "attention deficit hyperactivity disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007743) coho:COHO_0000146)
ClassAssertion(Annotation(rdfs:comment "Recruitment was performed through probands with a specific asthma phenotype. The collection includes 1394 individuals distributed in 271 families.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24646526+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "asthma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004979) coho:COHO_0000149)
ClassAssertion(Annotation(rdfs:comment "These participants included 600 cases with ischaemic stroke at ages 18 to 69 years and 600 controls matched for age and sex from the Sahlgrenska Academy Study on Ischemic Stroke (SAHLSIS 28 )") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6260132/fullTextXML") Annotation(obo:IAO_0000116 "ischaemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0000150)
ClassAssertion(Annotation(rdfs:comment "The Scania Diabetes Registry contains over 7000 diabetes patients recruited at hospitals in Scania, Sweden as from 1996.") Annotation(oboInOwl:hasDbXref "https://researchdata.se/en/catalogue/dataset/ext0074-1") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005015) coho:COHO_0000152)
ClassAssertion(Annotation(rdfs:comment "Patients with gallbladder carcinoma (GBC), the most aggressive malignancy of the biliary tract, have a poor prognosis. Here, we report our identification of somatic mutations of GBCs in 57 tumor-normal pairs by use of a combination of exome sequencing and ultra-deep sequencing of cancer-related genes.") Annotation(oboInOwl:hasDbXref "https://metadata.ega-archive.org/studies/EGAS00001000853") Annotation(obo:IAO_0000116 "gallbladder carcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0003220) coho:COHO_0000153)
ClassAssertion(Annotation(rdfs:comment "The SCOT study was an international, randomised, phase 3, non-inferiority trial done at 244 centres. Patients aged 18 years or older with high-risk stage II and stage III colorectal cancer underwent central randomisation with minimisation for centre, choice of regimen, sex, disease site, N stage, T stage, and the starting dose of capecitabine.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29611518+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000154)
ClassAssertion(Annotation(rdfs:comment "The Simons Simplex Collection (SSC) is a rigorously characterized set of data drawn from 2,700 families, designed to enrich the discovery of rare and de novo events in autism spectrum disorders.") Annotation(oboInOwl:hasDbXref "https://www.sfari.org/funded-project/the-simons-simplex-collection/") Annotation(obo:IAO_0000116 "autism spectrum disorders") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005258) coho:COHO_0000155)
ClassAssertion(Annotation(rdfs:comment "Mucosa specimens from 1,000 sporadic Chinese CRC patients (defined as age 50 or more at date of operation and without dominant family history of FAP and HNPCC) archived over the past ten years were selected as cases for the study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3411754/fullTextXML") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000156)
ClassAssertion(Annotation(rdfs:comment "A multi-centre phase III double-blind placebo-controlled study designed to examine the efficacy and tolerability of sorafenib (Nexavar) in patients with resected (total or partial) primary renal cell carcinoma (RCC) at high or intermediate risk of relapse") Annotation(oboInOwl:hasDbXref "https://innovative-ctu.ucl.ac.uk/studies/all-studies/s/sorce/") Annotation(obo:IAO_0000116 "renal cell carcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005086) coho:COHO_0000157)
ClassAssertion(Annotation(rdfs:comment "We describe an effort to create a university-wide research project aimed at understanding how genes and environments impact alcohol use and related substance use and mental health outcomes across time in college students.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24639683+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "substance use problems") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0002494) coho:COHO_0000158)
ClassAssertion(Annotation(rdfs:comment "We describe an effort to create a university-wide research project aimed at understanding how genes and environments impact alcohol use and related substance use and mental health outcomes across time in college students.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24639683+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "emotional health problems") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005084) coho:COHO_0000158)
ClassAssertion(Annotation(rdfs:comment "Across the two waves, SWEBIC recruited 8580 individuals diagnosed with bipolar disorder, 89 percent from BipoläR.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC12144026/") Annotation(obo:IAO_0000116 "bipolar disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004985) coho:COHO_0000159)
ClassAssertion(Annotation(rdfs:comment "A total of 2,798 unrelated individuals with T2D, age >20 years, were recruited from China Medical University Hospital (CMUH), Taichung, Taiwan; Chia-Yi Christian Hospital (CYCH), Chia-Yi, Taiwan; and National Taiwan University Hospital (NTU), Taipei, Taiwan.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2824763/fullTextXML") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005148) coho:COHO_0000161)
ClassAssertion(Annotation(rdfs:comment "The Fenland study is designed to investigate the interaction between genetic and lifestyle factors in determining diabetes, obesity, and related metabolic disorders.") Annotation(oboInOwl:hasDbXref "https://studies.epi.ims.cam.ac.uk/files/fenland-study/fenland2_pis-executive-function-v3-120219.pdf") Annotation(obo:IAO_0000116 "diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005015) coho:COHO_0000164)
ClassAssertion(Annotation(rdfs:comment "The Fenland study is designed to investigate the interaction between genetic and lifestyle factors in determining diabetes, obesity, and related metabolic disorders.") Annotation(oboInOwl:hasDbXref "https://studies.epi.ims.cam.ac.uk/files/fenland-study/fenland2_pis-executive-function-v3-120219.pdf") Annotation(obo:IAO_0000116 "related metabolic disorders") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005066) coho:COHO_0000164)
