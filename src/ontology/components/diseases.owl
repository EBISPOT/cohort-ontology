ClassAssertion(Annotation(rdfs:comment "The IGGC is a large international consortium established to identify glaucoma genetic risk genes through large-scale meta-analysis43,44.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10335935/fullTextXML") Annotation(obo:IAO_0000116 "glaucoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005041) coho:COHO_0000916)
ClassAssertion(Annotation(rdfs:comment "To determine the genetic basis for this rare phenomenon, we established a multinational consortium (www.hivcontrollers.org) to recruit HIV-1 controllers, who are defined by at least three measurements of plasma virus load (VL) < 2000 RNA copies/ml over at least a 12-month period in the absence of antiviral therapy.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3235490/unicode") Annotation(obo:IAO_0000116 "HIV infection") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005109) coho:COHO_0000917)
