ClassAssertion(Annotation(rdfs:comment "The families included in the present study comprised of 1412 families ascertained to have two or more cases of ovarian cancer; 17 families with one case of ovarian cancer and two cases of cancer at other sites; and 490 families in the category of those having at least one female with more than one primary tumors with one of the primaries being ovarian cancer or having more than one case of cancer with at least one case being ovarian cancer and the other cancer considered to be of early onset.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2694280/fullTextXML") Annotation(obo:IAO_0000116 "ovarian cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008170) coho:COHO_0001825)
ClassAssertion(Annotation(rdfs:comment "The program enrolled women at elevated risk due to their family histories of cancer, and participants underwent regular screenings with CA125 and ultrasound in an attempt to diagnose ovarian cancer before it had spread.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11047303/fullTextXML") Annotation(obo:IAO_0000116 "ovarian cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008170) coho:COHO_0001826)
ClassAssertion(Annotation(rdfs:comment "Five of the identified genes (CHD7, IST1, KIAA1958, MAP3K5, UBFD1) were also found to be differentially expressed six months after a MI in 39 MI survivors (Greek Recurrent Myocardial Infarction Cohort) that had not experienced any recurrent event during that period (p-adj ≤10-5).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6778823/fullTextXML") Annotation(obo:IAO_0000116 "myocardial infarction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005068) coho:COHO_0001827)
