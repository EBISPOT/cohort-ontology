ClassAssertion(Annotation(rdfs:comment "The Diabetes Heart Study (DHS) is a community-based study of the genetic and epidemiological contributions to diabetic heart disease in which siblings concordant for type 2 diabetes mellitus (T2DM), as well as unaffected family members, were recruited from internal medicine and endocrinology clinics in western North Carolina.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3609509/fullTextXML") Annotation(obo:IAO_0000116 "diabetic heart disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005267) coho:COHO_0000460)
ClassAssertion(Annotation(rdfs:comment "We validated our results in two independent type 1 diabetes case–control cohorts (Children's Hospital of Philadelphia, Center for Applied Genomics [CHOP-CAG] and Genetic Risk Assessment for Chinese Eaglet-T1D [GRACE]) and two population-based cohorts (All of Us and UK Biobank).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13109230/fullTextXML") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005147) coho:COHO_0000462)
ClassAssertion(Annotation(rdfs:comment "We included a total of 979 unique patients from the previously described prospective cohort AMC-PAS[6], with symptomatic Coronary Artery Disease (CAD) before the age of 51 years, defined as Myocardial Infarction (MI), coronary revascularization, or evidence of at least 70% stenosis in a major epicardial artery.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5330464/fullTextXML") Annotation(obo:IAO_0000116 "premature atherosclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0004416) coho:COHO_0000463)
