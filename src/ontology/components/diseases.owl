ClassAssertion(Annotation(rdfs:comment "GRAZ Between 1994 and 2003, subjects with first-ever and recurrent ischemic strokes admitted to the stroke unit of the Department of Neurology, Medical University of Graz (Graz, Austria) were included.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "ischaemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0001085)
