ClassAssertion(Annotation(rdfs:comment "A total of 819 incident cases and 879 controls were interviewed face-to-face using a standardized questionnaire gathering information on known or suspected risk factors of prostate cancer and personal history of specific sexually and non-sexually transmitted infections: gonorrhea, syphilis, trichomonas, herpes, mononucleosis, Epstein-Barr virus, varicella-zoster, and dengue.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38174802+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0001692)
ClassAssertion(Annotation(rdfs:comment "The EPIC Obesity study comprises a representative sample (n = 2,566) nested within the EPIC-Norfolk Study27, a population-based cohort study of 25,663 men and women of European descent aged 39–79 y recruited in Norfolk, UK between 1993 and 1997.") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC2669167") Annotation(obo:IAO_0000116 "obesity") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0011122) coho:COHO_0001693)
