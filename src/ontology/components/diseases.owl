ClassAssertion(Annotation(rdfs:comment "Community-based, prospective, randomized, double-blind trial including 1702 men and women with no prior history of cardiovascular disease (primary prevention cohort) and open-label study including 1182 patients with known cardiovascular disease (secondary prevention cohort) who provided at least baseline and 12-week blood samples.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11434828+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004995) coho:COHO_0002279)
ClassAssertion(Annotation(rdfs:comment "The ProAFHeart study is a multicentre prospective trial aiming to determine the prevalence and 2-year incidence of arrhythmias and athletic remodeling in endurance athletes 16–80 years of age.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12305178/fullTextXML") Annotation(obo:IAO_0000116 "arrhythmias") ObjectSomeValuesFrom(coho:is_population_study_of obo:HP_0011675) coho:COHO_0002280)
ClassAssertion(Annotation(rdfs:comment "Briefly, study participants were derived from a retrospective nationwide cohort study of men with localized prostate cancer, the National Prostate Cancer Register (NPCR) of Sweden Follow-up Study (Stattin et al., 2008).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7012357/fullTextXML") Annotation(obo:IAO_0000116 "localized prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002281)
ClassAssertion(Annotation(rdfs:comment "A total of 1347 consecutive Italian MS patients diagnosed according to McDonald criteria [4], were ascertained by two Italian consortia, PROGEMUS (N = 1002), and PROGRESSO (N = 345).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3681825/fullTextXML") Annotation(obo:IAO_0000116 "multiple sclerosis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005301) coho:COHO_0002282)
