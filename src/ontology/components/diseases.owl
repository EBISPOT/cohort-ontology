ClassAssertion(Annotation(rdfs:comment "To identify potential target gene(s), we examined the associations of the three lead SNPs with expression levels of genes located within 1 Mb in three different studies: (1) 116 normal breast samples and 241 breast tumors from the Norwegian Breast Cancer Study (NBCS)") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0000573)
