ClassAssertion(Annotation(rdfs:comment "The participants included in the discovery cohort were part of the Genetic Study in Ischemic Stroke Patients treated with recombinant tissue plasminogen activator (r-tPA) (GenoTPA) [9], Genetic contribution to Functional Outcome and Disability after Stroke (GODS) [13], the Genotyping Recurrence Risk of Stroke (GRECOS) [14], and Genetics of Early Neurological Instability After Ischemic Stroke (GENISIS) [15] studies.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8305811/fullTextXML") Annotation(obo:IAO_0000116 "ischemic stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060198) coho:COHO_0001787)
ClassAssertion(Annotation(rdfs:comment "Cases were recruited from the outpatient rheumatology clinics of the VU university medical center, the Jan van Breemen institute, and the AMC/University of Amsterdam, all situated in the Amsterdam region in the Netherlands. All cases had RA consistent with 1987 ACR criteria, and only those patients that were CCP positive were used in this study.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.479/MediaObjects/41588_2009_BFng479_MOESM310_ESM.pdf") Annotation(obo:IAO_0000116 "rheumatoid arthritis") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008383) coho:COHO_0001788)
ClassAssertion(Annotation(rdfs:comment "This is a study of a large sample of families with recurrent major depressive disorder (DSM-IV) beginning by the age 30 in probands or 40 in relatives.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12707949+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "recurrent early-onset major depressive disorder") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002009) coho:COHO_0001789)
ClassAssertion(Annotation(rdfs:comment "Subjects of GenRIC (Genomics Research in Cardiovascular Disease) study is composed of 2,099 CAD patients from three teaching hospitals (Samsung Medical Center, Seoul National University Hospital and Yonsei University College of Medicine) and 2,690 controls from HEXA (Health Examinee) which is one of the KoGES (Korean Genome Epidemiology Study) population based cohorts that were initiated in 2001 aiming to identify genetic risk factors of complex diseases.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3396/MediaObjects/41588_2015_BFng3396_MOESM57_ESM.pdf") Annotation(obo:IAO_0000116 "coronary artery disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0001790)
ClassAssertion(Annotation(rdfs:comment "The GLAUGEN study contains POAG cases and controls derived from the Genetic Etiologies of Primary Open-Angle Glaucoma (GEP) study, the Nurses’ Health Study (NHS), and the Health Professionals Follow-up Study (HPFS). The GEP is a clinical case-control study from Massachusetts Eye and Ear Infirmary while the NHS and HPFS contain cases and controls nested within population-based cohorts at risk for POAG.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3712669/fullTextXML") Annotation(obo:IAO_0000116 "primary open-angle glaucoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005338) coho:COHO_0001793)
