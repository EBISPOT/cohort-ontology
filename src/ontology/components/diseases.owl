ClassAssertion(Annotation(rdfs:comment "EPHESUS included 6632 patients with an acute MI (3‐14 days after the MI), and a LVEF ≤ 40% plus HF or diabetes to receive either eplerenone (25 mg per day initially, titrated to a maximum of 50 mg per day) or placebo.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6837025/fullTextXML") Annotation(obo:IAO_0000116 "acute myocardial infarction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004781) coho:COHO_0001691)
