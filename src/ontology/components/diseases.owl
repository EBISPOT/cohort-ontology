ClassAssertion(Annotation(rdfs:comment "The INVENT Consortium included 30,234 VTE cases and 172,122 controls from 18 studies with varying diagnostic approaches, which were detailly described in the genome-wide association study [25].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(obo:IAO_0000116 "venous thromboembolism") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005399) coho:COHO_0000829)
ClassAssertion(Annotation(rdfs:comment "We investigated the association between urinary tract infections (UTIs) and transitional cell carcinoma of the bladder in a population-based case-control study in Los Angeles covering 1586 cases and age-, gender-, and race-matched neighbourhood controls.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19174821+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "bladder cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001187) coho:COHO_0000830)
ClassAssertion(Annotation(rdfs:comment "The two large German birth cohorts, GINIplus and LISAplus, recruited 5,991 and 3,097 children, respectively, in Munich (West), Leipzig (East), Wesel (West), and Bad Honnef (West) to investigate various influences on the development of the immune system and the etiology of allergic diseases.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML") Annotation(obo:IAO_0000116 "allergic diseases") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005271) coho:COHO_0000831)
ClassAssertion(Annotation(rdfs:comment "The Mayo Venous Thromboembolism Study (Mayo VTE) is a case-control study of venous thromboembolism (VTE) conducted at the Mayo Clinic (Rochester, MN)).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(obo:IAO_0000116 "venous thromboembolism") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005399) coho:COHO_0000832)
ClassAssertion(Annotation(rdfs:comment "We evaluated the association between lifetime pool attendance and the risk of breast, colorectal, and prostate cancer in a multicase-control study that recruited 4,941 hospital-based cancer cases (1,724 breast, 2,111 colorectal, 1,106 prostate) and 4,039 population-based controls in Spain (2008-2013).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41183009+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chronic lymphocytic leukemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004948) coho:COHO_0000833)
ClassAssertion(Annotation(rdfs:comment "We evaluated the association between lifetime pool attendance and the risk of breast, colorectal, and prostate cancer in a multicase-control study that recruited 4,941 hospital-based cancer cases (1,724 breast, 2,111 colorectal, 1,106 prostate) and 4,039 population-based controls in Spain (2008-2013).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41183009+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0000833)
ClassAssertion(Annotation(rdfs:comment "We evaluated the association between lifetime pool attendance and the risk of breast, colorectal, and prostate cancer in a multicase-control study that recruited 4,941 hospital-based cancer cases (1,724 breast, 2,111 colorectal, 1,106 prostate) and 4,039 population-based controls in Spain (2008-2013).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41183009+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "breast cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007254) coho:COHO_0000833)
ClassAssertion(Annotation(rdfs:comment "We evaluated the association between lifetime pool attendance and the risk of breast, colorectal, and prostate cancer in a multicase-control study that recruited 4,941 hospital-based cancer cases (1,724 breast, 2,111 colorectal, 1,106 prostate) and 4,039 population-based controls in Spain (2008-2013).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41183009+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0000833)
ClassAssertion(Annotation(rdfs:comment "The Osteoporotic Fractures in Men (MrOs) Sweden study is a prospective population-based multicenter observational study consisting of 3014 older men aged between 69 and 81 years at inclusion (mean age 75.4 ± (SD) 3.2 years), with the main aim to identify risk factors for osteoporosis and fracture.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6431016/fullTextXML") Annotation(obo:IAO_0000116 "osteoporosis") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005298) coho:COHO_0000835)
ClassAssertion(Annotation(rdfs:comment "The Osteoporotic Fractures in Men (MrOs) Sweden study is a prospective population-based multicenter observational study consisting of 3014 older men aged between 69 and 81 years at inclusion (mean age 75.4 ± (SD) 3.2 years), with the main aim to identify risk factors for osteoporosis and fracture.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6431016/fullTextXML") Annotation(obo:IAO_0000116 "fracture") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005315) coho:COHO_0000835)
ClassAssertion(Annotation(rdfs:comment "Briefly, in New England, cases included patients newly diagnosed with carcinoma of the urinary bladder between 2001 and 2004 among residents of Maine, New Hampshire, and Vermont and population controls, which were frequency matched to the cases by age at diagnosis/interview, sex, and state of residence (989 White cases and 1,162 White controls with complete exposure information and genotype data).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9088962/fullTextXML") Annotation(obo:IAO_0000116 "bladder cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001187) coho:COHO_0000836)
ClassAssertion(Annotation(rdfs:comment "We did genome-wide, single-nucleotide-polymorphism (SNP) genotyping of publicly available samples from a cohort of Parkinson's disease patients (n=267) and neurologically normal controls (n=270).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17052657+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0000837)
ClassAssertion(Annotation(rdfs:comment "By analyzing data from the National Prion Disease Pathology Surveillance Center (NPDPSC) and the National Alzheimer's Coordinating Center (NACC), we constructed two data sets of rpAD cases based on either pathological findings or cognitive measurements.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10984493/fullTextXML") Annotation(obo:IAO_0000116 "rapidly progressive Alzheimer's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004975) coho:COHO_0000838)
ClassAssertion(Annotation(rdfs:comment "The OMG-SCD study enrolled over 800 adult patients with SCD to study genetic associations with clinical outcomes from five sickle cell centers in the southeastern U.S. between 2002 and 2015.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7416942/fullTextXML") Annotation(obo:IAO_0000116 "sickle cell disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0011382) coho:COHO_0000839)
ClassAssertion(Annotation(rdfs:comment "PD patients diagnosed within the past 3.5 years were prospectively recruited as part of the Oxford Parkinson’s Disease Centre (OPDC) cohort study from 11 hospitals across the Thames Valley covering a population of approximately 2.1 million (PD-Discovery, website: http://opdc.medsci.ox.ac.uk).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4923737/fullTextXML") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0000840)
ClassAssertion(Annotation(rdfs:comment "Index cases from these families, their full siblings and parents were recruited for three coordinated studies: (i) the NAG (Nicotine Addiction Genetics) Study which ascertained heavy smoking index cases; (ii) the OZALC-EDAC study, which ascertained index cases with a history of alcohol dependence") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3210694/unicode") Annotation(obo:IAO_0000116 "alcohol dependence") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0007079) coho:COHO_0000841)
ClassAssertion(Annotation(rdfs:comment "Index cases from these families, their full siblings and parents were recruited for three coordinated studies: (i) the NAG (Nicotine Addiction Genetics) Study which ascertained heavy smoking index cases; (ii) the OZALC-EDAC study, which ascertained index cases with a history of alcohol dependence") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3210694/unicode") Annotation(obo:IAO_0000116 "nicotine addiction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008575) coho:COHO_0000841)
ClassAssertion(Annotation(rdfs:comment "PDBP is building a resource of longitudinally collected data and biosamples from well-characterized patients with PD of different stages and duration, parkinsonism, and control participants, and includes hypothesis-driven biomarker discovery projects.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4824671/unicode") Annotation(obo:IAO_0000116 "Parkinson's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005180) coho:COHO_0000842)
ClassAssertion(Annotation(rdfs:comment "Smokers seeking treatment were randomly assigned by baseline NMR status and study site, in blocks of 12 patients (1:1:1 ratio), to 11 weeks of placebo (placebo pill plus placebo patch), nicotine patch (active patch plus placebo pill), or varenicline (active pill plus placebo patch), plus behavioural counselling.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25588294+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "tobacco dependence") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008575) coho:COHO_0000844)
ClassAssertion(Annotation(rdfs:comment "The Riesgo de Enfermedad TROmboembólica VEnosa (RETROVE) study is a prospective case–control study of 400 consecutive patients with VTE (cancer associated thrombosis excluded) and 400 healthy control volunteers.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML") Annotation(obo:IAO_0000116 "venous thromboembolism") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005399) coho:COHO_0000845)
ClassAssertion(Annotation(rdfs:comment "In a multicentre prospective cohort study, 646 participants with a first, unprovoked major venous thromboembolism were enrolled over a 4-year period.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18725614+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "unprovoked venous thromboembolism") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005399) coho:COHO_0000846)
ClassAssertion(Annotation(rdfs:comment "A study of cardiovascular disease in American Indians: design and methods.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11904716/fullTextXML") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0004995) coho:COHO_0000848)
ClassAssertion(Annotation(rdfs:comment "The SLESS is a prospective study that recruited 1200 consecutive black patients with stroke from a contiguous geographical area in South London in the UK, covered by three acute hospitals (Guy’s and St Thomas’ Hospitals, King’s College Hospital, and St George’s Hospital).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873985/fullTextXML") Annotation(obo:IAO_0000116 "stroke") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005098) coho:COHO_0000849)
ClassAssertion(Annotation(rdfs:comment "SLIC families were all selected on the basis of a single proband with receptive and/or expressive language skills more than 1.5 SD below the normative mean for his or her age.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2725236/fullTextXML") Annotation(obo:IAO_0000116 "specific language impairment") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0000724) coho:COHO_0000850)
ClassAssertion(Annotation(rdfs:comment "Men who developed TGCT while on active duty were eligible to participate as cases, whereas men who did not develop TGCT were eligible to participate as controls.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3314781/fullTextXML") Annotation(obo:IAO_0000116 "testicular germ cell tumours") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0010108) coho:COHO_0000851)
ClassAssertion(Annotation(rdfs:comment "Cases (n = 497) and controls (n = 957) in the Texas Bladder Cancer Study (TXBCS) who had been genotyped using a Genome-Wide Association panel were derived from an ongoing hospital-based bladder cancer case-control study [21].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526593/fullTextXML") Annotation(obo:IAO_0000116 "bladder cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001187) coho:COHO_0000853)
