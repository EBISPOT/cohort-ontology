ClassAssertion(Annotation(rdfs:comment "The PREDO study recruited between 12 and 14 gestational weeks (GWs) 1079 pregnant women with known risk factor status for preeclampsia and intrauterine growth restriction from 10 hospitals [26].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12964119/fullTextXML") Annotation(obo:IAO_0000116 "intrauterine growth restriction") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0005030) coho:COHO_0000690)
