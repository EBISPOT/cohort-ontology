ClassAssertion(Annotation(rdfs:comment "Here, we present the first GWAS meta-analysis of SA from the International Suicide Genetics Consortium (ISGC), including over 29,000 SA or suicide cases from 18 cohorts worldwide.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8851871/unicode") Annotation(obo:IAO_0000116 "suicide") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_5200330) coho:COHO_0001021)
ClassAssertion(Annotation(rdfs:comment "Using this consensus protocol, we obtained 1352 human cardiac samples and chose a subset of 313 hearts, including 177 failing hearts collected immediately post transplantation and 136 healthy donor controls that were suitable for transplantation but did not reach a recipient due to logistical reasons (clinical characteristics listed in Supplementary Table 1).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML") Annotation(obo:IAO_0000116 "heart failure") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005252) coho:COHO_0001022)
