ClassAssertion(Annotation(rdfs:comment "Briefly, the CEERCC study is a hospital-based case-control study of renal cell cancer conducted between 1999 and 2003 in seven centers in four Central and Eastern European countries (Moscow, Russia; Bucharest, Romania; Lodz, Poland; and Prague, Olomouc, Ceske-Budejovice, and Brno, Czech Republic).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2737618/fullTextXML") Annotation(obo:IAO_0000116 "renal cell carcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005086) coho:COHO_0001583)
