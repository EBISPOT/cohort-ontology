ClassAssertion(Annotation(rdfs:comment "We investigated the genetic determinants of premature CAD by performing a genomewide linkage analysis of 4,175 affected subjects from 1,933 families recruited throughout the United Kingdom. Each family had at least two available siblings with CAD, with validated onset before age 66 years.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16380912+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "premature coronary artery disease") ObjectSomeValuesFrom(coho:has_patients_with obo:HP_0005181) coho:COHO_0000346)
