ClassAssertion(Annotation(rdfs:comment "HGF-Study The HGF GWA study (center 1: Wichmann, Sauter, center 2: Bickeböller, Rosenberger, center 3: Risch, Chang-Claude) was made up of three independent German studies as detailed below: In total 506 incident lung cancer cases (LUCY-study: n=305, Heidelberg lung cancer case-control study: n=201) were compared to 480 popula-tion controls (KORA surveys KORA).") Annotation(oboInOwl:hasDbXref "https://www.downstate.edu/research/centers-departments/henri-begleiter-neurodynamics-laboratory/_documents/2012-Hartz-IncreasedgeneticvulnerabilitytosmokingatCHRNA5inearly-onsetsmokers-Supplement.pdf") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008903) coho:COHO_0000165)
ClassAssertion(Annotation(rdfs:comment "The individual GWAS data sets from Iceland and the Netherlands were adjusted for genomic inflation before inclusion in the meta-analysis.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253231/fullTextXML") Annotation(obo:IAO_0000116 "abdominal aortic aneurysm") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005350) coho:COHO_0000167)
ClassAssertion(Annotation(rdfs:comment "The Swedish/Norwegian GWAS5 was based on 1,668 and 157 MM patients from the Swedish National Myeloma Biobank (Skåne University Hospital, Lund, Sweden) and the Norwegian Biobank for Myeloma (Trondheim, Norway), respectively.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4932178/fullTextXML") Annotation(obo:IAO_0000116 "multiple myeloma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0009693) coho:COHO_0000168)
ClassAssertion(Annotation(rdfs:comment "By March 2009, PROMIS had recruited over 5,000 cases of first-ever confirmed acute myocardial infarction (MI) and over 5,000 matched controls aged 30-80 years.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19404752+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "acute myocardial infarction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004781) coho:COHO_0000169)
ClassAssertion(Annotation(rdfs:comment "The Second Manifestations of ARTerial disease (SMART) study is a single-centre prospective cohort study among patients, newly referred to the hospital with (1) clinically manifest atherosclerotic vessel disease, or (2) marked risk factors for atherosclerosis.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10608355+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "atherosclerotic vessel disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_1060134) coho:COHO_0000170)
ClassAssertion(Annotation(rdfs:comment "The sample under study comprised 924 Greek individuals (390 cases with CAD and 534 controls) from the THISEAS study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38929788+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "coronary artery disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0000171)
ClassAssertion(Annotation(rdfs:comment "A total of 10,001 patients with clinically evident CHD and LDL cholesterol levels of less than 130 mg per deciliter (3.4 mmol per liter) were randomly assigned to double-blind therapy and received either 10 mg or 80 mg of atorvastatin per day.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15755765+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "coronary heart disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005010) coho:COHO_0000172)
ClassAssertion(Annotation(rdfs:comment "The Type 1 Diabetes Genetics Consortium (T1DGC) is an international project whose primary aims are to: (a) discover genes that modify type 1 diabetes risk; and (b) expand upon the existing genetic resources for type 1 diabetes research. The initial goal was to collect 2500 affected sibling pair (ASP) families worldwide.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20603248+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005147) coho:COHO_0000174)
ClassAssertion(Annotation(rdfs:comment "An investigation into the possible causes of childhood cancer has been carried out throughout England, Scotland and Wales over the period 1991-1998. All children known to be suffering from one or other type of the disease over periods of 4-5 years have been included, and control children matched for sex, age and area of residence have been selected at random from population registers.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10737392+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "childhood cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0006517) coho:COHO_0000178)
ClassAssertion(Annotation(rdfs:comment "With the support of Crohn’s and Colitis UK, the UK Inflammatory Bowel Disease Genetics Consortium has been at the front of this research – building a vast database of genetic and clinical data from patients across the UK.") Annotation(oboInOwl:hasDbXref "https://www.crohnsandcolitis.org.uk/our-work/research-and-evidence/our-past-research-projects/using-genetics-to-discover-what-causes-ibd-and-why-people-react-in-different-ways-to-drugs") Annotation(obo:IAO_0000116 "Crohn's disease") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005011) coho:COHO_0000180)
