ClassAssertion(Annotation(rdfs:comment "The cohort is a mixture of random sampling and ascertainment through obese individuals.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24533236+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "obesity") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0011122) coho:COHO_0002303)
ClassAssertion(Annotation(rdfs:comment "SYNERGIQC originates from the Quebec lung cancer screening program [17], a provincial multicenter pilot-study launched in 2021 for ever-smokers aged 55–74.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13096907/fullTextXML") Annotation(obo:IAO_0000116 "lung cancer") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0008903) coho:COHO_0002304)
ClassAssertion(Annotation(rdfs:comment "QLD = A longitudinal cohort study (Prostate Cancer Supportive Care and Patient Outcomes Project: ProsCan)conducted in Queensland, through which men newly diagnosed with prostate cancer from 26 private practices and 10 public hospitals were directly referred to ProsCan at the time of diagnosis by their treating clinician (age range 43-88 years).") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002305)
