ClassAssertion(Annotation(rdfs:comment "The National Prostate Cancer Register (NPCR) of Sweden is a clinical cancer register with the aim of increasing the quality of care for men with prostate cancer by providing data to assess adherence to national guidelines [1, 2].") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC12516312/") Annotation(obo:IAO_0000116 "prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002724)
ClassAssertion(Annotation(rdfs:comment "The Follow-up Study was an observational study in the NPCR, with the aim of assessing outcome among patients with localized prostate cancer who were diagnosed after PSA testing had become prevalent in Sweden and for whom curative treatment may have been indicated.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2897875/") Annotation(obo:IAO_0000116 "localized prostate cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0008315) coho:COHO_0002725)
ClassAssertion(Annotation(rdfs:comment "In total, 978 acute myocardial infarction patients were enrolled in this study; of these, 146 died and 832 survived during 2 years of follow-up after the acute myocardial infarction.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30616610+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "acute myocardial infarction") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004781) coho:COHO_0002726)
ClassAssertion(Annotation(rdfs:comment "According to the pathological reassessment of independent neuropathologists, all the subjects were consistently diagnosed with glioma and were then further classified according to the 2007/2016 WHO classification system.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8498921/fullTextXML") Annotation(obo:IAO_0000116 "glioma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0021042) coho:COHO_0002727)
ClassAssertion(Annotation(rdfs:comment "The initial objective of the constitution of the collection was to conduct research in the field of GvHD, being the major complication of HSCT. This research topic was broadened to all the complications of HSCT, after validation in March 2016 by the Committee of the Protection of Persons – CPP – South Mediterranean I.") Annotation(oboInOwl:hasDbXref "https://www.cryostem.org/en/about-cryostem/ethics-and-regulation/") Annotation(obo:IAO_0000116 "Graft-versus-Host Disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0013730) coho:COHO_0002728)
ClassAssertion(Annotation(rdfs:comment "Between 1985–2000, 1457 children aged 0–18 years with newly diagnosed ALL (excluding mature B-cell ALL) were enrolled on four consecutive DFCI ALL Consortium protocols: 85-01 (1981–5, N=220), 87-01 (1987–91, N=369), 91-01 (1991–5, N=377) and 95-01 (1996–2000, N=491).") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2820141/unicode") Annotation(obo:IAO_0000116 "acute lymphoblastic leukemia") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0004967) coho:COHO_0002729)
ClassAssertion(Annotation(rdfs:comment "Our goal was to test whether administration of scheduled antimicrobials and daily nicotinamide improved linear growth in a region with a high prevalence of stunting and enteric pathogen carriage.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34582462+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "stunting") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:HP_0004322) coho:COHO_0002730)
ClassAssertion(Annotation(rdfs:comment "HTL’s access to all tissues involved in diabetes from the same individuals allows the researchers to map the genetic and environmental factors that may cause type 1 diabetes and type 2 diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ludc.lu.se/resources/human-tissue-laboratory") Annotation(obo:IAO_0000116 "type 1 diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005147) coho:COHO_0002731)
ClassAssertion(Annotation(rdfs:comment "HTL’s access to all tissues involved in diabetes from the same individuals allows the researchers to map the genetic and environmental factors that may cause type 1 diabetes and type 2 diabetes.") Annotation(oboInOwl:hasDbXref "https://www.ludc.lu.se/resources/human-tissue-laboratory") Annotation(obo:IAO_0000116 "type 2 diabetes") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005148) coho:COHO_0002731)
ClassAssertion(Annotation(rdfs:comment "Participants with a CVD relative risk of 1.5 assessed by risk scores were randomly assigned to one of the 3 groups: habitual (control, CT), high-flavonoid (HF) or low-flavonoid (LF) diets.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22476876+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cardiovascular disease") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0004995) coho:COHO_0002732)
ClassAssertion(Annotation(rdfs:comment "The study population consists of adult participants hospitalized with known or presumptive coronavirus disease 2019 (COVID-19), a human disease caused by Severe Acute Respiratory Syndrome Coronavirus-2 (SARS-CoV-2) infection.") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/api/v2/studies/NCT04378777") Annotation(obo:IAO_0000116 "COVID-19") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0100096) coho:COHO_0002734)
ClassAssertion(Annotation(rdfs:comment "Five initial cancer types, esophageal squamous cell carcinoma (ESCC), renal cell carcinoma (RCC), colorectal cancer (CRC), pancreatic ductal adenocarcinoma (PDAC), and gastroesophageal junction adenocarcinoma (GEJ), including both esophageal adenocarcinoma (EAD) and adenocarcinomas of gastric cardia, were selected based on the following criteria: (1) cancers with the highest differences in incidence across geographical regions, (2) cancers accounting for more than 10% of new cases and about 20% of deaths, and (3) cancers for which prevalence of known risk factors (i.e., smoking, alcohol, and obesity) do not fully explain the large geographical and temporal differences across regions (Figure 3).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(obo:IAO_0000116 "urinary bladder cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0001187) coho:COHO_0002737)
ClassAssertion(Annotation(rdfs:comment "Five initial cancer types, esophageal squamous cell carcinoma (ESCC), renal cell carcinoma (RCC), colorectal cancer (CRC), pancreatic ductal adenocarcinoma (PDAC), and gastroesophageal junction adenocarcinoma (GEJ), including both esophageal adenocarcinoma (EAD) and adenocarcinomas of gastric cardia, were selected based on the following criteria: (1) cancers with the highest differences in incidence across geographical regions, (2) cancers accounting for more than 10% of new cases and about 20% of deaths, and (3) cancers for which prevalence of known risk factors (i.e., smoking, alcohol, and obesity) do not fully explain the large geographical and temporal differences across regions (Figure 3).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(obo:IAO_0000116 "gastroesophageal junction adenocarcinoma") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0003219) coho:COHO_0002737)
