ClassAssertion(Annotation(rdfs:comment "The Ontario Familial Colon Cancer Registry (OFCCR) is a novel registry that collects family history information, epidemiologic data, blood samples and tumour specimens from a population-based sample of colorectal cancer patients and their families.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11007659+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "colorectal cancer") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005575) coho:COHO_0002200)
