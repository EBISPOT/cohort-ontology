ClassAssertion(Annotation(rdfs:comment "The Genetic Links to Anxiety and Depression (GLAD) Study (www.gladstudy.org.uk) recruits individuals with depression or anxiety into the NIHR Mental Health BioResource.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31715324+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "anxiety") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0005618) coho:COHO_0001010)
