ClassAssertion(Annotation(rdfs:comment "Inclusion criteria were having normal cognition (NC) or a diagnosis of mild cognitive impairment (MCI) or AD-type dementia at baseline, age above 50 years, known amyloid-beta (Aβ) status, availability of cognitive test results and at least two of the following materials: plasma, DNA, magnetic resonance imaging (MRI) or cerebrospinal fluid (CSF).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29980228+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "mild cognitive impairment") ObjectSomeValuesFrom(coho:has_patients_with obo:MONDO_0002039) coho:COHO_0000581)
