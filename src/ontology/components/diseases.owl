ClassAssertion(Annotation(rdfs:comment "To improve the phenotypic definition of familial TGCT (FTGCT), we studied an international cohort of multiple-case TGCT families to determine whether first-degree relatives of FTGCT cases are at increased risk of other types of cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25882629+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "testicular germ cell tumor") ObjectSomeValuesFrom(coho:has_participants_at_risk_of obo:MONDO_0010108) coho:COHO_0000825)
ClassAssertion(Annotation(rdfs:comment "With the GEFOS project we here propose to capitalize on the success of GENOMOS by using the most advanced gene discovery tools that have become recently available, i.e., Genome Wide Association (GWA) analysis with high density SNP arrays, to identify common risk gene variants for osteoporosis.") Annotation(oboInOwl:hasDbXref "http://www.gefos.org/") Annotation(obo:IAO_0000116 "osteoporosis") ObjectSomeValuesFrom(coho:is_population_study_of obo:MONDO_0005298) coho:COHO_0000826)
