# Class: <http://purl.obolibrary.org/obo/MONDO_0100233> (long COVID-19)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100233> "A chronic disease triggered by acute COVID-19 infection that is characterized by persistent symptoms following the acute phase of the SARS-CoV-2 infection, which may include fatigue, coughing, dyspnea, clouding of mentation, sleep disturbances, exercise intolerance and autonomic symptoms including tachycardia upon mild exercise or standing, night sweats, temperature dysregulation, gastroparesis, constipation or loose stools, and peripheral vasoconstriction.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100233> "long COVID-19")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100233> <http://purl.obolibrary.org/obo/MONDO_0100320>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100313> (focal segmental glomerulosclerosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100313> "A renal disorder characterized by sclerotic lesions in the glomeruli. Causes include drugs, viruses, and malignancies (lymphomas), or it may be idiopathic. It presents with asymptomatic proteinuria or nephritic syndrome and it may lead to renal failure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100313> "focal segmental glomerulosclerosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100313> <http://purl.obolibrary.org/obo/MONDO_0000490>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100313> <http://purl.obolibrary.org/obo/MONDO_0700328>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100320> (post-COVID-19 disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100320> "A SARS-CoV-2-related disease that is caused by infection by SARS-CoV-2, and manifests after the original primary infection.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100320> "post-COVID-19 disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100320> <http://purl.obolibrary.org/obo/MONDO_0021674>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100329> (primary viral infectious disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100329> "The initial viral infectious disase that causes illness.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100329> "primary viral infectious disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100329> <http://purl.obolibrary.org/obo/MONDO_0005108>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100342> (malignant glioma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100342> "A grade III or grade IV glioma arising from the central nervous system. This category includes glioblastoma, anaplastic astrocytoma, anaplastic ependymoma, anaplastic oligodendroglioma, and anaplastic oligoastrocytoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100342> "malignant glioma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100342> <http://purl.obolibrary.org/obo/MONDO_0002714>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100342> <http://purl.obolibrary.org/obo/MONDO_0020665>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100342> <http://purl.obolibrary.org/obo/MONDO_0021042>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100545> (hereditary neurological disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100545> "A heterogeneous group of genetic conditions with Mendelian (autosomal dominant, recessive, or X-linked) or chromosomal etiology characterized by abnormalities in the brain, spinal cord, nerves, or muscles.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100545> "hereditary neurological disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100545> <http://purl.obolibrary.org/obo/MONDO_0003847>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100545> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100546> (hereditary neuromuscular disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100546> "A heterogeneous group of genetic conditions with Mendelian (autosomal dominant, recessive, or X-linked) or chromosomal etiology that is characterized by progressive muscle degeneration and weakness.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100546> "hereditary neuromuscular disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100546> <http://purl.obolibrary.org/obo/MONDO_0019056>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100546> <http://purl.obolibrary.org/obo/MONDO_0100545>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100574> (generalized epilepsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100574> "Epilepsy that is characterized by generalized seizure types and may have typical interictal and/or ictal EEG findings that accompany generalized seizure types (for example generalized spike-wave).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100574> "generalized epilepsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100574> <http://purl.obolibrary.org/obo/MONDO_0005027>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100575> (genetic generalized epilepsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100575> "A generalized epilepsy that is understood to have a genetic etiology. This does not always mean that the epilepsy is inherited or can be transmitted to offspring, as the genetic etiology may be a de novo pathogenic variant, or the genetic etiology may have complex/polygenic inheritance.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100575> "genetic generalized epilepsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100575> <http://purl.obolibrary.org/obo/MONDO_0100574>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100576> (hereditary generalized epilepsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100576> "An instance of generalized epilepsy that is caused by an inherited genomic modification in an individual.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100576> "hereditary generalized epilepsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100576> <http://purl.obolibrary.org/obo/MONDO_0100545>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100576> <http://purl.obolibrary.org/obo/MONDO_0100575>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100581> (ocular growth disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100581> "An eye disorder characterized by an aberrant development of the eye resulting in significant shortening or elongation, and therefore affecting the final ocular dimensions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100581> "ocular growth disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100581> <http://purl.obolibrary.org/obo/MONDO_0005328>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0100637> (drug-induced myopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100637> "A myopathy caused by exposure to a drug.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100637> "drug-induced myopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100637> <http://purl.obolibrary.org/obo/MONDO_0005336>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0600023> (idiopathic inflammatory myopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0600023> "Idiopathic form of inflammatory myopathy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0600023> "idiopathic inflammatory myopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0600023> <http://purl.obolibrary.org/obo/MONDO_0021167>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700003> (obstetric disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700003> "Disorder associated with pregnancy, childbirth, and puerperium.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700003> "obstetric disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700003> <http://purl.obolibrary.org/obo/MONDO_7770007>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700007> (idiopathic disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700007> "A disease or disorder for which the cause is of uncertain or unknown.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700007> "idiopathic disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700007> <http://purl.obolibrary.org/obo/MONDO_7770008>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700038> (TDP-43 proteinopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700038> "Disease characterized by the presence of abnormally phosphorylated, ubiquitinated, and cleaved DNA-binding protein TDP-43 in affected brain and spinal cord. Inclusions of the pathologic protein in neurons and glia, without the presence of AMYLOID, is the major feature of these conditions, thus making these proteinopathies distinct from most other neurogenerative disorders in which protein misfolding leads to brain amyloidosis. Both frontotemporal lobar degeneration and AMYOTROPHIC LATERAL SCLEROSIS exhibit this common method of pathogenesis and thus they may represent two extremes of a continuous clinicopathological spectrum of one disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700038> "TDP-43 proteinopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700038> <http://purl.obolibrary.org/obo/MONDO_0021179>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700057> (neurological pain disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700057> "A nervous system disorder that has pain as a major feature.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700057> "neurological pain disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700057> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700079> (hormone receptor-positive breast cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700079> "A breast carcinoma which is positive for expression of estrogen receptor (ER), progesterone receptor (PR), and is negative for expression of human epidermal growth factor receptor 2 (HER2).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700079> "hormone receptor-positive breast cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700079> <http://purl.obolibrary.org/obo/MONDO_0000615>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700079> <http://purl.obolibrary.org/obo/MONDO_0000618>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700079> <http://purl.obolibrary.org/obo/MONDO_0006512>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700092> (neurodevelopmental disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700092> "A behavioral and cognitive disorder with onset during the developmental period that involves impaired or aberrant development of intellectual, motor, or social functions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700092> "neurodevelopmental disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700092> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700096> (human disease)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700096> "human disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700096> <http://purl.obolibrary.org/obo/MONDO_0000001>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700124> (chromosome 21 disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700124> "Chromosomal disorder in which chromosome 21 is affected.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700124> "chromosome 21 disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700124> <http://purl.obolibrary.org/obo/MONDO_0020049>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700328> (podocytopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700328> "A glomerular disorder caused by the structural or functional impairment of podocytes, which leads to proteinuria and often nephrotic syndrome.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700328> "podocytopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700328> <http://purl.obolibrary.org/obo/MONDO_0019722>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0800178> (platinum-induced ototoxicity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0800178> "Progressive, bilateral, and irreversible sensorineural hearing loss as a frequently encountered side effect of platinum-based chemotherapy such as cisplatin and carboplatin.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0800178> "platinum-induced ototoxicity")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0800178> <http://purl.obolibrary.org/obo/MONDO_0020678>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0800178> <http://purl.obolibrary.org/obo/MONDO_0029000>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0800486> (metabolic bone disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0800486> "A group of disorders that affect the bones secondary to increased levels of minerals or deficient levels of minerals such as calcium, magnesium, phosphorus, and vitamin D. Representative examples are osteomalacia, osteoporosis, and Paget disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0800486> "metabolic bone disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0800486> <http://purl.obolibrary.org/obo/MONDO_0005381>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0800504> (idiopathic pulmonary fibrosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0800504> "An interstitial lung disease with a poor prognosis, that is characterized by the progressive formation of scar tissue within the lungs in the absence of any known cause.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0800504> "idiopathic pulmonary fibrosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0800504> <http://purl.obolibrary.org/obo/MONDO_0002429>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0800504> <http://purl.obolibrary.org/obo/MONDO_0015925>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0850271> (myeloid leukemia associated with down syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0850271> "An acute megakaryocytic leukemia occurring in children with Down syndrome and that has material basis in mutation in the GATA1 gene.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0850271> "myeloid leukemia associated with down syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0850271> <http://purl.obolibrary.org/obo/MONDO_0018872>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0850292> (subjective cognitive decline)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0850292> "A cognitive disorder that is characterized by the presence of significant and persistent cognitive complaints.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0850292> "subjective cognitive decline")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0850292> <http://purl.obolibrary.org/obo/MONDO_0002039>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0858950> (traumatic brain injury)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0858950> "A brain disease that is characterized by brain dysfunction caused by an outside force, usually a violent blow to the head.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0858950> "traumatic brain injury")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0858950> <http://purl.obolibrary.org/obo/MONDO_0043510>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0958099> (idiopathic subglottic stenosis)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0958099> "idiopathic subglottic stenosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0958099> <http://purl.obolibrary.org/obo/MONDO_0004382>)

# Class: <http://purl.obolibrary.org/obo/MONDO_1040015> (infectious disease with sepsis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1040015> "An infectious disease characterized by life-threatening organ dysfunction due to a dysreguated host response.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1040015> "infectious disease with sepsis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1040015> <http://purl.obolibrary.org/obo/MONDO_0005550>)

# Class: <http://purl.obolibrary.org/obo/MONDO_1060134> (atherosclerotic cardiovascular disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060134> "Any cardiovascular disease resulting from atherosclerosis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1060134> "atherosclerotic cardiovascular disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1060134> <http://purl.obolibrary.org/obo/MONDO_0005311>)

# Class: <http://purl.obolibrary.org/obo/MONDO_1060198> (ischemic stroke)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060198> "A stroke disorder caused by obstruction of blood flow to the brain, due to thrombotic (local blood clot formation) or embolic (due to a blood clot or other material traveling from another site) event.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1060198> "ischemic stroke")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1060198> <http://purl.obolibrary.org/obo/MONDO_0005098>)

# Class: <http://purl.obolibrary.org/obo/MONDO_1060199> (hemorrhagic stroke)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060199> "A stroke disorder caused by bleeding into the brain parenchyma or surrounding spaces. Hemorrhagic stroke includes intracerebral hemorrhage (bleeding within the brain tissue) and subarachnoid hemorrhage (bleeding in the space between the brain and the surrounding membrane).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1060199> "hemorrhagic stroke")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1060199> <http://purl.obolibrary.org/obo/MONDO_0005098>)

# Class: <http://purl.obolibrary.org/obo/MONDO_1060213> (reticular pseudodrusen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060213> "A retinal drusen characterized by subretinal deposits located internal to the retinal pigment epithelium, composed of material aggregations in the subretinal space between photoreceptors and the retinal pigment epithelium. These deposits have a bluish-white appearance by biomicroscopy and appear as hyperreflective lesions above the retinal pigment epithelium on optical coherence tomography.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1060213> "reticular pseudodrusen")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1060213> <http://purl.obolibrary.org/obo/MONDO_0006949>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770003> (cystic fibrosis-related diabetes)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770003> "A form of diabetes mellitus unique to individuals with cystic fibrosis (CF), arising primarily from progressive fibrotic destruction of the pancreas leading to insulin deficiency, with additional contributions from insulin resistance. CFRD affects approximately 20% of adolescents and 40-50% of adults with CF. It shares features with both type 1 and type 2 diabetes but is a distinct clinical entity with its own diagnostic criteria and management guidelines.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_7770003> "cystic fibrosis-related diabetes")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_7770003> <http://purl.obolibrary.org/obo/MONDO_0005015>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770005> (cystic fibrosis-related liver disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770005> "A liver disorder that arises as a consequence of cystic fibrosis. Cystic fibrosis-related liver disease encompasses a spectrum of hepatobiliary abnormalities caused by CFTR dysfunction in cholangiocytes, including focal biliary cirrhosis, multilobular biliary cirrhosis, hepatic steatosis, and cholangiopathy. It is a significant cause of non-pulmonary morbidity and mortality in CF, affecting approximately 5-10% of CF patients.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_7770005> "cystic fibrosis-related liver disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_7770005> <http://purl.obolibrary.org/obo/MONDO_0005154>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770006> (disease by body system or component)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770006> "A grouping class for human diseases classified by the body system or anatomical component primarily affected.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_7770006> "disease by body system or component")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_7770006> <http://purl.obolibrary.org/obo/MONDO_0700096>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770007> (disease by developmental or physiological process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770007> "A grouping class for human diseases classified by the molecular, biochemical, cellular, anatomic, developmental or physiological process that is disrupted.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_7770007> "disease by developmental or physiological process")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_7770007> <http://purl.obolibrary.org/obo/MONDO_0700096>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770008> (disease by etiologic mechanism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770008> "A grouping class for human diseases classified by their etiologic mechanism, encompassing primarily intrinsic (genetic, genomic), primarily extrinsic (e.g., infections, toxins, radiation), and complex multifactorial (e.g. nutritional) causes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_7770008> "disease by etiologic mechanism")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_7770008> <http://purl.obolibrary.org/obo/MONDO_0700096>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770009> (disease of genetic or genomic mechanism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770009> "A grouping class for human diseases caused by genetic or genomic alterations, including chromosomal abnormalities and heritable mutations.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_7770009> "disease of genetic or genomic mechanism")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_7770009> <http://purl.obolibrary.org/obo/MONDO_7770008>)

# Class: <http://purl.obolibrary.org/obo/MONDO_7770010> (disease of primarily extrinsic mechanism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_7770010> "A grouping class for human diseases caused primarily by extrinsic factors, including infections, toxins, nutritional deficiencies, iatrogenic causes, and environmental exposures.")
