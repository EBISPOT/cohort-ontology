AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0003582> "syndrome, HBOC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0003582> "syndromes, HBOC")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0003582> "hereditary breast ovarian cancer syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0003582> <http://purl.obolibrary.org/obo/MONDO_0000426>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0003582> <http://purl.obolibrary.org/obo/MONDO_0015356>)

