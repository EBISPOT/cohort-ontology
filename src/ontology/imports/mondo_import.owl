# Class: <http://purl.obolibrary.org/obo/MONDO_0012521> (herpes simplex encephalitis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:1930") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0012521> "Herpes simplex virus encephalitis (HSE) is caused by the infection of the central nervous system by Herpes simplex virus (HSV) that could have a devastating clinical course and a potentially fatal outcome particularly with delay or lack of treatment. HSV often involves the frontal and temporal lobes, usually asymmetrically, resulting in personality changes, cognitive impairment, aphasia, seizures, and focal weakness.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0012521> "herpes simplex encephalitis")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0012521> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0020067> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MONDO_0100332> <http://purl.obolibrary.org/obo/NCBITaxon_10294>)))
