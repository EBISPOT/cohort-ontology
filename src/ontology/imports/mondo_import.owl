AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0021043> "mixed neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0021043> <http://purl.obolibrary.org/obo/MONDO_0005070>)

