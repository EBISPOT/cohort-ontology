AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005093> "skin disorder")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0005093> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004026> <http://purl.obolibrary.org/obo/UBERON_0000014>)))
