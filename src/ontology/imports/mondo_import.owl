AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005814> "A malignant neoplasm involving the intestine")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005814> "intestinal cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005814> <http://purl.obolibrary.org/obo/MONDO_0002516>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005814> <http://purl.obolibrary.org/obo/MONDO_0021118>)

