AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0021074> "A pathological process with signs indicating it may become cancerous. Representative examples include leukoplakia, dysplastic nevus, actinic keratosis, xeroderma pigmentosum, and intraepithelial neoplasia.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0021074> "precancerous condition")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0021074> <http://purl.obolibrary.org/obo/MONDO_0045024>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0021076> (pancreatic exocrine neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0021076> "A benign or malignant neoplasm that arises from the epithelial cells of the exocrine pancreatic tissue.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0021076> "pancreatic exocrine neoplasm")
