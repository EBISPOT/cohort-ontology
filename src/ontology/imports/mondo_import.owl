AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0043693> "liver disease, alcoholic")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0043693> "alcoholic liver disease")
