AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0016333> "familial dilated cardiomyopathy")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0016333> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0005021> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/MONDO_0021152>)))
