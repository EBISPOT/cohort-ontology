# Class: <http://purl.obolibrary.org/obo/MONDO_0015254> (schistosomiasis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:1247") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0015254> "An infectious disease caused by parasitic trematodes of the genus Schistosoma that colonize human blood vessels and release eggs that can cause granulomatous reactions leading to acute (swimmer's itch or acute schistosomiasis syndrome) or chronic disease. Depending on where the eggs lodge, manifestations of chronic schistosomiasis can include diarrhea, abdominal pain, loss of appetite, anemia (intestines), hepatosplenism, periportal fibrosis with portal hypertension (liver), urogenital inflammation and scarring, hematuria and dysuria (genitourinary system). Other patients may be asymptomatic.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0015254> "schistosomiasis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015254> <http://purl.obolibrary.org/obo/MONDO_0004664>)
