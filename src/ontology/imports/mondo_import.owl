AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005649> "appendicitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005649> <http://purl.obolibrary.org/obo/MONDO_0002031>)
