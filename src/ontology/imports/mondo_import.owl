AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005046> "immune system disorder")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0005046> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0700096> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004026> <http://purl.obolibrary.org/obo/UBERON_0002405>)))
