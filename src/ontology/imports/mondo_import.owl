AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005296> "sleep hypopneas")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005296> "sleep apnea syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005296> <http://purl.obolibrary.org/obo/MONDO_0003406>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005296> <http://purl.obolibrary.org/obo/MONDO_0005087>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005298> (osteoporosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005298> "A condition of reduced bone mass, with decreased cortical thickness and a decrease in the number and size of the trabeculae of cancellous bone (but normal chemical composition), resulting in increased fracture incidence. Osteoporosis is classified as primary (Type 1, postmenopausal osteoporosis; Type 2, age-associated osteoporosis; and idiopathic, which can affect juveniles, premenopausal women, and middle-aged men) and secondary osteoporosis (which results from an identifiable cause of bone mass loss).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005298> "osteoporosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005298> <http://purl.obolibrary.org/obo/MONDO_0000837>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005298> <http://purl.obolibrary.org/obo/MONDO_0800486>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005299> (brain ischemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005299> "Diminished or absent blood supply to the brain caused by obstruction (thrombosis or embolism) of an artery resulting in neurologic damage.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005299> "brain ischemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005299> <http://purl.obolibrary.org/obo/MONDO_0005053>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005299> <http://purl.obolibrary.org/obo/MONDO_0011057>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005300> (chronic kidney disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005300> "Impairment of the renal function secondary to chronic kidney damage persisting for three or more months.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005300> "chronic kidney disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005300> <http://purl.obolibrary.org/obo/MONDO_0005240>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005301> (multiple sclerosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005301> "A progressive autoimmune disorder affecting the central nervous system resulting in demyelination. Patients develop physical and cognitive impairments that correspond with the affected nerve fibers.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005301> "multiple sclerosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005301> <http://purl.obolibrary.org/obo/MONDO_0000568>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005301> <http://purl.obolibrary.org/obo/MONDO_0005560>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005301> <http://purl.obolibrary.org/obo/MONDO_0006704>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005301> <http://purl.obolibrary.org/obo/MONDO_0020800>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005303> (drug dependence)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005303> "Drug dependence - replaced the term \"drug addiction\" and is defined as a state, psychic and sometimes also physical, resulting from the interaction between a living organism and a drug, characterized by behavioral and other responses that always include a compulsion to take the drug on a continuous or periodic basis in order to experience its psychic effects, and sometimes to avoid the discomfort of its absence. Tolerance may or may not be present. A person may be dependent on more than one drug.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005303> "drug dependence")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005303> <http://purl.obolibrary.org/obo/MONDO_0004938>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005306> (ankylosing spondylitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005306> "An autoimmune chronic inflammatory disorder characterized by inflammation in the vertebral joints of the spine and sacroiliac joints. It predominantly affects young males. Patients present with stiffness and pain in the spine.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005306> "ankylosing spondylitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005306> <http://purl.obolibrary.org/obo/MONDO_0003937>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005306> <http://purl.obolibrary.org/obo/MONDO_0005095>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005306> <http://purl.obolibrary.org/obo/MONDO_0008383>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005306> <http://purl.obolibrary.org/obo/MONDO_0037847>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005311> (atherosclerosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005311> "A disease characterized by the build-up of fatty material and calcium deposition in the arterial wall resulting in partial or complete occlusion of the arterial lumen.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0005311> "ICD9:440.8")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005311> "atherosclerosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005311> <http://purl.obolibrary.org/obo/MONDO_0002277>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005315> (bone fracture)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005315> "Breaks in bones.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005315> "bone fracture")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005315> <http://purl.obolibrary.org/obo/MONDO_0021178>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005328> (eye disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005328> "A non-neoplastic or neoplastic disorder that affects the eye. Representative examples include conjunctivitis, glaucoma, cataract, conjunctival squamous cell carcinoma, uveal melanoma, and retinoblastoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005328> "eye disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005328> <http://purl.obolibrary.org/obo/MONDO_0002022>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005328> <http://purl.obolibrary.org/obo/MONDO_0024458>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005335> (colorectal neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005335> "A benign or malignant neoplasm that affects the colon or rectum. Representative examples of benign neoplasms include lipoma and leiomyoma. Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma. Colorectal adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005335> "colorectal neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005335> <http://purl.obolibrary.org/obo/MONDO_0021118>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005335> <http://purl.obolibrary.org/obo/MONDO_0024634>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005336> (myopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005336> "A disease of the muscle in which the muscle fibers do not function properly. This results in muscular weakness.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005336> "myopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005336> <http://purl.obolibrary.org/obo/MONDO_0020120>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005338> (open-angle glaucoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005338> "Chronic outflow obstruction of the eye's drainage canals that can lead to increased internal eye pressure and optic nerve damage.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005338> "open-angle glaucoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005338> <http://purl.obolibrary.org/obo/MONDO_0005041>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005341> (skin basal cell carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005341> "The most frequently seen skin cancer. It arises from basal cells of the epidermis and pilosebaceous units. Clinically it is divided into the following types: nodular, ulcerative, superficial, multicentric, erythematous, and sclerosing or morphea-like. More than 95% of these carcinomas occur in patients over 40. They develop on hair-bearing skin, most commonly on sun-exposed areas. Approximately 85% are found on the head and neck and the remaining 15% on the trunk and extremities. Basal cell carcinoma usually grows in a slow and indolent fashion. However, if untreated, the tumor may invade the subcutaneous fat, skeletal muscle and bone. Distant metastases are rare. Excision, curettage and irradiation cure most basal cell carcinomas.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005341> "skin basal cell carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005341> <http://purl.obolibrary.org/obo/MONDO_0002656>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005341> <http://purl.obolibrary.org/obo/MONDO_0020804>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005344> (hepatitis B virus infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005344> "A viral infection caused by the hepatitis B virus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005344> "hepatitis B virus infection")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005344> <http://purl.obolibrary.org/obo/MONDO_0005786>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005344> <http://purl.obolibrary.org/obo/MONDO_0006011>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005347> (hypertriglyceridemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005347> "A laboratory test result indicating elevated triglyceride concentration in the blood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005347> "hypertriglyceridemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005347> <http://purl.obolibrary.org/obo/MONDO_0005066>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005350> (abdominal aortic aneurysm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005350> "Enlargement and ballooning of the vessel that supplies arterial blood to the abdomen, pelvis and legs.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005350> "abdominal aortic aneurysm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005350> <http://purl.obolibrary.org/obo/MONDO_0005160>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005351> (anorexia nervosa)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005351> "A disorder most often seen in adolescent females characterized by a refusal to maintain a minimally normal body weight, an intense fear of gaining weight, a disturbance in body image, and, in postmenarcheal females, the development of amenorrhea.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005351> "anorexia nervosa")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005351> <http://purl.obolibrary.org/obo/MONDO_0005451>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005359> (drug-induced liver injury)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005359> "A spectrum of clinical liver diseases ranging from mild biochemical abnormalities to acute liver failure, caused by drugs, drug metabolites, and chemicals from the environment.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005359> "drug-induced liver injury")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005359> <http://purl.obolibrary.org/obo/MONDO_0005154>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005361> (eosinophilic esophagitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005361> "Eosinophilic esophagitis (EoE) is a chronic, allergic disease of the esophagus characterized clinically by symptoms of esophageal dysfunction (including vomiting, dysphagia, feeding disorders, food impaction and abdominal pain) which persist after treatment with proton pump inhibitors (PPIs).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005361> "eosinophilic esophagitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005361> <http://purl.obolibrary.org/obo/MONDO_0001409>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005361> <http://purl.obolibrary.org/obo/MONDO_0018438>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005365> (hearing loss disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005365> "A partial or complete loss of hearing in one or both ears. It is classified as conductive, sensory, or central.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005365> "hearing impairment")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005365> "hearing loss disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005365> <http://purl.obolibrary.org/obo/MONDO_0021945>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005367> (heroin dependence)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005367> "Physical and psychological dependence on the drug heroin.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005367> "heroin dependence")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005367> <http://purl.obolibrary.org/obo/MONDO_0005530>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005369> (carcinoid tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005369> "A slow growing neuroendocrine tumor, composed of uniform, round, or polygonal cells having monotonous, centrally located nuclei and small nucleoli, infrequent mitoses, and no necrosis. The tumor may show a variety of patterns, such as solid, trabecular, and acinar. Electron microscopy shows small secretory granules. Immunohistochemical studies reveal NSE, as well as chromogranin immunoreactivity. Malignant histology (cellular pleomorphism, hyperchromatic nuclei, prominent nucleoli, necrosis, and mitoses) can occasionally be seen. Such cases may have an aggressive clinical course. Gastrointestinal tract and lung are common sites of involvement.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005369> "carcinoid tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005369> <http://purl.obolibrary.org/obo/MONDO_0019496>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005371> (mood disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005371> "A cognitive disorder a disturbance in which the person's mood is hypothesized to be the main underlying feature.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005371> "mood disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005371> <http://purl.obolibrary.org/obo/MONDO_0005084>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005374> (bone marrow neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005374> "Neoplasms that affect the bone marrow. Such neoplasms may arise in the bone marrow (e.g. myeloid leukemias) or may involve the bone marrow as secondary, metastatic tumors (e.g. metastatic carcinomas to the bone marrow).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005374> "bone marrow neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005374> <http://purl.obolibrary.org/obo/MONDO_0002334>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005374> <http://purl.obolibrary.org/obo/MONDO_0003225>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005377> (nephrotic syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005377> "A collection of symptoms that include severe edema, proteinuria, and hypoalbuminemia; it is indicative of renal dysfunction.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005377> "nephrotic syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005377> <http://purl.obolibrary.org/obo/MONDO_0002254>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005377> <http://purl.obolibrary.org/obo/MONDO_0002331>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005379> (neurotic disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005379> "A form of functional mental illness that manifests in distressed emotional reactions such as anxiety, obsessive thoughts, compulsive behaviors, or irrational fears.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005379> "Psychoneuroses")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005379> "disorder, neurotic")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005379> "disorders, neurotic")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005379> "neuroses")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005379> "neurotic disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005379> <http://purl.obolibrary.org/obo/MONDO_0005618>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005381> (bone disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005381> "Diseases of bones.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005381> "bone disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005381> <http://purl.obolibrary.org/obo/MONDO_0005172>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005384> (focal epilepsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005384> "A seizure caused by a localized disorder.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005384> "focal epilepsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005384> <http://purl.obolibrary.org/obo/MONDO_0005027>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005385> (vascular disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005385> "A general term used to describe any disease affecting blood vessels]. It includes vascular abnormalities caused by degenerative, metabolic and inflammatory conditions, embolic diseases, coagulative disorders, and functional disorders such as posteri or reversible encephalopathy syndrome.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005385> "vasculopathy")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005385> "vascular disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005385> <http://purl.obolibrary.org/obo/MONDO_0004995>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005386> (peripheral arterial disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005386> "A disorder of the arteries supplying the upper and lower extremity and the visceral organs. This includes the mesenteric arteries, the renal arteries and the aorta and excludes cerebrovascular arterial disease. Patients experience cramping and pain usually in the calves and thighs while walking. The symptoms subside with rest.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005386> "peripheral arterial disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005386> <http://purl.obolibrary.org/obo/MONDO_0000473>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005386> <http://purl.obolibrary.org/obo/MONDO_0005294>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005391> (restless legs syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005391> "A condition that occurs while resting or lying in bed; it is characterized by an irresistible urgency to move the legs to obtain relief from a strange and uncomfortable sensation in the legs.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005391> "restless legs syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005391> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005393> (gout)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005393> "A condition characterized by painful swelling of the joints, which is caused by deposition of urate crystals.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005393> "gout")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005393> <http://purl.obolibrary.org/obo/MONDO_0005066>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005394> (brain infarction)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005394> "Tissue necrosis in any area of the brain, including the cerebral hemispheres, the cerebellum, and the brain stem. Brain infarction is the result of a cascade of events initiated by inadequate blood flow through the brain that is followed by hypoxia and hypoglycemia in brain tissue. Damage may be temporary, permanent, selective or pan-necrosis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005394> "brain infarction")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005394> <http://purl.obolibrary.org/obo/MONDO_0011057>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005395> (movement disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005395> "Neurological conditions resulting in abnormal voluntary or involuntary movement, which may impact the speed, fluency, quality and ease of movement.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005395> "movement disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005395> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005398> (upper aerodigestive tract neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005398> "Soft tissue tumors or cancer arising from the mucosal surfaces of the lip; oral cavity; pharynx; larynx; and cervical esophagus. Other sites included are the nose and paranasal sinuses; salivary glands; thyroid gland and parathyroid glands; and melanoma and non-melanoma skin cancers of the head and neck. (from Holland et al., Cancer Medicine, 4th ed, p1651)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005398> "upper aerodigestive tract neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005398> <http://purl.obolibrary.org/obo/MONDO_0005070>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005399> (venous thromboembolism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005399> "Occlusion of the lumen of a vein by a thrombus that has migrated from a distal site via the blood stream.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005399> "venous thromboembolism")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005399> <http://purl.obolibrary.org/obo/MONDO_0005385>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005401> (colonic neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005401> "A benign or malignant neoplasm that affects the colon. Representative examples of benign neoplasms include lipoma and leiomyoma. Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma. Colonic adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005401> "colonic neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005401> <http://purl.obolibrary.org/obo/MONDO_0003409>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005401> <http://purl.obolibrary.org/obo/MONDO_0005335>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005402> (lymphoid leukemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005402> "A malignant lymphocytic neoplasm of B-cell or T-cell lineage involving primarily the bone marrow and the peripheral blood. This category includes precursor or acute lymphoblastic leukemias and chronic leukemias.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005402> "lymphoid leukemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005402> <http://purl.obolibrary.org/obo/MONDO_0005059>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005402> <http://purl.obolibrary.org/obo/MONDO_0005157>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005405> (childhood onset asthma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005405> "Asthma that starts in childhood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005405> "childhood onset asthma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005405> <http://purl.obolibrary.org/obo/MONDO_0004979>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005406> (gestational diabetes)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005406> "Carbohydrate intolerance first diagnosed during pregnancy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005406> "gestational diabetes")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0005406> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0005015> <http://purl.obolibrary.org/obo/MONDO_0024575>))
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005406> <http://purl.obolibrary.org/obo/MONDO_0005015>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005406> <http://purl.obolibrary.org/obo/MONDO_0024575>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005411> (gallbladder cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005411> "A malignant neoplasm involving the gall bladder")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005411> "gallbladder cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005411> <http://purl.obolibrary.org/obo/MONDO_0002516>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005411> <http://purl.obolibrary.org/obo/MONDO_0021253>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005414> (treatment-refractory schizophrenia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005414> "Schizophrenia which does not respond to commonly used treatments.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005414> "treatment-refractory schizophrenia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005414> <http://purl.obolibrary.org/obo/MONDO_0005090>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005416> (osteoarthritis, knee)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005416> "Noninflammatory degenerative disease of the knee joint consisting of three large categories: conditions that block normal synchronous movement, conditions that produce abnormal pathways of motion, and conditions that cause stress concentration resulting in changes to articular cartilage. (Crenshaw, Campbell's Operative Orthopaedics, 8th ed, p2019)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005416> "osteoarthritis, knee")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005416> <http://purl.obolibrary.org/obo/MONDO_0005178>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005439> (familial hypercholesterolemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005439> "An inheritable form of hyperlipidemia, in which there are excess lipids in the blood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005439> "familial hypercholesterolemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005439> <http://purl.obolibrary.org/obo/MONDO_0001336>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005439> <http://purl.obolibrary.org/obo/MONDO_0037748>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005447> (testicular cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005447> "A primary or metastatic malignant neoplasm that affects the testis. Representative examples include seminoma, embryonal carcinoma, sarcoma, leukemia, and lymphoma.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005447> "paediatric testicular neoplasm")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005447> "testicular cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005447> <http://purl.obolibrary.org/obo/MONDO_0005836>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005447> <http://purl.obolibrary.org/obo/MONDO_0021348>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005451> (eating disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005451> "A broad group of psychological disorders with abnormal eating behaviors leading to physiological effects from overeating or insufficient food intake.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005451> "eating disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005451> <http://purl.obolibrary.org/obo/MONDO_0002025>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005451> <http://purl.obolibrary.org/obo/MONDO_0005137>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005454> (lung neuroendocrine neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005454> "A low, intermediate, or high grade malignant neoplasm with neuroendocrine differentiation that arises from the lung. This category includes typical carcinoid tumor, atypical carcinoid tumor, small cell carcinoma, large cell neuroendocrine carcinoma, and combined carcinoma.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005454> "pulmonary neuroendocrine tumour")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005454> "lung neuroendocrine neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005454> <http://purl.obolibrary.org/obo/MONDO_0019496>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005454> <http://purl.obolibrary.org/obo/MONDO_0021117>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005459> (human African trypanosomiasis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005459> "A parasitic disorder caused by protozoa of the Trypanosoma brucei species. It is transmitted by flies and is endemic in various regions of Sub-Saharan Africa. Signs and symptoms include fever, joint pain, headache, and significant swelling of the lymph nodes. If left untreated, the parasitic infection causes anemia, heart, kidney, and endocrine failure, and neurologic damage. Subsequently patients develop confusion, disruption of the sleep cycle, and mental deterioration. The infection may lead to coma and death.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005459> "human African trypanosomiasis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005459> <http://purl.obolibrary.org/obo/MONDO_0000940>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005459> <http://purl.obolibrary.org/obo/MONDO_0100120>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005462> (primitive neuroectodermal tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005462> "A malignant neoplasm that originates in the neuroectoderm. The neuroectoderm constitutes the portion of the ectoderm of the early embryo that gives rise to the central and peripheral nervous systems and includes some glial cell precursors.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005462> "primitive neuroectodermal tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005462> <http://purl.obolibrary.org/obo/MONDO_0005564>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005462> <http://purl.obolibrary.org/obo/MONDO_0021193>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005484> (colorectal adenoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005484> "An adenoma that arises from the colon or rectum. The group of colorectal adenomas includes tubular, villous, and tubulovillous adenomas, traditional serrated adenomas, sessile serrated adenomas/polyps, and familial adenomatous polyposis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005484> "colorectal adenoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005484> <http://purl.obolibrary.org/obo/MONDO_0005335>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005484> <http://purl.obolibrary.org/obo/MONDO_0006180>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005485> (psychotic disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005485> "An abnormal condition of the mind that involves a loss of contact with reality. People experiencing psychosis may exhibit personality changes and thought disorder. Depending on its severity, this may be accompanied by unusual or bizarre behavior, as well as difficulty with social interaction and impairment in carrying out daily life activities.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005485> "psychotic disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005485> <http://purl.obolibrary.org/obo/MONDO_0002039>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005485> <http://purl.obolibrary.org/obo/MONDO_0005084>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005487> (schizoaffective disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005487> "A disorder in which the individual suffers from both symptoms that qualify as schizophrenia and symptoms that qualify as a mood disorder (e.g., depression or bipolar disorder) for a substantial portion (but not all) of the active period of the illness; for the remainder of the active period of the illness, the individual suffers from delusions or hallucinations in the absence of prominent mood symptoms.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005487> "schizoaffective disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005487> <http://purl.obolibrary.org/obo/MONDO_0005485>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005489> (dyslexia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005489> "A learning disorder characterized by an impairment in processing written words. Reading difficulties can include distortions, omissions or substitutions of characters. Oral and silent reading difficulties can include faulty and slow comprehension.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005489> "dyslexia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005489> <http://purl.obolibrary.org/obo/MONDO_0001697>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005494> (triple-negative breast carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005494> "An invasive breast carcinoma which is negative for expression of estrogen receptor (ER), progesterone receptor (PR), and human epidermal growth factor receptor 2 (HER2).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005494> "triple-negative breast carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005494> <http://purl.obolibrary.org/obo/MONDO_0000616>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005494> <http://purl.obolibrary.org/obo/MONDO_0000618>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005494> <http://purl.obolibrary.org/obo/MONDO_0006513>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005503> (developmental disorder of mental health)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005503> "A disease of mental health that occur during a child's developmental period between birth and age 18 resulting in retarding of the child's psychological or physical development.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005503> "developmental disorder of mental health")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005503> <http://purl.obolibrary.org/obo/MONDO_0005084>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005515> (oral cavity cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005515> "A primary or metastatic malignant neoplasm involving the oral cavity. The majority are squamous cell carcinomas.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005515> "oral cavity cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005515> <http://purl.obolibrary.org/obo/MONDO_0002516>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005515> <http://purl.obolibrary.org/obo/MONDO_0021245>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005517> (pharynx cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005517> "A primary or metastatic malignant neoplasm that affects the pharynx.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005517> "pharynx cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005517> <http://purl.obolibrary.org/obo/MONDO_0000376>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005517> <http://purl.obolibrary.org/obo/MONDO_0002516>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005517> <http://purl.obolibrary.org/obo/MONDO_0020592>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005517> <http://purl.obolibrary.org/obo/MONDO_0021246>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005517> <http://purl.obolibrary.org/obo/MONDO_0021310>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005530> (opiate dependence)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005530> "Disorders related or resulting from abuse or mis-use of opioids.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005530> "opiate dependence")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005530> <http://purl.obolibrary.org/obo/MONDO_0005303>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005542> (acute coronary syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005542> "Signs and symptoms related to acute ischemia of the myocardium secondary to coronary artery disease. The clinical presentation covers a spectrum of heart diseases from unstable angina to myocardial infarction.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005542> "acute coronary syndromes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005542> "coronary syndrome, acute")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005542> "coronary syndromes, acute")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005542> "syndrome, acute coronary")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005542> "syndromes, acute coronary")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005542> "acute coronary syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005542> <http://purl.obolibrary.org/obo/MONDO_0002254>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005542> <http://purl.obolibrary.org/obo/MONDO_0020683>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005542> <http://purl.obolibrary.org/obo/MONDO_0024644>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005549> (renal cell adenocarcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005549> "A carcinoma arising from the renal parenchyma. There is a strong correlation between cigarette smoking and the development of renal cell carcinoma. The clinical presentation includes : hematuria, flank pain and a palpable lumbar mass. A high percentage of renal cell carcinomas are diagnosed when an ultrasound is performed for other purposes. Radical nephrectomy is the standard intervention procedure. Renal cell carcinoma is generally considered to be resistant to radiation treatment and chemotherapy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005549> "renal cell adenocarcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005549> <http://purl.obolibrary.org/obo/MONDO_0005086>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005550> (infectious disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005550> "A disorder directly resulting from the presence and activity of a microbial, viral, or parasitic agent in humans. It can be transmitted by direct or indirect contact.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005550> "infectious disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005550> <http://purl.obolibrary.org/obo/MONDO_7770010>)
DisjointClasses(<http://purl.obolibrary.org/obo/MONDO_0005550> <http://purl.obolibrary.org/obo/MONDO_0019751>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005552> (ocular vascular disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005552> "A disorder that is caused by pathologic changes in the ocular vasculature.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005552> "ocular vascular disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005552> <http://purl.obolibrary.org/obo/MONDO_0005328>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005552> <http://purl.obolibrary.org/obo/MONDO_0005385>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005554> (rheumatic disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005554> "Inflammatory and degenerative diseases of connective tissue structures, such as arthritis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005554> "disease, rheumatic")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005554> "diseases, rheumatic")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005554> "enthesopathies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005554> "enthesopathy")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005554> "rheumatism")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005554> "rheumatic disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005554> <http://purl.obolibrary.org/obo/MONDO_0003900>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005558> (ovarian disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005558> "A disease involving the ovary.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005558> "ovarian disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005558> <http://purl.obolibrary.org/obo/MONDO_0002259>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005558> <http://purl.obolibrary.org/obo/MONDO_0002263>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005559> (neurodegenerative disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005559> "A disorder of the central nervous system characterized by gradual and progressive loss of neural tissue and neurologic function.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005559> "neurodegenerative disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005559> <http://purl.obolibrary.org/obo/MONDO_0002602>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005560> (brain disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005560> "A disease affecting the brain or part of the brain.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005560> "brain disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005560> <http://purl.obolibrary.org/obo/MONDO_0002602>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005561> (aortic disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005561> "Pathology involving the thoracic, thoracoabdominal, or abdominal aorta (including aneurysms). (ACC)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005561> "aortic disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005561> <http://purl.obolibrary.org/obo/MONDO_0000473>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005564> (embryonal neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005564> "A usually malignant neoplasm composed of primitive (immature) tissues that resemble fetal tissues. Medulloblastoma, Ependymoblastoma, Pineoblastoma, and Wilms tumor are representative embryonal neoplasms. --2003")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005564> "EMBT")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005564> "embryonal neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005564> <http://purl.obolibrary.org/obo/MONDO_0005070>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005570> (hematologic disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005570> "A disease involving the hematopoietic system.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0005570> "GTR:AN1320635")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005570> "haematological disorders and malignancies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005570> "hematological disorders and malignancies")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005570> "hematologic disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005570> <http://purl.obolibrary.org/obo/MONDO_7770006>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005574> (tauopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005574> "Neurodegenerative disorders involving deposition of abnormal tau protein isoforms (tau proteins) in neurons and glial cells in the brain. Pathological aggregations of tau proteins are associated with mutation of the tau gene on chromosome 17 in patients with alzheimer disease; dementia; parkinsonian disorders; progressive supranuclear palsy (supranuclear palsy, progressive); and corticobasal degeneration.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005574> "tauopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005574> <http://purl.obolibrary.org/obo/MONDO_0005559>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005574> <http://purl.obolibrary.org/obo/MONDO_7770011>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005575> (colorectal cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005575> "A primary or metastatic malignant neoplasm that affects the colon or rectum. Representative examples include carcinoma, lymphoma, and sarcoma.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005575> "CRC")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005575> "colorectal cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005575> <http://purl.obolibrary.org/obo/MONDO_0005335>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005575> <http://purl.obolibrary.org/obo/MONDO_0005814>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005578> (arthritic joint disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005578> "An inflammatory process affecting a joint. Causes include infection, autoimmune processes, degenerative processes, and trauma. Signs and symptoms may include swelling around the affected joint and pain.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005578> "arthritic joint disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005578> <http://purl.obolibrary.org/obo/MONDO_0002614>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005578> <http://purl.obolibrary.org/obo/MONDO_0006816>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005578> <http://purl.obolibrary.org/obo/MONDO_0021166>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005579> (idiopathic generalized epilepsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005579> "A generalised epilepsy that encompasses several common seizure phenotypes including childhood absence epilepsy, juvenile absence epilepsy, juvenile myoclonic epilepsy and epilepsy with generalized tonic-clonic seizures alone. These epilepsy syndromes have polygenic inheritance with or without environmental factors contributing to seizure susceptibility. Seizure types include one or a combination of absence seizures, myoclonic seizures and/or generalized tonic-clonic seizures.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005579> "idiopathic generalized epilepsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005579> <http://purl.obolibrary.org/obo/MONDO_0100576>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005580> (esophageal squamous cell carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005580> "Esophageal squamous cell carcinoma (ESCC) is a type of esophageal carcinoma (EC) that can affect any part of the esophagus, but is usually located in the upper or middle third.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005580> "esophageal squamous cell carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005580> <http://purl.obolibrary.org/obo/MONDO_0005096>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005580> <http://purl.obolibrary.org/obo/MONDO_0019086>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005586> (head and neck neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005586> "A benign or malignant neoplasm that affects the anatomic structures of the head and neck region. Representative examples of benign neoplasms include salivary gland pleomorphic adenoma and nasal cavity papilloma. Representative examples of malignant neoplasms include oral cavity squamous cell carcinoma, laryngeal squamous cell carcinoma, and salivary gland carcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005586> "head and neck neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005586> <http://purl.obolibrary.org/obo/MONDO_0005070>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005606> (tubular adenocarcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005606> "An infiltrating adenocarcinoma in which the malignant cells form tubular structures. Representative examples include the tubular breast carcinoma and the gastric tubular adenocarcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005606> "tubular adenocarcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005606> <http://purl.obolibrary.org/obo/MONDO_0004970>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005607> (chronic bronchitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005607> "A type of chronic obstructive pulmonary disease characterized by chronic inflammation in the bronchial tree that results in edema, mucus production, obstruction, and reduced airflow to and from the lung alveoli. The most common cause is tobacco smoking. Signs and symptoms include coughing with excessive mucus production, and shortness of breath.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005607> "chronic bronchitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005607> <http://purl.obolibrary.org/obo/MONDO_0003781>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005607> <http://purl.obolibrary.org/obo/MONDO_0005002>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005618> (anxiety disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005618> "A category of psychiatric disorders which are characterized by anxious feelings or fear often accompanied by physical symptoms associated with anxiety.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005618> "anxiety disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005618> <http://purl.obolibrary.org/obo/MONDO_0005084>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005623> (autoimmune thyroid disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005623> "Inflammatory disease of the thyroid gland due to autoimmune responses leading to lymphocytic infiltration of the gland. It is characterized by the presence of circulating thyroid antigen-specific T-cells and thyroid autoantibodies. The clinical signs can range from hypothyroidism to thyrotoxicosis depending on the type of autoimmune thyroiditis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005623> "autoimmune thyroiditides")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005623> "autoimmune thyroiditis")
