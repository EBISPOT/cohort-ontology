AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0000940> "trypanosomiasis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0000940> <http://purl.obolibrary.org/obo/MONDO_0002428>)

