SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0010150> <http://purl.obolibrary.org/obo/MONDO_0005096>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0010643> (acute leukemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0010643> "A clonal (malignant) hematopoietic disorder with an acute onset, affecting the bone marrow and the peripheral blood. The malignant cells show minimal differentiation and are called blasts, either myeloid blasts (myeloblasts) or lymphoid blasts (lymphoblasts).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0010643> "stem cell leukaemia")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0010643> "stem cell leukaemia (disease)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0010643> "stem cell leukemia (disease)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0010643> "acute leukemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0010643> <http://purl.obolibrary.org/obo/MONDO_0005059>)
