AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002367> "Primary or metastatic malignant neoplasm involving the kidney.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002367> "kidney cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002367> <http://purl.obolibrary.org/obo/MONDO_0006295>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002367> <http://purl.obolibrary.org/obo/MONDO_0021163>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002406> (dermatitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002406> "An inflammatory process affecting the skin. Signs include red rash, itching, and blister formation. Representative examples are contact dermatitis, atopic dermatitis, and seborrheic dermatitis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002406> "dermatitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002406> <http://purl.obolibrary.org/obo/MONDO_0005093>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002406> <http://purl.obolibrary.org/obo/MONDO_0021166>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002409> (auditory system disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002409> "A disease involving the auditory system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002409> "auditory system disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002409> <http://purl.obolibrary.org/obo/MONDO_7770006>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002427> (cerebellar disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002427> "Diseases that affect the structure or function of the cerebellum. Cardinal manifestations of cerebellar dysfunction include dysmetria, gait ataxia, and muscle hypotonia.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002427> "cerebellar disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002427> <http://purl.obolibrary.org/obo/MONDO_0005560>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002428> (protozoa infectious disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002428> "An infection that is caused by protozoans.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002428> "protozoa infectious disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002428> <http://purl.obolibrary.org/obo/MONDO_0005135>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002429> (idiopathic interstitial pneumonia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002429> "A class of diffuse lung diseases that typically affect the pulmonary interstitium, although some also have a component affecting the airways (for instance, Cryptogenic organizing pneumonitis).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002429> "idiopathic interstitial pneumonia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002429> <http://purl.obolibrary.org/obo/MONDO_0005249>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002429> <http://purl.obolibrary.org/obo/MONDO_0700007>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002436> (nasal disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002436> "A disease involving the nose.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002436> "nasal disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002436> <http://purl.obolibrary.org/obo/MONDO_0024623>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002465> (bronchiolitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002465> "Inflammation of the bronchioles characterized by swelling of the bronchioles and mucus accumulation. It is usually caused by the respiratory syncytial virus and affects children. Signs and symptoms include coughing, wheezing, and shortness of breath.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002465> "bronchiolitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002465> <http://purl.obolibrary.org/obo/MONDO_0005275>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002480> (endometrioid tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002480> "A benign, borderline, or malignant epithelial tumor of the female reproductive system characterized by the presence of glands and/or cysts lined by neoplastic cells that resemble endometrial cells.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002480> "endometrioid tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002480> <http://purl.obolibrary.org/obo/MONDO_0005626>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002480> <http://purl.obolibrary.org/obo/MONDO_0021148>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002491> (substance abuse)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002491> "The use of a drug for a reason other than which it was intended or in a manner or in quantities other than directed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002491> "substance abuse")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002491> <http://purl.obolibrary.org/obo/MONDO_0002494>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002492> (acute kidney injury)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002492> "Sudden and sustained deterioration of the kidney function characterized by decreased glomerular filtration rate, increased serum creatinine or oliguria.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002492> "acute kidney injury")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002492> <http://purl.obolibrary.org/obo/MONDO_0001106>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002492> <http://purl.obolibrary.org/obo/MONDO_0020683>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002494> (substance-related disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002494> "A category of psychiatric disorders which include disorders related to the taking of a drug of abuse (including alcohol, prescribed medications and recreational drugs).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002494> "substance-related disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002494> <http://purl.obolibrary.org/obo/MONDO_0002025>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002514> (hepatobiliary neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002514> "A benign or malignant neoplasm that affects the liver parenchyma, bile ducts, and gallbladder. Representative examples of benign neoplasms include hepatocellular adenoma, bile duct adenoma, and gallbladder lipoma. Representative examples of malignant neoplasms include hepatocellular carcinoma, intrahepatic and extrahepatic cholangiocarcinoma, and gallbladder carcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002514> "hepatobiliary neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002514> <http://purl.obolibrary.org/obo/MONDO_0002515>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002514> <http://purl.obolibrary.org/obo/MONDO_0021223>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002515> (hepatobiliary disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002515> "A non-neoplastic or neoplastic disorder that affects the liver, bile ducts, and gallbladder. Representative examples of non-neoplastic disorders include hepatitis, cirrhosis, cholangitis, and cholecystitis. Representative examples of neoplastic disorders include hepatocellular adenoma, hepatocellular carcinoma, and cholangiocarcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002515> "hepatobiliary disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002515> <http://purl.obolibrary.org/obo/MONDO_0004335>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002516> (digestive system cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002516> "A primary or metastatic malignant neoplasm involving any part of the digestive system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002516> "digestive system cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002516> <http://purl.obolibrary.org/obo/MONDO_0004335>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002516> <http://purl.obolibrary.org/obo/MONDO_0004992>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002516> <http://purl.obolibrary.org/obo/MONDO_0021223>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002525> (inherited lipid metabolism disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002525> "An inherited metabolic disorder caused by an enzyme deficiency, resulting in an inability to oxidize fatty acids for energy production.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002525> "inherited lipid metabolism disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002525> <http://purl.obolibrary.org/obo/MONDO_0019052>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002529> (skin squamous cell carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002529> "A carcinoma arising from the squamous cells of the epidermis. Skin squamous cell carcinoma is most commonly found on sun-exposed areas. The majority of the tumors are well-differentiated.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002529> "CSCC")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002529> "skin squamous cell carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002529> <http://purl.obolibrary.org/obo/MONDO_0002656>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002529> <http://purl.obolibrary.org/obo/MONDO_0005096>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002531> (skin neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002531> "A benign or malignant tumor involving the skin. Representative examples of benign skin neoplasms include the benign melanocytic skin nevus, acanthoma, sebaceous adenoma, sweat gland adenoma, lipoma, hemangioma, fibroma, and benign fibrous histiocytoma. Representative examples of malignant skin neoplasms include basal cell carcinoma, squamous cell carcinoma, melanoma, and Kaposi sarcoma.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002531> "skin")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002531> "skin neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002531> <http://purl.obolibrary.org/obo/MONDO_0005070>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002531> <http://purl.obolibrary.org/obo/MONDO_0005093>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002532> (squamous cell neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002532> "A neoplasm that is composed of squamous epithelial cells. Squamous cell carcinoma is a representative example.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002532> "squamous cell neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002532> <http://purl.obolibrary.org/obo/MONDO_0005626>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002545> (spinal cord disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002545> "A disease involving the spinal cord.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002545> "spinal cord disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002545> <http://purl.obolibrary.org/obo/MONDO_0002602>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002546> (schwannoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002546> "A benign, usually encapsulated slow growing tumor composed of Schwann cells. It affects peripheral and cranial nerves. It recurs infrequently and only rare cases associated with malignant transformation have been reported.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002546> "SCHW")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002546> "neurolemmoma")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002546> "schwannoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002546> <http://purl.obolibrary.org/obo/MONDO_0002547>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002546> <http://purl.obolibrary.org/obo/MONDO_0016752>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002546> <http://purl.obolibrary.org/obo/MONDO_0021637>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002547> (nerve sheath neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002547> "A benign or malignant neoplasm arising from the perineural cells in the sheaths surrounding the nerves. Representative examples include neurofibroma, schwannoma, and malignant peripheral nerve sheath tumor.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002547> "nerve sheath neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002547> <http://purl.obolibrary.org/obo/MONDO_0001406>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002547> <http://purl.obolibrary.org/obo/MONDO_0021042>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002562> (demyelinating disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002562> "A broad group of disorders that affect the myelin sheaths that cover the neurons. Myelin sheathes cover neuronal axons in the central and peripheral nervous system and function to increase traveling impulse speeds. Disruption of this sheath impairs neuronal transmission and can result in disorders such as multiple sclerosis and Guillain-Barre syndrome, among others.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002562> "demyelinating disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002562> <http://purl.obolibrary.org/obo/MONDO_0005559>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002562> <http://purl.obolibrary.org/obo/MONDO_0021147>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002567> (tracheal disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002567> "A non-neoplastic or neoplastic disorder that affects the trachea. Representative examples of non-neoplastic disorders include congenital malformations and infection. Representative examples of neoplastic disorders include carcinoma and lymphoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002567> "tracheal disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002567> <http://purl.obolibrary.org/obo/MONDO_0000270>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002567> <http://purl.obolibrary.org/obo/MONDO_0004867>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002602> (central nervous system disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002602> "A disease involving the central nervous system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002602> "central nervous system disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002602> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002614> (bone inflammation disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002614> "Inflammation of the bone.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002614> "bone inflammation disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002614> <http://purl.obolibrary.org/obo/MONDO_0005381>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002616> (mesenchymal cell neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002616> "A benign, intermediate, or malignant neoplasm that arises from the mesenchyma-derived cells of the soft tissue or bone. Representative examples include lipoma, leiomyoma, leiomyosarcoma and osteosarcoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002616> "mesenchymal cell neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002616> <http://purl.obolibrary.org/obo/MONDO_0005070>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002635> (periodontal disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002635> "An inflammatory process of the gingival tissues and/or periodontal membrane of the teeth, resulting in an abnormally deep gingival sulcus, possibly producing periodontal pockets and loss of alveolar bone support.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002635> "periodontal disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002635> <http://purl.obolibrary.org/obo/MONDO_0005172>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002654> (uterine disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002654> "A non-neoplastic or neoplastic disorder that affects the uterine corpus or the cervix. Representative examples of non-neoplastic disorders include endometritis and cervicitis. Representative examples of neoplastic disorders include endometrial carcinoma, carcinosarcoma, and cervical carcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002654> "uterine disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002654> <http://purl.obolibrary.org/obo/MONDO_0002263>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002656> (skin carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002656> "A carcinoma that arises from epithelial cells of the zone of skin")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002656> "skin carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002656> <http://purl.obolibrary.org/obo/MONDO_0002898>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002656> <http://purl.obolibrary.org/obo/MONDO_0004993>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002656> <http://purl.obolibrary.org/obo/MONDO_0021634>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002657> (breast disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002657> "A disease involving the breast.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002657> "breast disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002657> <http://purl.obolibrary.org/obo/MONDO_7770006>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002659> (uveal cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002659> "A primary or metastatic malignant neoplasm that affects the choroid, ciliary body, or iris.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002659> "uveal cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002659> <http://purl.obolibrary.org/obo/MONDO_0002236>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002659> <http://purl.obolibrary.org/obo/MONDO_0021225>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002661> (uveal disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002661> "A non-neoplastic or neoplastic disorder that affects the uvea. Representative examples include uveitis, chorioretinitis, and uveal melanoma.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002661> "disorder of uveal tract")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002661> "uveal diseases")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002661> "uveal disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002661> <http://purl.obolibrary.org/obo/MONDO_0005328>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002679> (cerebral infarction)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002679> "An ischemic condition of the brain, producing a persistent focal neurological deficit in the area of distribution of the cerebral arteries.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002679> "cerebral infarction")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002679> <http://purl.obolibrary.org/obo/MONDO_0005394>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002679> <http://purl.obolibrary.org/obo/MONDO_1060198>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0002691> (liver cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0002691> "An epithelial or non-epithelial malignant neoplasm that arises from the liver. Representative examples include hepatocellular carcinoma, intrahepatic cholangiocarcinoma, lymphoma, and sarcoma.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002691> "primary cancer of liver")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002691> "primary tumor of the liver")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0002691> "primary tumour of the liver")
