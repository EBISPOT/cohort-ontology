AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0021065> "pleural neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0021065> <http://purl.obolibrary.org/obo/MONDO_0002037>)
