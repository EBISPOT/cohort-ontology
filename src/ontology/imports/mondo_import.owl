SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006955> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004027> <http://purl.obolibrary.org/obo/UBERON_0000948>))

# Class: <http://purl.obolibrary.org/obo/MONDO_0006969> (sialadenitis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://rarediseases.info.nih.gov/diseases/7638/sialadenitis") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006969> "Sialadenitis is an infection of the salivary glands. It is usually caused by a virus or bacteria. The parotid (in front ofthe ear) and submandibular (under the chin) glands are most commonly affected. Sialadenitis may be associated with pain, tenderness, redness, and gradual, localized swelling of the affected area. Sialadenitis most commonly affects the elderly and chronically ill especially those with dry mouth or who are dehydrated, but can also affected people of any age including newborn babies. Diagnosis is usually made by clinical exam but a CT scan, MRI scan or ultrasound may be done if the doctor suspects an abscess or to look for stones. Treatment may include an antibiotic (if bacterial), warm compresses, increasing fluid intake and good oral hygiene. Most salivary gland infections go away on their own or are cured with treatment. Complications are not common.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GARD:0007638") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006969> "adenitis, salivary gland")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GARD:0007638") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006969> "salivary gland inflammation")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006969> "sialadenitis")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0006969> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0002052> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004026> <http://purl.obolibrary.org/obo/UBERON_0001044>)))
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006969> <http://purl.obolibrary.org/obo/MONDO_0001142>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006969> <http://purl.obolibrary.org/obo/MONDO_0002052>)

