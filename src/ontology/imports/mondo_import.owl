AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006026> "urinary bladder disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006026> <http://purl.obolibrary.org/obo/MONDO_0002118>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006041> (lung carcinoid tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006041> "A neuroendocrine neoplasm that arises from the lung. It is characterized by the presence of uniform polygonal cells with small or moderate amount of cytoplasm and inconspicuous nucleoli. The cells are usually arranged in organoid and trabecular patterns. It is classified as typical or atypical carcinoid tumor based on the number of mitotic figures and the absence or presence of necrosis. Atypical carcinoid tumors have a worse prognosis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006041> "lung carcinoid")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006041> "lung carcinoid tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006041> <http://purl.obolibrary.org/obo/MONDO_0005369>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006041> <http://purl.obolibrary.org/obo/MONDO_0005454>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006047> (pancreatic adenocarcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006047> "A carcinoma that arises from glandular epithelial cells of the pancreas")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006047> "PAAD")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006047> "pancreatic adenocarcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006047> <http://purl.obolibrary.org/obo/MONDO_0004970>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006047> <http://purl.obolibrary.org/obo/MONDO_0005192>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006054> (reproductive system neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006054> "A benign or malignant, primary or metastatic neoplasm affecting the male and female reproductive system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006054> "reproductive system neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006054> <http://purl.obolibrary.org/obo/MONDO_0005039>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006054> <http://purl.obolibrary.org/obo/MONDO_0005070>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006058> (Wilms tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006058> "An embryonal neoplasm characterized by the presence of epithelial, mesenchymal, and blastema components. The vast majority of cases arise from the kidney. A small number of cases with morphologic features resembling Wilms tumor of the kidney have been reported arising from the ovary and the cervix.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006058> "Wilms tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006058> <http://purl.obolibrary.org/obo/MONDO_0005564>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006058> <http://purl.obolibrary.org/obo/MONDO_0005853>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006061> (cervical artery dissection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006061> "A tear within the wall of any of the arteries of the neck (carotid artery or vertebral artery) and that allows blood to separate the wall layers. By separating a portion of the wall of the artery (a layer of the Tunica intima or tunica media), a dissection creates two lumens or passages within the vessel, the native or true lumen, and the \"false lumen\" created by the new space within the wall of the artery.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006061> "cervical artery dissection")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006061> <http://purl.obolibrary.org/obo/MONDO_0000473>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006116> (breast carcinoma by gene expression profile)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006116> "A header term that includes the following breast carcinoma subtypes determined by gene expression profiling: luminal A breast carcinoma, luminal B breast carcinoma, HER2 positive breast carcinoma, basal-like breast carcinoma, triple-negative breast carcinoma, and normal breast-like subtype of breast carcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006116> "breast carcinoma by gene expression profile")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006116> <http://purl.obolibrary.org/obo/MONDO_0004989>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006130> (central nervous system neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006130> "A benign or malignant, primary or metastatic neoplasm that affects the brain, meninges, or spinal cord. Representative examples of primary neoplasms include astrocytoma, oligodendroglioma, ependymoma, and meningioma. Representative examples of metastatic neoplasms include carcinoma and leukemia.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006130> "central nervous system neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006130> <http://purl.obolibrary.org/obo/MONDO_0002602>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006130> <http://purl.obolibrary.org/obo/MONDO_0021248>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006180> (digestive system adenoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006180> "A sporadic or less frequently familial neoplasm, arising from the glandular epithelium of the stomach, small intestine, biliary tract, colon, and rectum. It is a polypoid or flat circumscribed lesion. Morphologically, it is characterized by a proliferation of neoplastic glandular cells and it is associated with dysplasia. According to the growth pattern, it may be classified as tubular, villous, or tubulovillous. The dysplasia is classified as mild, moderate, or severe. The frequency of malignant transformation depends on the size of the lesion and the degree of dysplasia. Larger adenomas with severe dysplastic changes (sometimes called carcinoma in situ) carry a higher risk of progressing to invasive adenocarcinoma. Gastrointestinal adenomas may present as solitary or multifocal lesions. Familial adenomas tend to be multifocal and carry a higher risk of malignant transformation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006180> "digestive system adenoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006180> <http://purl.obolibrary.org/obo/MONDO_0004972>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006180> <http://purl.obolibrary.org/obo/MONDO_0021223>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006181> (digestive system carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006181> "A malignant neoplasm that arises from the epithelium of any part of the digestive system. Representative examples include colorectal carcinoma, esophageal carcinoma, and pancreatic carcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006181> "digestive system carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006181> <http://purl.obolibrary.org/obo/MONDO_0002516>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006181> <http://purl.obolibrary.org/obo/MONDO_0004993>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006209> (fibroblastic neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006209> "A benign, intermediate, or malignant mesenchymal neoplasm characterized by the presence of neoplastic fibroblasts.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006209> "fibroblastic neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006209> <http://purl.obolibrary.org/obo/MONDO_0002616>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006209> <http://purl.obolibrary.org/obo/MONDO_0021581>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006244> (HER2 positive breast carcinoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006244> "A biologic subset of breast carcinoma defined by high expression of HER2, GRB7, and TRAP100, and by lack of expression of estrogen receptor (ER).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006244> "HER2 positive breast carcinoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006244> <http://purl.obolibrary.org/obo/MONDO_0006116>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006292> (malignant mesothelioma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006292> "A malignant neoplasm of the pleura or peritoneum, arising from mesothelial cells. It is associated with exposure to asbestos.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006292> "MESOM")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006292> "malignant mesothelioma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006292> <http://purl.obolibrary.org/obo/MONDO_0004992>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006292> <http://purl.obolibrary.org/obo/MONDO_0005065>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006294> (pleural cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006294> "A primary or metastatic malignant neoplasm affecting the pleura. A representative example of primary malignant pleural neoplasm is the malignant pleural mesothelioma. A representative example of metastatic malignant neoplasm to the pleura is metastatic carcinoma that has spread to the pleura from another anatomic site.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006294> "pleural cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006294> <http://purl.obolibrary.org/obo/MONDO_0000376>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006294> <http://purl.obolibrary.org/obo/MONDO_0003274>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006294> <http://purl.obolibrary.org/obo/MONDO_0021065>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006295> (malignant urinary system neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006295> "A primary or metastatic malignant tumor involving the urinary system. Common tumor types include carcinomas, lymphomas, and sarcomas.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006295> "malignant urinary system neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006295> <http://purl.obolibrary.org/obo/MONDO_0004992>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006295> <http://purl.obolibrary.org/obo/MONDO_0021066>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006316> (neuroblastic tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006316> "A group of nervous system tumors which display neuronal differentiation. It includes tumors that are composed of immature round cells and tumors that display advanced differentiation and the formation of ganglion cells.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006316> "neuroblastic tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006316> <http://purl.obolibrary.org/obo/MONDO_0005462>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006325> (ocular melanoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006325> "A melanoma that arises from the structures of the eye or ocular adnexa.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006325> "OM")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006325> "ocular melanoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006325> <http://purl.obolibrary.org/obo/MONDO_0002236>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006325> <http://purl.obolibrary.org/obo/MONDO_0005105>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006345> (palmar fibromatosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006345> "A superficial fibromatosis arising from the soft tissue of the palm. It is characterized by the presence of spindle-shaped fibroblasts, and an infiltrative growth pattern. It predominantly affects adult males.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006345> "palmar fibromatosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006345> <http://purl.obolibrary.org/obo/MONDO_0016037>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006424> (soft tissue neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006424> "A benign, intermediate, or malignant neoplasm that arises from the soft tissue. The most common types are lipomatous (fatty), vascular, smooth muscle, fibrous, and fibrohistiocytic neoplasms.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006424> "SOFT_TISSUE")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006424> "soft tissue neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006424> <http://purl.obolibrary.org/obo/MONDO_0044334>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006485> (uterine carcinosarcoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006485> "A usually aggressive malignant neoplasm arising from the uterine corpus and less often the cervix. It is characterized by the presence of two components: a malignant epithelial component and a sarcomatous component. In the uterine corpus the epithelial component is usually glandular whereas in the cervix is usually non-glandular. Carcinosarcoma of the cervix, although it is aggressive, it may have a better prognosis compared to the uterine corpus carcinosarcoma.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006485> "uterine carcinosarcoma/uterine malignant mixed mullerian tumor")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006485> "uterine carcinosarcoma/uterine malignant mixed mullerian tumour")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006485> "uterine carcinosarcoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006485> <http://purl.obolibrary.org/obo/MONDO_0002715>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006485> <http://purl.obolibrary.org/obo/MONDO_0002928>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006486> (uveal melanoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006486> "A melanoma derived from melanocytes of the uveal tract. It is the most common primary intraocular tumor in the United States and Western Europe. Similar to melanoma of the skin, it is rare in Africa and Asia. Diagnostic procedures include ophthalmoscopic exam, fluorescein angiography and ultrasound. Treatment includes: surgical excision of the eye, iridocyclectomy and tumor resection. Recent treatments also include radiotherapy or photo coagulation. Classification of uveal melanomas recognizes four cell types within these tumors: epithelioid, intermediate, mixed cell, and spindle cell types. The spindle cell type uveal melanomas are further sub-classified as spindle cell type A and spindle cell type B.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006486> "uveal melanoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006486> <http://purl.obolibrary.org/obo/MONDO_0002659>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006486> <http://purl.obolibrary.org/obo/MONDO_0006325>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006496> (palsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006496> "A general term most often used to describe severe or complete loss of muscle strength due to motor system disease from the level of the cerebral cortex to the muscle fiber. This term may also occasionally refer to a loss of sensory function. (From Adams et al., Principles of Neurology, 6th ed, p45)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006496> "palsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006496> <http://purl.obolibrary.org/obo/MONDO_0002602>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006497> (cerebral palsy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006497> "A group of disorders affecting the development of movement and posture, often accompanied by disturbances of sensation, perception, cognition, and behavior. It results from damage to the fetal or infant brain.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006497> "cerebral palsy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006497> <http://purl.obolibrary.org/obo/MONDO_0006496>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006497> <http://purl.obolibrary.org/obo/MONDO_0044996>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006502> (acute respiratory distress syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006502> "Progressive and life-threatening pulmonary distress in the absence of an underlying pulmonary condition, usually following major trauma or surgery. Cases of neonatal respiratory distress syndrome are not included in this definition.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "ALI")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "Stiff lung")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "acute lung injury")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "increased-permeability pulmonary edema")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "increased-permeability pulmonary oedema")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "non-cardiogenic pulmonary edema")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0006502> "non-cardiogenic pulmonary oedema")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006502> "acute respiratory distress syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006502> <http://purl.obolibrary.org/obo/MONDO_0001208>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006502> <http://purl.obolibrary.org/obo/MONDO_0002254>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006512> (estrogen-receptor positive breast cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006512> "A subtype of breast cancer that is estrogen-receptor positive")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006512> "estrogen-receptor positive breast cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006512> <http://purl.obolibrary.org/obo/MONDO_0006116>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006513> (estrogen-receptor negative breast cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006513> "A subtype of breast cancer that is estrogen-receptor negative")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006513> "estrogen-receptor negative breast cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006513> <http://purl.obolibrary.org/obo/MONDO_0006116>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006517> (childhood malignant neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006517> "A malignant tumor that occurs in children. Representative examples include soft tissue and bone sarcomas (e.g. osteosarcoma) and embryonal neoplasms (e.g. hepatoblastoma and rhabdoid tumor).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006517> "childhood malignant neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006517> <http://purl.obolibrary.org/obo/MONDO_0004992>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006517> <http://purl.obolibrary.org/obo/MONDO_0021079>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006519> (rectal cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006519> "A primary or metastatic malignant neoplasm that affects the rectum. Representative examples include carcinoma, lymphoma, and sarcoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006519> "rectal cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006519> <http://purl.obolibrary.org/obo/MONDO_0002165>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006519> <http://purl.obolibrary.org/obo/MONDO_0005575>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006559> (hidradenitis suppurativa)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006559> "A chronic suppurative and cicatricial disease of the apocrine glands occurring chiefly in the axillae in women and in the groin and anal regions in men. It is characterized by poral occlusion with secondary bacterial infection, evolving into abscesses which eventually rupture. As the disease becomes chronic, ulcers appear, sinus tracts enlarge, fistulas develop, and fibrosis and scarring become evident.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006559> "hidradenitis suppurativa")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006559> <http://purl.obolibrary.org/obo/MONDO_0002260>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006615> (sweat gland disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006615> "A disease involving the sweat gland.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006615> "sweat gland disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006615> <http://purl.obolibrary.org/obo/MONDO_0005093>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006626> (diabetic neuropathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006626> "A chronic, pathological complication associated with diabetes mellitus, where nerve damages are incurred due to diabetic microvascular injury involving small blood vessels that supply these nerves, resulting in peripheral and/or autonomic nerve dysfunction.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006626> "diabetic neuropathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006626> <http://purl.obolibrary.org/obo/MONDO_0005244>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006644> (alcoholic liver cirrhosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006644> "A disorder of the liver characterized by the presence of fibrotic scar tissue instead of healthy liver tissue. This condition is attributed to excessive consumption of alcoholic beverages.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006644> "alcoholic liver cirrhosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006644> <http://purl.obolibrary.org/obo/MONDO_0005155>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006644> <http://purl.obolibrary.org/obo/MONDO_0043693>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006704> (CNS demyelinating autoimmune disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006704> "Conditions characterized by loss or dysfunction of myelin (see myelin sheath) in the brain, spinal cord, or optic nerves secondary to autoimmune mediated processes. This may take the form of a humoral or cellular immune response directed toward myelin or oligodendroglia associated autoantigens.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006704> "CNS demyelinating autoimmune disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006704> <http://purl.obolibrary.org/obo/MONDO_0007179>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006761> (fibromuscular dysplasia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006761> "A disorder characterized by fibrous thickening of the arterial wall resulting in narrowing of the arterial lumen. It most often affects the renal artery and less often the carotid artery and abdominal arteries. It can cause hypertension and aneurysm formation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006761> "fibromuscular dysplasia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006761> <http://purl.obolibrary.org/obo/MONDO_0000473>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006761> <http://purl.obolibrary.org/obo/MONDO_0003847>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006769> (gastroparesis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006769> "Paralysis of the muscles of the stomach wall resulting in delayed emptying of the gastric contents into the small intestine.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006769> "gastroparesis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006769> <http://purl.obolibrary.org/obo/MONDO_0001318>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006816> (arthropathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006816> "Any disorder of the joints.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006816> "arthropathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006816> <http://purl.obolibrary.org/obo/MONDO_0005172>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006856> (mesothelial neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006856> "A benign or malignant neoplasm arising from mesothelial cells. Mesothelial cells are the lining cells of the pleura and peritoneum. -- 2003")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006856> "mesothelial neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006856> <http://purl.obolibrary.org/obo/MONDO_0005070>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006858> (mouth disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006858> "A disease involving the mouth.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006858> "mouth disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006858> <http://purl.obolibrary.org/obo/MONDO_7770006>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006920> (prediabetes syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006920> "A condition in which blood glucose levels are high, but not high enough to be classified as type 2 diabetes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006920> "prediabetes syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006920> <http://purl.obolibrary.org/obo/MONDO_0002908>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0006949> (retinal drusen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006949> "Colloid or hyaline bodies lying beneath the retinal pigment epithelium. They may occur either secondary to changes in the choroid that affect the pigment epithelium or as an autosomal dominant disorder of the retinal pigment epithelium.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006949> "retinal drusen")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006949> <http://purl.obolibrary.org/obo/MONDO_0002175>)

