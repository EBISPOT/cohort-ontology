SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005087> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004026> <http://purl.obolibrary.org/obo/UBERON_0001004>))

# Class: <http://purl.obolibrary.org/obo/MONDO_0005089> (sarcoma)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C9118") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005089> "A usually aggressive malignant neoplasm of the soft tissue or bone. It arises from muscle, fat, fibrous tissue, bone, cartilage, and blood vessels. Sarcomas occur in both children and adults. The prognosis depends largely on the degree of differentiation (grade) of the neoplasm. Representative subtypes are liposarcoma, leiomyosarcoma, osteosarcoma, and chondrosarcoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005089> "sarcoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005089> <http://purl.obolibrary.org/obo/MONDO_0004992>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005090> (schizophrenia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:P378") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005090> "A major psychotic disorder characterized by abnormalities in the perception or expression of reality. It affects the cognitive and psychomotor functions. Common clinical signs and symptoms include delusions, hallucinations, disorganized thinking, and retreat from reality.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005090> "schizophrenia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005090> <http://purl.obolibrary.org/obo/MONDO_0005485>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0005093> (skin disorder)

