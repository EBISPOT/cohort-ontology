AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0019722> "GTR:AN0966176")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019722> "glomerulopathies")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019722> "glomerular disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019722> <http://purl.obolibrary.org/obo/MONDO_0005240>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019751> (autoinflammatory syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019751> "A group of disorders of the innate immune system characterized by attacks of seemingly unprovoked inflammation without significant levels of either autoantibodies or autoreactive T cells more characteristic of autoimmune disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019751> "autoinflammatory syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019751> <http://purl.obolibrary.org/obo/MONDO_0002254>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019751> <http://purl.obolibrary.org/obo/MONDO_0005554>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019781> (astrocytoma (excluding glioblastoma))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019781> "A tumor of the brain or spinal cord showing astrocytic differentiation. It includes the following clinicopathological entities: pilocytic astrocytoma, diffuse astrocytoma, anaplastic astrocytoma, pleomorphic xanthoastrocytoma, and subependymal giant cell astrocytoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019781> "astrocytoma (excluding glioblastoma)")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019781> <http://purl.obolibrary.org/obo/MONDO_0021636>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0020049> (autosomal anomaly)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0020049> "Chromosomal disorder in which the chromosomal anomaly involves an autosome.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0020049> "autosomal anomaly")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0020049> <http://purl.obolibrary.org/obo/MONDO_0019040>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0020076> (myeloproliferative neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0020076> "A clonal hematopoietic stem cell disorder, characterized by proliferation in the bone marrow of one or more of the myeloid (i.e., granulocytic, erythroid, megakaryocytic, and mast cell) lineages. It is primarily a neoplasm of adults. (WHO 2008)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0020076> "chronic myeloproliferative disorders")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0020076> "myeloproliferative neoplasms")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0020076> "myeloproliferative neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0020076> <http://purl.obolibrary.org/obo/MONDO_0005170>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0020076> <http://purl.obolibrary.org/obo/MONDO_0015756>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0020076> <http://purl.obolibrary.org/obo/MONDO_0021138>)

