AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006025> "Autosomal recessive form of disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006025> "autosomal recessive disease")
