# Class: <http://purl.obolibrary.org/obo/MONDO_0004943> (orbit sarcoma)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:P378") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0004943> "A malignant soft tissue neoplasm that arises from the structures of the orbit. The majority of the cases are rhabdomyosarcomas.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0004943> "orbit sarcoma")
