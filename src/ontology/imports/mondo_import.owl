# Class: <http://purl.obolibrary.org/obo/MONDO_0011382> (sickle cell disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011382> "Sickle cell anemias are chronic hemolytic diseases that may induce three types of acute accidents: severe anemia, severe bacterial infections, and ischemic vasoocclusive accidents (VOA) caused by sickle-shaped red blood cells obstructing small blood vessels and capillaries. Many diverse complications can occur.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011382> "HPA 1 recognition polymorphism, beta-globin-related")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011382> "HPA1")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011382> "Haemoglobin S disease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011382> "HbS disease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011382> "Hemoglobin S disease")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011382> "sickle cell disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011382> <http://purl.obolibrary.org/obo/MONDO_0006025>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011382> <http://purl.obolibrary.org/obo/MONDO_0019050>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0011385> (intervertebral disk degenerative disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011385> "Any disease of a degenerative nature that affects the intervertebral disk.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011385> "intervertebral disk degenerative disorder")
