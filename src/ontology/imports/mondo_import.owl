AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0010108> "nonseminomatous germ cell tumours")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0010108> "testicular germ cell tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0010108> <http://purl.obolibrary.org/obo/MONDO_0018202>)
