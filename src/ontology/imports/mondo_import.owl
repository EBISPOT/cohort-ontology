AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0001020> "amblyopia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0001020> <http://purl.obolibrary.org/obo/MONDO_0021084>)

