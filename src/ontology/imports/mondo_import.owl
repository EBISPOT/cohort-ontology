# Class: <http://purl.obolibrary.org/obo/MONDO_0006955> (rheumatic heart disease)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C34882") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006955> "An autoinflammatory condition following an infection with Group A Beta Hemolytic Streptococcus (GABHS), in which the heart is attacked by antibodies formed in reaction to a recent GABHS infection. Chief anatomic changes of the valve include leaflet thickening, commissural fusion, and shortening and thickening of the tendinous cords, all of which can result in valvular dysfunction.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006955> "rheumatic heart disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0006955> <http://purl.obolibrary.org/obo/MONDO_0005267>)
