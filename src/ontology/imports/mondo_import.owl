AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0002329> "testicular disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0002329> <http://purl.obolibrary.org/obo/MONDO_0002259>)
