AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005853> "A malignant neoplasm composed of a carcinomatous epithelial component and a sarcomatous mesenchymal component. Representative examples include malignant mixed mesodermal (Mullerian) tumor of the female reproductive system and carcinosarcoma of the salivary gland and the lung.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005853> "malignant mixed tumors")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005853> "malignant mixed tumours")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005853> "mixed tumors, malignant")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005853> "tumor, malignant mixed")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0005853> "tumors, malignant mixed")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005853> "malignant mixed neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005853> <http://purl.obolibrary.org/obo/MONDO_0004992>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0005853> <http://purl.obolibrary.org/obo/MONDO_0021043>)

