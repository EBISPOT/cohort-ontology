AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0005110> "idiopathic cardiomyopathy")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0005110> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0004994> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/MONDO_0700005>)))
