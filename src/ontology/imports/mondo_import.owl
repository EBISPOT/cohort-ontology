AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011962> "Primary or metastatic malignant neoplasm involving the endometrium (mucous membrane that lines the endometrial cavity).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011962> "endometrial cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011962> <http://purl.obolibrary.org/obo/MONDO_0002715>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011962> <http://purl.obolibrary.org/obo/MONDO_0021251>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0012038> (speech-sound disorder)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0012038> "SSD")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0012038> "speech-sound disorder")
