AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0001056> "A primary or metastatic malignant neoplasm involving the stomach.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0001056> "gastric cancer")
