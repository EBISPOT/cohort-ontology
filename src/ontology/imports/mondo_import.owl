AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0021079> "childhood neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0021079> <http://purl.obolibrary.org/obo/MONDO_0005070>)

