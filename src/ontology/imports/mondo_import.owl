# Class: <http://purl.obolibrary.org/obo/MONDO_0011429> (juvenile idiopathic arthritis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011429> "Juvenile idiopathic arthritis (JIA) is the term used to describe a group of inflammatory articular disorders of unknown cause that begin before the age of 16 and last over 6 weeks. The term juvenile idiopathic arthritis was chosen to signify the absence of any known mechanism underlying the disorder and to highlight the necessity of excluding other types of arthritis occurring in well defined diseases (in particular arthritis occurring in association with infectious, inflammatory and haematooncologic diseases).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011429> "juvenile idiopathic arthritis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011429> <http://purl.obolibrary.org/obo/MONDO_0005554>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011429> <http://purl.obolibrary.org/obo/MONDO_0005578>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011429> <http://purl.obolibrary.org/obo/MONDO_0700007>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0011565> (metabolic syndrome X)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011565> "AOMS1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0011565> "abdominal obesity metabolic syndrome")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011565> "metabolic syndrome X")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011565> <http://purl.obolibrary.org/obo/MONDO_0000816>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0011786> (allergic rhinitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011786> "Inflammation of the nasal mucous membranes caused by an IgE-mediated response to external allergens. The inflammation may also involve the mucous membranes of the sinuses, eyes, middle ear, and pharynx. Symptoms include sneezing, nasal congestion, rhinorrhea, and itching. It may lead to fatigue, drowsiness, and malaise thus causing impairment of the quality of life.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011786> "allergic rhinitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011786> <http://purl.obolibrary.org/obo/MONDO_0000771>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011786> <http://purl.obolibrary.org/obo/MONDO_0003014>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0011849> (psoriatic arthritis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011849> "Joint inflammation associated with psoriasis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0011849> "psoriatic arthritis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011849> <http://purl.obolibrary.org/obo/MONDO_0002254>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0011849> <http://purl.obolibrary.org/obo/MONDO_0008383>)

