AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29763173") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-1149-7767") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.hopkinsmedicine.org/health/conditions-and-diseases/stroke/types-of-stroke") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.stroke.org.uk/stroke/types") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060199> "A stroke disorder caused by bleeding into the brain parenchyma or surrounding spaces. Hemorrhagic stroke includes intracerebral hemorrhage (bleeding within the brain tissue) and subarachnoid hemorrhage (bleeding in the space between the brain and the surrounding membrane).")
