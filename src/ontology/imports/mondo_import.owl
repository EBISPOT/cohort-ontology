# Class: <http://purl.obolibrary.org/obo/MONDO_0037255> (ovarian serous tumor)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C8431") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0037255> "A benign, borderline, or malignant epithelial tumor of the ovary characterized by the presence of neoplastic epithelial cells that, in well differentiated tumors, resemble the epithelial cells of the fallopian tube and, in poorly differentiated tumors, show anaplastic features. Approximately thirty to fifty percent of the tumors are bilateral. Grossly, the better differentiated tumors consist of cystic masses, usually unilocular, containing a clear but sometimes viscous fluid. Papillary formations are often present. The more malignant tumors tend to be solid and invasive, with areas of necrosis and hemorrhage.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0037255> "ovarian serous tumor")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0037255> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0037256> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004026> <http://purl.obolibrary.org/obo/UBERON_0000992>)))
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0037255> <http://purl.obolibrary.org/obo/MONDO_0002229>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0037255> <http://purl.obolibrary.org/obo/MONDO_0037256>)

