AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0000931> "A non-neoplastic or neoplastic disorder that affects the endometrium. Representative examples include endometritis, endometrial hyperplasia, and endometrial carcinoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0000931> "endometrial disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0000931> <http://purl.obolibrary.org/obo/MONDO_0002654>)

