AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ONCOTREE:HCCIHCH") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018531> "hepatocellular carcinoma plus intrahepatic cholangiocarcinoma")
