AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0016749> "tumor of cranial and spinal nerves")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0016749> <http://purl.obolibrary.org/obo/MONDO_0021248>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0016752> (benign peripheral nerve sheath tumor)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0016752> "benign peripheral nerve sheath tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0016752> <http://purl.obolibrary.org/obo/MONDO_0016749>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017181> (hypnic headache)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0017181> "Conditions in which the primary symptom is headache and the headache cannot be attributed to any known causes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017181> "hypnic headache")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017181> <http://purl.obolibrary.org/obo/MONDO_0021146>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017276> (frontotemporal dementia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0017276> "Frontotemporal dementia (FTD) comprises a group of neurodegenerative disorders, characterized by progressive changes in behavior, executive dysfunction and language impairment, as a result of degeneration of the medial prefrontal and frontoinsular cortices. Four clinical subtypes have been identified: semantic dementia, progressive non-fluent aphasia, behavioral variant FTD and right temporal lobar atrophy.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0017276> "MSTD")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0017276> "frontotemporal lobe dementia (FLDEM)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017276> "frontotemporal dementia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017276> <http://purl.obolibrary.org/obo/MONDO_0015547>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017276> <http://purl.obolibrary.org/obo/MONDO_0024237>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017341> (virus associated tumor)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017341> "virus associated tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017341> <http://purl.obolibrary.org/obo/MONDO_0005070>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017341> <http://purl.obolibrary.org/obo/MONDO_0021674>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017342> (Epstein-Barr virus-related tumor)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017342> "Epstein-Barr virus-related tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017342> <http://purl.obolibrary.org/obo/MONDO_0017341>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017343> (Epstein-Barr virus-associated lymphoproliferative disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0017343> "A range of lymphoproliferative diseases characterized by uncontrolled proliferation of B cells, T cells, or NK cells infected with Epstein-Barr virus. Depending on host immunity and viral factors, viral persistence in host cells can induce lymphoproliferation with a diverse clinical spectrum ranging from simple reactive hyperplasia to aggressive lymphoma/leukemia with unique clinical and pathological presentations.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017343> "Epstein-Barr virus-associated lymphoproliferative disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017343> <http://purl.obolibrary.org/obo/MONDO_0017342>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017594> (indolent B-cell non-Hodgkin lymphoma)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0017594> "B cell lymphoma, indolent")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0017594> "indolent B cell lymphoma")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017594> "indolent B-cell non-Hodgkin lymphoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017594> <http://purl.obolibrary.org/obo/MONDO_0015759>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0017595> (aggressive B-cell non-Hodgkin lymphoma)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017595> "aggressive B-cell non-Hodgkin lymphoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0017595> <http://purl.obolibrary.org/obo/MONDO_0015759>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018076> (tuberculosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018076> "A chronic, recurrent infection caused by the bacterium Mycobacterium tuberculosis. Tuberculosis (TB) may affect almost any tissue or organ of the body with the lungs being the most common site of infection. The clinical stages of TB are primary or initial infection, latent or dormant infection, and recrudescent or adult-type TB. Ninety to 95% of primary TB infections may go unrecognized. Histopathologically, tissue lesions consist of granulomas which usually undergo central caseation necrosis. Local symptoms of TB vary according to the part affected; acute symptoms include hectic fever, sweats, and emaciation; serious complications include granulomatous erosion of pulmonary bronchi associated with hemoptysis. If untreated, progressive TB may be associated with a high degree of mortality. This infection is frequently observed in immunocompromised individuals with AIDS or a history of illicit IV drug use.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018076> "Kochs disease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018076> "TB")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018076> "tuberculosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018076> <http://purl.obolibrary.org/obo/MONDO_0000314>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018076> <http://purl.obolibrary.org/obo/MONDO_0020590>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018078> (soft tissue sarcoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018078> "A malignant neoplasm arising from muscle tissue, adipose tissue, blood vessels, fibrous tissue, or other supportive tissues excluding the bones.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018078> "soft tissue sarcoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018078> <http://purl.obolibrary.org/obo/MONDO_0005089>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018078> <http://purl.obolibrary.org/obo/MONDO_0024637>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018155> (lateral sclerosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018155> "Primary lateral sclerosis (PLS) is an idiopathic non-familial motor neuron disease characterized by slowly progressive upper motor neuron dysfunction leading to spasticity, mild weakness in voluntary muscle movement, hyperreflexia, and loss of motor speech production.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018155> "lateral sclerosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018155> <http://purl.obolibrary.org/obo/MONDO_0024257>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018202> (gonadal germ cell tumor)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018202> "gonadal germ cell tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018202> <http://purl.obolibrary.org/obo/MONDO_0005040>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018364> (malignant epithelial tumor of ovary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018364> "An invasive malignant tumor that originates from the surface epithelium of the ovary. It is composed of malignant epithelial cells and stroma. Representative examples include serous adenocarcinoma, mucinous adenocarcinoma, endometrioid adenocarcinoma, clear cell adenocarcinoma, and malignant Brenner tumor.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018364> "malignant epithelial tumor of ovary")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018364> <http://purl.obolibrary.org/obo/MONDO_0002229>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018364> <http://purl.obolibrary.org/obo/MONDO_0004993>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018364> <http://purl.obolibrary.org/obo/MONDO_0008170>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018438> (eosinophilic gastrointestinal disease)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018438> "eosinophilic gastrointestinal disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018438> <http://purl.obolibrary.org/obo/MONDO_0005020>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018531> (carcinoma of liver and intrahepatic biliary tract)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018531> "A carcinoma that arises from the hepatocytes or intrahepatic bile ducts. The main subtypes are hepatocellular carcinoma (hepatoma) and cholangiocarcinoma.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018531> "hepatocellular carcinoma plus intrahepatic cholangiocarcinoma")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018531> "carcinoma of liver and intrahepatic biliary tract")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018531> <http://purl.obolibrary.org/obo/MONDO_0002691>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018531> <http://purl.obolibrary.org/obo/MONDO_0006181>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018630> (hereditary nonpolyposis colon cancer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018630> "A cancer-predisposing condition characterized by the development of colorectal cancer not associated with colorectal polyposis, endometrial cancer, and various other cancers (such as malignant epithelial tumor of ovary, gastric, biliary tract, small bowel, and urinary tract cancer) that are frequently diagnosed at an early age.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018630> "hereditary nonpolyposis colon cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018630> <http://purl.obolibrary.org/obo/MONDO_0015356>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018630> <http://purl.obolibrary.org/obo/MONDO_0023113>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018660> (hemophilia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018660> "Hemophilia is a genetic disorder characterized by spontaneous hemorrhage or prolonged bleeding due to factor VIII or IX deficiency.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018660> "hemophilia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018660> <http://purl.obolibrary.org/obo/MONDO_0002242>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018687> (progressive muscular atrophy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018687> "A rare, milder form of amyotrophic lateral sclerosis. It is characterized by a slowly progressive clinical course. Signs and symptoms include muscle weakness, atrophy, and fasciculation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018687> "progressive muscular atrophy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018687> <http://purl.obolibrary.org/obo/MONDO_0004976>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018872> (acute megakaryoblastic leukemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018872> "Acute megakaryoblastic leukemia (AMKL) is a form of acute myeloid leukemia (AML) that occurs predominantly in childhood and particularly in children with Down syndrome (DS-AMKL). Nonspecific symptoms may be irritability, weakness, and dizziness while specific symptoms include pallor, fever, mucocutaneous bleeding, hepatosplenomegaly, neurological manifestations and rarely lymphadenopathy. Acute panmyelosis with myelofibrosis may also be associated with AMKL. In contrast to DS-AMKL (around 80 % survival), non-DS-AMKL is an AML subgroup associated with poor prognosis.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018872> "acute myeloblastic leukaemia type 7")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018872> "acute myeloblastic leukemia type 7")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018872> "megakaryocytic leukaemia")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018872> "acute megakaryoblastic leukemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018872> <http://purl.obolibrary.org/obo/MONDO_0015667>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018874> (acute myeloid leukemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018874> "Acute myeloid leukemia (AML) is a group of neoplasms arising from precursor cells committed to the myeloid cell-line differentiation. All of them are characterized by clonal expansion of myeloid blasts. AML manifests by fever, pallor, anemia, hemorrhages and recurrent infections.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018874> "acute non lymphoblastic leukaemia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018874> "acute non lymphoblastic leukemia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018874> "leukemia, acute myeloid")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018874> "acute myeloid leukemia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018874> <http://purl.obolibrary.org/obo/MONDO_0004643>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018874> <http://purl.obolibrary.org/obo/MONDO_0010643>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018881> (myelodysplastic syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018881> "A clonal hematopoietic disorder characterized by dysplasia and ineffective hematopoiesis in one or more of the hematopoietic cell lines. The dysplasia may be accompanied by an increase in myeloblasts, but the number is less than 20%, which, according to the WHO guidelines, is the requisite threshold for the diagnosis of acute myeloid leukemia. It may occur de novo or as a result of exposure to alkylating agents and/or radiotherapy. (WHO, 2001)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018881> "myelodysplastic syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018881> <http://purl.obolibrary.org/obo/MONDO_0015756>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018881> <http://purl.obolibrary.org/obo/MONDO_0021058>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018882> (vasculitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018882> "Vasculitis represents a clinically heterogenous group of diseases of multifactorial etiology characterized by inflammation of either large-sized vessels (large-vessel vasculitis, e.g. Giant-cell arteritis and Takayasu arteritis), medium-sized vessels (medium-vessel vasculitis e.g. polyarteritis nodosa and Kawasaki disease), or small-sized vessels (small-vessel vasculitis, e.g. granulomatosis with polyangiitis, microscopic polyangiitis, immunoglobulin A vasculitis, and cutaneous leukocytoclastic angiitis). Vasculitis occurs at any age, may be acute or chronic, and manifests with general symptoms such as fever, weight loss and fatigue, as well as more specific clinical signs depending on the type of vessels and organs affected. The degree of severity is variable, ranging from life or sight threatening disease (e.g. Behcet disease) to relatively minor skin disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018882> "vasculitis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018882> <http://purl.obolibrary.org/obo/MONDO_0005385>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018882> <http://purl.obolibrary.org/obo/MONDO_0021166>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018905> (diffuse large B-cell lymphoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018905> "Diffuse large B-cell lymphoma is the most common subtype of non-Hodgkin lymphoma (NHL) in adults characterized by a median age of presentation in the sixth decade of life (but also rarely occurring in adolescents and children) with the initial presentation being single or multiple rapidly growing masses (that may or may not be painful) in nodal or extranodal sites (such as thyroid, skin, breast, gastrointestinal tract, testes, bone, or brain) and that can be accompanied by symptoms of fever, night sweats and weight loss. DLBCL has an aggressive disease course, with the elderly having a poorer prognosis than younger patients, and with relapses being common.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018905> "diffuse large B-cell lymphoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018905> <http://purl.obolibrary.org/obo/MONDO_0004949>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018905> <http://purl.obolibrary.org/obo/MONDO_0017595>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018906> (follicular lymphoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018906> "Follicular lymphoma is a form of non-Hodgkin lymphoma characterized by a proliferation of B cells whose nodular structure of follicular architecture is preserved.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018906> "lymphoma, follicular")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018906> "follicular lymphoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018906> <http://purl.obolibrary.org/obo/MONDO_0004949>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018906> <http://purl.obolibrary.org/obo/MONDO_0017594>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0018908> (non-Hodgkin lymphoma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018908> "Distinct from Hodgkin lymphoma both morphologically and biologically, non-Hodgkin lymphoma (NHL) is characterized by the absence of Reed-Sternberg cells, can occur at any age, and usually presents as a localized or generalized lymphadenopathy associated with fever and weight loss. The clinical course varies according to the morphologic type. NHL is clinically classified as indolent, aggressive, or having a variable clinical course. NHL can be of B-or T-/NK-cell lineage.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018908> "non-Hodgkin lymphoma")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018908> <http://purl.obolibrary.org/obo/MONDO_0005062>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019004> (kidney Wilms tumor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019004> "An embryonal pediatric tumor of the kidney which may also be seen rarely in adults. The peak incidence of Wilms tumor is between the second and fifth year of life. Microscopically, it is composed of a mixture of cellular elements (blastemal, stromal, and epithelial). The most common sites of metastasis include the regional lymph nodes, lungs, and liver.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019004> "kidney Wilms tumor")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019004> <http://purl.obolibrary.org/obo/MONDO_0002367>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019004> <http://purl.obolibrary.org/obo/MONDO_0006058>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019040> (chromosomal disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019040> "Clinical conditions caused by an abnormal chromosome constitution in which there is extra or missing chromosome material (either a whole chromosome or a chromosome segment). (from Thompson et al., Genetics in Medicine, 5th ed, p429)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "autosomal chromosome disorder")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "autosomal chromosome disorders")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "chromosome abnormality disorder")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "chromosome abnormality disorders")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "chromosome disorder, autosomal")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "chromosome disorders, autosomal")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019040> "disorder, chromosome abnormality")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019040> "chromosomal disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019040> <http://purl.obolibrary.org/obo/MONDO_7770009>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019050> (inherited hemoglobinopathy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019050> "An inherited disorder characterized by structural alterations of a globin chain within the hemoglobin molecule.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019050> "inherited hemoglobinopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019050> <http://purl.obolibrary.org/obo/MONDO_0003847>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019050> <http://purl.obolibrary.org/obo/MONDO_0044348>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019052> (inborn errors of metabolism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019052> "An inherited disorder resulting from an enzyme defect in biochemical and metabolic pathways affecting proteins, fats, carbohydrates metabolism or organelle function.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019052> "inborn errors of metabolism")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019052> <http://purl.obolibrary.org/obo/MONDO_0003847>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019052> <http://purl.obolibrary.org/obo/MONDO_0005066>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019056> (neuromuscular disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019056> "Any disease that impairs the functioning of the muscles, either directly, being pathologies of the voluntary muscle, or indirectly, being pathologies of nerves or neuromuscular junctions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019056> "neuromuscular disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019056> <http://purl.obolibrary.org/obo/MONDO_0005071>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019060> (bone neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019060> "A benign, intermediate, or malignant neoplasm involving the bone or articular cartilage.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019060> "primary bone cancer")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019060> "primary malignant neoplasm of bone")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003005>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019060> "rare bone tumour")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019060> "bone neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019060> <http://purl.obolibrary.org/obo/MONDO_0005381>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019060> <http://purl.obolibrary.org/obo/MONDO_0021581>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019064> (hereditary spastic paraplegia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019064> "Hereditary spastic paraplegias (HSP) comprise a genetically and clinically heterogeneous group of neurodegenerative disorders characterized by progressive spasticity and hyperreflexia of the lower limbs.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019064> "FSP")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019064> "familial spastic paraparesis")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019064> "hereditary spastic paraplegia")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019064> <http://purl.obolibrary.org/obo/MONDO_0003757>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019064> <http://purl.obolibrary.org/obo/MONDO_0024237>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019064> <http://purl.obolibrary.org/obo/MONDO_0100546>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019086> (carcinoma of esophagus)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019086> "Esophageal carcinoma (EC) is a tumor arising in the epithelial cells lining the esophagus and can be divided into two subtypes: esophageal squamous cell carcinoma (ESCC) and esophageal adenocarcinoma (EAC).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019086> "carcinoma of esophagus")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019086> <http://purl.obolibrary.org/obo/MONDO_0006181>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019086> <http://purl.obolibrary.org/obo/MONDO_0007576>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019118> (inherited retinal dystrophy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019118> "An instance of retinal degeneration that is caused by an inherited modification of the individual's genome.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019118> "inherited retinal dystrophy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019118> <http://purl.obolibrary.org/obo/MONDO_0004580>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019118> <http://purl.obolibrary.org/obo/MONDO_0100545>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019268> (epidermal disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019268> "A skin disease that involves the epidermis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019268> "epidermal disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019268> <http://purl.obolibrary.org/obo/MONDO_0005093>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019338> (sarcoidosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019338> "Sarcoidosis is a multisystemic disorder of unknown cause characterized by the formation of immune granulomas in involved organs.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019338> "sarcoidosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019338> <http://purl.obolibrary.org/obo/MONDO_0019751>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019467> (CD4+/CD56+ hematodermic neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019467> "An aggressive immature hematologic neoplasm formerly known as blastic NK cell lymphoma, composed of cells with a lymphoblast-like morphology. Recent evidence suggests derivation from a plasmacytoid monocyte. Patients present with cutaneous tumors and bone marrow involvement.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0019467> "blastic plasmacytoid dendritic cell")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019467> "CD4+/CD56+ hematodermic neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019467> <http://purl.obolibrary.org/obo/MONDO_0002898>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019467> <http://purl.obolibrary.org/obo/MONDO_0005170>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019467> <http://purl.obolibrary.org/obo/MONDO_0015760>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019496> (neuroendocrine neoplasm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019496> "Endocrine tumors, also referred to as neuroendocrine tumors (NETs), are defined by a common phenotype which is characterized by the expression of general markers (neuron specific enolase, chromogranin, synaptophysin) and hormone secretion products. These tumors may be localized in any part of the body and are generally discovered in non-specific situations, i.e. not immediately suggestive of NETs (tests for inherited predisposition to tumors or for a clinical syndrome caused by abnormal hormone secretion).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019496> "neuroendocrine neoplasm")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019496> <http://purl.obolibrary.org/obo/MONDO_0002082>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0019632> (Lyme disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019632> "Lyme disease (named after the towns in the USA where the disease was first identified) is a bacterial infection caused by Borrelia burgdorferi.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0019632> "Lyme disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019632> <http://purl.obolibrary.org/obo/MONDO_0000314>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019632> <http://purl.obolibrary.org/obo/MONDO_0021839>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0019632> <http://purl.obolibrary.org/obo/MONDO_0025294>)

