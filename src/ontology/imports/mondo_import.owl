AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0001063> "A malignant neoplasm involving the cardia of stomach.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0001063> "cardia cancer")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0001063> <http://purl.obolibrary.org/obo/MONDO_0001056>)

