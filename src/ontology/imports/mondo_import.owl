# Class: <http://purl.obolibrary.org/obo/MONDO_0012268> (AIDS)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0012268> "A syndrome resulting from the acquired deficiency of cellular immunity caused by the human immunodeficiency virus (HIV). It is characterized by the reduction of the Helper T-lymphocytes in the peripheral blood and the lymph nodes. Symptoms include generalized lymphadenopathy, fever, weight loss, and chronic diarrhea. Patients with AIDS are especially susceptible to opportunistic infections (usually pneumocystis carinii pneumonia, cytomegalovirus (CMV) infections, tuberculosis, candida infections, and cryptococcosis), and the development of malignant neoplasms (usually non-Hodgkin lymphoma and Kaposi sarcoma). The human immunodeficiency virus is transmitted through sexual contact, sharing of contaminated needles, or transfusion of contaminated blood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0012268> "AIDS")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0012268> <http://purl.obolibrary.org/obo/MONDO_0003780>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0012268> <http://purl.obolibrary.org/obo/MONDO_0005109>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0012511> (preterm premature rupture of the membranes)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0012511> "A female reproductive system disease characterized by rupture of chorioamniotic membranes before 37 weeks of gestation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0012511> "preterm premature rupture of the membranes")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0012511> <http://purl.obolibrary.org/obo/MONDO_0002263>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0012511> <http://purl.obolibrary.org/obo/MONDO_0003847>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0012727> (Kawasaki disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0012727> "A rare inflammatory disease characterized by an acute febrile, systemic, self-limiting, medium-vessel vasculitis primarily affecting children. It often causes acute coronary arteritis which is associated with coronary arterial aneurysms (CAA) that may be life threatening when untreated.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0012727> "Kawasaki disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0012727> <http://purl.obolibrary.org/obo/MONDO_0002052>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0012727> <http://purl.obolibrary.org/obo/MONDO_0018882>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0013153> (inflammatory bowel disease 28)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0013153> "Any inflammatory bowel disease in which the cause of the disease is a mutation in the IL10RA gene.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0013153> "inflammatory bowel disease 28")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0013153> <http://purl.obolibrary.org/obo/MONDO_0016542>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0013209> (metabolic dysfunction-associated steatotic liver disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0013209> "Metabolic dysfunction-associated steatotic liver disease (MASLD, formerly known as nonalcoholic fatty liver disease or NAFLD) is a type of liver disease that is not caused by alcohol. It typically does not cause symptoms in the early stages, but it can cause health problems due to fat accumulation, inflammation, and scarring in the liver.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013209> "NAFLD1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013209> "fatty liver disease, nonalcoholic, susceptibility to, 1")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0013209> "metabolic dysfunction-associated steatotic liver disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0013209> <http://purl.obolibrary.org/obo/MONDO_0004790>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0013282> (alpha 1-antitrypsin deficiency)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0013282> "Alpha-1-antitrypsin deficiency is a hereditary disease that develops in adulthood and is characterized by chronic liver disorders (cirrhosis), respiratory disorders (emphysema), and rarely panniculitis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013282> "A1AT deficiency")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013282> "A1ATD")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013282> "AATD")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013282> "Alpha 1 antitrypsin deficiency")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0013282> "Alpha-1 antitrypsin deficiency")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0013282> "alpha 1-antitrypsin deficiency")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0013282> <http://purl.obolibrary.org/obo/MONDO_0002254>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0013282> <http://purl.obolibrary.org/obo/MONDO_0002273>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0013282> <http://purl.obolibrary.org/obo/MONDO_0005087>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0013792> (intracerebral hemorrhage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0013792> "A cerebrovascular disorder characterized by bleeding into one or both cerebral hemispheres including the basal ganglia and the cerebral cortex. It is often associated with hypertension and craniocerebral trauma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0013792> "intracerebral hemorrhage")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0013792> <http://purl.obolibrary.org/obo/MONDO_1060199>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0015140> (early-onset autosomal dominant Alzheimer disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0015140> "A progressive dementia with reduction of cognitive functions. It presents the same phenotype as sporadic Alzheimer disease (AD) but has an early age of onset, usually before 60 years old.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0015140> "early-onset, autosomal dominant Alzheimer disease")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0015140> "early-onset autosomal dominant Alzheimer disease")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015140> <http://purl.obolibrary.org/obo/MONDO_0000426>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015140> <http://purl.obolibrary.org/obo/MONDO_0100087>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0015254> (schistosomiasis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0015254> "An infectious disease caused by parasitic trematodes of the genus Schistosoma that colonize human blood vessels and release eggs that can cause granulomatous reactions leading to acute (swimmer's itch or acute schistosomiasis syndrome) or chronic disease. Depending on where the eggs lodge, manifestations of chronic schistosomiasis can include diarrhea, abdominal pain, loss of appetite, anemia (intestines), hepatosplenism, periportal fibrosis with portal hypertension (liver), urogenital inflammation and scarring, hematuria and dysuria (genitourinary system). Other patients may be asymptomatic.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0015254> "schistosomiasis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015254> <http://purl.obolibrary.org/obo/MONDO_0004664>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015254> <http://purl.obolibrary.org/obo/MONDO_0100120>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0015356> (hereditary neoplastic syndrome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0015356> "The inherited predisposition toward getting a tumor.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0015356> "hereditary neoplastic syndrome")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015356> <http://purl.obolibrary.org/obo/MONDO_0003847>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015356> <http://purl.obolibrary.org/obo/MONDO_0020573>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015356> <http://purl.obolibrary.org/obo/MONDO_0021058>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0015474> (cryptosporidiosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0015474> "Intestinal infection with organisms of the genus Cryptosporidium. It occurs in both animals and humans. Symptoms include severe diarrhea.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0015474> "Cryptosporidioses")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0015474> "cryptosporidiosis")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015474> <http://purl.obolibrary.org/obo/MONDO_0005707>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015474> <http://purl.obolibrary.org/obo/MONDO_0024270>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0015486> (keratoconus)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0015486> "A degenerative, structural disorder of the eye, characterized by a cone-shaped protrusion of the cornea. It may lead to visual disturbances.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0015486> "KC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0015486> "noninflammatory corneal thining")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0015486> "keratoconus")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0015486> <http://purl.obolibrary.org/obo/MONDO_0000942>)
