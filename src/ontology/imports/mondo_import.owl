AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ONCOTREE:MNGT") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0016743> "meningothelial tumor")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0016743> "tumor of meninges")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0016743> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0005070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004026> <http://purl.obolibrary.org/obo/UBERON_0010743>)))
