# Class: <http://purl.obolibrary.org/obo/MONDO_0018174> (hereditary glaucoma)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:359") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018174> "Hereditary glaucoma is a clinically diverse group of rare eye disorders with genetic predisposition characterized by elevated intraocular pressure (IOP) and glaucomatous changes of the optic nerve head, leading to field defects, visual loss and blindness. Hereditary glaucoma can be sub-classified as primary (congenital glaucoma, juvenile glaucoma) or secondary according to the presence or absence of systemic or other ocular anomalies (iridogoniodysgenesis, Stickler syndrome, Coats syndrome). The clinical presentation is variable and is based on age, severity of glaucoma, presence of ocular abnormalities and development of secondary IOP related abnormalities.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GARD:0002486") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MONDO_0018174> "glaucoma, hereditary")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0018174> "hereditary glaucoma")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0018174> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0005041> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/MONDO_0021152>)))
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018174> <http://purl.obolibrary.org/obo/MONDO_0003847>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0018174> <http://purl.obolibrary.org/obo/MONDO_0005041>)

