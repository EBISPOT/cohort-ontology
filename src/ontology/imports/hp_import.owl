AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0410324> "Dust mite allergy")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0410324> <http://purl.obolibrary.org/obo/HP_0012393>)

