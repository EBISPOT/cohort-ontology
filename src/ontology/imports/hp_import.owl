AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5210001> "Unusual gram-positive bacterial infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210001> <http://purl.obolibrary.org/obo/HP_5210000>)

