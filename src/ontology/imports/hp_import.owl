# Class: <http://purl.obolibrary.org/obo/HP_0000001> (All)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000001> "All")

# Class: <http://purl.obolibrary.org/obo/HP_0000079> (Abnormality of the urinary system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000079> "An abnormality of the urinary system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000079> "Abnormality of the urinary system")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000079> <http://purl.obolibrary.org/obo/HP_0000119>)

# Class: <http://purl.obolibrary.org/obo/HP_0000118> (Phenotypic abnormality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000118> "A phenotypic abnormality.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000118> "Phenotypic abnormality")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000118> <http://purl.obolibrary.org/obo/HP_0000001>)

# Class: <http://purl.obolibrary.org/obo/HP_0000119> (Abnormality of the genitourinary system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000119> "The presence of any abnormality of the genitourinary system.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000119> "Genitourinary disease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000119> "Genitourinary dysplasia")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000119> "Abnormality of the genitourinary system")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000119> <http://purl.obolibrary.org/obo/HP_0000118>)

# Class: <http://purl.obolibrary.org/obo/HP_0000152> (Abnormality of head or neck)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000152> "An abnormality of head and neck.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000152> "Abnormality of head or neck")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000152> <http://purl.obolibrary.org/obo/HP_0000118>)

# Class: <http://purl.obolibrary.org/obo/HP_0000234> (Abnormality of the head)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000234> "An abnormality of the head.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000234> "Abnormality of the head")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000234> <http://purl.obolibrary.org/obo/HP_0000152>)

# Class: <http://purl.obolibrary.org/obo/HP_0000240> (Abnormality of skull size)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000240> "Any abnormality of the size of the skull.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000240> "Abnormality of skull size")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000240> <http://purl.obolibrary.org/obo/HP_0000929>)

# Class: <http://purl.obolibrary.org/obo/HP_0000252> (Microcephaly)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000252> "Head circumference below 2 standard deviations below the mean for age and gender.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0000252> "Fyler:4310")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000252> "Microcephaly")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000252> <http://purl.obolibrary.org/obo/HP_0007364>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000252> <http://purl.obolibrary.org/obo/HP_0040195>)

# Class: <http://purl.obolibrary.org/obo/HP_0000478> (Abnormality of the eye)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000478> "Any abnormality of the eye, including location, spacing, and intraocular abnormalities.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000478> "Eye disease")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000478> "Abnormality of the eye")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000478> <http://purl.obolibrary.org/obo/HP_0000118>)

# Class: <http://purl.obolibrary.org/obo/HP_0000504> (Abnormality of vision)

