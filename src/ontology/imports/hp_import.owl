AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0005181> "Premature coronary artery atherosclerosis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0005181> <http://purl.obolibrary.org/obo/HP_0001677>)

