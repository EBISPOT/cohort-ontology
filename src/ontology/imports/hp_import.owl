AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100545> "Arterial stenosis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100545> <http://purl.obolibrary.org/obo/HP_0011004>)

