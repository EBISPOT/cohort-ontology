AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5200423> "Subjective phenomena or perceptions that deviate from what is considered correct or are outside the range of normal human experiences.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5200423> "Abnormal experience of reality")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5200423> <http://purl.obolibrary.org/obo/HP_0011446>)

# Class: <http://purl.obolibrary.org/obo/HP_5200430> (Abnormal psychotic pattern)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5200430> "Any abnormal pattern of psychotic experiences, where an individual has significant disturbances in their thoughts, perceptions, emotions, and behavior, resulting in a loss of touch with reality.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5200430> "Abnormal psychotic pattern")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5200430> <http://purl.obolibrary.org/obo/HP_5200423>)

