AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030956> "An anomaly of the electrical conduction physiology of the heart.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030956> "Abnormality of cardiovascular system electrophysiology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030956> <http://purl.obolibrary.org/obo/HP_0011025>)

# Class: <http://purl.obolibrary.org/obo/HP_0030962> (Abnormal morphology of the great vessels)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030962> "A structural anomaly affecting a blood vessel involved in the circulation of the heart, i.e., the superior or inferior vena cava, the pulmonary arteries, the pulmonary veins, and the aorta.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030962> "Abnormal morphology of the great vessels")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030962> <http://purl.obolibrary.org/obo/HP_0033353>)

# Class: <http://purl.obolibrary.org/obo/HP_0031501> (Pelvic mass)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031501> "An abnormal enlargement or swelling in the pelvic region.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031501> "Pelvic mass")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031501> <http://purl.obolibrary.org/obo/HP_0001438>)

# Class: <http://purl.obolibrary.org/obo/HP_0031567> (Abnormal aortic valve cusp morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031567> "Any structural anomaly of the aortic valve leaflets.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0031567> "Fyler:1480")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031567> "Abnormal aortic valve cusp morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031567> <http://purl.obolibrary.org/obo/HP_0001646>)

# Class: <http://purl.obolibrary.org/obo/HP_0032101> (Unusual infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032101> "Increased susceptibility to infection, as manifested by recurrent infection, severe or invasive infection, infection occurring in an unusual anatomical location, or infection with opportunistic organisms, that is unusual for a healthy individual of the same age.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032101> "Unusual infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032101> <http://purl.obolibrary.org/obo/HP_0010978>)

# Class: <http://purl.obolibrary.org/obo/HP_0032169> (Severe infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032169> "A type of infection that is regarded as a sign of a pathological susceptibility to infection because of unusual severity or intensity of the infection.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032169> "Severe infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032169> <http://purl.obolibrary.org/obo/HP_0032101>)

# Class: <http://purl.obolibrary.org/obo/HP_0032180> (Abnormal circulating metabolite concentration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032180> "An abnormal level of an analyte measured in the blood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032180> "Abnormal circulating metabolite concentration")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032180> <http://purl.obolibrary.org/obo/HP_0001939>)

# Class: <http://purl.obolibrary.org/obo/HP_0032325> (Lacunar stroke)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032325> "A stroke related to a small infarct (2-20 mm in diameter) in the deep cerebral white matter, basal ganglia, or pons, that is presumed to result from the occlusion of a single small perforating artery supplying the subcortical areas of the brain.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032325> "Lacunar stroke")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032325> <http://purl.obolibrary.org/obo/HP_0002140>)

# Class: <http://purl.obolibrary.org/obo/HP_0033127> (Abnormality of the musculoskeletal system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033127> "An anomaly of the musculoskeletal system, which consists of the bones of the skeleton, muscles, cartilage, tendons, ligaments, joints, and other connective tissue. The musculoskeletal system supports the weight of the body, maintains body position and produces movements of the body or of parts of the body.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033127> "Abnormality of the musculoskeletal system")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033127> <http://purl.obolibrary.org/obo/HP_0000118>)

# Class: <http://purl.obolibrary.org/obo/HP_0033353> (Abnormal blood vessel morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033353> "Any structural anomaly of a blood vessel (artery, arteriole, capillary, venule, or vein).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033353> "Abnormal blood vessel morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033353> <http://purl.obolibrary.org/obo/HP_0025015>)

# Class: <http://purl.obolibrary.org/obo/HP_0033354> (Abnormal urine metabolite level)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033354> "Any deviation from the normal amount of a metabolite in urine.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033354> "Abnormal urine metabolite level")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033354> <http://purl.obolibrary.org/obo/HP_0003110>)

# Class: <http://purl.obolibrary.org/obo/HP_0033401> (Tissue ischemia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033401> "Ischemia is defined as a restriction of arterial blood supply to a tissue associated with insufficient oxygenation to support the metabolis requirements of the tissue. Depending on the involved tissues, clinical manifestations may include pain, pallor, lack of pulse, coldness, paresthesia, and paralysis. Additional associated manifestations include hemodynamic parameters (reduced blood pressure distal to the site of restricted arterial supply) and angiographic evidence of arterial occclusion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033401> "Tissue ischemia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033401> <http://purl.obolibrary.org/obo/HP_0025323>)

# Class: <http://purl.obolibrary.org/obo/HP_0034267> (Pelvic pain)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0034267> "Pain perceived in the area of the pelvis, the lower part of the abdomen located between the hip bones.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0034267> "Pelvic pain")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0034267> <http://purl.obolibrary.org/obo/HP_0012531>)

# Class: <http://purl.obolibrary.org/obo/HP_0040195> (Decreased head circumference)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0040195> "An abnormally reduced head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart. Microcephaly is defined as a head circumference (HC) that is great than two standard deviations below the mean of age- and gender-matched population based samples. Severe microcephaly is defined with an HC that is three standard deviations below the mean.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0040195> "Decreased head circumference")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0040195> <http://purl.obolibrary.org/obo/HP_0000240>)

# Class: <http://purl.obolibrary.org/obo/HP_0100326> (Immunologic hypersensitivity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100326> "Immunological states where the immune system produces harmful responses upon reexposure to sensitizing antigens.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100326> "Immunologic hypersensitivity")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100326> <http://purl.obolibrary.org/obo/HP_0010978>)

# Class: <http://purl.obolibrary.org/obo/HP_0100543> (Cognitive impairment)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100543> "Abnormal cognition is characterized by deficits in thinking, reasoning, or remembering.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100543> "Cognitive impairment")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100543> <http://purl.obolibrary.org/obo/HP_0011446>)

