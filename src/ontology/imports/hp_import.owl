AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000539> "Abnormality of refraction")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000539> <http://purl.obolibrary.org/obo/HP_0012373>)

# Class: <http://purl.obolibrary.org/obo/HP_0000545> (Myopia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000545> "An abnormality of refraction characterized by the ability to see objects nearby clearly, while objects in the distance appear blurry.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000545> "Myopia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000545> <http://purl.obolibrary.org/obo/HP_0000539>)

