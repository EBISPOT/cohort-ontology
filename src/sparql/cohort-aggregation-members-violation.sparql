# An aggregation needs at least two distinct, named, active cohort members.
# OWL's minimum-cardinality restriction alone does not require named members.
PREFIX coho: <http://www.ebi.ac.uk/coho/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?term ?label (COUNT(DISTINCT ?cohort) AS ?cohort_count)
WHERE {
  ?term a owl:NamedIndividual ;
        a/rdfs:subClassOf* coho:COHO_0000001 .
  FILTER(STRSTARTS(STR(?term), STR(coho:)))
  FILTER NOT EXISTS { ?term owl:deprecated true }
  OPTIONAL { ?term rdfs:label ?label }
  OPTIONAL {
    ?term coho:hasCohort ?cohort .
    ?cohort a owl:NamedIndividual ;
            a/rdfs:subClassOf* coho:COHO_0000000 .
    FILTER(isIRI(?cohort) && ?cohort != ?term)
    FILTER NOT EXISTS { ?cohort owl:deprecated true }
  }
}
GROUP BY ?term ?label
HAVING(COUNT(DISTINCT ?cohort) < 2)
ORDER BY ?term
