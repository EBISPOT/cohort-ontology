# Every active COHO individual needs an example, including aggregations and
# temporarily unclassified records, except placeholder terms whose curation status
# is uncurated (IAO:0000124). Examples are imported from example_studies.
PREFIX coho: <http://www.ebi.ac.uk/coho/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?term ?label
WHERE {
  ?term a owl:NamedIndividual .
  FILTER(STRSTARTS(STR(?term), STR(coho:)))
  FILTER NOT EXISTS { ?term owl:deprecated true }
  FILTER NOT EXISTS { ?term obo:IAO_0000114 obo:IAO_0000124 }
  OPTIONAL { ?term rdfs:label ?label }
  FILTER NOT EXISTS {
    ?term obo:IAO_0000112 ?example .
    FILTER((isLiteral(?example) || isIRI(?example)) && REGEX(STR(?example), "\\S"))
  }
}
ORDER BY ?term
